#!/usr/bin/env swift
//
// inspect-lulu-alert — read-only reader for the LuLu firewall alert window.
//
// Reads the currently visible LuLu alert through the macOS Accessibility API
// and writes one JSON object to stdout. It never presses a button, never
// changes the rule scope or duration, and never creates a LuLu rule. It reads
// Accessibility attributes and configures only this reader's IPC timeout.
//
// Usage:
//   inspect-lulu-alert              read the live alert, print the parsed JSON
//   inspect-lulu-alert --dump       print the raw Accessibility element dump
//   inspect-lulu-alert --fixture F  parse a saved dump instead of reading live
//   inspect-lulu-alert --help
//
// Exit status:
//   0   read succeeded (an alert was present, or provably was not)
//   64  usage error
//   69  LuLu is not running
//   70  capture failed, was incomplete, or could not select a unique alert
//   77  Accessibility permission denied
//

import Cocoa
import ApplicationServices
import Darwin

let kLuLuBundleID = "com.objective-see.lulu.app"
let kAlertWindowTitle = "lulu alert"
let kDumpSchema = "lulu-alert-ax-dump/1"
let kMaxDepth = 40
let kMaxElements = 4000
let kMaxFixtureBytes = 8 * 1024 * 1024
let kMaxTextBytes = 16 * 1024
let kMaxRawPairBytes = 64 * 1024
let kMaxRawPairs = 64

// MARK: - Exit

enum ExitCode: Int32 {
    case ok = 0
    case usage = 64
    case notRunning = 69
    case readFailed = 70
    case accessibilityDenied = 77
}

func fail(_ code: ExitCode, _ message: String) -> Never {
    FileHandle.standardError.write(("inspect-lulu-alert: " + message + "\n").data(using: .utf8)!)
    exit(code.rawValue)
}

// MARK: - Element model

/// One Accessibility element, flattened out of the alert window's tree.
struct Element {
    var index: Int
    var depth: Int
    var role: String?
    var subrole: String?
    var title: String?
    var value: String?
    var numberValue: Double?
    var elementDescription: String?
    var help: String?
    var identifier: String?
    var enabled: Bool?
    var x: Double?
    var y: Double?
    var width: Double?
    var height: Double?

    /// The element's visible text, whichever attribute happens to carry it.
    var text: String? {
        for candidate in [value, title, elementDescription] {
            if let candidate, !candidate.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
                return candidate.trimmingCharacters(in: .whitespacesAndNewlines)
            }
        }
        return nil
    }

    var hasFrame: Bool { x != nil && y != nil && width != nil && height != nil }
    var minX: Double { x ?? 0 }
    var maxX: Double { (x ?? 0) + (width ?? 0) }
    var minY: Double { y ?? 0 }
    var maxY: Double { (y ?? 0) + (height ?? 0) }
    var midY: Double { (minY + maxY) / 2 }

    var asJSON: [String: Any] {
        var out: [String: Any] = ["index": index, "depth": depth]
        out["role"] = role ?? NSNull()
        out["subrole"] = subrole ?? NSNull()
        out["title"] = title ?? NSNull()
        out["value"] = value ?? NSNull()
        out["number_value"] = numberValue ?? NSNull()
        out["description"] = elementDescription ?? NSNull()
        out["help"] = help ?? NSNull()
        out["identifier"] = identifier ?? NSNull()
        out["enabled"] = enabled ?? NSNull()
        out["x"] = x ?? NSNull()
        out["y"] = y ?? NSNull()
        out["width"] = width ?? NSNull()
        out["height"] = height ?? NSNull()
        return out
    }

    init(index: Int, depth: Int) {
        self.index = index
        self.depth = depth
    }

    init(json: [String: Any], fallbackIndex: Int) {
        index = json["index"] as? Int ?? fallbackIndex
        depth = json["depth"] as? Int ?? 0
        role = json["role"] as? String
        subrole = json["subrole"] as? String
        title = json["title"] as? String
        value = json["value"] as? String
        numberValue = json["number_value"] as? Double
        elementDescription = json["description"] as? String
        help = json["help"] as? String
        identifier = json["identifier"] as? String
        enabled = json["enabled"] as? Bool
        x = json["x"] as? Double
        y = json["y"] as? Double
        width = json["width"] as? Double
        height = json["height"] as? Double
    }
}

/// Everything a single read produced: which LuLu was read, whether an alert
/// window was found, and the flattened element tree of that window.
struct Dump {
    var luluPID: Int?
    var luluVersion: String?
    var luluRunning: Bool
    var windowFound: Bool
    var windowTitle: String?
    var windowCount: Int
    var alertWindowCount: Int
    var matchedBy: String?
    var elements: [Element]
    var readIssues: [String] = []
    var capturedAt: String?

    var asJSON: [String: Any] {
        [
            "schema": kDumpSchema,
            "read_issues": readIssues,
            "captured_at": capturedAt ?? NSNull(),
            "lulu": [
                "bundle_id": kLuLuBundleID,
                "running": luluRunning,
                "pid": luluPID ?? NSNull(),
                "version": luluVersion ?? NSNull(),
            ] as [String: Any],
            "window": [
                "found": windowFound,
                "title": windowTitle ?? NSNull(),
                "app_window_count": windowCount,
                "alert_window_count": alertWindowCount,
                "matched_by": matchedBy ?? NSNull(),
            ] as [String: Any],
            "elements": elements.map { $0.asJSON },
        ]
    }
}

// MARK: - Accessibility reads

var captureIssues: [String] = []
var captureDeadline: TimeInterval?

func captureIssue(_ message: String) {
    if !captureIssues.contains(message) { captureIssues.append(message) }
}

func withinCaptureBudget() -> Bool {
    if let deadline = captureDeadline, ProcessInfo.processInfo.systemUptime >= deadline {
        captureIssue("Accessibility capture exceeded its 20-second read budget")
        return false
    }
    return true
}

func axCopy(_ element: AXUIElement, _ attribute: String) -> CFTypeRef? {
    guard withinCaptureBudget() else { return nil }
    var value: CFTypeRef?
    let status = AXUIElementCopyAttributeValue(element, attribute as CFString, &value)
    guard status == .success else {
        if status != .noValue && status != .attributeUnsupported {
            captureIssue("Accessibility attribute read failed: \(attribute) (\(status.rawValue))")
        }
        return nil
    }
    return value
}

func axString(_ element: AXUIElement, _ attribute: String) -> String? {
    guard let raw = axCopy(element, attribute) else { return nil }
    if let string = raw as? String {
        guard string.utf8.count <= kMaxTextBytes else {
            captureIssue("Accessibility text exceeded the 16 KiB field limit")
            return nil
        }
        let trimmed = string.trimmingCharacters(in: .whitespacesAndNewlines)
        return trimmed.isEmpty ? nil : trimmed
    }
    if let attributed = raw as? NSAttributedString {
        guard attributed.string.utf8.count <= kMaxTextBytes else {
            captureIssue("Accessibility text exceeded the 16 KiB field limit")
            return nil
        }
        let trimmed = attributed.string.trimmingCharacters(in: .whitespacesAndNewlines)
        return trimmed.isEmpty ? nil : trimmed
    }
    return nil
}

func axNumber(_ element: AXUIElement, _ attribute: String) -> Double? {
    guard let raw = axCopy(element, attribute) else { return nil }
    if let number = raw as? NSNumber { return number.doubleValue }
    if let flag = raw as? Bool { return flag ? 1 : 0 }
    return nil
}

func axBool(_ element: AXUIElement, _ attribute: String) -> Bool? {
    guard let raw = axCopy(element, attribute), let number = raw as? NSNumber else { return nil }
    return number.boolValue
}

func axPoint(_ element: AXUIElement, _ attribute: String) -> CGPoint? {
    guard let raw = axCopy(element, attribute), CFGetTypeID(raw) == AXValueGetTypeID() else {
        return nil
    }
    var point = CGPoint.zero
    // swiftlint:disable:next force_cast
    guard AXValueGetValue(raw as! AXValue, .cgPoint, &point) else { return nil }
    return point
}

func axSize(_ element: AXUIElement, _ attribute: String) -> CGSize? {
    guard let raw = axCopy(element, attribute), CFGetTypeID(raw) == AXValueGetTypeID() else {
        return nil
    }
    var size = CGSize.zero
    // swiftlint:disable:next force_cast
    guard AXValueGetValue(raw as! AXValue, .cgSize, &size) else { return nil }
    return size
}

func axChildren(_ element: AXUIElement, role: String?) -> [AXUIElement] {
    guard let raw = axCopy(element, kAXChildrenAttribute as String) else {
        if ["AXWindow", "AXGroup", "AXScrollArea", "AXRadioGroup", "AXTabGroup", "AXSplitGroup"].contains(role ?? "") {
            captureIssue("Accessibility container children were unavailable")
        }
        return []
    }
    guard let children = raw as? [AXUIElement] else {
        captureIssue("Accessibility children had an unsupported type")
        return []
    }
    return children
}

/// Flatten one window's element tree, depth first, bounded so a pathological
/// tree cannot hang the read.
func flatten(window: AXUIElement) -> [Element] {
    var out: [Element] = []
    var stack: [(AXUIElement, Int)] = [(window, 0)]

    while let (node, depth) = stack.popLast() {
        guard withinCaptureBudget() else { break }
        if out.count >= kMaxElements {
            captureIssue("Accessibility element limit truncated the capture")
            break
        }

        var element = Element(index: out.count, depth: depth)
        element.role = axString(node, kAXRoleAttribute as String)
        if element.role == nil { captureIssue("An Accessibility element role was unreadable") }
        element.subrole = axString(node, kAXSubroleAttribute as String)
        element.title = axString(node, kAXTitleAttribute as String)
        element.value = axString(node, kAXValueAttribute as String)
        element.numberValue = axNumber(node, kAXValueAttribute as String)
        element.elementDescription = axString(node, kAXDescriptionAttribute as String)
        element.help = axString(node, kAXHelpAttribute as String)
        element.identifier = axString(node, kAXIdentifierAttribute as String)
        element.enabled = axBool(node, kAXEnabledAttribute as String)
        if let point = axPoint(node, kAXPositionAttribute as String) {
            element.x = Double(point.x)
            element.y = Double(point.y)
        }
        if let size = axSize(node, kAXSizeAttribute as String) {
            element.width = Double(size.width)
            element.height = Double(size.height)
        }
        out.append(element)

        let children = axChildren(node, role: element.role)
        if depth < kMaxDepth {
            for child in children.reversed() {
                stack.append((child, depth + 1))
            }
        } else if !children.isEmpty {
            captureIssue("Accessibility depth limit truncated the capture")
        }
    }
    return out
}

func readLiveDump() -> Dump {
    guard AXIsProcessTrusted() else {
        fail(.accessibilityDenied, """
            Accessibility permission is denied for the process running this script. \
            Grant it under System Settings > Privacy & Security > Accessibility, \
            then re-run. Until then the alert cannot be read.
            """)
    }

    // This configures IPC timeouts in this reader process, not LuLu UI state.
    guard AXUIElementSetMessagingTimeout(AXUIElementCreateSystemWide(), 0.5) == .success else {
        fail(.readFailed, "could not bound Accessibility messaging")
    }
    captureDeadline = ProcessInfo.processInfo.systemUptime + 20
    let running = NSRunningApplication.runningApplications(withBundleIdentifier: kLuLuBundleID)
    guard let lulu = running.first else {
        fail(.notRunning, "no running application matches LuLu's supported bundle identifier; no alert was read.")
    }
    guard running.count == 1 else {
        return Dump(luluPID: nil, luluVersion: nil, luluRunning: true, windowFound: false,
                    windowTitle: nil, windowCount: 0, alertWindowCount: 0, matchedBy: nil,
                    elements: [], readIssues: ["Multiple LuLu instances; no instance selected"],
                    capturedAt: iso8601Now())
    }

    var version: String?
    if let bundleURL = lulu.bundleURL, let bundle = Bundle(url: bundleURL) {
        version = bundle.infoDictionary?["CFBundleShortVersionString"] as? String
    }

    let app = AXUIElementCreateApplication(lulu.processIdentifier)
    var dump = Dump(
        luluPID: Int(lulu.processIdentifier),
        luluVersion: version,
        luluRunning: true,
        windowFound: false,
        windowTitle: nil,
        windowCount: 0,
        alertWindowCount: 0,
        matchedBy: nil,
        elements: [],
        capturedAt: iso8601Now()
    )

    func windowList() -> [AXUIElement]? {
        guard let raw = axCopy(app, kAXWindowsAttribute as String), let windows = raw as? [AXUIElement] else {
            captureIssue("LuLu window list was unavailable or had an unsupported type")
            return nil
        }
        return windows
    }
    guard let windows = windowList() else {
        dump.readIssues = captureIssues
        return dump
    }
    dump.windowCount = windows.count

    /// An alert shows LuLu's "<name> is connecting to <destination>" line. The
    /// second test is deliberately narrow: the Rules window also lists allow
    /// and block controls, and reading it as an alert would attribute one
    /// connection's evidence to a different one.
    func looksLikeAnAlert(_ elements: [Element]) -> Bool {
        var sawConnecting = false
        var sawAllow = false
        var sawBlock = false
        for element in elements {
            guard let text = element.text?.lowercased() else { continue }
            if text.contains("is connecting to") { sawConnecting = true }
            if element.role == "AXButton" {
                if text == "allow" { sawAllow = true }
                if text == "block" { sawBlock = true }
            }
        }
        return sawConnecting && sawAllow && sawBlock
    }

    // Prefer the window LuLu titles "LuLu Alert". Rules, Preferences and the
    // status-bar popover are also AX windows, so title matching keeps the read
    // off them; content matching is the fallback for a retitled release.
    var candidates: [(AXUIElement, [Element], String, String?)] = []
    for window in windows {
        guard withinCaptureBudget() else { break }
        let title = axString(window, kAXTitleAttribute as String)
        let elements = flatten(window: window)
        if normalize(title ?? "") == kAlertWindowTitle {
            candidates.append((window, elements, "title", title))
        } else if looksLikeAnAlert(elements) {
            candidates.append((window, elements, "content", title))
        } else {
            captureIssue("A LuLu window was not recognized as a supported alert; absence is unconfirmed")
        }
    }
    dump.alertWindowCount = candidates.count
    if candidates.count > 1 {
        captureIssue("Multiple alert windows; no alert selected")
    } else if let (target, elements, matchedBy, title) = candidates.first {
        dump.windowFound = true
        dump.matchedBy = matchedBy
        dump.windowTitle = title
        dump.elements = elements
        // Detect an observed replacement or edit. Two matching reads are not
        // an atomic snapshot and cannot bind a later click to this evidence.
        let repeated = flatten(window: target)
        let originalJSON = try? JSONSerialization.data(withJSONObject: elements.map { $0.asJSON }, options: .sortedKeys)
        let repeatedJSON = try? JSONSerialization.data(withJSONObject: repeated.map { $0.asJSON }, options: .sortedKeys)
        if originalJSON == nil || originalJSON != repeatedJSON {
            captureIssue("Selected alert changed during the read")
        }
    }
    if let repeated = windowList() {
        if windows.count != repeated.count || !zip(windows, repeated).allSatisfy({ CFEqual($0.0, $0.1) }) {
            captureIssue("LuLu window list changed during the read")
        }
    }
    dump.readIssues = captureIssues
    return dump
}

func readFixtureDump(path: String) -> Dump {
    let descriptor = open(path, O_RDONLY | O_NOFOLLOW | O_NONBLOCK)
    guard descriptor >= 0 else { fail(.usage, "cannot read fixture file") }
    let handle = FileHandle(fileDescriptor: descriptor, closeOnDealloc: true)
    defer { try? handle.close() }
    var before = stat()
    guard fstat(descriptor, &before) == 0, before.st_mode & S_IFMT == S_IFREG,
          before.st_size >= 0, before.st_size <= kMaxFixtureBytes,
          let data = try? handle.read(upToCount: kMaxFixtureBytes + 1), data.count <= kMaxFixtureBytes else {
        fail(.usage, "fixture must be a readable regular file within the 8 MiB limit")
    }
    var after = stat()
    guard fstat(descriptor, &after) == 0, data.count == before.st_size,
          before.st_dev == after.st_dev, before.st_ino == after.st_ino,
          before.st_mode == after.st_mode, before.st_size == after.st_size,
          before.st_mtimespec.tv_sec == after.st_mtimespec.tv_sec,
          before.st_mtimespec.tv_nsec == after.st_mtimespec.tv_nsec,
          before.st_ctimespec.tv_sec == after.st_ctimespec.tv_sec,
          before.st_ctimespec.tv_nsec == after.st_ctimespec.tv_nsec else {
        fail(.usage, "fixture changed during the bounded read")
    }
    guard let root = (try? JSONSerialization.jsonObject(with: data)) as? [String: Any] else {
        fail(.usage, "fixture is not a JSON object")
    }
    guard root["schema"] as? String == kDumpSchema else {
        fail(.usage, "fixture schema must be \(kDumpSchema)")
    }
    func keys(_ object: [String: Any], _ allowed: Set<String>) {
        guard Set(object.keys).isSubset(of: allowed) else { fail(.usage, "fixture contains unsupported fields") }
    }
    func number(_ value: Any?) -> Double? {
        guard let n = value as? NSNumber, CFGetTypeID(n) != CFBooleanGetTypeID(), n.doubleValue.isFinite else { return nil }
        return n.doubleValue
    }
    func integer(_ value: Any?, minimum: Int = 0, maximum: Int = Int(Int32.max)) -> Int? {
        guard let n = number(value), n >= Double(minimum), n <= Double(maximum), n.rounded() == n else { return nil }
        return Int(n)
    }
    func flag(_ value: Any?) -> Bool? {
        guard let n = value as? NSNumber, CFGetTypeID(n) == CFBooleanGetTypeID() else { return nil }
        return n.boolValue
    }
    func optionalString(_ object: [String: Any], _ key: String) {
        if let value = object[key], !(value is NSNull), !(value is String) {
            fail(.usage, "fixture has an invalid string field")
        }
    }
    keys(root, ["schema", "lulu", "window", "elements", "read_issues", "captured_at"])
    guard let lulu = root["lulu"] as? [String: Any],
          let window = root["window"] as? [String: Any],
          let rawElements = root["elements"] as? [[String: Any]], rawElements.count <= kMaxElements,
          lulu["bundle_id"] as? String == kLuLuBundleID,
          let running = flag(lulu["running"]), let found = flag(window["found"]),
          let windowCount = integer(window["app_window_count"], maximum: kMaxElements),
          let alertCount = integer(window["alert_window_count"], maximum: kMaxElements), alertCount <= windowCount else {
        fail(.usage, "fixture has missing or invalid source, window or element metadata")
    }
    keys(lulu, ["bundle_id", "running", "pid", "version"])
    keys(window, ["found", "title", "app_window_count", "alert_window_count", "matched_by"])
    optionalString(lulu, "version")
    optionalString(window, "title")
    optionalString(window, "matched_by")
    optionalString(root, "captured_at")
    if let captured = root["captured_at"] as? String, ISO8601DateFormatter().date(from: captured) == nil {
        fail(.usage, "fixture captured_at is not an ISO 8601 timestamp")
    }
    let pid = integer(lulu["pid"], minimum: 1)
    if let raw = lulu["pid"], !(raw is NSNull), pid == nil { fail(.usage, "fixture has an invalid LuLu PID") }
    var issues: [String] = []
    if let raw = root["read_issues"] {
        guard let strings = raw as? [String], strings.count <= 100,
              strings.allSatisfy({ !$0.isEmpty && $0.count <= 500 }) else { fail(.usage, "fixture has invalid read_issues") }
        issues = strings
    }
    guard (!running || pid != nil || !issues.isEmpty),
          (!found || ["title", "content"].contains(window["matched_by"] as? String ?? "")),
          (found || window["matched_by"] == nil || window["matched_by"] is NSNull) else {
        fail(.usage, "fixture lacks valid source or selection identity")
    }
    guard (!found || running && alertCount > 0 && !rawElements.isEmpty),
          (found || rawElements.isEmpty), (running || windowCount == 0),
          (found || alertCount == 0 || !issues.isEmpty) else {
        fail(.usage, "fixture window and source metadata contradict its elements")
    }
    var indexes = Set<Int>()
    for item in rawElements {
        keys(item, ["index", "depth", "role", "subrole", "title", "value", "number_value", "description",
                    "help", "identifier", "enabled", "x", "y", "width", "height"])
        guard let index = integer(item["index"], maximum: kMaxElements - 1), indexes.insert(index).inserted,
              integer(item["depth"], maximum: kMaxDepth) != nil else {
            fail(.usage, "fixture has invalid or duplicate element indexes/depths")
        }
        for key in ["role", "subrole", "title", "value", "description", "help", "identifier"] {
            optionalString(item, key)
        }
        if let role = item["role"] as? String {
            guard !role.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
                fail(.usage, "fixture has a blank element role")
            }
        } else if issues.isEmpty {
            fail(.usage, "fixture has an unreadable role without a capture issue")
        }
        for key in ["x", "y", "width", "height", "number_value"] {
            if let raw = item[key], !(raw is NSNull) {
                guard let n = number(raw), (!["width", "height"].contains(key) || n >= 0) else {
                    fail(.usage, "fixture has an invalid numeric element field")
                }
            }
        }
        if let raw = item["enabled"], !(raw is NSNull), flag(raw) == nil {
            fail(.usage, "fixture has an invalid enabled flag")
        }
    }
    var dump = Dump(
        luluPID: pid,
        luluVersion: lulu["version"] as? String,
        luluRunning: running,
        windowFound: found,
        windowTitle: window["title"] as? String,
        windowCount: windowCount,
        alertWindowCount: alertCount,
        matchedBy: window["matched_by"] as? String,
        elements: rawElements.enumerated().map { Element(json: $1, fallbackIndex: $0) },
        readIssues: issues,
        capturedAt: root["captured_at"] as? String
    )
    if alertCount > 1 {
        dump.windowFound = false
        dump.elements = []
        dump.windowTitle = nil
        dump.matchedBy = nil
        if !dump.readIssues.contains("Multiple alert windows; no alert selected") {
            dump.readIssues.append("Multiple alert windows; no alert selected")
        }
    }
    return dump
}

// MARK: - Parsing

func normalize(_ text: String) -> String {
    text.lowercased()
        .trimmingCharacters(in: .whitespacesAndNewlines)
        .replacingOccurrences(of: "\u{00A0}", with: " ")
}

/// Vertical overlap between two elements, as a fraction of the shorter one.
func verticalOverlap(_ a: Element, _ b: Element) -> Double {
    let top = max(a.minY, b.minY)
    let bottom = min(a.maxY, b.maxY)
    let shorter = min(a.maxY - a.minY, b.maxY - b.minY)
    guard shorter > 0 else { return 0 }
    return max(0, bottom - top) / shorter
}

struct ParsedAlert {
    var headline: String?
    var processName: String?
    var processID: Int?
    var processPath: String?
    var processArgs: String?
    var ipAddress: String?
    var portProtocol: String?
    var reverseDNS: String?
    var timestamp: String?
    var ruleScope: String?
    var ruleDuration: String?
    var scopeOptions: [[String: Any]] = []
    var durationOptions: [[String: Any]] = []
    var scopeOptionsComplete = false
    var durationOptionsComplete = false
    var buttons: [String] = []
    var labelPairs: [[String: Any]] = []
    var unreadable: [String] = []
}

// LuLu 4.3.2 lays the details out in two columns — Process on the left,
// Connection on the right — with each value drawn to the right of its label
// but *inside* the label field's own width.
let detailLabels: [(field: String, label: String)] = [
    ("process_id", "pid:"),
    ("process_args", "args:"),
    ("process_path", "path:"),
    ("ip_address", "ip address:"),
    ("port_protocol", "port/protocol:"),
    ("reverse_dns", "(reverse) dns:"),
]

let groupLabels = ["rule scope:", "rule duration:"]
let sectionHeaders = ["process:", "connection:", "details:", "details & options"]
let timestampPrefix = "time stamp:"
let controlRoles: Set<String> = ["AXRadioButton", "AXCheckBox", "AXPopUpButton"]

func parse(dump: Dump) -> ParsedAlert {
    var parsed = ParsedAlert()
    let elements = dump.elements.map { original -> Element in
        var element = original
        if [element.value, element.title, element.elementDescription].contains(where: {
            ($0?.utf8.count ?? 0) > kMaxTextBytes
        }) {
            // Keep geometry/control identity, but never substitute another
            // attribute after discarding an oversized value.
            element.value = nil
            element.title = nil
            element.elementDescription = nil
            if !parsed.unreadable.contains("oversized_text") { parsed.unreadable.append("oversized_text") }
        }
        return element
    }

    // Texts that are chrome rather than data: they must never be picked up as
    // the value belonging to some other label.
    let nonValueTexts = Set(
        detailLabels.map { $0.label } + groupLabels + sectionHeaders + ["lulu alert"]
    )

    // The window itself carries a title and encloses every child, so leaving it
    // in would let it masquerade as a neighbouring value.
    let textElements = elements.filter { $0.text != nil && $0.hasFrame && $0.role != "AXWindow" }

    /// The nearest text to the right of `label` on the same row. LuLu draws the
    /// value inside the label's own frame, so this compares left edges rather
    /// than starting past the label's right edge.
    func valueRightOf(_ label: Element) -> String? {
        // The next column's label is a boundary, not a replacement value.
        // Section headers also bound a missing field whose peer label is gone.
        let rowBoundaries = textElements.filter { candidate in
            candidate.minX > label.minX + 4 && verticalOverlap(candidate, label) >= 0.5
                && detailLabels.contains(where: { $0.label == normalize(candidate.text!) })
        }.map { $0.minX }
        let sectionBoundaries = textElements.filter { candidate in
            candidate.minX > label.minX + 4 && candidate.minY < label.minY
                && ["process:", "connection:"].contains(normalize(candidate.text!))
        }.map { $0.minX }
        let rightEdge = min(label.maxX, (rowBoundaries + sectionBoundaries).min() ?? Double.infinity)
        let candidates = textElements.filter { candidate in
            candidate.index != label.index
                && candidate.minX > label.minX + 4
                && candidate.minX < rightEdge
                && verticalOverlap(candidate, label) >= 0.5
                && ["AXStaticText", "AXTextArea", "AXTextField"].contains(candidate.role ?? "")
                && !nonValueTexts.contains(normalize(candidate.text!))
                && !normalize(candidate.text!).hasPrefix(timestampPrefix)
                && !controlRoles.contains(candidate.role ?? "")
        }
        let ordered = candidates.sorted { $0.minX < $1.minX }
        guard let first = ordered.first,
              ordered.count == 1 || ordered[1].minX - first.minX > 1 else { return nil }
        return first.text
    }

    for (field, label) in detailLabels {
        let labels = textElements.filter {
            normalize($0.text!) == label && $0.role == "AXStaticText"
        }
        guard labels.count == 1, let labelElement = labels.first, let value = valueRightOf(labelElement) else {
            parsed.unreadable.append(field)
            continue
        }
        switch field {
        case "process_id":
            parsed.processID = Int(value)
            if parsed.processID == nil || parsed.processID! <= 0 || parsed.processID! > Int32.max {
                parsed.processID = nil
                parsed.unreadable.append(field)
            }
        case "process_path":
            if value.hasPrefix("/") { parsed.processPath = value }
            else { parsed.unreadable.append(field) }
        case "process_args": parsed.processArgs = value
        case "ip_address": parsed.ipAddress = value
        case "port_protocol": parsed.portProtocol = value
        case "reverse_dns": parsed.reverseDNS = value
        default: break
        }
    }

    // LuLu draws the timestamp as one string, not as a label/value pair.
    let stamps = textElements.filter { $0.role == "AXStaticText" && normalize($0.text!).hasPrefix(timestampPrefix) }
    if stamps.count == 1, let stamp = stamps.first {
        parsed.timestamp = String(stamp.text!.dropFirst(timestampPrefix.count))
            .trimmingCharacters(in: .whitespacesAndNewlines)
    }
    if parsed.timestamp?.isEmpty != false {
        parsed.timestamp = nil
        parsed.unreadable.append("timestamp")
    }

    // Every static-text "label:" -> value pair, so a relabelled LuLu release
    // stays readable even when the canonical fields above come back empty.
    var rawPairBytes = 0
    var rawLabelsExamined = 0
    for element in textElements where element.text!.hasSuffix(":") {
        guard element.role == "AXStaticText" else { continue }
        let key = normalize(element.text!)
        if groupLabels.contains(key) || sectionHeaders.contains(key) { continue }
        rawLabelsExamined += 1
        guard rawLabelsExamined <= kMaxRawPairs else {
            parsed.unreadable.append("raw_label_pairs_truncated")
            break
        }
        if let value = valueRightOf(element) {
            let bytes = element.text!.utf8.count + value.utf8.count
            guard rawPairBytes + bytes <= kMaxRawPairBytes else {
                parsed.unreadable.append("raw_label_pairs_truncated")
                break
            }
            rawPairBytes += bytes
            parsed.labelPairs.append(["label": element.text!, "value": value])
        }
    }

    // The headline reads "<name> is connecting to <destination>"; LuLu splits it
    // across a bold name above and a text area below.
    let detailTop = textElements.filter { ["process:", "connection:"].contains(normalize($0.text!)) }
        .map { $0.minY }.min() ?? Double.infinity
    let headlines = textElements.filter { $0.minY < detailTop && $0.role == "AXTextArea"
        && normalize($0.text!).contains("is connecting to") }
    if headlines.count == 1, let connecting = headlines.first {
        parsed.headline = connecting.text
        let above = textElements.filter { candidate in
            candidate.index != connecting.index
                && candidate.maxY <= connecting.minY + 4
                && min(candidate.maxX, connecting.maxX) - max(candidate.minX, connecting.minX) > 0
                && !nonValueTexts.contains(normalize(candidate.text!))
        }
        parsed.processName = above.max(by: { $0.maxY < $1.maxY })?.text
    }
    if parsed.processName == nil, let path = parsed.processPath {
        parsed.processName = (path as NSString).lastPathComponent
    }
    if parsed.processName == nil { parsed.unreadable.append("process_name") }

    // Rule scope and duration sit under their labels in separate columns, and
    // LuLu renders scope as a pop-up button but duration as radio buttons.
    // Assign each control to the label above it that it lines up with.
    let allControls = elements.filter { controlRoles.contains($0.role ?? "") }
    let groupLabelElements = groupLabels.compactMap { wanted in
        textElements.first { normalize($0.text!) == wanted }
    }

    func horizontalOverlap(_ a: Element, _ b: Element) -> Double {
        max(0, min(a.maxX, b.maxX) - max(a.minX, b.minX))
    }

    func controls(under groupLabel: String) -> [Element] {
        let labels = textElements.filter { normalize($0.text!) == groupLabel }
        guard labels.count == 1, let label = labels.first else {
            return []
        }
        return allControls
            .filter { control in
                guard control.hasFrame, control.minY > label.minY else { return false }
                let ownOverlap = horizontalOverlap(control, label)
                guard ownOverlap > 0 else { return false }
                // A control that lines up better with the other group's label
                // belongs to that group instead.
                return groupLabelElements.allSatisfy { other in
                    other.index == label.index || horizontalOverlap(control, other) < ownOverlap
                }
            }
            .sorted { $0.minY < $1.minY }
    }

    /// A pop-up button *is* its current selection — it has no separate selected
    /// flag, and reporting `false` next to a matching `rule.scope` reads as a
    /// contradiction.
    func describe(_ control: Element) -> [String: Any] {
        var selected: Any = NSNull()
        if control.role == "AXPopUpButton" || control.numberValue == 1 { selected = true }
        else if control.numberValue == 0 { selected = false }
        return [
            "label": control.text ?? NSNull(),
            "role": control.role ?? NSNull(),
            "selected": selected,
        ]
    }

    /// A pop-up button's menu items only enter the Accessibility tree once the
    /// menu is opened, which is a click. So for a pop-up the list holds the
    /// current choice alone, and the alert offers others we cannot name.
    func optionsAreComplete(_ controls: [Element]) -> Bool {
        dump.readIssues.isEmpty && !uncertainControlLayout && !controls.isEmpty && controls.allSatisfy {
            $0.text != nil && $0.role == "AXRadioButton" && ($0.numberValue == 0 || $0.numberValue == 1)
        }
    }

    let scopeControls = controls(under: "rule scope:")
    let durationControls = controls(under: "rule duration:")
    let assigned = Set((scopeControls + durationControls).map { $0.index })
    let uncertainControlLayout = allControls.contains { control in
        !control.hasFrame || (groupLabelElements.contains { control.minY > $0.minY }
            && !assigned.contains(control.index))
    }
    parsed.scopeOptions = scopeControls.map(describe)
    parsed.durationOptions = durationControls.map(describe)
    parsed.scopeOptionsComplete = optionsAreComplete(scopeControls)
    parsed.durationOptionsComplete = optionsAreComplete(durationControls)

    /// A pop-up button reports its current choice as its own text; radio
    /// buttons report theirs through whichever one is selected.
    func selection(from controls: [Element]) -> String? {
        guard !uncertainControlLayout, controls.allSatisfy({ $0.text != nil }) else { return nil }
        if controls.count == 1, controls[0].role == "AXPopUpButton" { return controls[0].text }
        guard controls.allSatisfy({ $0.role == "AXRadioButton" && ($0.numberValue == 0 || $0.numberValue == 1) }) else { return nil }
        let selected = controls.filter { $0.numberValue == 1 }
        return selected.count == 1 ? selected[0].text : nil
    }

    parsed.ruleScope = selection(from: scopeControls)
    parsed.ruleDuration = selection(from: durationControls)

    // "Expires in:" carries its hours and minutes in adjacent text fields.
    if parsed.ruleDuration != nil, let expires = durationControls.first(where: {
        $0.numberValue == 1 && normalize($0.text ?? "").hasPrefix("expires in")
    }) {
        let fields = elements
            .filter { $0.role == "AXTextField" && $0.hasFrame && $0.minX >= expires.minX
                && verticalOverlap($0, expires) >= 0.5 }
            .sorted { $0.minX < $1.minX }
            .compactMap { $0.value }
        if fields.count == 2, let hours = Int(fields[0]), let minutes = Int(fields[1]),
           hours >= 0, (0...59).contains(minutes) {
            parsed.ruleDuration = "Expires in: " + fields.joined(separator: ":")
        } else {
            parsed.ruleDuration = nil
        }
    }

    if parsed.ruleScope == nil { parsed.unreadable.append("rule_scope") }
    if parsed.ruleDuration == nil { parsed.unreadable.append("rule_duration") }

    parsed.buttons = elements
        .filter { $0.role == "AXButton" }
        .compactMap { $0.text }

    return parsed
}

// MARK: - Output

func iso8601Now() -> String {
    let formatter = ISO8601DateFormatter()
    formatter.formatOptions = [.withInternetDateTime]
    formatter.timeZone = TimeZone(identifier: "UTC")
    return formatter.string(from: Date())
}

func report(dump: Dump, source: String) -> [String: Any] {
    let lulu: [String: Any] = [
        "bundle_id": kLuLuBundleID,
        "pid": dump.luluPID ?? NSNull(),
        "version": dump.luluVersion ?? NSNull(),
        "running": dump.luluRunning,
    ]

    var presence: Any = NSNull()
    if dump.windowFound { presence = true }
    else if dump.readIssues.isEmpty { presence = false }
    var result: [String: Any] = [
        "alert_present": presence,
        "source": source,
        "read_at": iso8601Now(),
        "captured_at": dump.capturedAt ?? NSNull(),
        "read_status": dump.readIssues.isEmpty ? "complete" : "incomplete",
        "read_issues": dump.readIssues,
        "snapshot_atomic": false,
        "lulu": lulu,
        "alert_windows_open": dump.alertWindowCount,
    ]
    guard dump.windowFound else { return result }

    let parsed = parse(dump: dump)
    let detail: [String: Any] = [
        "alert_present": true,
        "source": source,
        "read_at": iso8601Now(),
        "lulu": lulu,
        "alert_windows_open": dump.alertWindowCount,
        "window_title": dump.windowTitle ?? NSNull(),
        "window_matched_by": dump.matchedBy ?? NSNull(),
        "process": [
            "name": parsed.processName ?? NSNull(),
            "pid": parsed.processID ?? NSNull(),
            "path": parsed.processPath ?? NSNull(),
            "args": parsed.processArgs ?? NSNull(),
        ] as [String: Any],
        "connection": [
            "ip_address": parsed.ipAddress ?? NSNull(),
            "port_protocol": parsed.portProtocol ?? NSNull(),
            "reverse_dns": parsed.reverseDNS ?? NSNull(),
        ] as [String: Any],
        "rule": [
            "scope": parsed.ruleScope ?? NSNull(),
            "duration": parsed.ruleDuration ?? NSNull(),
            "scope_options": parsed.scopeOptions,
            "duration_options": parsed.durationOptions,
            "scope_options_complete": parsed.scopeOptionsComplete,
            "duration_options_complete": parsed.durationOptionsComplete,
        ] as [String: Any],
        "alert_timestamp": parsed.timestamp ?? NSNull(),
        "headline": parsed.headline ?? NSNull(),
        "buttons": parsed.buttons,
        "unreadable_fields": parsed.unreadable,
        "raw_label_pairs": parsed.labelPairs,
    ]
    result.merge(detail) { _, new in new }
    return result
}

func emit(_ object: [String: Any], code: ExitCode = .ok) -> Never {
    guard
        let data = try? JSONSerialization.data(
            withJSONObject: object,
            options: [.prettyPrinted, .sortedKeys]
        )
    else {
        fail(.readFailed, "could not serialize the result as JSON.")
    }
    FileHandle.standardOutput.write(data)
    FileHandle.standardOutput.write("\n".data(using: .utf8)!)
    exit(code.rawValue)
}

let usage = """
usage: inspect-lulu-alert [--dump] [--fixture FILE]

Reads the LuLu alert currently on screen and prints one JSON object to stdout.
This is a read-only tool: it never clicks Allow or Block, never changes the
rule scope or duration, and never creates a rule.

  --dump          print the raw Accessibility element dump instead of the
                  parsed report; save it to build a fixture
  --fixture FILE  parse a saved dump instead of reading the live window
  -h, --help      print this message

exit status: 0 read ok, 64 usage, 69 LuLu not running, 70 read failed,
77 Accessibility permission denied
"""

// MARK: - Main

var wantDump = false
var fixturePath: String?
var arguments = Array(CommandLine.arguments.dropFirst())

while !arguments.isEmpty {
    let argument = arguments.removeFirst()
    switch argument {
    case "--dump":
        wantDump = true
    case "--fixture":
        guard fixturePath == nil else { fail(.usage, "--fixture may be specified only once") }
        guard !arguments.isEmpty else { fail(.usage, "--fixture needs a file path") }
        fixturePath = arguments.removeFirst()
    case "-h", "--help":
        print(usage)
        exit(ExitCode.ok.rawValue)
    default:
        fail(.usage, "unknown argument: \(argument)\n\n" + usage)
    }
}

let dump = fixturePath.map { readFixtureDump(path: $0) } ?? readLiveDump()
emit(wantDump ? dump.asJSON : report(dump: dump, source: fixturePath == nil ? "live" : "fixture"),
     code: dump.readIssues.isEmpty ? .ok : .readFailed)
