#!/usr/bin/env python3
"""Resolve Claude/Codex skill files by skill name."""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
from dataclasses import dataclass
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[1]
HOME = Path.home()
BIN_DIR = Path(__file__).resolve().parent
CODEX_ADMIN_SKILLS = Path("/etc/codex/skills")
if str(BIN_DIR) not in sys.path:
    sys.path.insert(0, str(BIN_DIR))

from codex_plugin_roots import (  # noqa: E402
    codex_plugin_skill_roots,
    load_codex_plugin_list,
    stale_codex_prompt_plugin_roots,
)


@dataclass(frozen=True)
class SkillRoot:
    path: Path
    tool: str
    source: str
    priority: int
    plugin: str | None = None
    marketplace: str | None = None


@dataclass(frozen=True)
class SkillFile:
    name: str
    folder: str
    path: Path
    root: SkillRoot

    @property
    def match_names(self) -> set[str]:
        names = {self.name, self.folder}
        if self.root.plugin and self.root.marketplace:
            plugin = self.root.plugin
            for name in tuple(names):
                suffix = name.removeprefix(f"{plugin}:")
                names.add(f"{plugin}:{suffix}")
                names.add(f"{plugin}@{self.root.marketplace}:{suffix}")
        return names


def existing_dir(path: Path) -> bool:
    try:
        return path.is_dir()
    except OSError:
        return False


def ancestors(cwd: Path) -> list[Path]:
    resolved = cwd.resolve()
    return [resolved, *resolved.parents]


def codex_project_ancestors(cwd: Path) -> list[Path]:
    """Bound standard project roots by the nearest Git directory/worktree marker."""
    parents = ancestors(cwd)
    for depth, parent in enumerate(parents):
        if (parent / ".git").exists():
            return parents[:depth + 1]
    return parents[:1]


def add_root(
    roots: list[SkillRoot],
    seen: set[tuple[str, str]],
    path: Path,
    tool: str,
    source: str,
    priority: int,
    plugin: str | None = None,
    marketplace: str | None = None,
) -> None:
    if not existing_dir(path):
        return
    try:
        real = str(path.resolve())
    except OSError:
        real = str(path)
    key = (tool, real)
    if key in seen:
        return
    seen.add(key)
    roots.append(SkillRoot(
        path=path, tool=tool, source=source, priority=priority,
        plugin=plugin, marketplace=marketplace,
    ))


def plugin_path_is_orphaned(path: Path) -> bool:
    for parent in (path, *path.parents):
        if (parent / ".orphaned_at").exists():
            return True
        if parent.name == "cache":
            return False
    return False


def enabled_claude_plugins(claude_home: Path) -> list[str]:
    settings = claude_home / "settings.json"
    try:
        data = json.loads(settings.read_text())
    except FileNotFoundError:
        return []
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError("Claude plugin settings could not be read; discovery is incomplete") from error
    if not isinstance(data, dict):
        raise RuntimeError("Claude plugin settings are malformed; discovery is incomplete")
    enabled = data.get("enabledPlugins", {})
    if not isinstance(enabled, dict) or any(
        not isinstance(plugin_id, str) or not isinstance(active, bool)
        for plugin_id, active in enabled.items()
    ):
        raise RuntimeError("Claude enabledPlugins is malformed; discovery is incomplete")
    return sorted(plugin_id for plugin_id, active in enabled.items() if active)


def add_claude_plugin_roots(
    roots: list[SkillRoot],
    seen: set[tuple[str, str]],
    claude_home: Path,
    cwd: Path,
) -> None:
    enabled = enabled_claude_plugins(claude_home)
    if not enabled:
        return
    try:
        registry = json.loads((claude_home / "plugins" / "installed_plugins.json").read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError("Claude installed plugin registry could not be read; discovery is incomplete") from error
    if (
        not isinstance(registry, dict)
        or registry.get("version") != 2
        or not isinstance(registry.get("plugins"), dict)
    ):
        raise RuntimeError("Claude installed plugin registry has an unsupported schema; discovery is incomplete")
    for plugin_id in enabled:
        if "@" not in plugin_id:
            raise RuntimeError("Claude enabled plugin identifier is malformed; discovery is incomplete")
        plugin, marketplace = plugin_id.rsplit("@", 1)
        entries = registry["plugins"].get(plugin_id)
        if not isinstance(entries, list) or not entries:
            raise RuntimeError("An enabled Claude plugin has no installed registry entry; discovery is incomplete")
        for entry in entries:
            if not isinstance(entry, dict) or entry.get("scope") not in {"user", "project", "local"}:
                raise RuntimeError("Claude installed plugin scope is unsupported; discovery is incomplete")
            if entry["scope"] in {"project", "local"}:
                project = entry.get("projectPath")
                if not isinstance(project, str) or not Path(project).is_absolute():
                    raise RuntimeError("Claude plugin project path is malformed; discovery is incomplete")
                if not cwd.resolve().is_relative_to(Path(project).resolve()):
                    continue
            install = entry.get("installPath")
            if not isinstance(install, str) or not Path(install).is_absolute():
                raise RuntimeError("Claude plugin install path is malformed; discovery is incomplete")
            install_path = Path(install)
            if not existing_dir(install_path):
                raise RuntimeError("A registered Claude plugin installation is missing; discovery is incomplete")
            if plugin_path_is_orphaned(install_path):
                continue
            add_root(
                roots,
                seen,
                install_path / "skills",
                "claude",
                f"claude-plugin-cache:{plugin_id}",
                200,
                plugin,
                marketplace,
            )


def discover_roots(cwd: Path, tool: str) -> list[SkillRoot]:
    roots: list[SkillRoot] = []
    seen: set[tuple[str, str]] = set()
    wanted = {"codex", "claude"} if tool == "any" else {tool}

    if "codex" in wanted:
        for depth, parent in enumerate(codex_project_ancestors(cwd)):
            if parent != HOME:
                add_root(
                    roots, seen, parent / ".agents" / "skills", "codex",
                    f"project-local:{parent}", 10 + depth,
                )

    for depth, parent in enumerate(ancestors(cwd)):
        if parent == HOME:
            continue
        if "codex" in wanted:
            add_root(
                roots,
                seen,
                parent / ".codex" / "skills",
                "codex",
                f"project-local:{parent}",
                10 + depth,
            )
        if "claude" in wanted:
            add_root(
                roots,
                seen,
                parent / ".claude" / "skills",
                "claude",
                f"project-local:{parent}",
                10 + depth,
            )

    epoch_root = HOME / "My Drive" / "Epoch"
    if "codex" in wanted:
        add_root(
            roots,
            seen,
            epoch_root / ".codex" / "skills",
            "codex",
            "epoch-workspace",
            40,
        )
    if "claude" in wanted:
        add_root(
            roots,
            seen,
            epoch_root / ".claude" / "skills",
            "claude",
            "epoch-workspace",
            40,
        )

    if "codex" in wanted:
        codex_home = Path(os.environ.get("CODEX_HOME", HOME / ".codex"))
        add_root(roots, seen, HOME / ".agents" / "skills", "codex", "user-agents", 100)
        add_root(roots, seen, codex_home / "skills", "codex", "CODEX_HOME", 100)
        add_root(roots, seen, REPO_ROOT / "codex" / "skills", "codex", "dotfiles", 110)
        add_root(roots, seen, CODEX_ADMIN_SKILLS, "codex", "admin", 300)

        for skills_dir in codex_plugin_skill_roots(
            codex_home,
            load_codex_plugin_list(codex_home),
        ):
            marketplace, plugin = skills_dir.relative_to(codex_home / "plugins" / "cache").parts[:2]
            add_root(
                roots, seen, skills_dir, "codex", "codex-plugin-cache", 200,
                plugin, marketplace,
            )

    if "claude" in wanted:
        # CLAUDE_HOME is a legacy resolver compatibility option, used only when
        # Claude's native CLAUDE_CONFIG_DIR variable is unset.
        claude_home = Path(os.environ.get(
            "CLAUDE_CONFIG_DIR", os.environ.get("CLAUDE_HOME", HOME / ".claude")
        ))
        source = "CLAUDE_CONFIG_DIR" if "CLAUDE_CONFIG_DIR" in os.environ else "CLAUDE_HOME"
        add_root(roots, seen, claude_home / "skills", "claude", source, 100)
        add_root(roots, seen, REPO_ROOT / "claude" / "skills", "claude", "dotfiles", 110)
        add_claude_plugin_roots(roots, seen, claude_home, cwd)

    expanded: list[SkillRoot] = []
    expanded_seen: set[tuple[str, str]] = set()
    for root in sorted(roots, key=lambda root: (root.priority, str(root.path))):
        add_root(
            expanded, expanded_seen, root.path, root.tool, root.source, root.priority,
            root.plugin, root.marketplace,
        )
        add_root(
            expanded,
            expanded_seen,
            root.path / ".system",
            root.tool,
            f"{root.source}:system",
            root.priority + 1,
            root.plugin,
            root.marketplace,
        )

    return sorted(expanded, key=lambda root: (root.priority, str(root.path)))


def parse_skill_name(path: Path) -> str:
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return path.parent.name
    if not text.startswith("---"):
        return path.parent.name
    frontmatter = text.split("---", 2)
    if len(frontmatter) < 3:
        return path.parent.name
    for line in frontmatter[1].splitlines():
        match = re.match(r"\s*name:\s*(.+?)\s*$", line)
        if match:
            return match.group(1).strip().strip("\"'")
    return path.parent.name


def discover_skills(roots: list[SkillRoot]) -> list[SkillFile]:
    skills: list[SkillFile] = []
    seen_paths: set[str] = set()
    for root in roots:
        for path in sorted(root.path.glob("*/SKILL.md")):
            try:
                real = str(path.resolve())
            except OSError:
                real = str(path)
            if real in seen_paths:
                continue
            seen_paths.add(real)
            skills.append(
                SkillFile(
                    name=parse_skill_name(path),
                    folder=path.parent.name,
                    path=path,
                    root=root,
                )
            )
    return sorted(skills, key=lambda skill: (skill.root.priority, skill.name, str(skill.path)))


def resolve_skill(skills: list[SkillFile], name: str) -> SkillFile:
    matches = [skill for skill in skills if name in skill.match_names]
    if not matches:
        raise SystemExit(f"No skill named {name!r} found.")

    matches = sorted(matches, key=lambda skill: (skill.root.priority, str(skill.path)))
    best_priority = matches[0].root.priority
    best = [skill for skill in matches if skill.root.priority == best_priority]
    if len(best) > 1:
        lines = [f"Ambiguous skill name {name!r}; matching skills at the same priority:"]
        lines.extend(f"- {skill.path} [{skill.root.source}]" for skill in best)
        raise SystemExit("\n".join(lines))
    return best[0]


def add_common_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--tool", choices=("codex", "claude", "any"), default="codex")
    parser.add_argument("--cwd", default=os.getcwd(), help="working directory for project-local lookup")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    for command in ("path", "cat"):
        subparser = subparsers.add_parser(command)
        subparser.add_argument("name")
        add_common_args(subparser)

    list_parser = subparsers.add_parser("list")
    add_common_args(list_parser)

    duplicates_parser = subparsers.add_parser("duplicates")
    add_common_args(duplicates_parser)

    roots_parser = subparsers.add_parser("roots")
    add_common_args(roots_parser)

    return parser


def main() -> int:
    args = build_parser().parse_args()
    try:
        roots = discover_roots(Path(args.cwd), args.tool)
    except (OSError, RuntimeError) as error:
        print(f"Skill discovery failed: {error}", file=sys.stderr)
        return 2

    if args.command == "roots":
        for root in roots:
            print(f"{root.tool}\t{root.priority}\t{root.source}\t{root.path}")
        return 0

    skills = discover_skills(roots)
    if args.command == "list":
        for skill in skills:
            print(f"{skill.name}\t{skill.root.tool}\t{skill.path}")
        return 0

    if args.command == "duplicates":
        by_name: dict[tuple[str, str], list[SkillFile]] = {}
        for skill in skills:
            by_name.setdefault((skill.root.tool, skill.name), []).append(skill)
        found = False
        for (tool, name), matches in sorted(by_name.items()):
            if len(matches) <= 1:
                continue
            found = True
            print(f"{tool}\t{name}")
            for skill in matches:
                print(f"\t{skill.path}\t{skill.root.source}")
        return 1 if found else 0

    skill = resolve_skill(skills, args.name)
    if args.command == "path":
        print(skill.path)
        return 0
    if args.command == "cat":
        sys.stdout.write(skill.path.read_text(encoding="utf-8", errors="replace"))
        return 0

    raise AssertionError(args.command)


if __name__ == "__main__":
    raise SystemExit(main())
