#!/usr/bin/env bash
# Run agent-send from the active Emacs package checkout.  The tool sends a
# message from one agent session to another live agent.el session; it ships
# with the agent package, and `agent-send --help' gives its contract.
set -euo pipefail
script_dir=$(cd -- "$(dirname -- "$0")" && pwd)
errors=$(mktemp)
trap 'rm -f "$errors"' EXIT
# Locating the checkout queries Emacs, and a briefly stalled Emacs refuses
# connections outright; retry those refusals as agent-status does.
for delay in 0.5 1 2 4 ""; do
  if helper=$("$script_dir/elpaca-package-path" agent bin/agent-send 2>"$errors"); then
    rm -f "$errors"
    exec "$helper" "$@"
  fi
  if [ -z "$delay" ] || ! grep -qE "can't connect|error accessing socket" "$errors"; then
    cat "$errors" >&2
    exit 1
  fi
  sleep "$delay"
done
