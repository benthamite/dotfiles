#!/opt/homebrew/opt/gcalcli/libexec/bin/python
"""Run gcalcli with the canonical Epoch Google Workspace OAuth grant."""

import os
import pickle
import sys
import tempfile
from pathlib import Path

from google.auth.transport.requests import Request
from google.oauth2.credentials import Credentials
from googleapiclient.discovery import build
from gcalcli import env

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "claude" / "bin"))
import _gworkspace_auth as auth

GCALCLI = "/opt/homebrew/bin/gcalcli"


def refresh_credentials():
    """Validate the canonical grant before replacing gcalcli's OAuth cache."""
    client_id, client_secret, refresh_token = auth._read_env("epoch")
    credentials = Credentials(
        None, refresh_token=refresh_token, token_uri=auth.TOKEN_URL,
        client_id=client_id, client_secret=client_secret,
        scopes=["https://www.googleapis.com/auth/calendar"],
    )
    credentials.refresh(Request())
    primary = build("calendar", "v3", credentials=credentials).calendars().get(
        calendarId="primary"
    ).execute()
    if primary["id"] != "pablo@epoch.ai":
        raise ValueError("canonical grant belongs to the wrong Calendar account")
    target = env.data_file_paths("oauth")[0]
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, scratch = tempfile.mkstemp(prefix=".oauth-", dir=target.parent)
    try:
        with os.fdopen(fd, "wb") as output:
            pickle.dump(credentials, output)
        os.replace(scratch, target)
    finally:
        Path(scratch).unlink(missing_ok=True)


def main():
    arguments = sys.argv[1:]
    if not arguments or "--help" in arguments or "-h" in arguments or "--version" in arguments:
        os.execv(GCALCLI, [GCALCLI, *arguments])
    if "init" in arguments:
        sys.exit("Use update-gworkspace-refresh-token --account epoch to renew the canonical grant.")
    try:
        refresh_credentials()
    except Exception:
        # Auth/transport errors can carry credentials. Report no provider payload.
        sys.exit("Unable to validate the canonical Epoch Calendar grant; existing cache unchanged.")
    os.execv(GCALCLI, [GCALCLI, *arguments])


if __name__ == "__main__":
    main()
