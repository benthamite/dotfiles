#!/usr/bin/env bash
# Run 1Password CLI commands with the read-only Epoch Automations service account.

set -euo pipefail

PASS_ENTRY="epoch/1password-service-account-token"

if [[ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]]; then
  if ! command -v pass >/dev/null 2>&1; then
    printf 'op-automations: pass is required to load %s\n' "$PASS_ENTRY" >&2
    exit 1
  fi

  OP_SERVICE_ACCOUNT_TOKEN=$(pass show "$PASS_ENTRY" | sed -n '1p')
  if [[ -z "$OP_SERVICE_ACCOUNT_TOKEN" ]]; then
    printf 'op-automations: %s is empty\n' "$PASS_ENTRY" >&2
    exit 1
  fi
  export OP_SERVICE_ACCOUNT_TOKEN
fi

# shell/shims/op routes bare `op` back here for Automations-vault work, so this
# exec must reach the real binary rather than re-entering the shim.
export OP_SHIM_BYPASS=1

# Workaround for a macOS 26 + 1Password CLI interaction (verified 2026-09-07):
# on every account-bearing command `op` probes the desktop app's group
# container (~/Library/Group Containers/2BUA8C4S2C.com.1password) to detect the
# app integration, which the service-account path never uses. macOS 26 treats
# that container as protected "app data" and, for a process whose responsible
# binary holds no persistent grant (every launchd job rooted in an ad-hoc signed
# Homebrew interpreter), raises a consent dialog that blocks `op` until someone
# at the screen answers it -- for hours when the Mac is locked. Denying the read
# up front makes `op` treat the app as absent without any prompt; it still
# authenticates with the service account and resolves secrets normally.
# Children of `op run` inherit the same narrow denial, which they never need.
if [[ -x /usr/bin/sandbox-exec ]]; then
  sandbox_helper="$(dirname "$(realpath "${BASH_SOURCE[0]}")")/op_automations_sandbox.py"
  if python3 "$sandbox_helper" --check; then
    # The outer sandbox already enforces the same protection. macOS rejects
    # sandbox reinitialization; no environment flag can bypass this check.
    exec op "$@"
  else
    check_status=$?
    [[ "$check_status" == 1 ]] || exit "$check_status"
  fi
  profile="(version 1)(allow default)$(python3 "$sandbox_helper" --profile)"
  exec /usr/bin/sandbox-exec -p "$profile" op "$@"
fi

exec op "$@"
