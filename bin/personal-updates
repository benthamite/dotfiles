def now_utc():
    return datetime.now(timezone.utc)


def merge_scan(state, updates, now):
    merged = {}
    timestamp = now.isoformat()
    for kind in KINDS:
        previous = state.get(kind, {})
        current = {}
        for update in updates.get(kind, []):
            name = update["name"]
            old_entry = previous.get(name)
            if old_entry and old_entry.get("available") == update["available"]:
                first_seen = old_entry["first_seen"]
            else:
                first_seen = timestamp
            current[name] = {
                "installed": update.get("installed", ""),
                "available": update["available"],
                "first_seen": first_seen,
                **{key: update[key] for key in ("installed_receipt", "version_check_error") if key in update},
            }
        if current or kind in state:
            merged[kind] = current
    return merged


def parse_holds(text):
    holds = set()
    for line in text.splitlines():
        stripped = line.strip()
        if stripped and not stripped.startswith("#"):
            holds.add(stripped)
    return holds


def load_holds(path):
    if not path.exists():
        return set()
    return parse_holds(path.read_text())


def load_excluded_casks(path):
    if not path.exists():
        return set()
    return parse_holds(path.read_text())


def load_fast_brew_packages(path):
    packages = list(DEFAULT_FAST_BREW_PACKAGES)
    if path.exists():
        packages.extend(sorted(parse_holds(path.read_text())))
    return sorted(dict.fromkeys(packages))


def is_held(kind, name, holds):
    return name in holds or f"{kind}/{name}" in holds


def eligible_updates(state, min_age_days, now, holds=None, excluded_casks=None):
    holds = holds or set()
    excluded_casks = excluded_casks or set()
    cutoff = now - timedelta(days=min_age_days)
    eligible = {}
    for kind in KINDS:
        names = []
        for name, entry in state.get(kind, {}).items():
            if is_held(kind, name, holds):
                continue
            if kind == "brew_cask" and name in excluded_casks:
                continue
            first_seen = datetime.fromisoformat(entry["first_seen"])
            if first_seen <= cutoff:
                names.append(name)
        if names:
            eligible[kind] = sorted(names)
    return eligible


def load_json(path, default):
    if not path.exists():
        return default
    with path.open() as handle:
        return json.load(handle)


def save_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = path.with_suffix(path.suffix + ".tmp")
    with tmp_path.open("w") as handle:
        json.dump(data, handle, indent=2, sort_keys=True)
        handle.write("\n")
    tmp_path.replace(path)


def run(command, *, check=True, env_overrides=None):
    env = os.environ.copy()
    env["HOMEBREW_NO_INSTALL_CLEANUP"] = "1"
    env.update(env_overrides or {})
    return subprocess.run(command, check=check, text=True, capture_output=True, env=env)


def brew_update(run_command=run):
    run_command(["brew", "update-reset", "-q"], check=False)
    run_command(["brew", "update"])


def brew_outdated(*, refresh=True):
    if refresh:
        brew_update()
    result = run(["brew", "outdated", "--json=v2", "--greedy-auto-updates"], check=False,
                 env_overrides={"HOMEBREW_NO_AUTO_UPDATE": "1"})
    if result.returncode not in (0, 1):
        raise RuntimeError(result.stderr.strip() or result.stdout.strip())
    data = json.loads(result.stdout or "{}")
    # Read installed bundles independently of receipts: an application can
    # update itself, and even a current receipt can describe an older bundle.
    info = run(["brew", "info", "--json=v2", "--cask", "--installed"],
               env_overrides={"HOMEBREW_NO_AUTO_UPDATE": "1"})
    casks = cask_updates(data.get("casks", []), json.loads(info.stdout)["casks"])
    return {
        "brew_formula": [
            {
                "name": item["name"],
                "installed": ", ".join(item.get("installed_versions", [])),
                "available": item["current_version"],
            }
            for item in data.get("formulae", [])
        ],
        "brew_cask": casks,
    }


def numeric_version(value):
    """Comparable numeric release components, ignoring trailing zeroes."""
    if not value or not re.fullmatch(r"\d+(?:[.-]\d+)*", value):
        return None
    parts = tuple(int(part) for part in re.split(r"[.-]", value))
    while len(parts) > 1 and parts[-1] == 0:
        parts = parts[:-1]
    return parts


def installed_version_from_source(source):
    """Return (short, build) versions from a bundle or a plain VERSION file."""
    if source.suffix:
        try:
            with open(source / "Contents/Info.plist", "rb") as handle:
                info = plistlib.load(handle)
        except (OSError, plistlib.InvalidFileException):
            return None, None
        return info.get("CFBundleShortVersionString"), info.get("CFBundleVersion")
    try:
        return source.read_text().strip() or None, None
    except OSError:
        return None, None


def with_installed_version(item):
    """Fill in bundle versions Homebrew cannot report for non-app casks."""
    source = INSTALLED_VERSION_SOURCES.get(item["token"])
    if item.get("bundle_short_version") or source is None:
        return item
    short, build = installed_version_from_source(source)
    return {**item, "bundle_short_version": short, "bundle_version": build}


def cask_bundle_comparison(item):
    """Return installed-versus-available ordering or an explicit check error."""
    available, *builds = item["version"].split(",")
    short, build = item.get("bundle_short_version"), item.get("bundle_version")
    if not short:
        return None, "installed application bundle version is unavailable"
    installed = short
    # Brave's macOS legacy bundle prefixes its release with Chromium's major
    # version (147.1.89.132); the cask release is 1.89.132 or 1.89.132.0.
    if item["token"] in ("brave-browser", "brave-browser@beta", "brave-browser@nightly"):
        parts = short.split(".")
        release = available.split(".")
        if len(parts) == 4 and parts[0].isdigit() and int(parts[0]) >= 100 and parts[1] == release[0]:
            installed = ".".join(parts[1:])
    if "-" in available and numeric_version(available) is not None and build:
        installed = f"{installed}-{build}"
    # A full release can live in CFBundleVersion while the short field is
    # abbreviated (Plex), and equal opaque versions need no ordering rule.
    if installed == available or build == available:
        comparison = 0
    else:
        actual, target = numeric_version(installed), numeric_version(available)
        if actual is None or target is None:
            return None, "installed and available version formats cannot be compared"
        full_build = numeric_version(build)
        if len(actual) < len(target) and full_build is not None and len(full_build) == len(target):
            actual = full_build
        comparison = (actual > target) - (actual < target)
    if comparison == 0 and builds and numeric_version(builds[0]) is not None:
        actual_build = numeric_version(build)
        if actual_build is None:
            return None, "installed application build version is unavailable or incomparable"
        target_build = numeric_version(builds[0])
        # A numeric CSV suffix is not necessarily CFBundleVersion (Keyboard
        # Maestro uses 1111 for release 11.1.1). Compare only matching shapes.
        if len(actual_build) == len(target_build):
            comparison = (actual_build > target_build) - (actual_build < target_build)
    return comparison, None


def cask_updates(outdated, installed):
    """Keep actual stale bundles; explicitly defer unverifiable self-updaters."""
    candidates = {item["name"]: item for item in outdated}
    updates = []
    for item in installed:
        name = item["token"]
        if not item.get("installed") or (not item.get("auto_updates") and name not in candidates):
            continue
        entry = {"name": name, "installed": item["installed"], "available": item["version"]}
        if item.get("auto_updates"):
            item = with_installed_version(item)
            comparison, error = cask_bundle_comparison(item)
            if error:
                entry["version_check_error"] = error
            elif comparison >= 0:
                continue
            elif item["installed"] == item["version"]:
                entry["version_check_error"] = (
                    "installed bundle is older than its current Homebrew receipt; a verified reinstall is required")
            entry["installed_receipt"] = item["installed"]
            entry["installed"] = item.get("bundle_short_version") or "unknown"
        updates.append(entry)
    return updates


def brew_helper(mode, request, upgrade_args=()):
    # Never put generated request files under the Drive-backed repository.
    with tempfile.TemporaryDirectory(prefix="personal-updates-", dir="/private/tmp") as directory:
        request_path = Path(directory) / "request.json"
        with open(request_path, "x", opener=lambda path, flags: os.open(path, flags, 0o600)) as handle:
            json.dump(request, handle)
        result = run(["brew", "ruby", "--", str(BREW_HELPER), mode, str(request_path), *upgrade_args], check=False,
                   env_overrides={"HOMEBREW_NO_AUTO_UPDATE": "1", "HOMEBREW_NO_ASK": "1",
                                  "HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK": "1",
                                  "HOMEBREW_NO_ANALYTICS": "1", "HOMEBREW_DEV_CMD_RUN": "1"})
        if result.returncode:
            reasons = [line for line in result.stderr.splitlines() if "Delayed update refused:" in line]
            if not reasons:
                # Keep Homebrew's own account of the failure: without it the cause cannot be diagnosed.
                print(f"Homebrew {mode} output before the failure:\n{(result.stderr.strip() or result.stdout.strip())}",
                      file=sys.stderr)
            raise RuntimeError("; ".join(reasons) or f"Homebrew {mode} failed (exit {result.returncode}); no unguarded retry was attempted")
        return result


def observe_artifacts(updates):
    return json.loads(brew_helper("observe", updates).stdout)


def merge_observations(previous, observed, now):
    result = {}
    for kind in KINDS:
        result[kind] = {}
        for name, entry in observed.get(kind, {}).items():
            old = previous.get(kind, {}).get(name, {})
            unchanged = old.get("artifact") and old.get("artifact") == entry.get("artifact")
            result[kind][name] = {**entry, "first_seen": old["first_seen"] if unchanged else now.isoformat()}
    return result


def age_qualified_artifacts(observations, min_age_days, now, holds, excluded_casks):
    cutoff = now - timedelta(days=min_age_days)
    allowed = {kind: {} for kind in KINDS}
    for kind in KINDS:
        for alias, entry in observations.get(kind, {}).items():
            name = entry["name"]
            short_name = name.rsplit("/", 1)[-1]
            if any(is_held(kind, n, holds) for n in (alias, name, short_name)):
                continue
            if kind == "brew_cask" and {alias, name, short_name} & excluded_casks:
                continue
            if entry.get("artifact") and datetime.fromisoformat(entry["first_seen"]) <= cutoff:
                allowed[kind][name] = entry
    return allowed


def dependency_blockers(kind, name, observations, allowed):
    """Transitive dependencies Homebrew would install with the item that are not age-qualified.

    Observations record, per item, the dependencies that would be installed or
    upgraded alongside it. A dependency without an observation counts as
    unchecked. The in-Homebrew guard still verifies the actual installer objects.
    """
    blockers = []
    seen = set()
    stack = [(kind, name)]
    while stack:
        current_kind, current_name = stack.pop()
        for reference in observations.get(current_kind, {}).get(current_name, {}).get("pending_deps", []):
            dep_kind, dep_name = reference.split("/", 1)
            if (dep_kind, dep_name) in seen:
                continue
            seen.add((dep_kind, dep_name))
            if dep_name not in allowed.get(dep_kind, {}):
                blockers.append(reference)
            stack.append((dep_kind, dep_name))
    return sorted(blockers)


def dependent_holds(eligible, pending, observations):
    """Drop eligible items whose upgrade would strand a pending dependent.

    The upgrade runs with HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK, so Homebrew
    does not upgrade the dependents of what it upgrades. When a dependent's
    own new version is still waiting, upgrading the dependency alone can
    remove a library the installed dependent links to (2026-11-09: simdjson
    went ahead while node waited, and node failed to start). So an item goes
    ahead only if every pending item that would upgrade anything it upgrades
    goes ahead too. Returns (eligible, deferral reasons)."""
    accepted = {(kind, name) for kind, names in eligible.items() for name in names}
    waiting_items = {(kind, name) for kind in KINDS for name in pending.get(kind, {})}
    deferred = []
    changed = True
    while changed:
        changed = False
        for kind, name in sorted(accepted):
            entry = observations.get(kind, {}).get(name, {})
            upgraded = {f"{kind}/{entry.get('name', name)}", *upgrade_closure(kind, name, observations)}
            stranded = sorted(
                f"{dep_kind}/{dep_name}" for dep_kind, dep_name in waiting_items - accepted
                if upgraded & set(observations.get(dep_kind, {}).get(dep_name, {}).get("pending_deps", [])))
            if stranded:
                accepted.discard((kind, name))
                changed = True
                deferred.append(f"{kind}/{name}: installed dependents {', '.join(stranded)} "
                                "are waiting and would be left linked to the old version")
    return ({kind: [name for name in names if (kind, name) in accepted]
             for kind, names in eligible.items()}, deferred)


def upgrade_closure(kind, name, observations):
    """References of the pending dependencies upgraded along with an item."""
    closure = set()
    stack = [(kind, name)]
    while stack:
        current_kind, current_name = stack.pop()
        for reference in observations.get(current_kind, {}).get(current_name, {}).get("pending_deps", []):
            if reference not in closure:
                closure.add(reference)
                stack.append(tuple(reference.split("/", 1)))
    return closure


def broken_linkage(run_command=None):
    """Installed formulae whose linked libraries are missing, per `brew linkage --test'."""
    result = (run_command or run)(["brew", "linkage", "--test"], check=False,
                                  env_overrides={"HOMEBREW_NO_AUTO_UPDATE": "1"})
    broken, current = [], None
    for line in (result.stdout + "\n" + result.stderr).splitlines():
        match = re.match(r"==> Checking (\S+) linkage", line)
        if match:
            current = match.group(1)
        elif line.strip() == "Broken dependencies:" and current and current not in broken:
            broken.append(current)
    if result.returncode and not broken:
        raise RuntimeError(f"brew linkage --test failed (exit {result.returncode}): "
                           f"{(result.stderr or result.stdout).strip()[-300:]}")
    return broken


def linkage_alert_text(formulae):
    return ("Homebrew formulae with broken library links (a dependency's upgrade removed a library "
            "they use): " + ", ".join(formulae) + ". Upgrade or reinstall each, then check with: "
            "brew linkage --test")


def upgrade_brew(eligible, allowed):
    for command in brew_upgrade_commands_for_eligible(eligible):
        brew_helper("upgrade", allowed, command[2:])
    run(["brew", "doctor"], check=False)


def brew_upgrade_commands_for_eligible(eligible):
    commands = []
    for name in eligible.get("brew_formula", []):
        commands.append(["brew", "upgrade", "--formula", name])
    for name in eligible.get("brew_cask", []):
        commands.append(["brew", "upgrade", "--cask", "--greedy", "--require-sha", name])
    return commands


def brew_upgrade_commands(packages):
    return [["brew", "upgrade", package] for package in packages]


def upgrade_fast_brew(packages):
    for command in brew_upgrade_commands(packages):
        run(command)


def append_log(log_dir, message):
    log_dir.mkdir(parents=True, exist_ok=True)
    log_path = log_dir / f"{now_utc().date().isoformat()}.log"
    with log_path.open("a") as handle:
        handle.write(message.rstrip() + "\n")


def send_alert(text):
    result = subprocess.run([str(HEARTBEAT), "alert", HEARTBEAT_NAME], input=text,
                            text=True, capture_output=True)
    if result.returncode != 0:
        raise RuntimeError(f"alert not delivered: {result.stderr.strip()}")


def send_heartbeat():
    run([str(HEARTBEAT), "send", HEARTBEAT_NAME])


def lulu_uncovered_packages():
    """Return the Homebrew packages whose next upgrade would strand a LuLu rule.

    LuLu keys rules for ad-hoc signed Homebrew binaries on their versioned
    path, so upgrading such a package raises a LuLu alert on every connection
    until a directory rule covers it (claude/context/lulu-firewall.md).
    """
    result = subprocess.run([str(LULU_RULES), "check"], text=True, capture_output=True)
    if result.returncode == 0:
        return set()
    if result.returncode == 1 and result.stdout.strip():
        # The check also covers non-Homebrew installs (Claude Code), which
        # Homebrew upgrades cannot strand.
        return {Path(line).name for line in result.stdout.splitlines()
                if line.startswith("/opt/homebrew/")}
    raise RuntimeError(f"lulu-directory-rules check failed: {result.stderr.strip()}")


def lulu_alert_text(packages):
    return ("LuLu has version-specific allow rules but no directory rule for "
            + ", ".join(sorted(packages))
            + ", so upgrading them would raise a LuLu alert on every connection. "
            "Their upgrades are held back until you run: lulu-directory-rules add")


class WhatsmeowStepError(RuntimeError):
    """A failed command of the whatsmeow lane, carrying the command's own output."""


def go_environment(**overrides):
    # Never switch to a Go toolchain the Homebrew lane has not aged: with
    # GOTOOLCHAIN=local, a module needing a newer Go fails instead of downloading one.
    return {"GOTOOLCHAIN": "local", **overrides}


def run_step(step, command, cwd, *, timeout=GO_TIMEOUT_SECONDS, env_overrides=None):
    """Run COMMAND in CWD and return its stdout bytes; raise WhatsmeowStepError on failure."""
    try:
        result = subprocess.run(command, cwd=cwd, input=b"", capture_output=True, timeout=timeout,
                                env={**os.environ, **(env_overrides or {})})
    except subprocess.TimeoutExpired:
        raise WhatsmeowStepError(f"{step} timed out after {timeout} s") from None
    if result.returncode:
        output = (result.stderr + result.stdout).decode(errors="replace").strip()
        raise WhatsmeowStepError(f"{step} failed (exit {result.returncode}): {output[-1500:]}")
    return result.stdout


def decode_json_stream(text):
    """Parse the concatenated JSON objects that `go list -json' prints."""
    decoder, items, index = json.JSONDecoder(), [], 0
    text = text.strip()
    while index < len(text):
        item, index = decoder.raw_decode(text, index)
        items.append(item)
        while index < len(text) and text[index].isspace():
            index += 1
    return items


def go_module_info(queries):
    """`go list -m -json' for QUERIES (MODULE@VERSION), in a throwaway module outside Drive."""
    with tempfile.TemporaryDirectory(prefix="personal-updates-go-", dir="/private/tmp") as directory:
        env = go_environment(GOFLAGS="-mod=mod")
        run_step("go mod init", ["go", "mod", "init", "personal-updates-probe"], directory, env_overrides=env)
        output = run_step("go list", ["go", "list", "-m", "-e", "-json", *queries], directory, env_overrides=env)
    infos = decode_json_stream(output.decode())
    if len(infos) != len(queries):
        raise RuntimeError(f"go list returned {len(infos)} results for {len(queries)} queries")
    return infos


def parse_go_time(value):
    return datetime.fromisoformat(value.replace("Z", "+00:00"))


def module_time(info):
    """Publication time of a `go list -m -json' result, or None when unknown."""
    if info.get("Error") or not info.get("Time"):
        return None
    return parse_go_time(info["Time"])


def required_module_time(info):
    published = module_time(info)
    if published is None:
        reason = (info.get("Error") or {}).get("Err", "no publication time")
        raise RuntimeError(f"go list {info.get('Path')}@{info.get('Version')}: {reason}")
    return published


def read_go_mod(directory):
    output = run_step("go mod edit -json", ["go", "mod", "edit", "-json"], directory,
                      env_overrides=go_environment())
    return json.loads(output)


def required_version(go_mod, path):
    for item in go_mod.get("Require") or []:
        if item["Path"] == path:
            return item["Version"]
    raise RuntimeError(f"go.mod does not require {path}")


def go_sum_entries(text):
    """go.sum's (module, version) entries; a `/go.mod' suffix marks a go.mod-only hash."""
    return {tuple(line.split()[:2]) for line in text.splitlines() if len(line.split()) == 3}


def changed_module_versions(before_mod, after_mod, before_sum, after_sum):
    """MODULE@VERSION pairs an update adds to go.mod's requirements or to go.sum.

    A version whose code enters go.sum when only its go.mod was there before
    counts as changed: its code is new to the build."""
    def required(go_mod):
        return {(item["Path"], item["Version"]) for item in go_mod.get("Require") or []}
    added = (required(after_mod) - required(before_mod)) | (go_sum_entries(after_sum) - go_sum_entries(before_sum))
    return sorted({(path, version.removesuffix("/go.mod")) for path, version in added})


def toolchain_changes(before_mod, after_mod, goos, goarch):
    """(label, query) pairs for changed go and toolchain lines, aged by Go's toolchain module."""
    changes = []
    if after_mod.get("Go") and after_mod.get("Go") != before_mod.get("Go"):
        changes.append((f"go line {after_mod['Go']}",
                        f"golang.org/toolchain@v0.0.1-go{after_mod['Go']}.{goos}-{goarch}"))
    before_toolchain = (before_mod.get("Toolchain") or {}).get("Name")
    after_toolchain = (after_mod.get("Toolchain") or {}).get("Name")
    if after_toolchain and after_toolchain != before_toolchain:
        changes.append((f"toolchain line {after_toolchain}",
                        f"golang.org/toolchain@v0.0.1-{after_toolchain}.{goos}-{goarch}"))
    return changes


def age_blockers(changes, infos, cutoff):
    """Labels of CHANGES whose publication time is unknown or after CUTOFF."""
    blockers = []
    for (label, _query), info in zip(changes, infos):
        published = module_time(info)
        if published is None:
            reason = (info.get("Error") or {}).get("Err", "no publication time")
            blockers.append(f"{label} (unchecked: {reason})")
        elif published > cutoff:
            blockers.append(f"{label} (published {published.isoformat()})")
    return blockers


def merge_whatsmeow_candidates(candidates, head, current_time, now):
    """Keep recorded commits newer than go.mod's and add HEAD, keeping its first sighting."""
    merged = {version: entry for version, entry in candidates.items()
              if datetime.fromisoformat(entry["commit_time"]) > current_time}
    head_time = required_module_time(head)
    if head_time > current_time and head["Version"] not in merged:
        merged[head["Version"]] = {"commit_time": head_time.isoformat(), "first_seen": now.isoformat()}
    return merged


def select_whatsmeow_candidate(candidates, current_time, min_age_days, now):
    """The newest recorded commit newer than go.mod's whose commit and first sighting have aged.

    Taking the newest aged commit, not the newest commit, keeps a busy
    upstream from restarting the wait forever."""
    cutoff = now - timedelta(days=min_age_days)
    aged = []
    for version, entry in candidates.items():
        committed = datetime.fromisoformat(entry["commit_time"])
        if committed > current_time and max(committed, datetime.fromisoformat(entry["first_seen"])) <= cutoff:
            aged.append((committed, version))
    return max(aged)[1] if aged else None


def wa_archive_blockers(repo):
    """Reasons the wa-archive checkout cannot take an unattended update (read-only checks)."""
    branch = subprocess.run(["git", "symbolic-ref", "--quiet", "--short", "HEAD"], cwd=repo,
                            capture_output=True, text=True)
    status = subprocess.run(["git", "status", "--porcelain"], cwd=repo, capture_output=True, text=True)
    if status.returncode:
        raise RuntimeError(f"git status in {repo} failed: {status.stderr.strip()}")
    blockers = []
    if branch.stdout.strip() != WA_ARCHIVE_BRANCH:
        blockers.append(f"{repo} is on {branch.stdout.strip() or 'a detached HEAD'}, not {WA_ARCHIVE_BRANCH}")
    if status.stdout.strip():
        blockers.append(f"{repo} has uncommitted changes, which install.sh would deploy")
    return blockers


def check_commit_signing(repo):
    """Fail before deploying if the update could not be committed for lack of a signing key."""
    signing = subprocess.run(["git", "config", "--bool", "commit.gpgsign"], cwd=repo,
                             capture_output=True, text=True).stdout.strip() == "true"
    if signing:
        # Writes only an unreferenced commit object; nothing points to it.
        run_step("commit signing check", ["git", "commit-tree", "-S", "HEAD^{tree}", "-p", "HEAD",
                                          "-m", "personal-updates signing check"], repo)


def resolve_whatsmeow_update(repo, version):
    """Run `go get' and `go mod tidy' for VERSION on a temporary copy of wa-archive's HEAD."""
    with tempfile.TemporaryDirectory(prefix="personal-updates-wa-archive-", dir="/private/tmp") as directory:
        archive = run_step("git archive", ["git", "archive", "--format=tar", "HEAD"], repo)
        with tarfile.open(fileobj=io.BytesIO(archive)) as tar:
            tar.extractall(directory, filter="data")
        copy = Path(directory)
        before_mod = read_go_mod(directory)
        before_sum = (copy / "go.sum").read_text() if (copy / "go.sum").exists() else ""
        env = go_environment(GOFLAGS="-mod=mod")
        run_step("go get", ["go", "get", f"{WHATSMEOW}@{version}"], directory, env_overrides=env)
        run_step("go mod tidy", ["go", "mod", "tidy"], directory, env_overrides=env)
        goos, goarch = run_step("go env", ["go", "env", "GOOS", "GOARCH"], directory,
                                env_overrides=env).decode().split()
        return {"before_mod": before_mod, "after_mod": read_go_mod(directory),
                "before_sum": before_sum, "after_sum": (copy / "go.sum").read_text(),
                "go_mod": (copy / "go.mod").read_bytes(), "go_sum": (copy / "go.sum").read_bytes(),
                "goos": goos, "goarch": goarch}


def update_changes(resolution, waive_age):
    """(label, query) for every module version and Go line the update changes.

    With WAIVE_AGE, whatsmeow and its author's other go.mau.fi modules are
    exempt; every other module and the Go line are not."""
    changes = [(f"{path}@{version}", f"{path}@{version}")
               for path, version in changed_module_versions(resolution["before_mod"], resolution["after_mod"],
                                                            resolution["before_sum"], resolution["after_sum"])
               if not (waive_age and (path == WHATSMEOW or path.startswith(WHATSMEOW_WAIVED_PREFIX)))]
    return changes + toolchain_changes(resolution["before_mod"], resolution["after_mod"],
                                       resolution["goos"], resolution["goarch"])


def apply_whatsmeow_update(repo, version, resolution):
    """Test, deploy and commit the resolved go.mod and go.sum; restore both unless committed."""
    paths = {name: Path(repo) / name for name in ("go.mod", "go.sum")}
    originals = {name: path.read_bytes() for name, path in paths.items()}
    committed = False
    try:
        paths["go.mod"].write_bytes(resolution["go_mod"])
        paths["go.sum"].write_bytes(resolution["go_sum"])
        run_step("go test ./...", ["go", "test", "./..."], repo, env_overrides=go_environment())
        # install.sh restores the previous binary itself when the new one does not connect.
        run_step("install.sh", ["./install.sh"], repo, timeout=INSTALL_TIMEOUT_SECONDS,
                 env_overrides=go_environment())
        run_step("git commit", ["git", "commit", "--quiet", "-m", f"Update whatsmeow to {version}",
                                "--", "go.mod", "go.sum"], repo)
        committed = True
    finally:
        if not committed:
            try:
                for name, data in originals.items():
                    paths[name].write_bytes(data)
            except OSError as error:
                raise RuntimeError(f"restoring go.mod and go.sum failed ({error}); "
                                   f"run git checkout -- go.mod go.sum in {repo}") from error


def whatsmeow_lane(args, *, waive_age=False, now=None):
    """Bring wa-archive's whatsmeow up to the newest eligible commit; return a report.

    Failures are recorded in the report, not raised, so the Homebrew lanes
    still run; the caller alerts on them."""
    now = now or now_utc()
    repo = args.wa_archive
    report = {"status": None, "current": None, "candidate": None, "waived_age": waive_age}
    try:
        current = required_version(read_go_mod(repo), WHATSMEOW)
        report["current"] = current
        queries = [f"{WHATSMEOW}@{current}"] + ([f"{WHATSMEOW}@main"] if waive_age else [])
        infos = go_module_info(queries)
        current_time = required_module_time(infos[0])
        candidates = load_json(args.whatsmeow_state_file, {}).get("candidates", {})
        if waive_age:
            head = infos[1]
            candidate = head["Version"] if required_module_time(head) > current_time else None
        else:
            candidate = select_whatsmeow_candidate(candidates, current_time, args.min_age_days, now)
            report["waiting"] = sorted(
                version for version, entry in candidates.items()
                if datetime.fromisoformat(entry["commit_time"]) > current_time and version != candidate)
        if candidate is None:
            report["status"] = "waiting" if report.get("waiting") else "current"
            return report
        report["candidate"] = candidate
        blockers = wa_archive_blockers(repo)
        try:
            resolution = resolve_whatsmeow_update(repo, candidate)
        except WhatsmeowStepError as error:
            if "GOTOOLCHAIN=local" not in str(error):
                raise
            report.update(status="deferred", deferred=blockers + [
                f"{candidate} needs a newer Go than the installed one, which the Homebrew lane updates: {error}"])
            return report
        changes = update_changes(resolution, waive_age)
        report["changes"] = [label for label, _query in changes]
        if changes:
            cutoff = now - timedelta(days=args.min_age_days)
            blockers += [f"not aged {args.min_age_days} days: {blocker}" for blocker in
                         age_blockers(changes, go_module_info([query for _label, query in changes]), cutoff)]
        if blockers:
            report.update(status="deferred", deferred=blockers)
        elif args.dry_run:
            report["status"] = "eligible"
        else:
            check_commit_signing(repo)
            apply_whatsmeow_update(repo, candidate, resolution)
            report["status"] = "updated"
    except Exception as error:
        report.update(status="failed", error=str(error))
    return report


def whatsmeow_failure_text(report):
    target = f" to {report['candidate']}" if report.get("candidate") else ""
    return (f"wa-archive's whatsmeow update{target} failed: {report['error']} "
            "After fixing the cause, retry with: "
            + (WHATSMEOW_WAIVE_COMMAND if report.get("waived_age") else "personal-updates whatsmeow"))


def run_whatsmeow_lane(args, *, waive_age=False):
    """Run the whatsmeow lane, then print, log and (unless a dry run) alert on its outcome."""
    report = whatsmeow_lane(args, waive_age=waive_age)
    if args.dry_run:
        print(json.dumps({"whatsmeow": report}, indent=2, sort_keys=True))
        return report
    status = report["status"]
    if status == "deferred":
        for reason in report["deferred"]:
            append_log(args.log_dir, f"whatsmeow deferred {report['candidate']}: {reason}")
            print(f"Delayed update deferred: whatsmeow {report['candidate']}: {reason}", file=sys.stderr)
    elif status == "failed":
        append_log(args.log_dir, f"whatsmeow failed: {report['error']}")
        print(f"whatsmeow update failed: {report['error']}", file=sys.stderr)
        send_alert(whatsmeow_failure_text(report))
    else:
        if status == "updated":
            message = f"updated whatsmeow from {report['current']} to {report['candidate']}"
        elif status == "waiting":
            message = f"whatsmeow {report['current']}; newer commits waiting: {', '.join(report['waiting'])}"
        else:
            message = f"whatsmeow {report['current']} has no newer commit to take"
        append_log(args.log_dir, message)
        print(message)
    return report


def command_whatsmeow_scan(args, now=None):
    """Record whatsmeow's newest commit on main and when it was first seen."""
    now = now or now_utc()
    state = load_json(args.whatsmeow_state_file, {})
    current = required_version(read_go_mod(args.wa_archive), WHATSMEOW)
    current_info, head = go_module_info([f"{WHATSMEOW}@{current}", f"{WHATSMEOW}@main"])
    candidates = merge_whatsmeow_candidates(state.get("candidates", {}), head,
                                            required_module_time(current_info), now)
    new_state = {"current": current, "candidates": candidates}
    save_json(args.whatsmeow_state_file, new_state)
    append_log(args.log_dir, f"scan recorded {len(candidates)} whatsmeow commits newer than {current}")
    print(json.dumps({"whatsmeow": new_state}, indent=2, sort_keys=True))


def command_scan(args):
    state = load_json(args.state_file, {})
    updates = brew_outdated()
    new_state = merge_scan(state, updates, now_utc())
    new_state["observations"] = merge_observations(
        state.get("observations", {}), observe_artifacts(updates), now_utc())
    save_json(args.state_file, new_state)
    append_log(args.log_dir, f"scan recorded {sum(len(new_state.get(k, {})) for k in KINDS)} pending updates")
    print(json.dumps(new_state, indent=2, sort_keys=True))


def command_delayed(args, now=None, lulu_held=frozenset()):
    state = load_json(args.state_file, {})
    now = now or now_utc()
    # Reconcile saved eligibility with today's candidates. The in-process Ruby
    # guard below also covers changes after this check and implicit dependencies.
    updates = brew_outdated(refresh=False)
    current = merge_scan(state, updates, now)
    observations = merge_observations(state.get("observations", {}), observe_artifacts(updates), now)
    current["observations"] = observations
    holds = load_holds(args.hold_file)
    excluded_casks = load_excluded_casks(args.excluded_casks_file)
    allowed = age_qualified_artifacts(observations, args.min_age_days, now, holds, excluded_casks)
    eligible = eligible_updates(
        current,
        args.min_age_days,
        now,
        holds,
        excluded_casks,
    )
    deferred = [f"{kind}/{name}: {entry['version_check_error']}"
                for kind in KINDS for name, entry in current.get(kind, {}).items()
                if entry.get("version_check_error")]
    for kind, names in eligible.items():
        accepted = []
        for name in names:
            version_error = current.get(kind, {}).get(name, {}).get("version_check_error")
            if version_error:
                continue
            if name in lulu_held:
                deferred.append(f"{kind}/{name}: its LuLu allow rule would not cover the new version")
                continue
            observed = observations.get(kind, {}).get(name, {})
            if observed.get("name") not in allowed[kind]:
                deferred.append(f"{kind}/{name}: artifact is unchecked or has not completed the waiting period")
                continue
            blockers = dependency_blockers(kind, name, observations, allowed)
            if blockers:
                deferred.append(f"{kind}/{name}: dependencies {', '.join(blockers)} are unchecked "
                                "or have not completed the waiting period")
                continue
            accepted.append(name)
        eligible[kind] = accepted
    eligible, stranding = dependent_holds(eligible, current, observations)
    deferred.extend(stranding)
    eligible = {kind: names for kind, names in eligible.items() if names}
    if args.dry_run:
        print(json.dumps({"eligible": eligible, "deferred": deferred}, indent=2, sort_keys=True))
        return
    save_json(args.state_file, current)
    for reason in deferred:
        append_log(args.log_dir, f"delayed deferred {reason}")
        print(f"Delayed update deferred: {reason}", file=sys.stderr)
    if not eligible:
        append_log(args.log_dir, "delayed found 0 eligible updates")
        return
    upgrade_brew(eligible, allowed)
    append_log(args.log_dir, f"delayed upgraded {sum(len(v) for v in eligible.values())} updates")
    command_scan(args)


def command_fast(args):
    run(["softwareupdate", "--install", "--recommended"])
    append_log(args.log_dir, "fast lane installed recommended macOS updates")


def command_fast_brew(args, lulu_held=frozenset()):
    packages = [name for name in load_fast_brew_packages(args.fast_brew_file)
                if name not in lulu_held]
    if args.dry_run:
        print(json.dumps(packages, indent=2, sort_keys=True))
        return
    upgrade_fast_brew(packages)
    append_log(args.log_dir, f"fast brew upgraded {', '.join(packages)}")


def build_parser():
    parser = argparse.ArgumentParser(description="Apply a delayed personal update policy.")
    parser.add_argument("--state-file", type=Path, default=DEFAULT_STATE_FILE)
    parser.add_argument("--log-dir", type=Path, default=DEFAULT_LOG_DIR)
    parser.add_argument("--hold-file", type=Path, default=DEFAULT_HOLD_FILE)
    parser.add_argument("--excluded-casks-file", type=Path, default=DEFAULT_EXCLUDED_CASKS_FILE)
    parser.add_argument("--fast-brew-file", type=Path, default=DEFAULT_FAST_BREW_FILE)
    parser.add_argument("--whatsmeow-state-file", type=Path, default=DEFAULT_WHATSMEOW_STATE_FILE)
    parser.add_argument("--wa-archive", type=Path, default=DEFAULT_WA_ARCHIVE)
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("scan")

    delayed = subparsers.add_parser("delayed")
    delayed.add_argument("--min-age-days", type=int, default=DEFAULT_MIN_AGE_DAYS)
    delayed.add_argument("--dry-run", action="store_true")

    whatsmeow = subparsers.add_parser(
        "whatsmeow", help="run only the whatsmeow lane of delayed (wa-archive's WhatsApp library)")
    whatsmeow.add_argument("--min-age-days", type=int, default=DEFAULT_MIN_AGE_DAYS)
    whatsmeow.add_argument("--dry-run", action="store_true")
    whatsmeow.add_argument(
        "--waive-age", action="store_true",
        help="take whatsmeow's current main now, for when WhatsApp reports the client outdated; "
             "its author's go.mau.fi modules are exempt too, other modules must still have aged")

    subparsers.add_parser("fast")

    fast_brew = subparsers.add_parser("fast-brew")
    fast_brew.add_argument("--dry-run", action="store_true")
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        if args.command == "scan":
            # Each scan runs even when the other fails.
            whatsmeow_error = None
            try:
                command_whatsmeow_scan(args)
            except Exception as error:
                whatsmeow_error = error
                append_log(args.log_dir, f"error: whatsmeow scan: {error}")
                print(f"whatsmeow scan: {error}", file=sys.stderr)
            command_scan(args)
            if whatsmeow_error:
                raise RuntimeError(f"whatsmeow scan: {whatsmeow_error}")
        elif args.command == "whatsmeow":
            report = run_whatsmeow_lane(args, waive_age=args.waive_age)
            return 0 if report["status"] in ("current", "waiting", "eligible", "updated") else 1
        elif args.command in ("delayed", "fast-brew"):
            # The whatsmeow lane goes first and reports its own failures, so
            # neither lane's failure stops the other.
            whatsmeow = run_whatsmeow_lane(args) if args.command == "delayed" else {}
            held = lulu_uncovered_packages()
            if args.command == "delayed":
                command_delayed(args, lulu_held=held)
            else:
                command_fast_brew(args, lulu_held=held)
            if not args.dry_run:
                # Only the daily delayed lane alerts, so a held package is
                # reported once a day rather than once per lane.
                if held and args.command == "delayed":
                    send_alert(lulu_alert_text(held))
                # Checked every night, not only after an upgrade, so a break
                # from a manual upgrade is caught too.
                broken = broken_linkage() if args.command == "delayed" else []
                if broken:
                    send_alert(linkage_alert_text(broken))
                send_heartbeat()
            elif whatsmeow.get("status") == "failed":
                return 1
        elif args.command == "fast":
            command_fast(args)
    except Exception as error:
        append_log(args.log_dir, f"error: {error}")
        print(error, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
