+contains_op_secret_output() {
+  # Return 0 when the command would print a 1Password secret into agent output.
+  local raw="$1" variant prepared seg
+  raw=$(mask_heredoc_bodies "$raw")
+  op_inert_literal_output "$raw" && return 1
+  # A broker named inside an interpreter program or reached through variable or
+  # command-discovery indirection hides its subcommand from this analysis; those
+  # forms are denied rather than guessed at.
+  if printf '%s' "$raw" | grep -qE '(^|[;&|(!][[:space:]]*|\$\([[:space:]]*)(([^;&|[:space:]]*/)?(command|env|sudo|timeout|nice|exec|nohup|time)([[:space:]]+[^;&|[:space:]]+)*[[:space:]]+)?(([^;&|[:space:]]*/)?(bash|sh|zsh|dash|ksh)[[:space:]]+-l?c|eval)[[:space:]]+["'"'"']' && \
+     printf '%s' "$raw" | grep -qE '(^|[^A-Za-z0-9_-])(op-automations|op-desktop)([^A-Za-z0-9_-]|$)'; then
+    return 0
+  fi
+  if printf '%s' "$raw" | grep -qE '[A-Za-z_][A-Za-z0-9_]*=[[:space:]]*["'"'"']?([^"'"'"'[:space:]]*/)?(op-automations|op-desktop)["'"'"']?([[:space:]]*;|$)' && \
+     printf '%s' "$raw" | grep -qE '\$\{?[A-Za-z_][A-Za-z0-9_]*\}?'; then
+    return 0
+  fi
+  printf '%s' "$raw" | grep -qE '\$\([[:space:]]*(command[[:space:]]+-v|which|type[[:space:]]+-P)[[:space:]]+(op-automations|op-desktop)[[:space:]]*\)' && return 0
