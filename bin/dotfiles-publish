# Push authorization
# --------------------------------------------------------------------------


def authorization_path(repo):
    return repo.state_dir / "authorization.json"


def incidents_path(repo):
    return repo.state_dir / "incidents.json"


def resolved_fingerprints(repo):
    path = incidents_path(repo)
    if not path.exists():
        return frozenset()
    return frozenset(
        fingerprint
        for fingerprint, incident in read_json(path).get("incidents", {}).items()
        if incident.get("resolution") in INCIDENT_RESOLUTIONS
    )


def revalidate_run(repo, run_id):
    """Refuse unless every security input still matches the reviewed run."""
    record = load_run(repo, run_id)
    if os.path.realpath(record["repository"]) != os.path.realpath(str(repo.root)):
        raise PublishError("run %s belongs to another repository" % run_id, EXIT_REFUSED)
    if record["remote_url"] != repo.fetch_url:
        raise PublishError("the remote URL changed since the review", EXIT_REFUSED)
    if record["remote_ref"] != repo.remote_ref:
        raise PublishError("the configured upstream ref changed since the review", EXIT_REFUSED)
    current_ruleset = ruleset_identity(repo.root)
    if record["ruleset_id"] != current_ruleset:
        raise PublishError(
            "the ruleset changed since the review; scan again under the current policy",
            EXIT_REFUSED,
        )
    boundary = resolve_boundary(repo)
    if boundary.candidate_oid != record["candidate_oid"]:
        raise PublishError(
            "the candidate changed since the review (%s != %s); scan again"
            % (boundary.candidate_oid[:12], record["candidate_oid"][:12]),
            EXIT_REFUSED,
        )
    if boundary.remote_oid != record["remote_oid"]:
        raise PublishError(
            "the remote tip advanced since the review (%s != %s); scan again"
            % (boundary.remote_oid[:12], record["remote_oid"][:12]),
            EXIT_REFUSED,
        )
    return record, boundary


def tag_update(repo, record, tag):
    if record["mode"] != "release":
        raise PublishError("a tag may only be published by a release run", EXIT_REFUSED)
    resolved = run_git(repo.root, "rev-parse", "--verify", "refs/tags/%s^{commit}" % tag, check=False)
    if resolved.code != 0:
        raise PublishError("tag %s does not exist locally" % tag, EXIT_REFUSED)
    tag_object = run_git(repo.root, "rev-parse", "--verify", "refs/tags/%s" % tag).text.strip()
    if tag_object != record["candidate_oid"]:
        raise PublishError(
            "tag %s does not point at the reviewed candidate; use a lightweight tag on it" % tag,
            EXIT_REFUSED,
        )
    existing = run_git(repo.root, "ls-remote", repo.fetch_url, "refs/tags/%s" % tag).text.strip()
    if existing:
        raise PublishError("tag %s already exists on the remote" % tag, EXIT_REFUSED)
    return {
        "local_ref": tag_object,
        "local_oid": tag_object,
        "remote_ref": "refs/tags/%s" % tag,
        "remote_oid": "0" * len(record["remote_oid"]),
    }


def authorization_updates(repo, record, tag):
    updates = [
        {
            "local_ref": record["candidate_oid"],
            "local_oid": record["candidate_oid"],
            "remote_ref": record["remote_ref"],
            "remote_oid": record["remote_oid"],
        }
    ]
    if tag:
        updates.append(tag_update(repo, record, tag))
    return updates


def authorize_run(repo, run_id, tag, now):
    record = load_run(repo, run_id)
    if record["mode"] == "full-audit":
        raise PublishError("a full audit run never publishes", EXIT_REFUSED)
    if record["mode"] == "readiness":
        raise PublishError("a readiness run cannot authorize a push", EXIT_REFUSED)
    record, _ = revalidate_run(repo, run_id)
    if record["mode"] == "release" and tag != record.get("release_tag"):
        raise PublishError(
            "the requested tag does not match the reviewed release tag; scan and review the intended tag",
            EXIT_REFUSED,
        )
    staleness = full_audit_staleness(repo, record["ruleset_id"], now)
    if staleness:
        raise PublishError("full audit required: %s" % staleness, EXIT_REFUSED)

    status = review_status(repo, run_id)
    if not status.clean:
        details = []
        for unit_id in status.missing:
            details.append("missing-unit: %s" % unit_id)
        for unit_id in status.extra:
            details.append("extra-unit: %s" % unit_id)
        for unit_id in status.unit_findings:
            details.append("review-finding: %s" % unit_id)
        for print_key in status.deterministic:
            details.append("deterministic-finding: %s" % print_key)
        raise PublishError(
            "the review is not exhaustive and clean:\n%s" % "\n".join(details), EXIT_REFUSED
        )

    authorization = {
        "schema": SCHEMA,
        "run_id": run_id,
        "mode": record["mode"],
        "created_at": rfc3339(now),
        "expires_at": rfc3339(now + AUTHORIZATION_LIFETIME_SECONDS),
        "remote_url": record["remote_url"],
        "ruleset_id": record["ruleset_id"],
        "updates": authorization_updates(repo, record, tag),
    }
    write_json(authorization_path(repo), authorization)
    return record, authorization


def command_authorize(args):
    repo = discover_repository()
    fingerprint_key(repo)
    _, authorization = authorize_run(repo, args.run, args.tag, now_epoch())
    print("authorized: %s" % args.run)
    print("expires_at: %s" % authorization["expires_at"])
    for update in authorization["updates"]:
        print("update: %s -> %s" % (update["local_oid"][:12], update["remote_ref"]))
    return EXIT_OK


# --------------------------------------------------------------------------
# hook
# --------------------------------------------------------------------------


def parse_rfc3339(text):
    return float(calendar_timegm(time.strptime(text, "%Y-%m-%dT%H:%M:%SZ")))


def update_key(update):
    return (
        update["local_ref"],
        update["local_oid"],
        update["remote_ref"],
        update["remote_oid"],
    )


def read_proposed_updates(stream):
    proposed = []
    for line in stream.read().splitlines():
        if not line.strip():
            continue
        fields = line.split()
        if len(fields) != 4:
            raise PublishError("unsupported pre-push input: %d fields" % len(fields), EXIT_REFUSED)
        proposed.append(
            {
                "local_ref": fields[0],
                "local_oid": fields[1],
                "remote_ref": fields[2],
                "remote_oid": fields[3],
            }
        )
    return proposed


def consume_authorization(repo):
    """Read and unlink the authorization before any decision is made."""
    path = authorization_path(repo)
    if not path.exists():
        return None
    try:
        return read_json(path)
    finally:
        path.unlink(missing_ok=True)


def command_hook(args):
    repo = discover_repository()
    proposed = read_proposed_updates(sys.stdin)
    authorization = consume_authorization(repo)
    now = now_epoch()

    if authorization is None:
        raise PublishError(
            "no push authorization; use publish-dotfiles to review and publish this branch",
            EXIT_REFUSED,
        )
    if not proposed:
        raise PublishError("no proposed update to authorize", EXIT_REFUSED)
    if authorization.get("schema") != SCHEMA:
        raise PublishError("the authorization has an unsupported schema", EXIT_REFUSED)
    if now > parse_rfc3339(authorization["expires_at"]):
        raise PublishError(
            "the push authorization expired at %s; authorize again"
            % authorization["expires_at"],
            EXIT_REFUSED,
        )
    if authorization["remote_url"] not in (args.remote_location, repo.fetch_url):
        raise PublishError(
            "the authorization was issued for a different remote URL", EXIT_REFUSED
        )
    if authorization["ruleset_id"] != ruleset_identity(repo.root):
        raise PublishError("the ruleset changed after the authorization", EXIT_REFUSED)

    for update in proposed:
        if set(update["local_oid"]) == {"0"}:
            raise PublishError("this guard never authorizes a ref deletion", EXIT_REFUSED)

    authorized = sorted(update_key(update) for update in authorization["updates"])
    requested = sorted(update_key(update) for update in proposed)
    if authorized != requested:
        raise PublishError(
            "the proposed push does not match the authorization exactly:\n%s"
            % "\n".join("proposed: %s" % " ".join(item) for item in requested),
            EXIT_REFUSED,
        )

    for update in authorization["updates"]:
        present = run_git(
            repo.root, "cat-file", "-e", update["local_oid"] + "^{object}", check=False
        )
        if present.code != 0:
            raise PublishError(
                "authorized object %s is no longer present locally" % update["local_oid"][:12],
                EXIT_REFUSED,
            )

    print("push authorized for run %s" % authorization["run_id"])
    return EXIT_OK


# --------------------------------------------------------------------------
# push
# --------------------------------------------------------------------------


def command_push(args):
    repo = discover_repository()
    fingerprint_key(repo)
    record, authorization = authorize_run(repo, args.run, args.tag, now_epoch())
    refspecs = [
        "%s:%s" % (update["local_oid"], update["remote_ref"])
        for update in authorization["updates"]
    ]
    try:
        result = run_git(repo.root, "push", record["remote_url"], *refspecs, check=False)
    finally:
        # A failure consumes the authorization; publishing again needs a fresh one.
        authorization_path(repo).unlink(missing_ok=True)
    for line in structural_redaction(result.text + result.error_text).splitlines():
        if line.strip():
            print("git: %s" % line.rstrip())
    if result.code != 0:
        raise PublishError(
            "git push failed: %s" % clip(structural_redaction(result.error_text), 400),
            EXIT_FAILURE,
        )

    for update in authorization["updates"]:
        actual = remote_tip_of(repo, record["remote_url"], update["remote_ref"])
        if actual != update["local_oid"]:
            raise PublishError(
                "%s is %s on the remote after the push, not %s"
                % (update["remote_ref"], (actual or "missing")[:12], update["local_oid"][:12]),
                EXIT_FAILURE,
            )
        print("published: %s %s" % (update["remote_ref"], update["local_oid"]))

    for ref in clear_recovery_refs(repo, record["remote_oid"]):
        print("recovery-ref-removed: %s" % ref)

    record["published_at"] = rfc3339(now_epoch())
    write_json(run_directory(repo, args.run) / "run.json", record)
    print("pushed: %s" % args.run)
    return EXIT_OK


# --------------------------------------------------------------------------
# install
# --------------------------------------------------------------------------

EXPECTED_REMOTE = re.compile(r"(?:^|[/:])benthamite/dotfiles(?:\.git)?/?$")

# The temporary blocker installed while this workflow was being designed.  It
# is the only pre-push content install may replace besides its own symlink.
BOOTSTRAP_PRE_PUSH_SHA256 = (
    "f78f818bc470c90c1a4b5ffb1243850925a537609d0964981d854b393233a29e"
)

GITLEAKS_MINIMUM_VERSION = (8, 29)

TRACKED_HELPERS = ("dotfiles-publish", "dotfiles-pre-push", "git-remote-dotfiles-blocked")


def require_repository_identity(repo):
    if os.environ.get("DOTFILES_PUBLISH_TESTING") == "1":
        expected = os.environ.get("DOTFILES_PUBLISH_EXPECTED_REMOTE")
        if expected:
            if expected != repo.fetch_url:
                raise PublishError(
                    "this guard installs into %s, not %s" % (expected, repo.fetch_url)
                )
            return
    if not EXPECTED_REMOTE.search(repo.fetch_url):
        raise PublishError(
            "this guard installs into benthamite/dotfiles only, not %s" % repo.fetch_url
        )


def require_gitleaks():
    executable = gitleaks_executable()
    completed = subprocess.run(
        [executable, "version"], stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )
    if completed.returncode != 0:
        raise PublishError("could not run '%s version'" % executable)
    reported = completed.stdout.decode("utf-8", "replace").strip().splitlines()[-1].strip()
    numbers = re.search(r"(\d+)\.(\d+)", reported)
    if not numbers:
        raise PublishError("could not read the gitleaks version from %r" % reported)
    version = (int(numbers.group(1)), int(numbers.group(2)))
    if version < GITLEAKS_MINIMUM_VERSION:
        raise PublishError(
            "gitleaks %s is older than the required %d.%d"
            % (reported, *GITLEAKS_MINIMUM_VERSION)
        )
    return reported


def hooks_directory(repo):
    configured = run_git(repo.root, "config", "--get", "core.hooksPath", check=False).text.strip()
    if configured:
        path = Path(configured)
        return path if path.is_absolute() else repo.root / path
    return repo.git_dir / "hooks"


def install_pre_push_hook(repo):
    target = repo.root / "bin" / "dotfiles-pre-push"
    hook = hooks_directory(repo) / "pre-push"
    if hook.is_symlink():
        resolved = (hook.parent / os.readlink(str(hook))).resolve()
        if resolved != target.resolve():
            raise PublishError(
                "pre-push is a symlink to %s; point it at bin/dotfiles-pre-push by hand" % resolved
            )
        return "unchanged", hook
    if hook.exists():
        digest = hashlib.sha256(hook.read_bytes()).hexdigest()
        if digest != BOOTSTRAP_PRE_PUSH_SHA256:
            raise PublishError(
                "%s already contains an unrelated hook; merge it with bin/dotfiles-pre-push "
                "by hand and rerun install" % hook
            )
    hook.parent.mkdir(parents=True, exist_ok=True)
    temporary = hook.parent / ".pre-push.dotfiles-publish"
    temporary.unlink(missing_ok=True)
    os.symlink(str(target), str(temporary))
    os.replace(str(temporary), str(hook))
    return "installed", hook


def command_install(args):
    repo = discover_repository()
    require_repository_identity(repo)

    for name in TRACKED_HELPERS:
        helper = repo.root / "bin" / name
        if not helper.is_file():
            raise PublishError("tracked helper is missing: %s" % helper)
        if not os.access(str(helper), os.X_OK):
            raise PublishError("tracked helper is not executable: %s" % helper)

    transport = shutil.which("git-remote-dotfiles-blocked")
    if not transport:
        raise PublishError(
            "git-remote-dotfiles-blocked is not on PATH, so Git could not refuse a push; "
            "add %s to PATH and rerun install" % (repo.root / "bin")
        )

    version = require_gitleaks()
    hook_state, hook = install_pre_push_hook(repo)

    push_setting = "remote.%s.pushurl" % repo.remote_name
    current = run_git(repo.root, "config", "--get", push_setting, check=False).text.strip()
    if current == BLOCKED_PUSH_URL:
        push_state = "unchanged"
    else:
        run_git(repo.root, "config", push_setting, BLOCKED_PUSH_URL)
        push_state = "set"
    fetch_url = run_git(repo.root, "remote", "get-url", repo.remote_name).text.strip()
    if fetch_url != repo.fetch_url:
        raise PublishError("the fetch URL changed during install; inspect the remote by hand")

    ensure_state_dir(repo)
    fingerprint_key(repo)
    write_json(
        repo.state_dir / "install.json",
        {
            "schema": SCHEMA,
            "installed_at": rfc3339(now_epoch()),
            "remote_name": repo.remote_name,
            "fetch_url": fetch_url,
            "push_url": BLOCKED_PUSH_URL,
            "hook": str(hook),
            "gitleaks": version,
        },
    )

    print("hook: %s %s" % (hook_state, hook))
    print("pushurl: %s %s" % (push_state, BLOCKED_PUSH_URL))
    print("fetch-url: %s" % fetch_url)
    print("transport: %s" % transport)
    print("gitleaks: %s" % version)
    return EXIT_OK


# --------------------------------------------------------------------------
# Command line
# --------------------------------------------------------------------------


def build_parser():
    parser = argparse.ArgumentParser(
        prog="dotfiles-publish",
        description="Scan, review, and authorize publication of the dotfiles repository.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    scan = subparsers.add_parser("scan", help="capture and scan the outgoing boundary")
    scan.add_argument("--mode", default="publish", choices=MODES)
    scan.add_argument("--release-notes", default=None)
    scan.add_argument("--tag", default=None)
    scan.set_defaults(handler=command_scan)

    review_list = subparsers.add_parser("review-list", help="list review unit identifiers")
    review_list.add_argument("--run", required=True)
    review_list.set_defaults(handler=command_review_list)

    review_show = subparsers.add_parser("review-show", help="show exactly one review unit")
    review_show.add_argument("--run", required=True)
    review_show.add_argument("--unit", required=True)
    review_show.set_defaults(handler=command_review_show)

    review_record = subparsers.add_parser("review-record", help="record one review verdict")
    review_record.add_argument("--run", required=True)
    review_record.add_argument("--unit", required=True)
    review_record.add_argument("--verdict", required=True, choices=("clean", "finding"))
    review_record.add_argument("--findings", default=None)
    review_record.set_defaults(handler=command_review_record)

    review_status = subparsers.add_parser("review-status", help="report review completeness")
    review_status.add_argument("--run", required=True)
    review_status.set_defaults(handler=command_review_status)

    repair_start = subparsers.add_parser("repair-start", help="protect history before repair")
    repair_start.add_argument("--run", required=True)
    repair_start.set_defaults(handler=command_repair_start)

    repair_verify = subparsers.add_parser("repair-verify", help="verify a repaired history")
    repair_verify.add_argument("--run", required=True)
    repair_verify.add_argument("--allowed-path", action="append", default=[])
    repair_verify.set_defaults(handler=command_repair_verify)

    incident = subparsers.add_parser("incident-record", help="record a public incident disposition")
    incident.add_argument("--run", required=True)
    incident.add_argument("--fingerprint", required=True)
    incident.add_argument("--resolution", required=True, choices=INCIDENT_RESOLUTIONS)
    incident.add_argument("--evidence", required=True)
    incident.set_defaults(handler=command_incident_record)

    authorize = subparsers.add_parser("authorize", help="write a short-lived push authorization")
    authorize.add_argument("--run", required=True)
    authorize.add_argument("--tag", default=None)
    authorize.set_defaults(handler=command_authorize)

    push = subparsers.add_parser("push", help="authorize and push the reviewed objects")
    push.add_argument("--run", required=True)
    push.add_argument("--tag", default=None)
    push.set_defaults(handler=command_push)

    hook = subparsers.add_parser("hook", help="pre-push hook implementation")
    hook.add_argument("remote_name")
    hook.add_argument("remote_location")
    hook.set_defaults(handler=command_hook)

    install = subparsers.add_parser("install", help="install the push guard")
    install.set_defaults(handler=command_install)

    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.handler(args)
    except PublishError as error:
        sys.stderr.write("dotfiles-publish: %s\n" % error)
        return error.code
    except BrokenPipeError:
        return EXIT_FAILURE


if __name__ == "__main__":
    sys.exit(main())
