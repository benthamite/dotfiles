#!/usr/bin/env python3
"""Create/store AI-provider runtime keys for Epoch automation projects.

This command separates provider admin credentials from project runtime keys:

- Admin credentials are read from a fixed 1Password reference and are never
  stored in project repos or automation runtime env files.
- Runtime keys are stored in the Automations vault as provider/project-scoped
  items such as "OpenAI - automations-dashboard".

OpenAI automation keys are service-account keys in the shared OpenAI
Automations project. Anthropic automation keys are keys in the shared Anthropic
Automations workspace; Anthropic's public Admin API supports workspace
management and API-key inventory/update, but not API-key creation, so the
Anthropic flow stores a key that was created in the console.
"""

from __future__ import annotations

import argparse
import copy
import hmac
import http.client
import json
import math
import os
import re
import stat
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass, field, replace
from pathlib import Path
from typing import Any


DEFAULT_AUTOMATIONS_VAULT = "Automations"
DEFAULT_OPENAI_ADMIN_REF = "op://Employee/OpenAI - api-provisioning-admin/credential"
DEFAULT_ANTHROPIC_ADMIN_REF = "op://Employee/Anthropic - api-provisioning-admin/credential"
DEFAULT_OPENAI_AUTOMATIONS_PROJECT_ID = "proj_mdM7wTXIQUFqquI4A1zCO2BF"
DEFAULT_ANTHROPIC_AUTOMATIONS_WORKSPACE_ID = "wrkspc_016hokUAzbZA7qVGuAUjfZTb"
DEFAULT_MAX_AUTONOMOUS_MONTHLY_SPEND_USD = 500.0
# Retained helper ceiling, not a claim about current provider controls.
# The caller must establish current scoped authority and control evidence;
# this constant neither enforces nor allocates provider spend.
MAX_AUTONOMOUS_MONTHLY_SPEND_USD_BY_PROVIDER = {
    "anthropic": 2000.0,
}


def max_autonomous_cap(provider: str) -> float:
    return MAX_AUTONOMOUS_MONTHLY_SPEND_USD_BY_PROVIDER.get(
        provider, DEFAULT_MAX_AUTONOMOUS_MONTHLY_SPEND_USD
    )
ANTHROPIC_VERSION = "2023-06-01"


class ProvisionError(RuntimeError):
    pass


@dataclass(frozen=True)
class RuntimeCredential:
    provider: str
    item_title: str
    env_name: str
    op_ref: str
    project_or_workspace_id: str
    secret: str = field(repr=False)


def run(args: list[str], *, input_text: str | None = None) -> subprocess.CompletedProcess[str]:
    """Capture all broker output. Errors can contain credentials: never relay it."""
    try:
        return subprocess.run(args, input=input_text, capture_output=True, text=True,
                              check=False, timeout=120)
    except (OSError, subprocess.SubprocessError, UnicodeError):
        raise ProvisionError("Credential broker failed or timed out; completion is unconfirmed. Do not retry a write blindly.") from None


def validate_reference(reference: str) -> str:
    if not isinstance(reference, str) or not re.fullmatch(r"op://[A-Za-z0-9 _-]+/[A-Za-z0-9 _.-]+/[A-Za-z0-9 _-]+", reference):
        raise ProvisionError("Invalid 1Password reference; expected one vault/item/field reference.")
    return reference.split("/")[2]


def op_read(reference: str, *, desktop_session: bool = False) -> str:
    vault = validate_reference(reference)
    if desktop_session:
        args = ["op-desktop", "read", reference]
    elif vault == DEFAULT_AUTOMATIONS_VAULT:
        args = ["op-automations", "read", reference]
    else:
        raise ProvisionError(
            "Non-Automations 1Password reads must explicitly use the desktop session."
        )
    result = run(args)
    if result.returncode != 0:
        raise ProvisionError("Could not read the selected credential through its broker.")
    secret = result.stdout.removesuffix("\n")
    if not secret or len(secret) > 4096 or any(c.isspace() or ord(c) < 32 for c in secret):
        raise ProvisionError("Selected credential has an unsupported shape.")
    return secret


def broker_json(args: list[str]) -> Any:
    result = run(args)
    if result.returncode != 0:
        raise ProvisionError("1Password metadata lookup failed; absence is not established.")
    try:
        if len(result.stdout) > 4 * 1024 * 1024:
            raise ValueError
        return json.loads(result.stdout)
    except (ValueError, TypeError):
        raise ProvisionError("1Password returned unsupported metadata.") from None


def lookup_item(title: str, vault: str) -> dict[str, Any] | None:
    rows = broker_json(["op-automations", "item", "list", "--vault", vault, "--format", "json"])
    if not isinstance(rows, list) or any(not isinstance(r, dict) or not isinstance(r.get("title"), str)
                                       or not isinstance(r.get("id"), str)
                                       or not re.fullmatch(r"[a-z0-9]{26}", r["id"]) for r in rows):
        raise ProvisionError("Item inventory is incomplete or malformed.")
    matches = [r for r in rows if r["title"] == title]
    if len(matches) > 1:
        raise ProvisionError("Multiple matching secret items; refusing ambiguous selection.")
    return matches[0] if matches else None


def op_item_exists(title: str, vault: str) -> bool:
    return lookup_item(title, vault) is not None


def ensure_desktop_op_session() -> None:
    if run(["op-desktop", "whoami"]).returncode != 0:
        raise ProvisionError("1Password desktop broker is unavailable; no raw CLI or forced sign-in fallback.")


@dataclass
class ItemPlan:
    title: str
    vault: str
    item_id: str | None
    template: dict[str, Any] = field(repr=False)


def validate_template(data: Any) -> dict[str, Any]:
    if not isinstance(data, dict) or data.get("category") != "API_CREDENTIAL" or not isinstance(data.get("fields"), list):
        raise ProvisionError("Expected an API Credential item/template.")
    if data.get("files") or data.get("document") or data.get("sshKey") or data.get("passkeys"):
        raise ProvisionError("Item has unsupported attached material; refusing a lossy template update.")
    if any(not isinstance(f, dict) or not isinstance(f.get("type"), str)
           or f["type"] in {"SSHKEY", "FILE", "PASSKEY"} for f in data["fields"]):
        raise ProvisionError("Item contains unsupported fields.")
    # Do not infer the installed category layout or append a second credential
    # when the captured template exposes a section-scoped/custom alternative.
    managed = ("credential", "provider", "scope", "env_var", "provider_resource_id")
    for key in managed:
        matching = [f for f in data["fields"] if f.get("id") == key or f.get("label") == key]
        if len(matching) > 1 or any(f.get("section") for f in matching):
            raise ProvisionError("Item has duplicate or section-scoped managed fields; unsupported template.")
        if key == "credential" and (len(matching) != 1 or matching[0].get("id") != "credential"
                                    or matching[0]["type"] != "CONCEALED"):
            raise ProvisionError("Template lacks the supported unique credential field.")
    return data


def prepare_item(title: str, vault: str, *, force: bool) -> ItemPlan:
    existing = lookup_item(title, vault)
    if existing and not force:
        raise ProvisionError("Selected item already exists; --force is required to replace its credential.")
    if existing:
        data = validate_template(broker_json(["op-automations", "item", "get", existing["id"], "--vault", vault, "--format", "json"]))
        if data.get("id") != existing["id"] or data.get("title") != title:
            raise ProvisionError("Selected item identity changed during preflight.")
    else:
        data = validate_template(broker_json(["op-desktop", "item", "template", "get", "API Credential", "--format", "json"]))
    return ItemPlan(title, vault, existing["id"] if existing else None, data)


def create_or_update_automation_item(credential: RuntimeCredential, vault: str, *, force: bool,
                                     prepared: ItemPlan | None = None) -> str:
    prepared = prepared or prepare_item(credential.item_title, vault, force=force)
    current = lookup_item(prepared.title, vault)
    if (current["id"] if current else None) != prepared.item_id:
        raise ProvisionError("Item identity changed after preflight; no write attempted.")
    if prepared.item_id:
        current_data = broker_json(["op-automations", "item", "get", prepared.item_id, "--vault", vault, "--format", "json"])
        if current_data != prepared.template:
            raise ProvisionError("Item contents changed after preflight; refusing overwrite.")
    template = copy.deepcopy(prepared.template)
    template["title"] = credential.item_title
    values = {"credential": credential.secret, "provider": credential.provider,
              "scope": credential.item_title.split(" - ", 1)[1], "env_var": credential.env_name,
              "provider_resource_id": credential.project_or_workspace_id}
    for key, value in values.items():
        fields = [f for f in template["fields"] if f.get("id") == key or (f.get("label") == key and not f.get("section"))]
        if len(fields) > 1:
            raise ProvisionError("Item has ambiguous managed fields; refusing overwrite.")
        target = fields[0] if fields else {"id": key, "label": key}
        target.update(type="CONCEALED" if key == "credential" else "STRING", value=value)
        if not fields:
            template["fields"].append(target)
    command = ["op-desktop", "item", "edit", prepared.item_id] if prepared.item_id else ["op-desktop", "item", "create", "-"]
    result = run([*command, "--vault", vault], input_text=json.dumps(template))
    if result.returncode != 0:
        raise ProvisionError("Secret item write failed or has uncertain completion; reconcile before retrying.")
    stored = lookup_item(credential.item_title, vault)
    if not stored or (prepared.item_id and stored["id"] != prepared.item_id):
        raise ProvisionError("Secret item was written but its unique identity could not be verified.")
    reference = f"op://{vault}/{stored['id']}/credential"
    if not hmac.compare_digest(op_read(reference), credential.secret):
        raise ProvisionError("Secret item was written but exact read-back verification failed.")
    return reference


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise ProvisionError("Provider redirect refused; credentials were not forwarded.")


def request_json(url: str, *, method: str = "GET", headers: dict[str, str], body: dict[str, Any] | None = None) -> dict[str, Any]:
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme != "https" or parsed.netloc not in {"api.openai.com", "api.anthropic.com"} or parsed.fragment:
        raise ProvisionError("Unsupported provider endpoint.")
    payload = None if body is None else json.dumps(body).encode("utf-8")
    request = urllib.request.Request(url, data=payload, method=method, headers=headers)
    try:
        # Do not forward Authorization/x-api-key through redirects. Preserve
        # normal HTTPS proxy/TLS behavior; a failed POST is not retried.
        opener = urllib.request.build_opener(NoRedirect())
        with opener.open(request, timeout=30) as response:
            raw = response.read(4 * 1024 * 1024 + 1)
            if len(raw) > 4 * 1024 * 1024:
                raise ProvisionError("Provider response exceeded the supported size.")
            data = json.loads(raw)
            if not isinstance(data, dict):
                raise ProvisionError("Provider returned an unsupported response shape.")
            return data
    except urllib.error.HTTPError as exc:
        raise ProvisionError(f"Provider request failed with HTTP {exc.code}; response body withheld.") from None
    except (OSError, ValueError, UnicodeError, http.client.HTTPException):
        raise ProvisionError("Provider request failed or returned malformed data; details withheld.") from None


def openai_headers(admin_key: str) -> dict[str, str]:
    return {
        "Authorization": f"Bearer {admin_key}",
        "Content-Type": "application/json",
    }


def list_openai_projects(admin_key: str) -> list[dict[str, Any]]:
    return paginated_resources("https://api.openai.com/v1/organization/projects?limit=100&include_archived=false",
                               openai_headers(admin_key), "after")


def paginated_resources(url: str, headers: dict[str, str], cursor_name: str) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    seen = set()
    cursor = None
    for _ in range(100):
        data = request_json(url + ("&" + urllib.parse.urlencode({cursor_name: cursor}) if cursor else ""), headers=headers)
        page = data.get("data")
        if not isinstance(page, list) or type(data.get("has_more")) is not bool or any(
            not isinstance(r, dict) or not isinstance(r.get("id"), str) or not isinstance(r.get("name"), str) for r in page
        ):
            raise ProvisionError("Provider inventory was incomplete; no resource will be created.")
        for row in page:
            if row["id"] in seen:
                raise ProvisionError("Provider inventory repeated an identity; refusing uncertain creation.")
            seen.add(row["id"])
        rows.extend(page)
        if not data["has_more"]:
            return rows
        cursor = data.get("last_id")
        if not page or cursor != page[-1]["id"]:
            raise ProvisionError("Provider inventory has an invalid continuation.")
    raise ProvisionError("Provider inventory page bound exceeded; no resource will be created.")


def get_or_create_openai_project(admin_key: str, name: str) -> tuple[str, bool]:
    matches = [p for p in list_openai_projects(admin_key) if p["name"] == name]
    if len(matches) > 1:
        raise ProvisionError("Multiple provider projects match; select an explicit resource ID.")
    if matches:
        return resource_id(matches[0]["id"], "openai"), False
    data = request_json(
        "https://api.openai.com/v1/organization/projects",
        method="POST",
        headers=openai_headers(admin_key),
        body={"name": name},
    )
    return resource_id(data.get("id"), "openai"), True


def create_openai_service_account(admin_key: str, project_id: str, name: str) -> tuple[str, str]:
    url = f"https://api.openai.com/v1/organization/projects/{project_id}/service_accounts"
    data = request_json(url, method="POST", headers=openai_headers(admin_key), body={"name": name})
    key = data.get("api_key")
    secret = key.get("value") if isinstance(key, dict) else None
    if not isinstance(secret, str) or not re.fullmatch(r"sk-[A-Za-z0-9_-]{20,1024}", secret):
        raise ProvisionError("OpenAI did not return a service-account key value.")
    identity = data.get("id")
    if not isinstance(identity, str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,128}", identity):
        raise ProvisionError("OpenAI returned an unsupported service-account identity.")
    return identity, secret


def anthropic_headers(admin_key: str) -> dict[str, str]:
    return {
        "x-api-key": admin_key,
        "anthropic-version": ANTHROPIC_VERSION,
        "Content-Type": "application/json",
    }


def list_anthropic_workspaces(admin_key: str) -> list[dict[str, Any]]:
    return paginated_resources("https://api.anthropic.com/v1/organizations/workspaces?limit=100",
                               anthropic_headers(admin_key), "after_id")


def get_or_create_anthropic_workspace(admin_key: str, name: str) -> tuple[str, bool]:
    matches = [w for w in list_anthropic_workspaces(admin_key) if w["name"] == name and w.get("archived_at") is None]
    if len(matches) > 1:
        raise ProvisionError("Multiple provider workspaces match; select an explicit resource ID.")
    if matches:
        return resource_id(matches[0]["id"], "anthropic"), False
    data = request_json(
        "https://api.anthropic.com/v1/organizations/workspaces",
        method="POST",
        headers=anthropic_headers(admin_key),
        body={"name": name},
    )
    return resource_id(data.get("id"), "anthropic"), True


def env_name_for(project_slug: str, provider: str) -> str:
    prefix = project_slug.upper().replace("-", "_")
    return f"{prefix}_{provider.upper()}_API_KEY"


def read_regular(path: Path, limit: int) -> bytes:
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        before = os.fstat(fd)
        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or before.st_size > limit:
            raise ProvisionError("Selected file must be a bounded regular, unshared file.")
        with os.fdopen(fd, "rb", closefd=False) as stream:
            data = stream.read(limit + 1)
        after = os.fstat(fd)
        identity = lambda s: (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns)
        if len(data) > limit or identity(before) != identity(after):
            raise ProvisionError("Selected file changed during its bounded read.")
        return data
    finally:
        os.close(fd)


@dataclass
class EnvPlan:
    repo: Path
    env_name: str
    original: bytes | None = field(repr=False)
    index: int | None
    directory_identity: tuple[int, int]


def prepare_env(repo: Path, env_name: str, op_ref: str, *, force: bool) -> EnvPlan:
    if repo.is_symlink():
        raise ProvisionError("Selected repository root must not be a symlink.")
    repo = repo.resolve(strict=True)
    if not repo.is_dir():
        raise ProvisionError("Selected repository root is not a directory.")
    try:
        original = read_regular(repo / ".env.op", 256 * 1024)
    except FileNotFoundError:
        original = None
    lines = original.decode("utf-8").splitlines(keepends=True) if original is not None else []
    matches = [i for i, line in enumerate(lines) if re.match(r"^\s*(?:export\s+)?" + re.escape(env_name) + r"\s*=", line)]
    if len(matches) > 1:
        raise ProvisionError("The env file has duplicate definitions of the selected variable.")
    index = matches[0] if matches else None
    if index is not None and not force and lines[index].strip() != f"{env_name}={op_ref}":
        raise ProvisionError("The env file defines another reference; --force is required to replace it.")
    directory = repo.stat()
    return EnvPlan(repo, env_name, original, index, (directory.st_dev, directory.st_ino))


def write_env_op(repo: Path, env_name: str, op_ref: str, *, force: bool, prepared: EnvPlan | None = None) -> None:
    prepared = prepared or prepare_env(repo, env_name, op_ref, force=force)
    directory = prepared.repo.lstat()
    if not stat.S_ISDIR(directory.st_mode) or (directory.st_dev, directory.st_ino) != prepared.directory_identity:
        raise ProvisionError("Selected repository directory changed after preflight.")
    path = prepared.repo / ".env.op"
    try:
        current = read_regular(path, 256 * 1024)
    except FileNotFoundError:
        current = None
    if current != prepared.original:
        raise ProvisionError("The env file changed after preflight; refusing overwrite.")
    lines = current.decode("utf-8").splitlines(keepends=True) if current is not None else []
    entry = f"{env_name}={op_ref}\n"
    if prepared.index is not None:
        lines[prepared.index] = entry
    else:
        if lines and not lines[-1].endswith("\n"):
            lines[-1] += "\n"
        lines.append(entry)
    fd, temporary = tempfile.mkstemp(prefix=".env.op.", dir=prepared.repo)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write("".join(lines).encode("utf-8"))
            stream.flush()
            os.fsync(stream.fileno())
        # Preflight/recheck is not a remote transaction or a lock against an
        # adversarial writer racing the final replace. No blind retry follows.
        try:
            latest = read_regular(path, 256 * 1024)
        except FileNotFoundError:
            latest = None
        if latest != current:
            raise ProvisionError("The env file changed before publication.")
        if current is None:
            os.link(temporary, path)  # Exclusive publication; never replace a new competing file.
            os.unlink(temporary)
        else:
            os.replace(temporary, path)
        if read_regular(path, 256 * 1024) != "".join(lines).encode("utf-8"):
            raise ProvisionError("The env file write could not be verified.")
    finally:
        if os.path.lexists(temporary):
            os.unlink(temporary)  # Only this owned non-secret temporary file.


def create_openai(args: argparse.Namespace) -> RuntimeCredential:
    admin_ref = args.admin_key_ref or os.environ.get("EPOCH_OPENAI_ADMIN_KEY_REF") or DEFAULT_OPENAI_ADMIN_REF
    admin_key = op_read(admin_ref, desktop_session=validate_reference(admin_ref) != DEFAULT_AUTOMATIONS_VAULT)
    if args.provider_resource_id:
        project_id = args.provider_resource_id
    elif args.provider_project_name:
        project_id, _ = get_or_create_openai_project(admin_key, args.provider_project_name)
    else:
        project_id = DEFAULT_OPENAI_AUTOMATIONS_PROJECT_ID
    service_account_id, secret = create_openai_service_account(admin_key, project_id, args.key_name or args.project)
    item_title = f"OpenAI - {args.project}"
    env_name = args.env_name or env_name_for(args.project, "OPENAI")
    op_ref = f"op://{args.vault}/{item_title}/credential"
    return RuntimeCredential("openai", item_title, env_name, op_ref, f"{project_id}:{service_account_id}", secret)


def create_anthropic(args: argparse.Namespace) -> RuntimeCredential:
    secret = getattr(args, "imported_secret", None) or read_secret_argument(args)
    if args.provider_resource_id:
        workspace_id = args.provider_resource_id
    elif args.provider_project_name:
        admin_ref = args.admin_key_ref or os.environ.get("EPOCH_ANTHROPIC_ADMIN_KEY_REF") or DEFAULT_ANTHROPIC_ADMIN_REF
        admin_key = op_read(admin_ref, desktop_session=validate_reference(admin_ref) != DEFAULT_AUTOMATIONS_VAULT)
        workspace_id, _ = get_or_create_anthropic_workspace(admin_key, args.provider_project_name)
    else:
        workspace_id = DEFAULT_ANTHROPIC_AUTOMATIONS_WORKSPACE_ID
    item_title = f"Anthropic - {args.project}"
    env_name = args.env_name or env_name_for(args.project, "ANTHROPIC")
    op_ref = f"op://{args.vault}/{item_title}/credential"
    return RuntimeCredential("anthropic", item_title, env_name, op_ref, workspace_id, secret)


def dry_run_plan(args: argparse.Namespace) -> dict[str, Any]:
    provider_label = {"openai": "OpenAI", "anthropic": "Anthropic"}[args.provider]
    item_title = f"{provider_label} - {args.project}"
    env_name = args.env_name or env_name_for(args.project, args.provider.upper())
    admin_ref = args.admin_key_ref
    if not admin_ref:
        if args.provider == "openai":
            admin_ref = os.environ.get("EPOCH_OPENAI_ADMIN_KEY_REF") or DEFAULT_OPENAI_ADMIN_REF
        else:
            admin_ref = os.environ.get("EPOCH_ANTHROPIC_ADMIN_KEY_REF") or DEFAULT_ANTHROPIC_ADMIN_REF
    if args.provider_resource_id:
        provider_resource = args.provider_resource_id
    elif args.provider_project_name:
        provider_resource = args.provider_project_name
    elif args.provider == "openai":
        provider_resource = DEFAULT_OPENAI_AUTOMATIONS_PROJECT_ID
    else:
        provider_resource = DEFAULT_ANTHROPIC_AUTOMATIONS_WORKSPACE_ID
    verified_cap = args.verified_monthly_spend_cap_usd
    if verified_cap is None:
        policy_status = (
            "blocked: supply a current, authorized project/workspace spend-control assertion"
        )
    elif verified_cap > max_autonomous_cap(args.provider):
        policy_status = (
            f"blocked: verified cap ${verified_cap:g} exceeds "
            f"autonomous maximum ${max_autonomous_cap(args.provider):g}"
        )
    else:
        policy_status = "within helper ceiling; caller assertion only, not provider enforcement"
    return {
        "provider": args.provider,
        "provider_project_or_workspace": provider_resource,
        "provider_key_or_service_account_name": args.key_name or args.project,
        "admin_key_ref": admin_ref,
        "max_autonomous_monthly_spend_usd": max_autonomous_cap(args.provider),
        "verified_monthly_spend_cap_usd": verified_cap,
        "spend_control_basis": "caller assertion; no API verification, per-key allocation or hard-cap enforcement",
        "provider_controls_policy_status": policy_status,
        "item_title": item_title,
        "env_name": env_name,
        "op_ref": f"op://{args.vault}/{item_title}/credential",
        "repo_env_file": str(args.repo / ".env.op") if args.repo else None,
        "will_create_provider_secret": False,
        "will_store_secret": False,
    }


def read_secret_argument(args: argparse.Namespace) -> str:
    if args.secret_file:
        secret = read_regular(Path(args.secret_file), 4096).decode("utf-8").removesuffix("\n")
    elif args.secret_stdin:
        secret = sys.stdin.read(4097).removesuffix("\n")
    else:
        raise ProvisionError(
            "Anthropic workspace creation is supported, but API-key creation is not exposed by the public Admin API. "
            "Create the key in the shared Anthropic Automations workspace "
            f"({DEFAULT_ANTHROPIC_AUTOMATIONS_WORKSPACE_ID}) and pass it with --secret-file or --secret-stdin."
        )
    if not re.fullmatch(r"sk-ant-[A-Za-z0-9_-]{20,1024}", secret):
        raise ProvisionError("Provided secret has an unsupported Anthropic key shape.")
    return secret


def enforce_spend_cap_precondition(args: argparse.Namespace) -> None:
    verified_cap = args.verified_monthly_spend_cap_usd
    if verified_cap is None:
        raise ProvisionError(
            "Refusing to create/store an AI-provider runtime key without an explicit "
            "--verified-monthly-spend-cap-usd assertion backed by current scoped "
            "authority and provider-control readback. The helper does not verify "
            "or enforce a provider cap or allocate per-key spending."
        )
    if not math.isfinite(verified_cap) or verified_cap < 0:
        raise ProvisionError("The asserted spend cap must be finite and nonnegative.")
    if verified_cap > max_autonomous_cap(args.provider):
        raise ProvisionError(
            f"Refusing to create/store an AI-provider runtime key with verified "
            f"monthly spend cap ${verified_cap:g}; helper maximum for "
            f"{args.provider} is ${max_autonomous_cap(args.provider):g}."
        )


def resource_id(value: Any, provider: str) -> str:
    prefix = "proj_" if provider == "openai" else "wrkspc_"
    if not isinstance(value, str) or not re.fullmatch(re.escape(prefix) + r"[A-Za-z0-9_-]{1,120}", value):
        raise ProvisionError("Unsupported provider project/workspace ID.")
    return value


def validate_args(args: argparse.Namespace) -> None:
    if not re.fullmatch(r"[a-z][a-z0-9]*(?:-[a-z0-9]+)*", args.project) or len(args.project) > 63:
        raise ProvisionError("Project must be a lowercase, hyphenated slug of at most 63 characters.")
    if args.vault != DEFAULT_AUTOMATIONS_VAULT:
        raise ProvisionError("Automation runtime keys must use the Automations vault.")
    if args.env_name is not None and not re.fullmatch(r"[A-Z_][A-Z0-9_]{0,127}", args.env_name):
        raise ProvisionError("Invalid environment variable name.")
    if args.provider_resource_id is not None:
        resource_id(args.provider_resource_id, args.provider)
    for value in (args.provider_project_name, args.key_name):
        if value is not None and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9 _.-]{0,79}", value):
            raise ProvisionError("Invalid provider resource/key name.")
    ref = args.admin_key_ref or os.environ.get(f"EPOCH_{args.provider.upper()}_ADMIN_KEY_REF")
    if args.admin_key_ref is not None and not args.admin_key_ref:
        raise ProvisionError("An explicit admin reference must not be empty.")
    if ref:
        validate_reference(ref)
    for path in (args.repo, args.secret_file):
        if path is not None and (not str(path) or any(ord(c) < 32 for c in str(path))):
            raise ProvisionError("Invalid selected file/directory path.")
    if args.provider == "openai" and (args.secret_file is not None or args.secret_stdin):
        raise ProvisionError("OpenAI is mint-only; imported secrets are not supported and will not be read.")
    if args.verified_monthly_spend_cap_usd is not None:
        enforce_spend_cap_precondition(args)


class SafeParser(argparse.ArgumentParser):
    def error(self, message):
        # Argument diagnostics may otherwise repeat a misplaced credential.
        self.exit(2, "Invalid arguments; use --help for the supported options.\n")


def build_parser() -> argparse.ArgumentParser:
    parser = SafeParser(description=__doc__, allow_abbrev=False)
    subparsers = parser.add_subparsers(dest="command", required=True)
    create = subparsers.add_parser("create-automation", help="Create/store an automation runtime key", allow_abbrev=False)
    create.add_argument("--provider", choices=("openai", "anthropic"), required=True)
    create.add_argument("--project", required=True, help="Automation project slug, e.g. automations-dashboard")
    resource = create.add_mutually_exclusive_group()
    resource.add_argument(
        "--provider-project-name",
        help="Override provider project/workspace name; defaults to the shared Automations resource",
    )
    resource.add_argument(
        "--provider-resource-id",
        help="Override provider project/workspace id; defaults to the shared Automations resource",
    )
    create.add_argument("--key-name", help="Provider key/service-account name; defaults to --project")
    create.add_argument("--vault", default=DEFAULT_AUTOMATIONS_VAULT)
    create.add_argument("--admin-key-ref", help="1Password reference for the provider admin/broker key")
    create.add_argument("--env-name", help="Runtime env var name to write to .env.op")
    create.add_argument("--repo", type=Path, help="Repo where .env.op should be created or updated")
    secret = create.add_mutually_exclusive_group()
    secret.add_argument("--secret-file", help="Existing Anthropic key to store (regular file)")
    secret.add_argument("--secret-stdin", action="store_true", help="Read an existing Anthropic key from stdin")
    create.add_argument(
        "--verified-monthly-spend-cap-usd",
        type=float,
        help=(
            "Provider-console verified monthly cap for the target project/workspace. "
            "Required for non-dry-run key creation/storage and must be at or below "
            "the retained helper ceiling ($500 OpenAI, $2000 Anthropic). "
            "Caller assertion only; not a per-key hard cap or API enforcement."
        ),
    )
    create.add_argument("--dry-run", action="store_true", help="Print a pure plan; do not read secrets, query accounts or create/store anything")
    create.add_argument("--force", action="store_true", help="Replace existing 1Password field/.env.op entry")
    return parser


def main() -> int:
    options = [arg.split("=", 1)[0] for arg in sys.argv[1:] if arg.startswith("--")]
    if len(options) != len(set(options)):
        print("ERROR: Repeated options are not supported.", file=sys.stderr)
        return 2
    args = build_parser().parse_args()
    if args.command != "create-automation":
        raise AssertionError(args.command)
    side_effects_possible = False
    try:
        validate_args(args)
        if args.dry_run:
            print(json.dumps(dry_run_plan(args), indent=2, sort_keys=True))
            return 0
        enforce_spend_cap_precondition(args)
        # Validate/import before any admin lookup, biometric broker or mutation.
        if args.provider == "anthropic":
            args.imported_secret = read_secret_argument(args)
        plan = dry_run_plan(args)
        env_plan = prepare_env(args.repo, plan["env_name"], plan["op_ref"], force=args.force) if args.repo else None
        item_plan = prepare_item(plan["item_title"], args.vault, force=args.force)
        ensure_desktop_op_session()
        side_effects_possible = True
        if args.provider == "openai":
            credential = create_openai(args)
        else:
            credential = create_anthropic(args)
        reference = create_or_update_automation_item(credential, args.vault, force=args.force, prepared=item_plan)
        credential = replace(credential, op_ref=reference)
        if args.repo:
            write_env_op(args.repo, credential.env_name, credential.op_ref, force=args.force, prepared=env_plan)
        print(f"stored {credential.op_ref}")
        if args.repo:
            print(f"updated {args.repo / '.env.op'}")
        return 0
    except ProvisionError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        if side_effects_possible:
            print("Provider/store side effects may exist. Reconcile selected identities before retrying; no automatic rollback was attempted.", file=sys.stderr)
        return 1
    except (OSError, UnicodeError, ValueError, TypeError):
        print("ERROR: Unsupported input or local I/O failure; details withheld.", file=sys.stderr)
        if side_effects_possible:
            print("Side effects may exist; reconcile before retrying.", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
