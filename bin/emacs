#!/bin/bash
# Wrapper to launch Emacs.app with profile support.

EMACS_BIN="/Applications/Emacs.app/Contents/MacOS/Emacs"
PROFILES_DIR="$HOME/.config/emacs-profiles"
PROFILE=""
ARGS=()

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -p|--profile)
            PROFILE="$2"
            shift 2
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

# The GNotificationCenterDelegate warning this used to filter came from a
# second GLib that jinx's module loaded; jinx-extras now relinks the module to
# Emacs.app's GLib (bin/jinx-enchant-relink), so the warning is left visible.
if [[ -n "$PROFILE" ]]; then
    exec "$EMACS_BIN" --init-directory="$PROFILES_DIR/$PROFILE" "${ARGS[@]}"
else
    exec "$EMACS_BIN" "${ARGS[@]}"
fi
