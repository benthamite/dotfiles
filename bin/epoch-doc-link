#!/usr/bin/env python3
"""Create and open fail-closed Epoch Google document links."""

from __future__ import annotations

import argparse
import errno
import os
import re
import secrets
import stat
import subprocess
import sys
from pathlib import Path


DOC_ID_RE = re.compile(r"^[A-Za-z0-9_-]+$")
URL_PREFIX = "epoch-doc:///document/"
PROFILE_ALIAS = "epoch"
PROFILE_OPENER = Path.home() / "bin" / "chrome-profile-open"


class LinkError(Exception):
    """Raised when a shortcut is malformed or unsafe."""


def validate_doc_id(value: str) -> str:
    if not DOC_ID_RE.fullmatch(value):
        raise LinkError(f"Invalid Google document ID: {value!r}")
    return value


def link_url(document_id: str) -> str:
    return URL_PREFIX + validate_doc_id(document_id)


def document_url(document_id: str) -> str:
    validated = validate_doc_id(document_id)
    return f"https://docs.google.com/document/d/{validated}/edit"


def shortcut_text(document_id: str) -> str:
    return f"[InternetShortcut]\nURL={link_url(document_id)}\n"


def parse_link_url(value: str) -> str:
    if not value.startswith(URL_PREFIX):
        raise LinkError("Expected epoch-doc:///document/DOC_ID")
    document_id = validate_doc_id(value[len(URL_PREFIX) :])
    if value != link_url(document_id):
        raise LinkError("Epoch document URL is not in canonical form")
    return document_id


def file_identity(metadata: os.stat_result) -> tuple[int, int]:
    return metadata.st_dev, metadata.st_ino


def file_state(metadata: os.stat_result) -> tuple[int, ...]:
    return (*file_identity(metadata), metadata.st_mode, metadata.st_size,
            metadata.st_mtime_ns, metadata.st_ctime_ns)


def verify_parent(destination: Path, directory: int) -> None:
    if file_identity(os.stat(destination.parent)) != file_identity(os.fstat(directory)):
        raise LinkError(f"Destination directory changed during creation: {destination.parent}")


def inspect_shortcut(destination: Path, directory: int, content: bytes,
                     expected_identity: tuple[int, int] | None = None) -> bool:
    """Read one regular file without following a replaced shortcut path."""
    try:
        descriptor = os.open(destination.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                             dir_fd=directory)
    except FileNotFoundError:
        return False
    except OSError as error:
        if error.errno == errno.ELOOP:
            raise LinkError(f"Refusing to replace symlink: {destination}") from error
        raise
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode):
            raise LinkError(f"Refusing to replace non-file: {destination}")
        with os.fdopen(descriptor, "rb", closefd=False) as handle:
            if handle.read(len(content) + 1) != content:
                raise LinkError(f"Refusing to replace different regular file: {destination}")
        if stat.S_IMODE(before.st_mode) != 0o644:
            raise LinkError(f"Existing shortcut has unexpected mode: {destination}")
        after = os.fstat(descriptor)
        current = os.stat(destination.name, dir_fd=directory, follow_symlinks=False)
        if (file_state(before) != file_state(after) or file_state(after) != file_state(current)
                or (expected_identity is not None and file_identity(after) != expected_identity)):
            raise LinkError(f"Shortcut changed during verification: {destination}")
    finally:
        os.close(descriptor)
    return True


def create_shortcut(document_id: str, destination: Path) -> None:
    if destination.suffix != ".url":
        raise LinkError("Shortcut destination must end in .url")
    content = shortcut_text(document_id).encode("ascii")
    try:
        try:
            parent_before = os.stat(destination.parent)
            directory = os.open(destination.parent, os.O_RDONLY | os.O_DIRECTORY)
        except (FileNotFoundError, NotADirectoryError) as error:
            raise LinkError(f"Destination directory does not exist: {destination.parent}") from error
        try:
            if file_identity(parent_before) != file_identity(os.fstat(directory)):
                raise LinkError(f"Destination directory changed during creation: {destination.parent}")
            verify_parent(destination, directory)
            if inspect_shortcut(destination, directory, content):
                verify_parent(destination, directory)
                return

            # Every write and cleanup stays anchored to this directory even if
            # its pathname is renamed or replaced by a symlink concurrently.
            temporary = f".{destination.name}.{secrets.token_hex(12)}"
            descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                                 0o600, dir_fd=directory)
            with os.fdopen(descriptor, "wb") as handle:
                temporary_identity = file_identity(os.fstat(handle.fileno()))
                try:
                    handle.write(content)
                    handle.flush()
                    os.fchmod(handle.fileno(), 0o644)
                    os.fsync(handle.fileno())
                    created = os.fstat(handle.fileno())
                    verify_parent(destination, directory)
                    current = os.stat(temporary, dir_fd=directory, follow_symlinks=False)
                    if file_state(created) != file_state(current):
                        raise LinkError(f"Temporary shortcut changed during creation: {destination}")
                    try:
                        os.link(temporary, destination.name, src_dir_fd=directory,
                                dst_dir_fd=directory, follow_symlinks=False)
                    except FileExistsError as error:
                        raise LinkError(f"Destination appeared during shortcut creation: {destination}") from error
                    if not inspect_shortcut(destination, directory, content, file_identity(created)):
                        raise LinkError(f"Shortcut disappeared during verification: {destination}")
                    verify_parent(destination, directory)
                finally:
                    # Keep the original inode open through cleanup. Do not
                    # delete a temporary name replaced by another writer, or a
                    # published destination after failed readback.
                    try:
                        current = os.stat(temporary, dir_fd=directory, follow_symlinks=False)
                    except FileNotFoundError as error:
                        raise LinkError(f"Temporary shortcut disappeared during creation: {destination}") from error
                    if file_identity(current) != temporary_identity:
                        raise LinkError(f"Temporary shortcut changed; leaving replacement untouched: {destination}")
                    os.unlink(temporary, dir_fd=directory)
        finally:
            os.close(directory)
    except OSError as error:
        raise LinkError(f"Cannot create or verify shortcut {destination}: {error.strerror or error}") from error


def open_shortcut(value: str, opener: Path = PROFILE_OPENER) -> int:
    document_id = parse_link_url(value)
    command = [str(opener), PROFILE_ALIAS, document_url(document_id)]
    try:
        return subprocess.run(command, check=False).returncode
    except OSError as error:
        raise LinkError(f"Cannot run profile opener: {error}") from error


def create_link(document_id: str, destination: Path | str) -> None:
    """Compatibility name for callers that describe the file as a link."""
    create_shortcut(document_id, Path(destination))


def doc_id_from_url(value: str) -> str:
    """Compatibility name for the strict URL parser."""
    return parse_link_url(value)


def open_link(value: str) -> int:
    """Open through the configured Epoch profile opener."""
    return open_shortcut(value)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Create or open an Epoch Google document link."
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    create = subparsers.add_parser("create")
    create.add_argument("document_id")
    create.add_argument("destination", type=Path)
    open_parser = subparsers.add_parser("open")
    open_parser.add_argument("url")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(sys.argv[1:] if argv is None else argv)
    try:
        if args.command == "create":
            create_shortcut(args.document_id, args.destination)
            return 0
        return open_shortcut(args.url)
    except LinkError as error:
        print(f"epoch-doc-link: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
