#!/usr/bin/env python3
"""Fail-closed tooling for migrating repositories out of Google Drive.

This module provides the migration manifest data model with its strict
loader, plus a strictly read-only audit layer.  Manifest loading is
structural only: it never calls Git, never requires a source to exist on
disk, and never mutates anything.  Every schema violation raises
ManifestError; nothing is warned about and then accepted.

The remote-coverage gate proves that every commit that matters (HEADs,
branches, tags, stash, submodule HEADs) is reachable from a ref some
remote advertises, before any move is allowed.  It is the sole exception
to pure reads: advertised refs are fetched into a run-scoped
refs/drive-workspace-audit/<run-id>/ namespace that is deleted in a
finally path, with every pre-existing ref verified byte-identical
afterwards.  There is no push path and no waiver option.

The audit layer observes filesystem and Git state without mutating either:
traversal never follows a symlink, Git is invoked read-only with optional
locks disabled, and every unreadable path is an error rather than an empty
success.  The audit payload is canonical (sorted records and keys, no
timestamps or other volatile fields) so two audits of unchanged state are
byte-identical; volatile observation metadata belongs only in an external
journal event wrapper.
"""

from __future__ import annotations

import argparse
import difflib
import fcntl
import hashlib
import json
import os
import re
import shutil
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path
from types import MappingProxyType

TRANSACTION_TMP = "{transaction_tmp}"
PLACEHOLDER_RE = re.compile(r"\{[^{}]*\}")
ENV_NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
ENV_ASSIGNMENT_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
SHELL_NAMES = {"sh", "bash", "zsh", "dash", "ksh"}
SHELL_OPERATORS = ("&&", "||", ";", "|", ">", "<", "`", "$(", "\n")

MANIFEST_KEYS = {
    "version", "drive_root", "repos_root", "epoch_repos_root",
    "worktrees_root", "state_root", "workspaces",
}
WORKSPACE_KEYS = {
    "name", "group", "kind", "source", "destination", "git_roots",
    "expected_symlinks", "links", "consumers", "smoke", "runtime_services",
}
WORKTREE_KEYS = {
    "name", "group", "kind", "source", "destination", "owner", "branch",
    "expected_symlinks", "consumers", "smoke",
}
LINK_KEYS = {
    "path", "lstat_type", "lstat_mode", "link_text",
    "disposition", "target_policy", "post_smoke_type",
}
SMOKE_KEYS = {"cwd", "argv", "env"}
CONSUMER_KEYS = {"name", "kind", "path", "old", "new", "count", "session_adapter"}
CONSUMER_REQUIRED_KEYS = CONSUMER_KEYS - {"session_adapter"}
RUNTIME_SERVICE_KEYS = {"name", "cwd", "argv", "port", "http"}
HTTP_JSON_KEYS = {"json_keys"}
HTTP_MARKER_KEYS = {"status", "content_marker"}

GROUPS = {"personal", "worktree"}
KINDS = {"workspace", "linked_worktree"}
LSTAT_TYPES = {"symlink", "directory", "file"}
DISPOSITIONS = {"preserve_link", "materialize_generated_directory"}
TARGET_POLICIES = {"retain", "disposable"}
POST_SMOKE_TYPES = {"link", "directory", "absent"}
POST_SMOKE_BY_DISPOSITION = {
    "preserve_link": {"link"},
    "materialize_generated_directory": {"directory", "absent"},
}
TARGET_POLICY_BY_DISPOSITION = {
    "preserve_link": "retain",
    "materialize_generated_directory": "disposable",
}


class ManifestError(ValueError):
    """A manifest failed structural validation."""


def _fail(context: str, message: str) -> None:
    raise ManifestError(f"Manifest {context}: {message}")


def _require_keys(raw: dict, allowed: set, required: set, context: str) -> None:
    if not isinstance(raw, dict):
        _fail(context, "must be a JSON object")
    unknown = sorted(set(raw) - allowed)
    if unknown:
        _fail(context, f"contains unknown keys: {', '.join(unknown)}")
    missing = sorted(required - set(raw))
    if missing:
        _fail(context, f"is missing required keys: {', '.join(missing)}")


def _require_string(value, context: str) -> str:
    if not isinstance(value, str) or not value:
        _fail(context, "must be a nonempty string")
    return value


def _require_tilde_path(value, context: str) -> str:
    _require_string(value, context)
    if not value.startswith("~/"):
        _fail(context, "must be a raw '~/'-prefixed path")
    if not Path(value).expanduser().is_absolute():
        _fail(context, "must expand to an absolute path")
    return value


def _expanded(raw_path: str) -> str:
    return os.path.normpath(os.path.expanduser(raw_path))


def _is_within(candidate: str, root: str) -> bool:
    return candidate == root or candidate.startswith(root + os.sep)


def _require_relative_path(value, context: str) -> str:
    _require_string(value, context)
    if value.startswith(("/", "~")):
        _fail(context, "must be a relative path")
    parts = value.split("/")
    if value != ".":
        if "" in parts or "." in parts or ".." in parts:
            _fail(context, "must be a normalized relative path without '.' or '..'")
    return value


def _reject_placeholders(value: str, context: str) -> None:
    if TRANSACTION_TMP in value:
        _fail(context, f"must not contain the {TRANSACTION_TMP} placeholder")


def _validate_argv(argv, context: str) -> tuple:
    """Validate one exec argument array; reject every shell-string escape."""
    if not isinstance(argv, list) or not argv:
        _fail(context, "argv must be a nonempty array")
    for index, arg in enumerate(argv):
        arg_context = f"{context} argv[{index}]"
        _require_string(arg, arg_context)
        _reject_placeholders(arg, arg_context)
        for operator in SHELL_OPERATORS:
            if operator in arg:
                _fail(arg_context, f"must not contain shell operator {operator!r}")
        if ENV_ASSIGNMENT_RE.match(arg):
            _fail(arg_context, "must not encode an environment assignment")
        if "/tmp/uv-cache" in arg:
            _fail(arg_context, "must not name a shared /tmp/uv-cache")
    if argv[0] == "cd":
        _fail(context, "argv must not encode a 'cd' command")
    if Path(argv[0]).name == "env":
        _fail(context, "argv must not use an 'env' wrapper; declare env in the env object")
    if Path(argv[0]).name in SHELL_NAMES and "-c" in argv[1:]:
        _fail(context, "argv must not invoke a shell with a command string")
    return tuple(argv)


@dataclass(frozen=True)
class Smoke:
    """One smoke command: a structured record, never a shell string."""

    cwd: str
    argv: tuple
    env: MappingProxyType
    raw: dict = field(compare=False)

    @staticmethod
    def load(raw: dict, context: str) -> "Smoke":
        _require_keys(raw, SMOKE_KEYS, SMOKE_KEYS, context)
        cwd = _require_relative_path(raw["cwd"], f"{context} cwd")
        _reject_placeholders(raw["cwd"], f"{context} cwd")
        argv = _validate_argv(raw["argv"], context)
        env = raw["env"]
        if not isinstance(env, dict):
            _fail(context, "env must be an object")
        for name, value in env.items():
            env_context = f"{context} env[{name!r}]"
            if not isinstance(name, str) or not ENV_NAME_RE.match(name):
                _fail(context, f"env name is invalid: {name!r}")
            _require_string(value, env_context)
            for match in PLACEHOLDER_RE.findall(value):
                if match != TRANSACTION_TMP:
                    _fail(env_context, f"uses unsupported placeholder {match!r}")
            if "/tmp/uv-cache" in value:
                _fail(env_context, "must not name a shared /tmp/uv-cache")
        return Smoke(
            cwd=cwd,
            argv=tuple(argv),
            env=MappingProxyType(dict(env)),
            raw=raw,
        )


@dataclass(frozen=True)
class Link:
    """One captured symlink disposition record."""

    path: str
    lstat_type: str
    lstat_mode: str
    link_text: str
    disposition: str
    target_policy: str
    post_smoke_type: str
    raw: dict = field(compare=False)

    @staticmethod
    def load(raw: dict, context: str) -> "Link":
        _require_keys(raw, LINK_KEYS, LINK_KEYS, context)
        path = _require_relative_path(raw["path"], f"{context} path")
        if path == ".":
            _fail(context, "path must name an entry inside the workspace")
        lstat_type = _require_string(raw["lstat_type"], f"{context} lstat_type")
        if lstat_type not in LSTAT_TYPES:
            _fail(context, f"lstat_type must be one of: {', '.join(sorted(LSTAT_TYPES))}")
        lstat_mode = _require_string(raw["lstat_mode"], f"{context} lstat_mode")
        if not re.fullmatch(r"0o[0-7]{3,4}", lstat_mode):
            _fail(context, "lstat_mode must be an octal mode string like '0o755'")
        link_text = _require_string(raw["link_text"], f"{context} link_text")
        disposition = _require_string(raw["disposition"], f"{context} disposition")
        if disposition not in DISPOSITIONS:
            _fail(context, f"disposition must be one of: {', '.join(sorted(DISPOSITIONS))}")
        target_policy = _require_string(raw["target_policy"], f"{context} target_policy")
        if target_policy != TARGET_POLICY_BY_DISPOSITION[disposition]:
            _fail(
                context,
                f"target_policy {target_policy!r} contradicts disposition {disposition!r}",
            )
        post_smoke_type = _require_string(raw["post_smoke_type"], f"{context} post_smoke_type")
        if post_smoke_type not in POST_SMOKE_TYPES:
            _fail(
                context,
                f"post_smoke_type must be one of: {', '.join(sorted(POST_SMOKE_TYPES))}",
            )
        if post_smoke_type not in POST_SMOKE_BY_DISPOSITION[disposition]:
            _fail(
                context,
                f"post_smoke_type {post_smoke_type!r} contradicts disposition {disposition!r}",
            )
        return Link(
            path=path,
            lstat_type=lstat_type,
            lstat_mode=lstat_mode,
            link_text=link_text,
            disposition=disposition,
            target_policy=target_policy,
            post_smoke_type=post_smoke_type,
            raw=raw,
        )


@dataclass(frozen=True)
class Consumer:
    """One external configuration record that names the workspace path."""

    name: str
    kind: str
    path: str
    old: str
    new: str
    count: int
    session_adapter: str | None
    raw: dict = field(compare=False)

    @staticmethod
    def load(raw: dict, context: str) -> "Consumer":
        _require_keys(raw, CONSUMER_KEYS, CONSUMER_REQUIRED_KEYS, context)
        name = _require_string(raw["name"], f"{context} name")
        kind = _require_string(raw["kind"], f"{context} kind")
        path = _require_string(raw["path"], f"{context} path")
        old = _require_string(raw["old"], f"{context} old")
        new = _require_string(raw["new"], f"{context} new")
        if old == new:
            _fail(context, "old and new values must differ")
        count = raw["count"]
        if not isinstance(count, int) or isinstance(count, bool) or count < 1:
            _fail(context, "count must be a positive integer")
        session_adapter = raw.get("session_adapter")
        if session_adapter is not None:
            _require_string(session_adapter, f"{context} session_adapter")
        return Consumer(
            name=name,
            kind=kind,
            path=path,
            old=old,
            new=new,
            count=count,
            session_adapter=session_adapter,
            raw=raw,
        )


@dataclass(frozen=True)
class RuntimeService:
    """One long-running service with a structured HTTP verification."""

    name: str
    cwd: str
    argv: tuple
    port: int
    http: MappingProxyType
    raw: dict = field(compare=False)

    @staticmethod
    def load(raw: dict, context: str) -> "RuntimeService":
        _require_keys(raw, RUNTIME_SERVICE_KEYS, RUNTIME_SERVICE_KEYS, context)
        name = _require_string(raw["name"], f"{context} name")
        cwd = _require_relative_path(raw["cwd"], f"{context} cwd")
        argv = _validate_argv(raw["argv"], context)
        port = raw["port"]
        if not isinstance(port, int) or isinstance(port, bool) or not 1 <= port <= 65535:
            _fail(context, "port must be an integer between 1 and 65535")
        http = raw["http"]
        if not isinstance(http, dict):
            _fail(context, "http must be an object")
        if set(http) == HTTP_JSON_KEYS:
            keys = http["json_keys"]
            if (
                not isinstance(keys, list)
                or not keys
                or not all(isinstance(key, str) and key for key in keys)
            ):
                _fail(context, "http json_keys must be a nonempty array of strings")
        elif set(http) == HTTP_MARKER_KEYS:
            if http["status"] != 200:
                _fail(context, "http status must be exactly 200")
            _require_string(http["content_marker"], f"{context} http content_marker")
        else:
            _fail(
                context,
                "http must contain exactly json_keys, or exactly status and content_marker",
            )
        return RuntimeService(
            name=name,
            cwd=cwd,
            argv=tuple(argv),
            port=port,
            http=MappingProxyType(dict(http)),
            raw=raw,
        )


@dataclass(frozen=True)
class Workspace:
    """One migration transaction: a workspace or a linked worktree."""

    name: str
    group: str
    kind: str
    source: str
    destination: str
    expected_symlinks: int
    git_roots: tuple
    links: tuple
    consumers: tuple
    smoke: tuple
    runtime_services: tuple
    owner: str | None
    branch: str | None
    raw: dict = field(compare=False)

    @property
    def source_path(self) -> Path:
        return Path(self.source).expanduser()

    @property
    def destination_path(self) -> Path:
        return Path(self.destination).expanduser()

    @property
    def owner_path(self) -> Path | None:
        return None if self.owner is None else Path(self.owner).expanduser()

    @staticmethod
    def load(raw: dict, drive_root: str, index: int) -> "Workspace":
        context = f"workspaces[{index}]"
        if not isinstance(raw, dict):
            _fail(context, "must be a JSON object")
        if "wuzapi" in json.dumps(raw):
            _fail(context, "must not contain 'wuzapi'")
        kind = raw.get("kind")
        if kind not in KINDS:
            _fail(context, f"kind must be one of: {', '.join(sorted(KINDS))}")
        if kind == "workspace":
            required = WORKSPACE_KEYS - {"runtime_services"}
            _require_keys(raw, WORKSPACE_KEYS, required, context)
        else:
            _require_keys(raw, WORKTREE_KEYS, WORKTREE_KEYS, context)

        name = _require_string(raw["name"], f"{context} name")
        context = f"workspace {name!r}"
        group = _require_string(raw["group"], f"{context} group")
        if group not in GROUPS:
            _fail(context, f"group must be one of: {', '.join(sorted(GROUPS))}")
        source = _require_tilde_path(raw["source"], f"{context} source")
        destination = _require_tilde_path(raw["destination"], f"{context} destination")
        drive = _expanded(drive_root)
        if not _is_within(_expanded(source), drive):
            _fail(context, f"source must be inside {drive_root}")
        if _is_within(_expanded(destination), drive):
            _fail(context, f"destination must be outside {drive_root}")

        expected_symlinks = raw["expected_symlinks"]
        if (
            not isinstance(expected_symlinks, int)
            or isinstance(expected_symlinks, bool)
            or expected_symlinks < 0
        ):
            _fail(context, "expected_symlinks must be a non-negative integer")

        owner = None
        branch = None
        git_roots: tuple = ()
        links: tuple = ()
        runtime_services: tuple = ()
        if kind == "workspace":
            raw_git_roots = raw["git_roots"]
            if not isinstance(raw_git_roots, list) or not raw_git_roots:
                _fail(context, "git_roots must be a nonempty array")
            for position, root in enumerate(raw_git_roots):
                _require_relative_path(root, f"{context} git_roots[{position}]")
            if len(set(raw_git_roots)) != len(raw_git_roots):
                _fail(context, "git_roots must not repeat entries")
            git_roots = tuple(raw_git_roots)

            raw_links = raw["links"]
            if not isinstance(raw_links, list):
                _fail(context, "links must be an array of records, not a count")
            links = tuple(
                Link.load(link, f"{context} links[{position}]")
                for position, link in enumerate(raw_links)
            )
            if len(links) != expected_symlinks:
                _fail(
                    context,
                    f"expected_symlinks is {expected_symlinks} "
                    f"but links contains {len(links)} records",
                )
            seen_paths = [link.path for link in links]
            if len(set(seen_paths)) != len(seen_paths):
                _fail(context, "links must not repeat a path")
            for link in links:
                for other in links:
                    if link is not other and other.path.startswith(link.path + "/"):
                        _fail(
                            context,
                            f"links overlap: {link.path!r} contains {other.path!r}",
                        )
            if "runtime_services" in raw:
                raw_services = raw["runtime_services"]
                if not isinstance(raw_services, list) or not raw_services:
                    _fail(context, "runtime_services must be a nonempty array")
                runtime_services = tuple(
                    RuntimeService.load(service, f"{context} runtime_services[{position}]")
                    for position, service in enumerate(raw_services)
                )
                service_names = [service.name for service in runtime_services]
                if len(set(service_names)) != len(service_names):
                    _fail(context, "runtime_services must not repeat a name")
        else:
            owner = _require_tilde_path(raw["owner"], f"{context} owner")
            if not _is_within(_expanded(owner), drive):
                _fail(context, f"owner must be inside {drive_root}")
            branch = _require_string(raw["branch"], f"{context} branch")
            if expected_symlinks != 0:
                _fail(context, "a linked worktree must declare zero expected symlinks")

        raw_consumers = raw["consumers"]
        if not isinstance(raw_consumers, list):
            _fail(context, "consumers must be an array")
        consumers = tuple(
            Consumer.load(consumer, f"{context} consumers[{position}]")
            for position, consumer in enumerate(raw_consumers)
        )
        consumer_names = [consumer.name for consumer in consumers]
        if len(set(consumer_names)) != len(consumer_names):
            _fail(context, "consumers must not repeat a name")

        raw_smoke = raw["smoke"]
        if not isinstance(raw_smoke, list) or not raw_smoke:
            _fail(context, "smoke must be a nonempty array")
        smoke = tuple(
            Smoke.load(record, f"{context} smoke[{position}]")
            for position, record in enumerate(raw_smoke)
        )

        return Workspace(
            name=name,
            group=group,
            kind=kind,
            source=source,
            destination=destination,
            expected_symlinks=expected_symlinks,
            git_roots=git_roots,
            links=links,
            consumers=consumers,
            smoke=smoke,
            runtime_services=runtime_services,
            owner=owner,
            branch=branch,
            raw=raw,
        )


@dataclass(frozen=True)
class Manifest:
    """The validated migration manifest, with raw '~' forms preserved."""

    version: int
    drive_root: str
    repos_root: str
    epoch_repos_root: str
    worktrees_root: str
    state_root: str
    workspaces: tuple
    raw: dict = field(compare=False)

    @property
    def drive_root_path(self) -> Path:
        return Path(self.drive_root).expanduser()

    @property
    def state_root_path(self) -> Path:
        return Path(self.state_root).expanduser()

    def by_name(self, name: str) -> Workspace:
        for workspace in self.workspaces:
            if workspace.name == name:
                return workspace
        raise KeyError(f"Manifest has no workspace named {name!r}")


def load_manifest(path: Path) -> Manifest:
    """Load and structurally validate the migration manifest.

    Raises ManifestError on any schema violation.  Never calls Git and
    never requires a declared source to exist on disk.
    """
    try:
        raw = json.loads(Path(path).read_text(encoding="utf-8"))
    except OSError as error:
        raise ManifestError(f"Manifest could not be read: {path} ({error})") from error
    except json.JSONDecodeError as error:
        raise ManifestError(f"Manifest is not valid JSON: {path} ({error})") from error

    _require_keys(raw, MANIFEST_KEYS, MANIFEST_KEYS, "document")
    if raw["version"] != 1:
        _fail("document", "version must be exactly 1")
    drive_root = _require_tilde_path(raw["drive_root"], "document drive_root")
    repos_root = _require_tilde_path(raw["repos_root"], "document repos_root")
    epoch_repos_root = _require_tilde_path(
        raw["epoch_repos_root"], "document epoch_repos_root"
    )
    worktrees_root = _require_tilde_path(
        raw["worktrees_root"], "document worktrees_root"
    )
    state_root = _require_tilde_path(raw["state_root"], "document state_root")
    drive = _expanded(drive_root)
    for label, root in (
        ("repos_root", repos_root),
        ("epoch_repos_root", epoch_repos_root),
        ("worktrees_root", worktrees_root),
        ("state_root", state_root),
    ):
        if _is_within(_expanded(root), drive):
            _fail("document", f"{label} must be outside {drive_root}")

    raw_workspaces = raw["workspaces"]
    if not isinstance(raw_workspaces, list) or not raw_workspaces:
        _fail("document", "workspaces must be a nonempty array")
    workspaces = tuple(
        Workspace.load(entry, drive_root, index)
        for index, entry in enumerate(raw_workspaces)
    )

    names = [workspace.name for workspace in workspaces]
    duplicate_names = sorted({name for name in names if names.count(name) > 1})
    if duplicate_names:
        _fail("document", f"workspace names are duplicated: {', '.join(duplicate_names)}")
    destinations = [workspace.destination for workspace in workspaces]
    duplicate_destinations = sorted(
        {value for value in destinations if destinations.count(value) > 1}
    )
    if duplicate_destinations:
        _fail(
            "document",
            f"workspace destinations are duplicated: {', '.join(duplicate_destinations)}",
        )

    return Manifest(
        version=raw["version"],
        drive_root=drive_root,
        repos_root=repos_root,
        epoch_repos_root=epoch_repos_root,
        worktrees_root=worktrees_root,
        state_root=state_root,
        workspaces=workspaces,
        raw=raw,
    )


class AuditError(RuntimeError):
    """A read-only audit could not observe state completely."""


def _scan_sorted(directory: Path) -> list[os.DirEntry]:
    """List one directory's entries sorted by name, failing closed.

    An unreadable directory raises AuditError; it is never reported as an
    empty (successful) listing.
    """
    try:
        with os.scandir(directory) as entries:
            return sorted(entries, key=lambda entry: entry.name)
    except OSError as error:
        raise AuditError(
            f"Audit cannot read directory: {directory} ({error})"
        ) from error


def scan_symlinks(root: Path) -> list[str]:
    """Report every symlink under root without ever following one.

    Traversal uses os.scandir() and recurses only into real directories
    (entry.is_dir(follow_symlinks=False)); a symlink is recorded and never
    entered.  Returns sorted absolute paths.
    """
    root = Path(root)
    found: list[str] = []
    pending = [root]
    while pending:
        directory = pending.pop()
        for entry in _scan_sorted(directory):
            try:
                if entry.is_symlink():
                    found.append(entry.path)
                elif entry.is_dir(follow_symlinks=False):
                    pending.append(Path(entry.path))
            except OSError as error:
                raise AuditError(
                    f"Audit cannot classify entry: {entry.path} ({error})"
                ) from error
    return sorted(found)


def _sha256_file(path: Path) -> str:
    """Hash one regular file; any read error is a blocker, never skipped."""
    digest = hashlib.sha256()
    try:
        with open(path, "rb") as handle:
            for chunk in iter(lambda: handle.read(1 << 20), b""):
                digest.update(chunk)
    except OSError as error:
        raise AuditError(f"Audit cannot hash file: {path} ({error})") from error
    return digest.hexdigest()


def audit_filesystem(root: Path) -> list[dict]:
    """Record every entry under root for the journal representation.

    Each record carries the filesystem device ID, file mode, link target
    for symlinks, and SHA-256 hash for regular files.  Traversal never
    follows a symlink, and every unreadable path raises AuditError.
    Records are sorted by path so the output is deterministic.
    """
    root = Path(root)
    records: list[dict] = []
    pending = [root]
    while pending:
        directory = pending.pop()
        for entry in _scan_sorted(directory):
            path = Path(entry.path)
            try:
                info = os.lstat(path)
            except OSError as error:
                raise AuditError(f"Audit cannot stat: {path} ({error})") from error
            record = {
                "path": path.relative_to(root).as_posix(),
                "dev": info.st_dev,
                "mode": f"0o{stat.S_IMODE(info.st_mode):o}",
            }
            if stat.S_ISLNK(info.st_mode):
                record["type"] = "symlink"
                try:
                    record["link_target"] = os.readlink(path)
                except OSError as error:
                    raise AuditError(
                        f"Audit cannot read link: {path} ({error})"
                    ) from error
            elif stat.S_ISDIR(info.st_mode):
                record["type"] = "directory"
                pending.append(path)
            elif stat.S_ISREG(info.st_mode):
                record["type"] = "file"
                record["size"] = info.st_size
                record["sha256"] = _sha256_file(path)
            else:
                record["type"] = "other"
            records.append(record)
    return sorted(records, key=lambda record: record["path"])


def _run_git(repo: Path, args: tuple, stdin_text: str | None = None) -> str:
    """Shared fail-closed core for every Git invocation in this module.

    shell=False and check=True always; GIT_OPTIONAL_LOCKS=0 keeps even
    `git status` from touching the index.  Output is decoded as strict
    UTF-8 regardless of locale so results cannot vary by environment;
    non-UTF-8 output is an AuditError, never a raw UnicodeDecodeError.
    """
    command = ["git", "-C", str(repo), *args]
    env = dict(os.environ, GIT_OPTIONAL_LOCKS="0")
    try:
        completed = subprocess.run(
            command,
            shell=False,
            check=True,
            capture_output=True,
            encoding="utf-8",
            errors="strict",
            env=env,
            input=stdin_text,
        )
    except FileNotFoundError as error:
        raise AuditError(f"Audit cannot find git: {error}") from error
    except subprocess.CalledProcessError as error:
        detail = (error.stderr or "").strip()
        raise AuditError(
            f"Audit git command failed: {' '.join(command)} ({detail})"
        ) from error
    except UnicodeDecodeError as error:
        raise AuditError(
            f"Audit git output is not valid UTF-8: {' '.join(command)} ({error})"
        ) from error
    return completed.stdout


def _git_read(repo: Path, *args: str) -> str:
    """Run one read-only Git command and return its stdout.

    Observation never mutates the repository; see _run_git for the
    fail-closed execution contract.  Commands that write refs must use
    _git_write_audit_refs instead, never this helper.
    """
    return _run_git(repo, args)


def _git_write_audit_refs(
    repo: Path, *args: str, stdin_text: str | None = None
) -> str:
    """Run one Git command that WRITES refs for the coverage audit.

    Deliberately named apart from _git_read: the only writes this module
    ever performs are the run-scoped refs/drive-workspace-audit/<run-id>/
    namespace lifecycle -- fetching advertised remote refs into it and
    deleting exactly that namespace afterwards.  Same fail-closed
    execution contract as _run_git.
    """
    return _run_git(repo, args, stdin_text=stdin_text)


def snapshot_git(repo: Path) -> dict:
    """Snapshot one repository's observable Git state, read-only.

    Output is NUL-delimited where Git supports it and contains no
    timestamps or other volatile fields, so an unchanged repository
    snapshots identically.
    """
    repo = Path(repo)
    return {
        "head": _git_read(repo, "rev-parse", "HEAD"),
        "branch": _git_read(repo, "branch", "--show-current"),
        "refs": _git_read(repo, "for-each-ref", "--format=%(refname)%00%(objectname)"),
        "status_porcelain_v2": _git_read(repo, "status", "--porcelain=v2", "-z"),
        "untracked": _git_read(repo, "ls-files", "--others", "--exclude-standard", "-z"),
        "ignored": _git_read(
            repo, "ls-files", "--others", "--ignored", "--exclude-standard", "-z"
        ),
        "worktrees": _git_read(repo, "worktree", "list", "--porcelain"),
        "submodules": _git_read(repo, "submodule", "status", "--recursive"),
        "symlinks": scan_symlinks(repo),
    }


AUDIT_REF_ROOT = "refs/drive-workspace-audit"


def _is_ancestor(repo: Path, ancestor: str, descendant: str) -> bool:
    """Report whether ancestor is reachable from descendant.

    `git merge-base --is-ancestor` answers with exit code 1 for "no",
    which is the only non-error failure; every other nonzero exit is an
    AuditError, so a missing object can never read as "not covered but
    fine" -- it fails the audit outright.
    """
    command = [
        "git", "-C", str(repo), "merge-base", "--is-ancestor",
        ancestor, descendant,
    ]
    env = dict(os.environ, GIT_OPTIONAL_LOCKS="0")
    try:
        completed = subprocess.run(
            command,
            shell=False,
            check=False,
            capture_output=True,
            encoding="utf-8",
            errors="strict",
            env=env,
        )
    except FileNotFoundError as error:
        raise AuditError(f"Audit cannot find git: {error}") from error
    if completed.returncode == 0:
        return True
    if completed.returncode == 1:
        return False
    raise AuditError(
        f"Audit git command failed: {' '.join(command)} "
        f"({(completed.stderr or '').strip()})"
    )


def _worktree_head_commits(repo: Path) -> list[str]:
    """Every worktree HEAD commit, primary and linked alike."""
    heads: list[str] = []
    for line in _git_read(repo, "worktree", "list", "--porcelain").splitlines():
        if line.startswith("HEAD "):
            oid = line.split(" ", 1)[1].strip()
            if oid.strip("0"):
                heads.append(oid)
    return heads


def _checked_out_submodules(repo: Path) -> list[Path]:
    """Absolute worktree paths of every populated submodule, recursively."""
    output = _git_read(repo, "submodule", "foreach", "--recursive", "--quiet", "pwd")
    return [Path(line) for line in output.splitlines() if line]


def _required_commits(repo: Path) -> tuple[dict[str, str], list[str]]:
    """Map each required commit OID to the reason it is required.

    Required commits: the primary HEAD, every `git worktree list` HEAD,
    refs/heads/*, refs/tags/* (annotated tags peeled to their target
    commit), and refs/stash.  A ref that does not peel to a commit is a
    blocker, never silently skipped.
    """
    required: dict[str, str] = {}
    blockers: list[str] = []
    head = _git_read(repo, "rev-parse", "--verify", "HEAD^{commit}").strip()
    required[head] = "HEAD"
    for oid in _worktree_head_commits(repo):
        required.setdefault(oid, "worktree HEAD")
    listing = _git_read(
        repo,
        "for-each-ref",
        "--format=%(refname)%00%(objecttype)%00%(objectname)"
        "%00%(*objecttype)%00%(*objectname)",
        "refs/heads", "refs/tags", "refs/stash",
    )
    for line in listing.splitlines():
        refname, objecttype, objectname, peeled_type, peeled_name = (
            line.split("\x00")
        )
        if objecttype == "commit":
            required.setdefault(objectname, refname)
        elif peeled_type == "commit":
            required.setdefault(peeled_name, refname)
        else:
            blockers.append(
                f"{repo}: {refname} does not peel to a commit "
                f"({objectname} is a {objecttype})"
            )
    return required, blockers


def _advertised_refs(repo: Path, remote: str) -> list[tuple[str, str]]:
    """The (refname, OID) pairs one remote advertises, via ls-remote."""
    pairs: list[tuple[str, str]] = []
    for line in _git_read(repo, "ls-remote", "--refs", remote).splitlines():
        oid, _tab, refname = line.partition("\t")
        pairs.append((refname, oid))
    return pairs


def _delete_audit_namespace(repo: Path, namespace: str, before: str) -> None:
    """Delete exactly this run's audit refs and prove nothing else moved.

    Deletion goes through `git update-ref --stdin` with the expected old
    value for each ref.  Afterwards the full ref listing must be
    byte-identical to the pre-audit snapshot; any difference is an
    AuditError.  Fetched objects that became unreachable are left for
    normal Git maintenance.
    """
    listing = _git_read(
        repo, "for-each-ref", "--format=%(refname)%00%(objectname)", namespace
    )
    instructions = []
    for line in listing.splitlines():
        refname, oid = line.split("\x00")
        instructions.append(f"delete {refname} {oid}")
    if instructions:
        _git_write_audit_refs(
            repo, "update-ref", "--stdin",
            stdin_text="\n".join(instructions) + "\n",
        )
    after = _git_read(repo, "for-each-ref", "--format=%(refname)%00%(objectname)")
    if after != before:
        raise AuditError(
            f"Audit ref cleanup failed: refs in {repo} no longer match "
            f"their pre-audit snapshot"
        )


def _cover_repo(repo: Path, required: dict[str, str]) -> list[str]:
    """Check one repository's required commits against its remotes.

    Advertised refs are fetched only into a unique run namespace with
    explicit force refspecs, --no-tags, and an empty --refmap so neither
    refs/remotes/* nor refs/tags/* can move; there is no --prune and no
    fetch of unqualified object IDs.  Every advertised pair must resolve
    to its fetched audit ref, and every required commit must be an
    ancestor of at least one advertised tip.  The namespace is deleted in
    a finally path whether or not blockers were found.
    """
    blockers: list[str] = []
    tips: set[str] = set()
    namespace = f"{AUDIT_REF_ROOT}/{os.urandom(16).hex()}"
    before = _git_read(repo, "for-each-ref", "--format=%(refname)%00%(objectname)")
    try:
        remotes = _git_read(repo, "remote").split()
        for remote_index, remote in enumerate(sorted(remotes)):
            try:
                advertised = _advertised_refs(repo, remote)
            except AuditError as error:
                blockers.append(
                    f"{repo}: remote {remote!r} advertisement failed: {error}"
                )
                continue
            fetchable: list[tuple[str, str]] = []
            for refname, oid in advertised:
                if refname.startswith("refs/"):
                    fetchable.append((refname, oid))
                else:
                    blockers.append(
                        f"{repo}: remote {remote!r} advertises non-ref "
                        f"{refname!r}; refusing to fetch it"
                    )
            if not fetchable:
                continue
            refspecs = [
                f"+{refname}:{namespace}/{remote_index}/{position}"
                for position, (refname, _oid) in enumerate(fetchable)
            ]
            try:
                _git_write_audit_refs(
                    repo, "fetch", "--quiet", "--no-tags", "--no-prune",
                    "--no-recurse-submodules", "--no-write-fetch-head",
                    "--no-auto-maintenance", "--refmap=", remote, *refspecs,
                )
            except AuditError as error:
                blockers.append(
                    f"{repo}: fetch from remote {remote!r} failed: {error}"
                )
                continue
            for position, (refname, oid) in enumerate(fetchable):
                audit_ref = f"{namespace}/{remote_index}/{position}"
                try:
                    fetched = _git_read(
                        repo, "rev-parse", "--verify", audit_ref
                    ).strip()
                except AuditError:
                    blockers.append(
                        f"{repo}: advertised {refname} ({oid}) from remote "
                        f"{remote!r} is missing after fetch"
                    )
                    continue
                if fetched != oid:
                    blockers.append(
                        f"{repo}: advertised {refname} on remote {remote!r} "
                        f"moved during audit (expected {oid}, fetched {fetched})"
                    )
                    continue
                try:
                    tip = _git_read(
                        repo, "rev-parse", "--verify", f"{audit_ref}^{{commit}}"
                    ).strip()
                except AuditError:
                    # A non-commit advertisement (e.g. a tag of a blob)
                    # cannot cover commits; it is verified above but
                    # contributes no tip.
                    continue
                tips.add(tip)
        for oid in sorted(required):
            if not any(_is_ancestor(repo, oid, tip) for tip in sorted(tips)):
                blockers.append(
                    f"{repo}: unpublished commit {oid} ({required[oid]}) is "
                    f"not reachable from any advertised remote ref"
                )
    finally:
        _delete_audit_namespace(repo, namespace, before)
    return blockers


def remote_coverage(root: Path) -> dict:
    """Prove every commit that matters is on some remote, fail-closed.

    Required commits: the primary HEAD, every linked-worktree HEAD,
    refs/heads/*, refs/tags/* (peeled), refs/stash, and each recursively
    checked-out submodule's HEAD (checked against that submodule's own
    remotes).  A failed advertisement or fetch, a missing or moved
    object, or an uncovered commit lands in the blocker list; unpublished
    commit OIDs appear verbatim there.  The repository is never mutated
    beyond the run-scoped audit ref namespace, which is deleted in a
    finally path with pre-existing refs verified byte-identical.  There
    is no push path and no waiver option.
    """
    root = Path(root)
    required, blockers = _required_commits(root)
    blockers.extend(_cover_repo(root, required))
    for submodule in _checked_out_submodules(root):
        head = _git_read(submodule, "rev-parse", "--verify", "HEAD^{commit}").strip()
        blockers.extend(
            _cover_repo(submodule, {head: "checked-out submodule HEAD"})
        )
    return {"root": str(root), "blockers": sorted(blockers), "ok": not blockers}


# ---------------------------------------------------------------------------
# Journal layer: append-only, hash-chained JSON Lines
# ---------------------------------------------------------------------------

JOURNAL_SCHEMA_VERSION = 1
STATE_ROOT_ENV = "DRIVE_WORKSPACE_STATE_ROOT"
DEFAULT_STATE_ROOT = "~/.local/state/drive-workspace-migration"

JOURNAL_KINDS = {"transaction", "observation", "program", "path_repair"}
EVENTS_BY_KIND = {
    "transaction": {
        "capture", "drive_state", "drive_paused", "moved", "local_verified",
        "consumers_applied", "consumers_verified", "consumers_staged",
        "consumers_rolled_back", "generated_paths_materialized", "smoke",
        "generated_paths_rolled_back", "rollback_window_closed",
        "generated_target_finalized", "local_rolled_back",
        "rollback_verified", "rollback_drill_requested",
        "cloud_recorded", "cloud_verified", "cloud_restored",
        "native_errors_recorded",
        "smoke_started", "smoke_checked", "smoke_stopped",
    },
    "observation": {"drive_state", "native_errors_recorded"},
    "program": {"program_gate"},
    "path_repair": {
        "path_captured", "drive_paused", "path_local_verified",
        "path_local_rolled_back", "path_cloud_recorded",
        "path_cloud_verified", "path_cloud_restored",
        "native_errors_recorded", "rollback_window_closed",
        "path_target_finalized", "private_preimage_finalized",
    },
}
EVENT_KEYS = {
    "event", "transaction_id", "sequence", "previous_hash",
    "time_utc", "payload", "event_hash",
}
HEADER_KEYS = {
    "event", "transaction_id", "sequence", "previous_hash", "time_utc",
    "schema_version", "journal_kind", "workspace", "source", "destination",
    "workspace_kind", "label", "event_hash",
}

# Provider seams.  Real native-Drive and cloud observation providers land in
# later tasks; the fail-closed default (None) makes every command that needs
# provider evidence a blocker rather than a fabricated success.
DRIVE_STATE_PROVIDER = None
DRIVE_PAUSE_PROVIDER = None
SESSION_ADAPTERS: dict = {}


class JournalError(RuntimeError):
    """A journal is unusable: misplaced, corrupted, or insecure."""


class TransactionError(RuntimeError):
    """A transaction command refused to proceed."""


def _state_root() -> str:
    """The active state root: env override for tests, real default otherwise."""
    raw = os.environ.get(STATE_ROOT_ENV) or DEFAULT_STATE_ROOT
    return os.path.abspath(os.path.expanduser(raw))


def _journal_abspath(journal) -> str:
    return os.path.abspath(os.path.expanduser(str(journal)))


def _utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def _canonical_line(event: dict) -> bytes:
    """One canonical journal line: sorted keys, compact separators, newline."""
    return (
        json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n"
    ).encode("utf-8")


def _event_hash(event: dict) -> str:
    """SHA-256 of the canonical event with event_hash omitted."""
    body = {key: value for key, value in event.items() if key != "event_hash"}
    return hashlib.sha256(_canonical_line(body)).hexdigest()


def _line_hash(line: bytes) -> str:
    """SHA-256 of one full journal line, trailing newline included."""
    return hashlib.sha256(line).hexdigest()


def _check_journal_permissions(journal: str) -> None:
    """Require exactly 0o600 on the journal and 0o700 on its parent."""
    try:
        info = os.lstat(journal)
    except OSError as error:
        raise JournalError(f"journal cannot be read: {journal} ({error})") from error
    if not stat.S_ISREG(info.st_mode):
        raise JournalError(f"journal is not a regular file: {journal}")
    mode = stat.S_IMODE(info.st_mode)
    if mode != 0o600:
        raise JournalError(
            f"journal permissions are 0o{mode:o}, not 0o600: {journal}; "
            f"broader permissions permanently block mutation"
        )
    parent = os.path.dirname(journal)
    try:
        parent_info = os.lstat(parent)
    except OSError as error:
        raise JournalError(
            f"journal parent cannot be read: {parent} ({error})"
        ) from error
    if not stat.S_ISDIR(parent_info.st_mode):
        raise JournalError(f"journal parent is not a directory: {parent}")
    parent_mode = stat.S_IMODE(parent_info.st_mode)
    if parent_mode != 0o700:
        raise JournalError(
            f"journal parent permissions are 0o{parent_mode:o}, not 0o700: "
            f"{parent}; broader permissions permanently block mutation"
        )


def _parse_journal(journal: str, data: bytes) -> list[dict]:
    """Validate the full hash chain; any defect is permanent, never repaired."""
    if not data:
        raise JournalError(f"journal is empty: {journal}")
    if not data.endswith(b"\n"):
        raise JournalError(f"journal last line is truncated: {journal}")
    lines = data.splitlines(keepends=True)
    events: list[dict] = []
    previous_line: bytes | None = None
    journal_kind = None
    transaction_id = None
    for index, line in enumerate(lines):
        try:
            event = json.loads(line.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise JournalError(
                f"journal line {index} is not valid JSON: {journal} ({error})"
            ) from error
        if not isinstance(event, dict):
            raise JournalError(
                f"journal line {index} is not an object: {journal}"
            )
        expected_keys = HEADER_KEYS if index == 0 else EVENT_KEYS
        if set(event) != expected_keys:
            raise JournalError(
                f"journal line {index} has an unexpected structure: {journal}"
            )
        if index == 0:
            if event["event"] != "header":
                raise JournalError(f"journal has no header event: {journal}")
            if event["schema_version"] != JOURNAL_SCHEMA_VERSION:
                raise JournalError(
                    f"journal schema version {event['schema_version']!r} is "
                    f"unsupported: {journal}"
                )
            journal_kind = event["journal_kind"]
            if journal_kind not in JOURNAL_KINDS:
                raise JournalError(
                    f"journal kind {journal_kind!r} is unknown: {journal}"
                )
            transaction_id = event["transaction_id"]
            if event["previous_hash"] is not None:
                raise JournalError(
                    f"journal header must have a null previous_hash: {journal}"
                )
        else:
            if event["event"] not in EVENTS_BY_KIND[journal_kind]:
                raise JournalError(
                    f"journal line {index} has unknown event "
                    f"{event['event']!r} for a {journal_kind} journal: "
                    f"{journal}"
                )
            if event["transaction_id"] != transaction_id:
                raise JournalError(
                    f"journal line {index} changes the transaction UUID: "
                    f"{journal}"
                )
            if event["previous_hash"] != _line_hash(previous_line):
                raise JournalError(
                    f"journal line {index} has a previous_hash that does not "
                    f"match the prior line: {journal}"
                )
        if event["sequence"] != index:
            raise JournalError(
                f"journal line {index} has sequence {event['sequence']!r}; "
                f"duplicate or skipped sequences permanently block mutation: "
                f"{journal}"
            )
        if event["event_hash"] != _event_hash(event):
            raise JournalError(
                f"journal line {index} has an event_hash that does not match "
                f"its canonical content: {journal}"
            )
        if _canonical_line(event) != line:
            raise JournalError(
                f"journal line {index} is not in canonical form: {journal}"
            )
        events.append(event)
        previous_line = line
    return events


def read_journal(journal) -> list[dict]:
    """Read and fully validate one journal, permissions included."""
    path = _journal_abspath(journal)
    _check_journal_permissions(path)
    try:
        data = Path(path).read_bytes()
    except OSError as error:
        raise JournalError(f"journal cannot be read: {path} ({error})") from error
    return _parse_journal(path, data)


def _append_event(journal, event_type: str, payload: dict) -> dict:
    """Append one event under an exclusive lock, then revalidate the chain."""
    path = _journal_abspath(journal)
    _check_journal_permissions(path)
    fd = os.open(path, os.O_APPEND | os.O_WRONLY)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        data = Path(path).read_bytes()
        events = _parse_journal(path, data)
        journal_kind = events[0]["journal_kind"]
        if event_type not in EVENTS_BY_KIND[journal_kind]:
            raise JournalError(
                f"event {event_type!r} is not permitted in a "
                f"{journal_kind} journal: {path}"
            )
        last_line = data.splitlines(keepends=True)[-1]
        event = {
            "event": event_type,
            "transaction_id": events[0]["transaction_id"],
            "sequence": events[-1]["sequence"] + 1,
            "previous_hash": _line_hash(last_line),
            "time_utc": _utc_now(),
            "payload": payload,
        }
        event["event_hash"] = _event_hash(event)
        line = _canonical_line(event)
        written = os.write(fd, line)
        if written != len(line):
            raise JournalError(
                f"journal append wrote {written} of {len(line)} bytes: {path}"
            )
        os.fsync(fd)
        _parse_journal(path, Path(path).read_bytes())
        return event
    finally:
        os.close(fd)


def _validate_new_journal_path(journal) -> str:
    """A new journal must resolve below the state root and not exist yet."""
    path = _journal_abspath(journal)
    root = _state_root()
    if not _is_within(path, root):
        raise JournalError(
            f"journal must resolve below the state root {root}: {path}"
        )
    if os.path.lexists(path):
        raise JournalError(f"journal already exists: {path}")
    return path


def _create_journal(
    journal,
    *,
    journal_kind: str,
    workspace: str | None = None,
    source: str | None = None,
    destination: str | None = None,
    workspace_kind: str | None = None,
    label: str | None = None,
) -> str:
    """Create a mode-0600 journal in a mode-0700 parent and write the header."""
    path = _validate_new_journal_path(journal)
    root = _state_root()
    parent = os.path.dirname(path)
    missing: list[str] = []
    probe = parent
    while not os.path.isdir(probe) and _is_within(probe, root):
        missing.append(probe)
        probe = os.path.dirname(probe)
    if not os.path.isdir(probe):
        raise JournalError(
            f"journal ancestor directory is missing outside the state root: "
            f"{probe}"
        )
    for directory in reversed(missing):
        os.mkdir(directory, 0o700)
        os.chmod(directory, 0o700)
    parent_mode = stat.S_IMODE(os.lstat(parent).st_mode)
    if parent_mode != 0o700:
        raise JournalError(
            f"journal parent permissions are 0o{parent_mode:o}, not 0o700: "
            f"{parent}"
        )
    header = {
        "event": "header",
        "transaction_id": str(uuid.uuid4()),
        "sequence": 0,
        "previous_hash": None,
        "time_utc": _utc_now(),
        "schema_version": JOURNAL_SCHEMA_VERSION,
        "journal_kind": journal_kind,
        "workspace": workspace,
        "source": source,
        "destination": destination,
        "workspace_kind": workspace_kind,
        "label": label,
    }
    header["event_hash"] = _event_hash(header)
    line = _canonical_line(header)
    fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_APPEND, 0o600)
    try:
        os.fchmod(fd, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX)
        written = os.write(fd, line)
        if written != len(line):
            raise JournalError(
                f"journal header wrote {written} of {len(line)} bytes: {path}"
            )
        os.fsync(fd)
        parent_fd = os.open(parent, os.O_RDONLY)
        try:
            os.fsync(parent_fd)
        finally:
            os.close(parent_fd)
        _parse_journal(path, Path(path).read_bytes())
    finally:
        os.close(fd)
    _check_journal_permissions(path)
    return path


def build_audit_payload(manifest: Manifest) -> dict:
    """Assemble the deterministic audit payload for one manifest.

    Symlinks are scanned across the whole Drive root; the journal-grade
    filesystem records and Git snapshots cover each workspace source.
    The payload carries no timestamps, PIDs, or other volatile fields;
    such observation metadata belongs only in an external journal event
    wrapper around this payload.
    """
    workspaces: dict[str, dict] = {}
    for workspace in sorted(manifest.workspaces, key=lambda item: item.name):
        source = workspace.source_path
        git_roots = workspace.git_roots or (".",)
        workspaces[workspace.name] = {
            "filesystem": audit_filesystem(source),
            "git": {root: snapshot_git(source / root) for root in sorted(git_roots)},
        }
    return {
        "drive_root": manifest.drive_root,
        "symlinks": scan_symlinks(manifest.drive_root_path),
        "workspaces": workspaces,
    }


def canonical_json(payload: dict) -> str:
    """Serialize a payload canonically: sorted keys, minimal separators."""
    return json.dumps(payload, sort_keys=True, separators=(",", ":")) + "\n"


def run_audit(manifest_path: Path) -> int:
    """Run the read-only audit subcommand; nonzero on any blocker or symlink."""
    try:
        manifest = load_manifest(manifest_path)
        payload = build_audit_payload(manifest)
    except (ManifestError, AuditError) as error:
        print(f"drive-workspace audit: {error}", file=sys.stderr)
        return 1
    sys.stdout.write(canonical_json(payload))
    if payload["symlinks"]:
        print(
            f"drive-workspace audit: {len(payload['symlinks'])} symlink(s) "
            f"remain under drive root {manifest.drive_root}",
            file=sys.stderr,
        )
        return 1
    return 0


# ---------------------------------------------------------------------------
# Transaction command layer
# ---------------------------------------------------------------------------


def _print_journal(path: str) -> None:
    """Success stdout is exactly one JSON object naming the journal."""
    sys.stdout.write(
        json.dumps({"journal": path}, separators=(",", ":")) + "\n"
    )


def _device_of(path) -> int:
    """st_dev of one path; a seam so tests can simulate device mismatches."""
    return os.lstat(os.path.abspath(os.path.expanduser(str(path)))).st_dev


def _load_workspace(manifest_path, name: str) -> tuple[Manifest, Workspace]:
    manifest = load_manifest(Path(manifest_path))
    try:
        workspace = manifest.by_name(name)
    except KeyError as error:
        raise TransactionError(str(error)) from error
    return manifest, workspace


def _latest(events: list[dict], event_type: str) -> dict | None:
    matches = [event for event in events if event["event"] == event_type]
    return matches[-1] if matches else None


def _active(
    events: list[dict], event_type: str, undo_type: str
) -> dict | None:
    """The latest event of a type unless a later undo event supersedes it."""
    done = _latest(events, event_type)
    if done is None:
        return None
    undone = _latest(events, undo_type)
    if undone is not None and undone["sequence"] > done["sequence"]:
        return None
    return done


def _require_transaction_header(
    events: list[dict], name: str, journal: str
) -> dict:
    header = events[0]
    if header["journal_kind"] != "transaction":
        raise TransactionError(
            f"journal is a {header['journal_kind']} journal, not a "
            f"transaction journal: {journal}"
        )
    if header["workspace"] != name:
        raise TransactionError(
            f"journal belongs to workspace {header['workspace']!r}, "
            f"not {name!r}: {journal}"
        )
    return header


def _require_capture(events: list[dict], journal: str) -> dict:
    capture = _latest(events, "capture")
    if capture is None:
        raise TransactionError(f"journal has no capture event: {journal}")
    return capture


def _workspace_git_roots(workspace: Workspace) -> tuple:
    return workspace.git_roots or (".",)


def _comparable_filesystem(records: list[dict]) -> list[dict]:
    """Filesystem records with Git internals excluded.

    Git state is compared through snapshot_git; the audited .git trees
    legitimately change under read-only Git observation (e.g. the
    remote-coverage fetch adds objects), so byte-comparing them would
    reject unchanged workspaces.
    """
    return [
        record for record in records
        if ".git" not in record["path"].split("/")
    ]


def _workspace_snapshot(workspace: Workspace, root: Path) -> dict:
    return {
        "filesystem": audit_filesystem(root),
        "git": {
            git_root: snapshot_git(root / git_root)
            for git_root in sorted(_workspace_git_roots(workspace))
        },
    }


def _snapshots_match(current: dict, captured: dict) -> bool:
    return (
        _comparable_filesystem(current["filesystem"])
        == _comparable_filesystem(captured["filesystem"])
        and current["git"] == captured["git"]
    )


def _sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def _read_text(path: str, context: str) -> str:
    try:
        return Path(path).read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as error:
        raise TransactionError(
            f"{context} cannot be read as UTF-8 text: {path} ({error})"
        ) from error


def _atomic_write(path: str, content: str) -> None:
    """Replace one file's content atomically, preserving its mode.

    Every operating-system failure (full disk, permissions, read-only
    filesystem) is raised as TransactionError so callers' rollback paths
    run instead of the process dying with a traceback, and the temporary
    file is removed on any failure after its creation.
    """
    try:
        mode = stat.S_IMODE(os.stat(path).st_mode)
        directory = os.path.dirname(path)
        fd, temp_path = tempfile.mkstemp(
            prefix=".drive-workspace-", dir=directory
        )
    except OSError as error:
        raise TransactionError(f"cannot write {path}: {error}") from error
    try:
        try:
            os.write(fd, content.encode("utf-8"))
            os.fsync(fd)
        finally:
            os.close(fd)
        os.chmod(temp_path, mode)
        os.rename(temp_path, path)
    except OSError as error:
        # Best-effort removal of the tool's own just-created temporary
        # file; the original write failure below is what callers must see.
        try:
            os.unlink(temp_path)
        except OSError:
            pass
        raise TransactionError(f"cannot write {path}: {error}") from error


def _capture_payload(workspace: Workspace) -> dict:
    """Audit state and exact consumer preimages for the capture event."""
    source = workspace.source_path
    if not source.is_dir():
        raise TransactionError(f"workspace source is missing: {source}")
    snapshot = _workspace_snapshot(workspace, source)
    links = []
    for link in workspace.links:
        link_path = source / link.path
        try:
            info = os.lstat(link_path)
        except OSError as error:
            raise TransactionError(
                f"manifest link is missing: {link_path} ({error})"
            ) from error
        if not stat.S_ISLNK(info.st_mode):
            raise TransactionError(
                f"manifest link is not a symlink: {link_path}"
            )
        text = os.readlink(link_path)
        if text != link.link_text:
            raise TransactionError(
                f"manifest link text mismatch at {link_path}: "
                f"observed {text!r}, declared {link.link_text!r}"
            )
        mode = f"0o{stat.S_IMODE(info.st_mode):o}"
        if mode != link.lstat_mode:
            raise TransactionError(
                f"manifest link mode mismatch at {link_path}: "
                f"observed {mode}, declared {link.lstat_mode}"
            )
        if os.path.isabs(text):
            target = os.path.normpath(text)
        else:
            target = os.path.normpath(
                os.path.join(str(link_path.parent), text)
            )
        links.append(
            {
                "path": link.path,
                "link_text": text,
                "lstat_mode": mode,
                "disposition": link.disposition,
                "target_policy": link.target_policy,
                "post_smoke_type": link.post_smoke_type,
                "target": target,
            }
        )
    consumers = []
    for consumer in workspace.consumers:
        consumer_path = os.path.abspath(os.path.expanduser(consumer.path))
        content = _read_text(consumer_path, f"consumer {consumer.name!r}")
        count = content.count(consumer.old)
        if count != consumer.count:
            raise TransactionError(
                f"consumer {consumer.name!r} contains {count} occurrence(s) "
                f"of the old value; the manifest declares {consumer.count}"
            )
        if consumer.new in content:
            raise TransactionError(
                f"consumer {consumer.name!r} preimage already contains the "
                f"new value; exact occurrence verification could never "
                f"distinguish applied from unapplied state: {consumer_path}"
            )
        consumers.append(
            {
                "name": consumer.name,
                "path": consumer_path,
                "old": consumer.old,
                "new": consumer.new,
                "count": consumer.count,
                "session_adapter": consumer.session_adapter,
                "content": content,
                "sha256": _sha256_text(content),
            }
        )
    return {
        "filesystem": snapshot["filesystem"],
        "git": snapshot["git"],
        "links": links,
        "consumers": consumers,
        "runtime_services": [
            {
                "name": service.name,
                "cwd": service.cwd,
                "argv": list(service.argv),
                "port": service.port,
                "http": dict(service.http),
            }
            for service in workspace.runtime_services
        ],
        "source_dev": _device_of(source),
    }


def cmd_capture(name: str, journal, manifest_path) -> int:
    path = _validate_new_journal_path(journal)
    _manifest, workspace = _load_workspace(manifest_path, name)
    payload = _capture_payload(workspace)
    _create_journal(
        path,
        journal_kind="transaction",
        workspace=name,
        source=str(workspace.source_path),
        destination=str(workspace.destination_path),
        workspace_kind=workspace.kind,
    )
    _append_event(path, "capture", payload)
    _print_journal(path)
    return 0


def cmd_init_journal(journal, kind: str, label: str) -> int:
    path = _create_journal(journal, journal_kind=kind, label=label)
    _print_journal(path)
    return 0


def cmd_verify_journal(journal) -> int:
    path = _journal_abspath(journal)
    read_journal(path)
    _print_journal(path)
    return 0


def _require_provider_evidence(name: str) -> dict:
    if DRIVE_STATE_PROVIDER is None:
        raise TransactionError(
            "no native Drive state provider is configured; refusing to "
            "fabricate drive_state evidence"
        )
    evidence = DRIVE_STATE_PROVIDER(name)
    if (
        not isinstance(evidence, dict)
        or "rows" not in evidence
        or "queue_cursors" not in evidence
    ):
        raise TransactionError(
            "the Drive state provider returned no usable evidence "
            "(rows and queue_cursors are required)"
        )
    return evidence


def cmd_record_drive_state(name: str, journal) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    header = events[0]
    if header["journal_kind"] == "transaction" and header["workspace"] != name:
        raise TransactionError(
            f"journal belongs to workspace {header['workspace']!r}, "
            f"not {name!r}: {path}"
        )
    if header["journal_kind"] == "program":
        raise TransactionError(
            f"drive_state cannot be recorded in a program journal: {path}"
        )
    evidence = _require_provider_evidence(name)
    _append_event(
        path, "drive_state", {"workspace": name, "evidence": evidence}
    )
    _print_journal(path)
    return 0


def _require_pause_evidence(name: str) -> dict:
    """Fresh characterized pause evidence, or a blocker.

    Characterization: the provider must report a boolean paused state and
    a boolean queue observation; anything else (a missing provider, an
    ambiguous UI reading, a running client, or a queue cursor advancing
    while the UI claims to be paused) is a blocker.
    """
    if DRIVE_PAUSE_PROVIDER is None:
        raise TransactionError(
            "no Drive pause provider is configured; refusing to assume the "
            "native client is paused"
        )
    evidence = DRIVE_PAUSE_PROVIDER(name)
    if (
        not isinstance(evidence, dict)
        or not isinstance(evidence.get("paused"), bool)
        or not isinstance(evidence.get("queue_advanced"), bool)
    ):
        raise TransactionError(
            "the Drive pause provider returned an ambiguous UI reading; "
            "refusing to treat it as paused"
        )
    if evidence["paused"] is not True:
        raise TransactionError(
            "the Drive pause provider did not observe a paused native state"
        )
    if evidence["queue_advanced"] is not False:
        raise TransactionError(
            "the Drive pause provider observed outbound queue advancement "
            "during the bounded observation"
        )
    return evidence


def cmd_confirm_drive_paused(name: str, journal) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    _require_capture(events, path)
    evidence = _require_pause_evidence(name)
    _append_event(
        path, "drive_paused", {"workspace": name, "evidence": evidence}
    )
    _print_journal(path)
    return 0


def cmd_move(name: str, journal, manifest_path) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    capture = _require_capture(events, path)
    if _active(events, "moved", "local_rolled_back") is not None:
        raise TransactionError(
            f"workspace was already moved by this transaction: {path}"
        )
    paused = _latest(events, "drive_paused")
    if paused is None or paused["sequence"] < capture["sequence"]:
        raise TransactionError(
            "fresh pause evidence is missing: confirm-drive-paused must "
            "succeed after capture and before move"
        )
    _manifest, workspace = _load_workspace(manifest_path, name)
    source = workspace.source_path
    destination = workspace.destination_path
    if not source.is_dir():
        raise TransactionError(f"workspace source is missing: {source}")
    if os.path.lexists(destination):
        raise TransactionError(
            f"destination already exists; refusing to collide: {destination}"
        )
    parent = destination.parent
    if not parent.is_dir():
        raise TransactionError(f"destination parent is missing: {parent}")
    if _device_of(source) != _device_of(parent):
        raise TransactionError(
            f"source {source} and destination parent {parent} are on "
            f"different devices; os.rename would degrade to a copy"
        )
    # No live user may sit below the source when it is renamed away: a
    # process cwd or an Emacs file-visiting buffer below the source is a
    # blocker (the same gates re-run at close-rollback-window).
    _require_no_live_source_users(str(source))
    current = _workspace_snapshot(workspace, source)
    if not _snapshots_match(current, capture["payload"]):
        raise TransactionError(
            "source snapshot changed since capture; start a new transaction"
        )
    for git_root in sorted(_workspace_git_roots(workspace)):
        coverage = remote_coverage(source / git_root)
        if not coverage["ok"]:
            raise TransactionError(
                "uncovered commits block the move: "
                + "; ".join(coverage["blockers"])
            )
    if workspace.kind == "workspace":
        try:
            os.rename(source, destination)
        except OSError as error:
            raise TransactionError(
                f"rename failed: {source} -> {destination} ({error})"
            ) from error
        for git_root in sorted(_workspace_git_roots(workspace)):
            _run_git(destination / git_root, ("worktree", "repair"))
            _run_git(
                destination / git_root,
                ("submodule", "status", "--recursive"),
            )
    else:
        owner = workspace.owner_path
        _run_git(owner, ("worktree", "move", str(source), str(destination)))
        _run_git(owner, ("worktree", "repair"))
        _run_git(destination, ("submodule", "status", "--recursive"))
    _append_event(
        path,
        "moved",
        {
            "source": str(source),
            "destination": str(destination),
            "dev": _device_of(destination),
            "kind": workspace.kind,
        },
    )
    _print_journal(path)
    return 0


def _require_moved(events: list[dict], journal: str) -> dict:
    moved = _active(events, "moved", "local_rolled_back")
    if moved is None:
        raise TransactionError(
            f"journal records no active move for this workspace: {journal}"
        )
    return moved


# --- Consumers -------------------------------------------------------------


def cmd_apply_consumers(name: str, journal, manifest_path) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    capture = _require_capture(events, path)
    _require_moved(events, path)
    if _active(events, "consumers_applied", "consumers_rolled_back"):
        raise TransactionError(f"consumers were already applied: {path}")
    _load_workspace(manifest_path, name)
    consumers = capture["payload"]["consumers"]
    for consumer in consumers:
        adapter_name = consumer["session_adapter"]
        if adapter_name is not None and adapter_name not in SESSION_ADAPTERS:
            raise TransactionError(
                f"no session adapter is registered for {adapter_name!r}; "
                f"refusing to apply consumers"
            )
    plans = []
    for consumer in consumers:
        consumer_path = consumer["path"]
        content = _read_text(
            consumer_path, f"consumer {consumer['name']!r}"
        )
        if content != consumer["content"]:
            raise TransactionError(
                f"consumer {consumer['name']!r} drifted from its captured "
                f"preimage: {consumer_path}"
            )
        new_content = content.replace(consumer["old"], consumer["new"])
        if (
            consumer["old"] in new_content
            or new_content.count(consumer["new"]) != consumer["count"]
        ):
            raise TransactionError(
                f"consumer {consumer['name']!r} substitution did not produce "
                f"the exact expected occurrences"
            )
        plans.append((consumer, consumer_path, content, new_content))
    applied: list[tuple[str, str]] = []
    try:
        for consumer, consumer_path, old_content, new_content in plans:
            _atomic_write(consumer_path, new_content)
            applied.append((consumer_path, old_content))
            adapter_name = consumer["session_adapter"]
            if adapter_name is not None:
                try:
                    SESSION_ADAPTERS[adapter_name](consumer)
                except Exception as error:
                    raise TransactionError(
                        f"session adapter {adapter_name!r} failed: {error}"
                    ) from error
    except TransactionError:
        # Tested rollback before returning nonzero: restore every preimage
        # that was already substituted.  A restoration failure is reported
        # but never masks the original error being re-raised.
        for consumer_path, old_content in reversed(applied):
            try:
                _atomic_write(consumer_path, old_content)
            except TransactionError as restore_error:
                print(
                    f"drive-workspace: preimage restoration failed for "
                    f"{consumer_path}: {restore_error}",
                    file=sys.stderr,
                )
        raise
    _append_event(
        path,
        "consumers_applied",
        {
            "consumers": [
                {
                    "name": consumer["name"],
                    "path": consumer_path,
                    "content": new_content,
                    "sha256": _sha256_text(new_content),
                }
                for consumer, consumer_path, _old, new_content in plans
            ]
        },
    )
    _print_journal(path)
    return 0


def _capture_consumer_by_name(capture: dict) -> dict:
    return {
        consumer["name"]: consumer
        for consumer in capture["payload"]["consumers"]
    }


def cmd_verify_consumers(name: str, journal, manifest_path) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    capture = _require_capture(events, path)
    applied = _active(events, "consumers_applied", "consumers_rolled_back")
    if applied is None:
        raise TransactionError(
            f"journal records no active consumer application: {path}"
        )
    _load_workspace(manifest_path, name)
    by_name = _capture_consumer_by_name(capture)
    for record in applied["payload"]["consumers"]:
        consumer = by_name[record["name"]]
        content = _read_text(record["path"], f"consumer {record['name']!r}")
        old_count = content.count(consumer["old"])
        if old_count != 0:
            raise TransactionError(
                f"consumer {record['name']!r} still contains {old_count} "
                f"occurrence(s) of the old value: {record['path']}"
            )
        new_count = content.count(consumer["new"])
        if new_count != consumer["count"]:
            raise TransactionError(
                f"consumer {record['name']!r} contains {new_count} "
                f"occurrence(s) of the new value; expected "
                f"{consumer['count']}: {record['path']}"
            )
    _append_event(path, "consumers_verified", {"workspace": name})
    _print_journal(path)
    return 0


def _consumer_repo(consumer_path: str) -> tuple[str, str]:
    directory = os.path.dirname(consumer_path)
    try:
        repo = _git_read(
            Path(directory), "rev-parse", "--show-toplevel"
        ).strip()
    except AuditError as error:
        raise TransactionError(
            f"consumer file is not inside a Git repository: "
            f"{consumer_path} ({error})"
        ) from error
    return repo, os.path.relpath(consumer_path, repo)


def _unified_patch(rel: str, old_content: str, new_content: str) -> str:
    diff = "".join(
        difflib.unified_diff(
            old_content.splitlines(keepends=True),
            new_content.splitlines(keepends=True),
            fromfile=f"a/{rel}",
            tofile=f"b/{rel}",
        )
    )
    if not diff:
        raise TransactionError(
            f"consumer substitution produced no staged change for {rel}"
        )
    return f"diff --git a/{rel} b/{rel}\n{diff}"


def cmd_stage_consumers(name: str, journal, manifest_path) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    capture = _require_capture(events, path)
    applied = _active(events, "consumers_applied", "consumers_rolled_back")
    if applied is None:
        raise TransactionError(
            f"consumers must be applied before staging: {path}"
        )
    if _active(events, "consumers_staged", "consumers_rolled_back"):
        raise TransactionError(f"consumers were already staged: {path}")
    _load_workspace(manifest_path, name)
    applied_by_name = {
        record["name"]: record
        for record in applied["payload"]["consumers"]
    }
    plans = []
    repos: dict[str, list[str]] = {}
    for consumer in capture["payload"]["consumers"]:
        consumer_path = consumer["path"]
        repo, rel = _consumer_repo(consumer_path)
        current = _read_text(
            consumer_path, f"consumer {consumer['name']!r}"
        )
        if current != applied_by_name[consumer["name"]]["content"]:
            raise TransactionError(
                f"consumer {consumer['name']!r} drifted after application; "
                f"refusing to stage: {consumer_path}"
            )
        try:
            index_content = _git_read(Path(repo), "show", f":{rel}")
        except AuditError as error:
            raise TransactionError(
                f"consumer file is not tracked in its Git index: "
                f"{consumer_path} ({error})"
            ) from error
        index_count = index_content.count(consumer["old"])
        if index_count != consumer["count"]:
            raise TransactionError(
                f"overlapping dirty hunk: the index copy of {rel} contains "
                f"{index_count} occurrence(s) of the old value; the manifest "
                f"declares {consumer['count']}"
            )
        target = index_content.replace(consumer["old"], consumer["new"])
        patch = _unified_patch(rel, index_content, target)
        plans.append((consumer, repo, rel, target, patch))
        repos.setdefault(repo, []).append(rel)
    for repo, rels in repos.items():
        staged = _git_read(
            Path(repo), "diff", "--cached", "--name-only"
        ).strip()
        if staged:
            raise TransactionError(
                f"additional staged paths are present in {repo}: {staged}; "
                f"refusing to mix them with manifest-owned hunks"
            )
    for _consumer, repo, rel, _target, patch in plans:
        _run_git(
            Path(repo), ("apply", "--cached", "--check", "-"),
            stdin_text=patch,
        )
    for _consumer, repo, rel, _target, patch in plans:
        _run_git(Path(repo), ("apply", "--cached", "-"), stdin_text=patch)
    for repo, rels in repos.items():
        staged_now = sorted(
            line
            for line in _git_read(
                Path(repo), "diff", "--cached", "--name-only"
            ).splitlines()
            if line
        )
        if staged_now != sorted(rels):
            raise TransactionError(
                f"staged paths in {repo} are {staged_now}, expected "
                f"exactly {sorted(rels)}"
            )
    for _consumer, repo, rel, target, _patch in plans:
        staged_content = _git_read(Path(repo), "show", f":{rel}")
        if staged_content != target:
            raise TransactionError(
                f"staged content of {rel} does not match the exact "
                f"manifest-owned patch"
            )
    _append_event(
        path,
        "consumers_staged",
        {
            "patches": [
                {"name": consumer["name"], "repo": repo, "rel": rel,
                 "patch": patch, "sha256": _sha256_text(patch)}
                for consumer, repo, rel, _target, patch in plans
            ]
        },
    )
    _print_journal(path)
    return 0


def cmd_rollback_consumers(name: str, journal, manifest_path) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    capture = _require_capture(events, path)
    applied = _active(events, "consumers_applied", "consumers_rolled_back")
    if applied is None:
        raise TransactionError(
            f"journal records no active consumer application to roll "
            f"back: {path}"
        )
    _load_workspace(manifest_path, name)
    for record in applied["payload"]["consumers"]:
        current = _read_text(record["path"], f"consumer {record['name']!r}")
        if current != record["content"]:
            raise TransactionError(
                f"concurrent drift in consumer {record['name']!r}; refusing "
                f"to roll back over unjournaled changes: {record['path']}"
            )
    staged = _active(events, "consumers_staged", "consumers_rolled_back")
    if staged is not None:
        for patch_record in staged["payload"]["patches"]:
            _run_git(
                Path(patch_record["repo"]),
                ("apply", "--cached", "-R", "-"),
                stdin_text=patch_record["patch"],
            )
    by_name = _capture_consumer_by_name(capture)
    for record in applied["payload"]["consumers"]:
        _atomic_write(record["path"], by_name[record["name"]]["content"])
    _append_event(path, "consumers_rolled_back", {"workspace": name})
    _print_journal(path)
    return 0


# --- verify-local, generated paths, smoke ----------------------------------


def _verify_destination_links(
    events: list[dict], capture: dict, destination: Path
) -> None:
    """Require the destination link set to match the journaled expectation.

    Raises on any concurrent path drift: a missing or altered preserved
    link, a materialized path that reappeared before smoke, a post-smoke
    type other than the declared one, or any unclassified symlink change.

    The interior of a regenerated post-smoke directory is exempt from the
    exact-symlink-set check: only the journaled transition at the record's
    own path is required, and regenerated trees (node_modules/.bin, venv
    interpreters) legitimately contain symlinks of their own.  Full
    strictness applies everywhere else under the destination.
    """
    links = capture["payload"]["links"]
    materialized_event = _active(
        events, "generated_paths_materialized", "generated_paths_rolled_back"
    )
    materialized = (
        {record["path"] for record in materialized_event["payload"]["links"]}
        if materialized_event
        else set()
    )
    smoke_after = None
    if materialized_event is not None:
        smoke = _latest(events, "smoke")
        if smoke is not None and smoke["sequence"] > materialized_event["sequence"]:
            smoke_after = smoke
    expected_links = []
    exempt_interiors = []
    for link in links:
        link_path = destination / link["path"]
        if link["path"] in materialized:
            if smoke_after is not None:
                declared = link["post_smoke_type"]
                if declared == "directory":
                    try:
                        info = os.lstat(link_path)
                    except OSError as error:
                        raise TransactionError(
                            f"concurrent path drift: generated path "
                            f"{link['path']} is absent but its declared "
                            f"post-smoke type is directory ({error})"
                        ) from error
                    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(
                        info.st_mode
                    ):
                        raise TransactionError(
                            f"concurrent path drift: generated path "
                            f"{link['path']} is not the declared post-smoke "
                            f"directory"
                        )
                    exempt_interiors.append(str(link_path))
                elif declared == "absent":
                    if os.path.lexists(link_path):
                        raise TransactionError(
                            f"concurrent path drift: generated path "
                            f"{link['path']} is present but its declared "
                            f"post-smoke type is absent"
                        )
                else:
                    raise TransactionError(
                        f"concurrent path drift: unclassified post-smoke "
                        f"type {declared!r} for {link['path']}"
                    )
            elif os.path.lexists(link_path):
                raise TransactionError(
                    f"concurrent path drift: materialized path "
                    f"{link['path']} reappeared before smoke"
                )
            continue
        try:
            info = os.lstat(link_path)
        except OSError as error:
            raise TransactionError(
                f"concurrent path drift: captured link is missing at "
                f"{link_path} ({error})"
            ) from error
        if not stat.S_ISLNK(info.st_mode):
            raise TransactionError(
                f"concurrent path drift: {link_path} is no longer a symlink"
            )
        if os.readlink(link_path) != link["link_text"]:
            raise TransactionError(
                f"concurrent path drift: link text changed at {link_path}"
            )
        if f"0o{stat.S_IMODE(info.st_mode):o}" != link["lstat_mode"]:
            raise TransactionError(
                f"concurrent path drift: link mode changed at {link_path}"
            )
        expected_links.append(str(link_path))
    found = [
        symlink
        for symlink in scan_symlinks(destination)
        if not any(
            symlink.startswith(interior + os.sep)
            for interior in exempt_interiors
        )
    ]
    if sorted(found) != sorted(expected_links):
        raise TransactionError(
            f"concurrent path drift: symlinks under {destination} are "
            f"{sorted(found)}, expected exactly {sorted(expected_links)}"
        )


def cmd_verify_local(name: str, journal, manifest_path) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    capture = _require_capture(events, path)
    _require_moved(events, path)
    _manifest, workspace = _load_workspace(manifest_path, name)
    destination = workspace.destination_path
    if not destination.is_dir():
        raise TransactionError(f"destination is missing: {destination}")
    if workspace.kind == "linked_worktree":
        _git_read(destination, "rev-parse", "--git-dir")
        owner_listing = _git_read(
            workspace.owner_path, "worktree", "list", "--porcelain"
        )
        if f"worktree {destination}" not in owner_listing.splitlines():
            raise TransactionError(
                f"owner repository does not list the moved worktree: "
                f"{destination}"
            )
    else:
        _verify_destination_links(events, capture, destination)
    _append_event(path, "local_verified", {"workspace": name})
    _print_journal(path)
    return 0


def _trash_directory(journal_path: str, category: str) -> Path:
    trash = Path(os.path.dirname(journal_path)) / "trash" / category
    os.makedirs(trash, mode=0o700, exist_ok=True)
    os.chmod(trash, 0o700)
    os.chmod(trash.parent, 0o700)
    return trash


def cmd_materialize_generated_paths(name: str, journal, manifest_path) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    capture = _require_capture(events, path)
    moved = _require_moved(events, path)
    verified = _latest(events, "local_verified")
    if verified is None or verified["sequence"] < moved["sequence"]:
        raise TransactionError(
            "verify-local must pass after the move before generated paths "
            "are materialized"
        )
    if _active(
        events, "generated_paths_materialized", "generated_paths_rolled_back"
    ):
        raise TransactionError(
            f"generated paths were already materialized: {path}"
        )
    _manifest, workspace = _load_workspace(manifest_path, name)
    destination = workspace.destination_path
    generated = [
        link
        for link in capture["payload"]["links"]
        if link["disposition"] == "materialize_generated_directory"
    ]
    checks = []
    for link in generated:
        link_path = destination / link["path"]
        try:
            info = os.lstat(link_path)
        except OSError as error:
            raise TransactionError(
                f"concurrent path drift: generated link is missing at "
                f"{link_path} ({error})"
            ) from error
        if not stat.S_ISLNK(info.st_mode):
            raise TransactionError(
                f"concurrent path drift: {link_path} is no longer a symlink"
            )
        if os.readlink(link_path) != link["link_text"]:
            raise TransactionError(
                f"concurrent path drift: link text changed at {link_path}"
            )
        if f"0o{stat.S_IMODE(info.st_mode):o}" != link["lstat_mode"]:
            raise TransactionError(
                f"concurrent path drift: link mode changed at {link_path}"
            )
        target = link["target"]
        try:
            target_info = os.lstat(target)
        except OSError as error:
            raise TransactionError(
                f"generated link target is missing: {target} ({error})"
            ) from error
        checks.append((link, link_path, target, target_info))
    trash = _trash_directory(path, "links")
    records = []
    for index, (link, link_path, target, target_info) in enumerate(checks):
        trash_path = trash / f"{index:03d}-{os.path.basename(link['path'])}"
        if os.path.lexists(trash_path):
            raise TransactionError(
                f"trash entry already exists: {trash_path}"
            )
        os.rename(link_path, trash_path)
        if os.path.lexists(link_path) or not os.path.islink(trash_path):
            raise TransactionError(
                f"materialization postcondition failed for {link_path}"
            )
        if os.readlink(trash_path) != link["link_text"]:
            raise TransactionError(
                f"trashed link no longer matches its capture: {trash_path}"
            )
        if not os.path.isdir(target):
            raise TransactionError(
                f"external target vanished during materialization: {target}"
            )
        records.append(
            {
                "path": link["path"],
                "link_text": link["link_text"],
                "lstat_mode": link["lstat_mode"],
                "target_policy": link["target_policy"],
                "post_smoke_type": link["post_smoke_type"],
                "trash_path": str(trash_path),
                "target": target,
                "target_dev": target_info.st_dev,
                "target_ino": target_info.st_ino,
            }
        )
    _append_event(path, "generated_paths_materialized", {"links": records})
    _print_journal(path)
    return 0


def cmd_rollback_generated_paths(name: str, journal, manifest_path) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    _require_capture(events, path)
    materialized = _active(
        events, "generated_paths_materialized", "generated_paths_rolled_back"
    )
    if materialized is None:
        raise TransactionError(
            f"journal records no active generated-path materialization: "
            f"{path}"
        )
    _manifest, workspace = _load_workspace(manifest_path, name)
    destination = workspace.destination_path
    plans = []
    for record in materialized["payload"]["links"]:
        trash_path = record["trash_path"]
        if not os.path.islink(trash_path):
            raise TransactionError(
                f"concurrent drift: trashed link is missing or altered: "
                f"{trash_path}"
            )
        if os.readlink(trash_path) != record["link_text"]:
            raise TransactionError(
                f"concurrent drift: trashed link text changed: {trash_path}"
            )
        link_path = destination / record["path"]
        replacement = False
        if os.path.lexists(link_path):
            info = os.lstat(link_path)
            if stat.S_ISLNK(info.st_mode):
                raise TransactionError(
                    f"concurrent drift: {link_path} is unexpectedly a "
                    f"symlink; refusing to overwrite it"
                )
            if not stat.S_ISDIR(info.st_mode):
                raise TransactionError(
                    f"concurrent drift: {link_path} is not a generated "
                    f"directory replacement"
                )
            replacement = True
        plans.append((record, link_path, replacement))
    trash = _trash_directory(path, "replacements")
    restored = []
    for index, (record, link_path, replacement) in enumerate(plans):
        if replacement:
            replacement_trash = (
                trash / f"{index:03d}-{os.path.basename(record['path'])}"
            )
            if os.path.lexists(replacement_trash):
                raise TransactionError(
                    f"trash entry already exists: {replacement_trash}"
                )
            os.rename(link_path, replacement_trash)
        os.rename(record["trash_path"], link_path)
        if (
            not os.path.islink(link_path)
            or os.readlink(link_path) != record["link_text"]
        ):
            raise TransactionError(
                f"rollback postcondition failed for {link_path}"
            )
        restored.append(record["path"])
    _append_event(
        path, "generated_paths_rolled_back", {"paths": restored}
    )
    _print_journal(path)
    return 0


def cmd_run_smoke(name: str, journal, manifest_path) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    capture = _require_capture(events, path)
    _require_moved(events, path)
    manifest, workspace = _load_workspace(manifest_path, name)
    destination = workspace.destination_path
    if not destination.is_dir():
        raise TransactionError(f"destination is missing: {destination}")
    if workspace.kind == "workspace":
        _verify_destination_links(events, capture, destination)
    drive_root = str(manifest.drive_root_path)
    transaction_tmp = tempfile.mkdtemp(prefix="drive-workspace-")
    os.chmod(transaction_tmp, 0o700)
    if _is_within(os.path.abspath(transaction_tmp), drive_root):
        # The tool provably just created this empty directory; remove it
        # before refusing so nothing is leaked inside the Drive root.
        os.rmdir(transaction_tmp)
        raise TransactionError(
            f"transaction temporary root resolved inside the Drive "
            f"root: {transaction_tmp}"
        )
    results: list[dict] = []
    failure: TransactionError | None = None
    try:
        for smoke in workspace.smoke:
            cwd = destination / smoke.cwd
            if not cwd.is_dir():
                raise TransactionError(
                    f"smoke cwd is missing: {cwd}"
                )
            env = dict(os.environ)
            for key, value in smoke.env.items():
                env[key] = value.replace(TRANSACTION_TMP, transaction_tmp)
            try:
                completed = subprocess.run(
                    list(smoke.argv),
                    cwd=str(cwd),
                    env=env,
                    shell=False,
                    capture_output=True,
                )
            except OSError as error:
                raise TransactionError(
                    f"smoke command could not run: "
                    f"{' '.join(smoke.argv)} ({error})"
                ) from error
            results.append(
                {
                    "argv": list(smoke.argv),
                    "cwd": str(cwd),
                    "status": completed.returncode,
                }
            )
            if completed.returncode != 0:
                failure = TransactionError(
                    f"smoke command failed with status "
                    f"{completed.returncode}: {' '.join(smoke.argv)}"
                )
                break
    except TransactionError as error:
        failure = error
    finally:
        tmp_abs = os.path.abspath(transaction_tmp)
        if _is_within(tmp_abs, drive_root):
            cleanup_note = (
                f"refusing to delete a temporary root inside the Drive "
                f"root: {transaction_tmp}"
            )
            if failure is None:
                failure = TransactionError(cleanup_note)
            else:
                print(f"drive-workspace: {cleanup_note}", file=sys.stderr)
        else:
            try:
                shutil.rmtree(transaction_tmp)
            except OSError as error:
                cleanup_note = (
                    f"temporary root cleanup failed: "
                    f"{transaction_tmp} ({error})"
                )
                if failure is None:
                    failure = TransactionError(cleanup_note)
                else:
                    # Never hide the original failure behind a cleanup error.
                    print(
                        f"drive-workspace: {cleanup_note}", file=sys.stderr
                    )
    if results or failure is None:
        _append_event(
            path,
            "smoke",
            {
                "results": results,
                "transaction_tmp": transaction_tmp,
                "completed": failure is None,
            },
        )
    if failure is not None:
        raise failure
    _print_journal(path)
    return 0


# --- rollback-local, finalize, verify-rollback, drill, program gates -------


def cmd_rollback_local(name: str, journal, manifest_path) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    capture = _require_capture(events, path)
    _require_moved(events, path)
    if _active(events, "consumers_applied", "consumers_rolled_back"):
        raise TransactionError(
            "consumer changes must be rolled back before the local path"
        )
    if _active(
        events, "generated_paths_materialized", "generated_paths_rolled_back"
    ):
        raise TransactionError(
            "generated paths must be rolled back before the local path"
        )
    _manifest, workspace = _load_workspace(manifest_path, name)
    source = workspace.source_path
    destination = workspace.destination_path
    if not os.path.lexists(destination):
        raise TransactionError(f"destination is missing: {destination}")
    if os.path.lexists(source):
        raise TransactionError(
            f"source position is occupied; refusing to collide: {source}"
        )
    parent = source.parent
    if not parent.is_dir():
        raise TransactionError(f"source parent is missing: {parent}")
    if _device_of(destination) != _device_of(parent):
        raise TransactionError(
            f"destination {destination} and source parent {parent} are on "
            f"different devices; os.rename would degrade to a copy"
        )
    if workspace.kind == "workspace":
        try:
            os.rename(destination, source)
        except OSError as error:
            raise TransactionError(
                f"rename failed: {destination} -> {source} ({error})"
            ) from error
    else:
        owner = workspace.owner_path
        _run_git(owner, ("worktree", "move", str(destination), str(source)))
        _run_git(owner, ("worktree", "repair"))
    current = _workspace_snapshot(workspace, source)
    if not _snapshots_match(current, capture["payload"]):
        raise TransactionError(
            "restored tree does not match the captured snapshot exactly; "
            "manual inspection is required before this transaction is "
            "considered rolled back"
        )
    _append_event(
        path,
        "local_rolled_back",
        {"source": str(source), "destination": str(destination)},
    )
    _print_journal(path)
    return 0


def _resolve_link_target(base: Path, link_path: str, link_text: str) -> str:
    if os.path.isabs(link_text):
        return os.path.normpath(link_text)
    return os.path.normpath(
        os.path.join(str((base / link_path).parent), link_text)
    )


def cmd_finalize_generated_paths(name: str, journal, manifest_path) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    _require_capture(events, path)
    materialized = _active(
        events, "generated_paths_materialized", "generated_paths_rolled_back"
    )
    if materialized is None:
        raise TransactionError(
            f"journal records no active generated-path materialization to "
            f"finalize: {path}"
        )
    if _latest(events, "rollback_window_closed") is None:
        raise TransactionError(
            "rollback_window_closed has not been recorded; the old targets "
            "stay recoverable until the rollback window is closed"
        )
    manifest, workspace = _load_workspace(manifest_path, name)
    finalized_targets = {
        target
        for event in events
        if event["event"] == "generated_target_finalized"
        for target in event["payload"]["targets"]
    }
    records = materialized["payload"]["links"]
    target_counts: dict[str, int] = {}
    for record in records:
        target_counts[record["target"]] = (
            target_counts.get(record["target"], 0) + 1
        )
    plans = []
    for record in records:
        target = record["target"]
        if record["target_policy"] != "disposable":
            continue
        if target in finalized_targets:
            continue
        if target_counts[target] > 1:
            raise TransactionError(
                f"target is ambiguous: {target} is claimed by more than one "
                f"materialized link"
            )
        for other_workspace in manifest.workspaces:
            for link in other_workspace.links:
                own_link = (
                    other_workspace.name == workspace.name
                    and link.path == record["path"]
                )
                for base in (
                    other_workspace.source_path,
                    other_workspace.destination_path,
                ):
                    candidate = _resolve_link_target(
                        base, link.path, link.link_text
                    )
                    if candidate != target:
                        continue
                    live_path = base / link.path
                    if not os.path.islink(live_path):
                        continue
                    if own_link:
                        # The record's own path was materialized away; a
                        # live symlink here means it was recreated behind
                        # the journal's back and still references the
                        # target.
                        raise TransactionError(
                            f"target is still referenced: the materialized "
                            f"link was recreated at {live_path}: {target}"
                        )
                    raise TransactionError(
                        f"target is shared with the live link "
                        f"{live_path} declared by workspace "
                        f"{other_workspace.name!r}: {target}"
                    )
        try:
            target_info = os.lstat(target)
        except OSError as error:
            raise TransactionError(
                f"target changed since materialization (now missing): "
                f"{target} ({error})"
            ) from error
        if (
            target_info.st_dev != record["target_dev"]
            or target_info.st_ino != record["target_ino"]
        ):
            raise TransactionError(
                f"target changed since materialization; refusing to "
                f"finalize: {target}"
            )
        if not stat.S_ISDIR(target_info.st_mode) or stat.S_ISLNK(
            target_info.st_mode
        ):
            raise TransactionError(
                f"target changed since materialization (not a directory): "
                f"{target}"
            )
        plans.append((record, target))
    if plans:
        trash = _trash_directory(path, "targets")
        finalized = []
        for index, (record, target) in enumerate(plans):
            trash_path = trash / f"{index:03d}-{os.path.basename(target)}"
            if os.path.lexists(trash_path):
                raise TransactionError(
                    f"trash entry already exists: {trash_path}"
                )
            os.rename(target, trash_path)
            finalized.append(target)
        _append_event(
            path, "generated_target_finalized", {"targets": finalized}
        )
    _print_journal(path)
    return 0


def cmd_verify_rollback(
    name: str, journal, baseline_journal, manifest_path
) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    baseline_path = _journal_abspath(baseline_journal)
    baseline_events = read_journal(baseline_path)
    _require_transaction_header(events, name, path)
    capture = _require_capture(events, path)
    rolled_back = _latest(events, "local_rolled_back")
    if rolled_back is None:
        raise TransactionError(
            f"journal records no local rollback to verify: {path}"
        )
    if _latest(events, "rollback_verified") is not None:
        raise TransactionError(
            f"rollback was already verified; the terminal event is "
            f"append-once: {path}"
        )
    _manifest, workspace = _load_workspace(manifest_path, name)
    source = workspace.source_path
    if not source.is_dir():
        raise TransactionError(f"restored source is missing: {source}")
    for link in capture["payload"]["links"]:
        link_path = source / link["path"]
        if (
            not os.path.islink(link_path)
            or os.readlink(link_path) != link["link_text"]
        ):
            raise TransactionError(
                f"generated-link preimage mismatch at {link_path}"
            )
    current = _workspace_snapshot(workspace, source)
    if not _snapshots_match(current, capture["payload"]):
        raise TransactionError(
            "local snapshot does not match the captured pre-move state"
        )
    for consumer in capture["payload"]["consumers"]:
        content = _read_text(
            consumer["path"], f"consumer {consumer['name']!r}"
        )
        if content != consumer["content"]:
            raise TransactionError(
                f"consumer preimage mismatch: {consumer['path']}"
            )
    current_state = _require_provider_evidence(name)
    journaled = _latest(events, "drive_state")
    if journaled is None:
        raise TransactionError(
            f"journal has no drive_state evidence to compare against: {path}"
        )
    baseline_state = _latest(baseline_events, "drive_state")
    if baseline_state is None:
        raise TransactionError(
            f"baseline journal has no drive_state evidence: {baseline_path}"
        )
    journaled_cloud = journaled["payload"]["evidence"].get("cloud")
    current_cloud = current_state.get("cloud")
    if not isinstance(journaled_cloud, dict) or not isinstance(
        current_cloud, dict
    ):
        raise TransactionError(
            "cloud identity evidence is missing from the provider or the "
            "journal"
        )
    if current_cloud.get("object_id") != journaled_cloud.get("object_id"):
        raise TransactionError(
            f"cloud object ID mismatch: "
            f"{current_cloud.get('object_id')!r} is not the original "
            f"{journaled_cloud.get('object_id')!r}"
        )
    if current_cloud.get("parent_id") != journaled_cloud.get("parent_id"):
        raise TransactionError(
            f"cloud parent mismatch: {current_cloud.get('parent_id')!r} is "
            f"not the original {journaled_cloud.get('parent_id')!r}"
        )
    duplicates = current_cloud.get("duplicates")
    if duplicates != []:
        raise TransactionError(
            f"replacement or duplicate cloud objects are present: "
            f"{duplicates!r}"
        )
    baseline_evidence = baseline_state["payload"]["evidence"]
    if current_state["queue_cursors"] != baseline_evidence["queue_cursors"]:
        raise TransactionError(
            "queue cursors are not stable against the supplied baseline"
        )
    if current_state["rows"] != baseline_evidence["rows"]:
        raise TransactionError(
            "native rows do not equal the supplied baseline"
        )
    _append_event(
        path,
        "rollback_verified",
        {
            "workspace": name,
            "baseline_journal": baseline_path,
            "baseline_final_hash": baseline_events[-1]["event_hash"],
        },
    )
    _print_journal(path)
    return 0


def cmd_request_rollback_drill(name: str, journal, manifest_path) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    capture = _require_capture(events, path)
    _manifest, workspace = _load_workspace(manifest_path, name)
    current_state = _require_provider_evidence(name)
    journaled = _latest(events, "drive_state")
    if journaled is None:
        raise TransactionError(
            f"record-drive-state evidence is required before a rollback "
            f"drill: {path}"
        )
    journaled_cloud = journaled["payload"]["evidence"].get("cloud")
    current_cloud = current_state.get("cloud")
    if not isinstance(journaled_cloud, dict) or not isinstance(
        current_cloud, dict
    ):
        raise TransactionError(
            "cloud identity evidence is missing from the provider or the "
            "journal"
        )
    if (
        current_cloud.get("object_id") != journaled_cloud.get("object_id")
        or current_cloud.get("parent_id") != journaled_cloud.get("parent_id")
    ):
        raise TransactionError(
            "cloud identity has not converged; refusing the rollback drill"
        )
    if current_cloud.get("duplicates") != []:
        raise TransactionError(
            f"replacement or duplicate cloud objects are present: "
            f"{current_cloud.get('duplicates')!r}"
        )
    source = workspace.source_path
    if not source.is_dir():
        raise TransactionError(f"workspace source is missing: {source}")
    current = _workspace_snapshot(workspace, source)
    if not _snapshots_match(current, capture["payload"]):
        raise TransactionError(
            "local state has drifted from the capture; refusing the "
            "rollback drill"
        )
    _append_event(
        path,
        "rollback_drill_requested",
        {"workspace": name, "evidence": current_state},
    )
    _print_journal(path)
    return 0


PROGRAM_GATES = (
    "native_record_convergence_passed",
    "after_resume_rollback_passed",
)


def cmd_record_program_gate(journal, gate: str, evidence_journal) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    if events[0]["journal_kind"] != "program":
        raise TransactionError(
            f"journal is a {events[0]['journal_kind']} journal, not a "
            f"program journal: {path}"
        )
    evidence_path = _journal_abspath(evidence_journal)
    evidence_events = read_journal(evidence_path)
    if evidence_events[0]["journal_kind"] != "transaction":
        raise TransactionError(
            f"evidence journal is not a transaction journal: {evidence_path}"
        )
    if gate == "native_record_convergence_passed":
        evidence = _latest(evidence_events, "drive_state")
        if evidence is None:
            raise TransactionError(
                f"evidence journal has no drive_state evidence for the "
                f"native convergence gate: {evidence_path}"
            )
        if "rows" not in evidence["payload"].get("evidence", {}):
            raise TransactionError(
                f"drive_state evidence carries no native rows: "
                f"{evidence_path}"
            )
    else:
        evidence = _latest(evidence_events, "rollback_verified")
        if evidence is None:
            raise TransactionError(
                f"evidence journal has no rollback_verified terminal event "
                f"for the after-resume gate: {evidence_path}"
            )
    _append_event(
        path,
        "program_gate",
        {
            "gate": gate,
            "evidence_journal": evidence_path,
            "evidence_transaction_id": evidence_events[0]["transaction_id"],
            "evidence_sequence": evidence["sequence"],
            "evidence_final_hash": evidence_events[-1]["event_hash"],
        },
    )
    _print_journal(path)
    return 0


# ---------------------------------------------------------------------------
# Live gates: processes, Emacs buffers, cloud identity, native UI, services
# ---------------------------------------------------------------------------

LSOF = "/usr/sbin/lsof"
PS = "/bin/ps"
OSASCRIPT = "/usr/bin/osascript"
# Deliberately PATH-resolved, not absolute: the dotfiles shim
# shell/shims/emacsclient must win when present (it repairs Emacs server
# socket discovery under an overridden TMPDIR), and its absolute path
# lives under the Drive tree this very migration relocates.  Hardcoding
# either candidate breaks one environment; PATH order picks the right
# one per invoking shell.
EMACSCLIENT = "emacsclient"
EMACS_BUFFER_QUERY = (
    "(json-encode (delq nil (mapcar #'buffer-file-name (buffer-list))))"
)
NATIVE_JXA_PATH = os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "drive-workspace-native.jxa"
)
NATIVE_PAGE_LIMIT = 100
PREFLIGHT_WINDOW_KEYS = (
    "AXRole", "AXIdentifier", "AXTitle", "AXDescription",
    "AXValue", "AXPosition", "AXSize", "AXWindowNumber",
)
SHA256_HEX_RE = re.compile(r"[0-9a-f]{64}")

OAUTH_FILE_ENV = "DRIVE_WORKSPACE_OAUTH_FILE"
DEFAULT_OAUTH_FILE = "~/.config/gdoc/accounts/personal/token.json"
GOOGLE_TOKEN_URI = "https://oauth2.googleapis.com/token"
DRIVE_API_ROOT = "https://www.googleapis.com/drive/v3"
DRIVE_FILE_FIELDS = (
    "id,name,parents,trashed,explicitlyTrashed,ownedByMe,driveId,mimeType,"
    "md5Checksum"
)
DRIVE_LIST_FIELDS = (
    "nextPageToken,incompleteSearch,"
    "files(id,name,parents,trashed,ownedByMe,driveId)"
)
CLOUD_PAGE_LIMIT = 100

SMOKE_STOP_TIMEOUT = 10.0
# Popen handles for smoke services started by this same process.  Real
# runs start and stop services from separate invocations, where this map
# is empty and reaping is a no-op; in-process callers (tests) need it so
# an exited child is reaped instead of lingering as a zombie that
# `ps -Ao pgid=,pid=` would misreport as a live group member.
_SMOKE_CHILDREN: dict = {}


def _run_tool(argv) -> subprocess.CompletedProcess:
    """Sole subprocess seam for live observers.

    Everything close-rollback-window and the native provider observe
    (lsof, emacsclient, osascript, ps) runs through this function with a
    structured argv, shell=False, and strict UTF-8 decoding, so tests can
    substitute recorded fixtures for the entire observation surface.
    """
    try:
        return subprocess.run(
            [str(item) for item in argv],
            shell=False,
            check=False,
            capture_output=True,
            encoding="utf-8",
            errors="strict",
        )
    except FileNotFoundError as error:
        raise TransactionError(
            f"required observer tool is missing: {argv[0]} ({error})"
        ) from error
    except UnicodeDecodeError as error:
        raise TransactionError(
            f"observer output is not valid UTF-8: {argv[0]} ({error})"
        ) from error


# --- Process and Emacs gates ----------------------------------------------


def _process_cwds() -> list:
    """(pid, cwd) for every observable process, via lsof field output.

    `lsof -Fn -a -d cwd` is parsed structurally (p/n field lines); no
    shell and no column splitting are involved.
    """
    completed = _run_tool([LSOF, "-Fn", "-a", "-d", "cwd"])
    if completed.returncode != 0:
        raise TransactionError(
            f"lsof -Fn -a -d cwd failed (status {completed.returncode}); "
            f"the process gate cannot observe"
        )
    records = []
    pid = None
    for line in completed.stdout.splitlines():
        if line.startswith("p"):
            try:
                pid = int(line[1:])
            except ValueError as error:
                raise TransactionError(
                    f"lsof output is unreadable: {line!r}"
                ) from error
        elif line.startswith("n") and pid is not None:
            records.append((pid, line[1:]))
    return records


def _emacs_visited_files() -> list:
    """Every file-visiting buffer path in the live Emacs session.

    Emacs is queried only with `emacsclient -e`; it is never signalled.
    The elisp expression returns a JSON array printed as an elisp string,
    which is decoded here fail-closed: any unreadable output is a
    blocker, never an empty success.
    """
    completed = _run_tool([EMACSCLIENT, "-e", EMACS_BUFFER_QUERY])
    if completed.returncode != 0:
        raise TransactionError(
            "emacsclient -e failed; the Emacs buffer gate cannot observe "
            "(is the Emacs server running?)"
        )
    raw = completed.stdout.strip()
    try:
        printed = json.loads(raw)
        value = json.loads(printed) if isinstance(printed, str) else printed
    except (json.JSONDecodeError, TypeError) as error:
        raise TransactionError(
            f"emacsclient buffer listing is unreadable: {raw!r} ({error})"
        ) from error
    if value is None:
        return []
    if not isinstance(value, list) or not all(
        isinstance(item, str) for item in value
    ):
        raise TransactionError(
            f"emacsclient buffer listing is unreadable: {raw!r}"
        )
    return value


def _require_no_live_source_users(source: str) -> None:
    """Block while any process cwd or Emacs buffer is below the source."""
    root = os.path.normpath(str(source))
    for pid, cwd in _process_cwds():
        if _is_within(os.path.normpath(cwd), root):
            raise TransactionError(
                f"process {pid} has its cwd below the source path "
                f"{root}: {cwd}"
            )
    for file_path in _emacs_visited_files():
        expanded = os.path.normpath(os.path.expanduser(file_path))
        if _is_within(expanded, root):
            raise TransactionError(
                f"an Emacs buffer visits {file_path} below the source "
                f"path {root}; close it before the window can close"
            )


# --- Cloud reader ----------------------------------------------------------


def _oauth_file_path() -> str:
    raw = os.environ.get(OAUTH_FILE_ENV) or DEFAULT_OAUTH_FILE
    return os.path.abspath(os.path.expanduser(raw))


def _load_oauth_credentials() -> dict:
    """Read the personal gdoc OAuth file at runtime only, never at import.

    The values are used solely to mint a short-lived access token over
    TLS; nothing from this file is ever printed, journaled, or included
    in an error message.
    """
    path = _oauth_file_path()
    try:
        raw = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise TransactionError(
            f"cloud OAuth credential file cannot be read: {path} "
            f"({type(error).__name__})"
        ) from error
    if not isinstance(raw, dict):
        raise TransactionError(
            f"cloud OAuth credential file is not a JSON object: {path}"
        )
    for key in ("refresh_token", "client_id", "client_secret"):
        value = raw.get(key)
        if not isinstance(value, str) or not value:
            raise TransactionError(
                f"cloud OAuth credential file is missing {key}: {path}"
            )
    token_uri = raw.get("token_uri") or GOOGLE_TOKEN_URI
    if not isinstance(token_uri, str) or not token_uri.startswith("https://"):
        raise TransactionError(
            f"cloud OAuth token_uri is not an https endpoint: {path}"
        )
    return {
        "refresh_token": raw["refresh_token"],
        "client_id": raw["client_id"],
        "client_secret": raw["client_secret"],
        "token_uri": token_uri,
    }


class _CloudReader:
    """Minimal fail-closed Google Drive v3 client over urllib.request.

    The only mutation it can express is files.update with trashed=false
    (for restore-cloud); there is no create, copy, upload, delete, or
    rename path.  The refreshed access token lives only in memory and in
    the Authorization header; it is never printed or journaled.
    """

    def __init__(self):
        credentials = _load_oauth_credentials()
        body = urllib.parse.urlencode(
            {
                "grant_type": "refresh_token",
                "refresh_token": credentials["refresh_token"],
                "client_id": credentials["client_id"],
                "client_secret": credentials["client_secret"],
            }
        ).encode("ascii")
        request = urllib.request.Request(
            credentials["token_uri"],
            data=body,
            method="POST",
            headers={"Content-Type": "application/x-www-form-urlencoded"},
        )
        payload = self._json(request)
        token = payload.get("access_token")
        if not isinstance(token, str) or not token:
            raise TransactionError(
                "the OAuth token refresh returned no usable access token"
            )
        self._token = token

    @staticmethod
    def _json(request) -> dict:
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                data = response.read()
        except urllib.error.HTTPError as error:
            raise TransactionError(
                f"cloud API request failed: {error.code} {error.reason} "
                f"({request.get_method()} "
                f"{request.full_url.split('?')[0]})"
            ) from error
        except (urllib.error.URLError, OSError) as error:
            raise TransactionError(
                f"cloud API request failed: {error}"
            ) from error
        try:
            payload = json.loads(data.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise TransactionError(
                f"cloud API response is not valid JSON ({error})"
            ) from error
        if not isinstance(payload, dict):
            raise TransactionError("cloud API response is not a JSON object")
        return payload

    def _api(self, method: str, path: str, params: dict, body=None) -> dict:
        url = f"{DRIVE_API_ROOT}/{path}"
        if params:
            url += "?" + urllib.parse.urlencode(params)
        data = None
        headers = {"Authorization": f"Bearer {self._token}"}
        if body is not None:
            data = json.dumps(body).encode("utf-8")
            headers["Content-Type"] = "application/json"
        request = urllib.request.Request(
            url, data=data, method=method, headers=headers
        )
        return self._json(request)

    def get_file(self, file_id: str) -> dict:
        return self._api(
            "GET",
            f"files/{urllib.parse.quote(str(file_id), safe='')}",
            {"fields": DRIVE_FILE_FIELDS, "supportsAllDrives": "true"},
        )

    def list_files(self, query: str, page_token: str | None = None) -> dict:
        params = {
            "q": query, "fields": DRIVE_LIST_FIELDS, "pageSize": "100",
        }
        if page_token is not None:
            params["pageToken"] = page_token
        return self._api("GET", "files", params)

    def clear_trashed(self, file_id: str) -> dict:
        """The ONLY mutation: files.update with {"trashed": false}."""
        return self._api(
            "PATCH",
            f"files/{urllib.parse.quote(str(file_id), safe='')}",
            {"fields": DRIVE_FILE_FIELDS, "supportsAllDrives": "true"},
            body={"trashed": False},
        )


def _latest_cloud_record(events: list, journal: str) -> dict:
    recorded = _latest(events, "cloud_recorded")
    if recorded is None:
        raise TransactionError(
            f"journal has no cloud_recorded event; record-cloud must run "
            f"first: {journal}"
        )
    return recorded["payload"]


def _escape_drive_query(value: str) -> str:
    return value.replace("\\", "\\\\").replace("'", "\\'")


def _parent_chain(reader: _CloudReader, meta: dict) -> list:
    """The [{id, name}, ...] chain from meta's parent up to its root."""
    chain = []
    seen = set()
    current = meta
    for _ in range(64):
        parents = current.get("parents")
        if not parents:
            return chain
        if not isinstance(parents, list) or len(parents) != 1:
            raise TransactionError(
                f"cloud parent chain for {current.get('id')!r} is "
                f"ambiguous: {parents!r}"
            )
        parent_id = parents[0]
        if parent_id in seen:
            raise TransactionError(
                "cloud parent chain loops; refusing the ambiguity"
            )
        seen.add(parent_id)
        parent = reader.get_file(parent_id)
        chain.append({"id": parent.get("id"), "name": parent.get("name")})
        current = parent
    raise TransactionError("cloud parent chain is too deep; refusing")


def _chain_root_id(reader: _CloudReader, meta: dict) -> str:
    chain = _parent_chain(reader, meta)
    return chain[-1]["id"] if chain else meta.get("id")


def _cloud_name_hits(reader: _CloudReader, record: dict) -> list:
    """Live objects sharing the journaled workspace object name."""
    return _cloud_live_name_hits(reader, record["object"]["name"])


def _cloud_live_name_hits(reader: _CloudReader, name: str) -> list:
    """Live objects sharing one name, across ALL listing pages.

    Every page must carry the expected fields; a truncated, incomplete,
    or looping listing is a blocker, never a silently shorter sweep.
    """
    query = f"name = '{_escape_drive_query(name)}' and trashed = false"
    hits: list = []
    seen_tokens: set = {None}
    token = None
    for _ in range(CLOUD_PAGE_LIMIT):
        listing = reader.list_files(query, page_token=token)
        if listing.get("incompleteSearch") is not False:
            raise TransactionError(
                "cloud listing is incomplete (incompleteSearch); the "
                "duplicate check is ambiguous and therefore a blocker"
            )
        files = listing.get("files")
        if not isinstance(files, list):
            raise TransactionError(
                "cloud listing returned no usable files array"
            )
        hits.extend(files)
        next_token = listing.get("nextPageToken")
        if next_token is None:
            return hits
        if not isinstance(next_token, str) or not next_token:
            raise TransactionError(
                "cloud listing returned an unusable next-page token"
            )
        if next_token in seen_tokens:
            raise TransactionError(
                f"cloud listing pagination loop on token {next_token!r}"
            )
        seen_tokens.add(next_token)
        token = next_token
    raise TransactionError("cloud listing pagination did not terminate")


def _classify_name_hits(
    reader: _CloudReader, record: dict, hits: list
) -> int:
    """Every live same-name object is a blocker of a specific class."""
    for hit in hits:
        hit_id = hit.get("id")
        if hit_id == record["object"]["id"]:
            raise TransactionError(
                f"old cloud object {hit_id} appears live in the name "
                f"listing; it is not trashed"
            )
        if record["parent_id"] in (hit.get("parents") or []):
            raise TransactionError(
                f"a live object occupies the old cloud path: {hit_id!r}"
            )
        root = _chain_root_id(reader, hit)
        if root == record["root_id"]:
            raise TransactionError(
                f"duplicate live cloud object {hit_id!r} shares the old "
                f"name under the journaled root"
            )
        raise TransactionError(
            f"computer-backup (machine root {root!r}) duplicate: "
            f"{hit_id!r}; the machine_root count must be zero"
        )
    return 0


def _cloud_verification(
    name: str, reader: _CloudReader, record: dict
) -> dict:
    object_id = record["object"]["id"]
    old = reader.get_file(object_id)
    if old.get("trashed") is not True:
        raise TransactionError(
            f"old cloud object {object_id} is not trashed"
        )
    if old.get("parents") != [record["parent_id"]]:
        raise TransactionError(
            f"old cloud object {object_id} has a changed parent "
            f"{old.get('parents')!r}; the journaled parent is "
            f"{record['parent_id']!r}"
        )
    if old.get("ownedByMe") is not True or old.get("driveId"):
        raise TransactionError(
            f"old cloud object {object_id} is not in My Drive "
            f"(is_my_drive must be 1)"
        )
    root = reader.get_file("root")
    if root.get("id") != record["root_id"]:
        raise TransactionError(
            f"cloud root ID mismatch: {root.get('id')!r} is not the "
            f"journaled root {record['root_id']!r}"
        )
    hits = _cloud_name_hits(reader, record)
    machine_count = _classify_name_hits(reader, record, hits)
    return {
        "workspace": name,
        "object_id": object_id,
        "parent_id": record["parent_id"],
        "root_id": record["root_id"],
        "machine_root_count": machine_count,
        "is_my_drive": 1,
    }


def cmd_record_cloud(name: str, journal) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    _require_capture(events, path)
    state = _latest(events, "drive_state")
    if state is None:
        raise TransactionError(
            f"journal has no drive_state evidence; record-drive-state "
            f"must run before record-cloud: {path}"
        )
    cloud_evidence = state["payload"]["evidence"].get("cloud")
    if not isinstance(cloud_evidence, dict) or not isinstance(
        cloud_evidence.get("object_id"), str
    ):
        raise TransactionError(
            f"drive_state evidence names no cloud object_id: {path}"
        )
    reader = _CloudReader()
    object_id = cloud_evidence["object_id"]
    obj = reader.get_file(object_id)
    if obj.get("id") != object_id:
        raise TransactionError(
            f"cloud object {object_id} refetched with a different ID: "
            f"{obj.get('id')!r}"
        )
    if not isinstance(obj.get("name"), str) or not obj["name"]:
        raise TransactionError(
            f"cloud object {object_id} has no usable name"
        )
    parents = obj.get("parents")
    if not isinstance(parents, list) or len(parents) != 1:
        raise TransactionError(
            f"cloud object {object_id} has an ambiguous parent set: "
            f"{parents!r}"
        )
    if obj.get("ownedByMe") is not True or obj.get("driveId"):
        raise TransactionError(
            f"cloud object {object_id} is not in My Drive "
            f"(is_my_drive must be 1)"
        )
    chain = _parent_chain(reader, obj)
    if not chain:
        raise TransactionError(
            f"cloud object {object_id} has no parent chain"
        )
    root = reader.get_file("root")
    if chain[-1]["id"] != root.get("id"):
        raise TransactionError(
            f"cloud object {object_id} does not chain to the My Drive "
            f"root {root.get('id')!r}"
        )
    _append_event(
        path,
        "cloud_recorded",
        {
            "workspace": name,
            "object": {
                "id": obj["id"],
                "name": obj["name"],
                "parents": parents,
                "mimeType": obj.get("mimeType"),
            },
            "parent_id": parents[0],
            "parent_chain": chain,
            "root_id": root["id"],
            "is_my_drive": 1,
        },
    )
    _print_journal(path)
    return 0


def cmd_verify_cloud(name: str, journal) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    record = _latest_cloud_record(events, path)
    reader = _CloudReader()
    summary = _cloud_verification(name, reader, record)
    _append_event(path, "cloud_verified", summary)
    _print_journal(path)
    return 0


def cmd_restore_cloud(name: str, journal) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    _require_capture(events, path)
    record = _latest_cloud_record(events, path)
    evidence = _require_pause_evidence(name)
    destination = events[0]["destination"]
    if not destination or not os.path.isdir(destination):
        raise TransactionError(
            f"the destination is missing outside Drive; refusing the "
            f"cloud restore: {destination}"
        )
    reader = _CloudReader()
    object_id = record["object"]["id"]
    old = reader.get_file(object_id)
    if old.get("trashed") is not True:
        raise TransactionError(
            f"old cloud object {object_id} is not in Trash; there is "
            f"nothing to restore"
        )
    if old.get("parents") != [record["parent_id"]]:
        raise TransactionError(
            f"old cloud object {object_id} has a changed parent "
            f"{old.get('parents')!r}; the journaled parent is "
            f"{record['parent_id']!r}"
        )
    for hit in _cloud_name_hits(reader, record):
        raise TransactionError(
            f"a live duplicate blocks the cloud restore: {hit.get('id')!r}"
        )
    reader.clear_trashed(object_id)
    refetched = reader.get_file(object_id)
    if (
        refetched.get("id") != object_id
        or refetched.get("trashed") is not False
        or refetched.get("parents") != [record["parent_id"]]
    ):
        raise TransactionError(
            f"the restored cloud object did not refetch at its original "
            f"parent: {refetched!r}"
        )
    _append_event(
        path,
        "cloud_restored",
        {
            "workspace": name,
            "object_id": object_id,
            "parents": refetched.get("parents"),
            "metadata": {
                key: refetched.get(key)
                for key in ("id", "name", "parents", "trashed", "mimeType")
            },
            "pause_evidence": evidence,
        },
    )
    _print_journal(path)
    return 0


# --- Native provider: preflight and error rows -----------------------------


def _run_native(args: list) -> dict:
    completed = _run_tool(
        [OSASCRIPT, "-l", "JavaScript", NATIVE_JXA_PATH, *args]
    )
    stderr = (completed.stderr or "").strip()
    if completed.returncode == 77:
        raise TransactionError(
            f"the native provider was denied Accessibility (exit 77): "
            f"{stderr}"
        )
    if completed.returncode != 0:
        raise TransactionError(
            f"the native provider failed (status {completed.returncode}): "
            f"{stderr}"
        )
    try:
        payload = json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        raise TransactionError(
            f"native provider output is not valid JSON ({error})"
        ) from error
    if not isinstance(payload, dict):
        raise TransactionError("native provider output is not an object")
    return payload


def cmd_native_preflight() -> int:
    payload = _run_native(["preflight"])
    window = payload.get("window")
    if not isinstance(window, dict):
        raise TransactionError(
            "native preflight payload has no window object"
        )
    for key in PREFLIGHT_WINDOW_KEYS:
        if key not in window:
            raise TransactionError(
                f"native preflight payload is missing the {key} attribute"
            )
    digest = payload.get("screenshot_sha256")
    if not isinstance(digest, str) or not SHA256_HEX_RE.fullmatch(digest):
        raise TransactionError(
            "native preflight payload has no usable screenshot hash"
        )
    if not isinstance(payload.get("captured_utc"), str):
        raise TransactionError(
            "native preflight payload has no capture time"
        )
    sys.stdout.write(canonical_json(payload))
    return 0


def _native_row_identity(row: dict) -> tuple:
    return (row["row_key"], row["path"], row["category"], row["text"])


def _native_row_record(
    row, page_index: int, captured: str, screenshot: str
) -> dict:
    if not isinstance(row, dict):
        raise TransactionError(
            f"native error row is unreadable (not an object): {row!r}"
        )
    unknown = set(row) - {
        "row_key", "path", "category", "text", "row_index", "annotation",
    }
    if unknown:
        raise TransactionError(
            f"native error row carries unknown fields "
            f"{sorted(unknown)}: {row!r}"
        )
    row_key = row.get("row_key")
    path = row.get("path")
    category = row.get("category")
    text = row.get("text")
    row_index = row.get("row_index")
    if (
        not isinstance(row_key, str) or not row_key
        or not isinstance(path, str) or not path
        or not isinstance(category, str)
        or not isinstance(text, str)
        or not isinstance(row_index, int) or isinstance(row_index, bool)
    ):
        raise TransactionError(f"native error row is unreadable: {row!r}")
    record = {
        "row_key": row_key,
        "path": path,
        "category": category,
        "text": text,
        "page_index": page_index,
        "row_index": row_index,
        "captured_utc": captured,
        "screenshot_sha256": screenshot,
    }
    annotation = row.get("annotation")
    if annotation is not None:
        # Log/database matches are optional annotations only; they can
        # never create or clear a native row.
        if not isinstance(annotation, str):
            raise TransactionError(
                f"native error row annotation is unreadable: {row!r}"
            )
        record["annotation"] = annotation
    return record


def _native_error_rows() -> list:
    """All visible native error rows via the sole tested JXA provider."""
    rows = []
    seen_keys = set()
    seen_tokens = {""}
    token = ""
    for page_index in range(NATIVE_PAGE_LIMIT):
        payload = _run_native(["list-errors", "--page-token", token])
        page_rows = payload.get("rows")
        screenshot = payload.get("screenshot_sha256")
        captured = payload.get("captured_utc")
        if (
            not isinstance(page_rows, list)
            or not isinstance(screenshot, str)
            or not SHA256_HEX_RE.fullmatch(screenshot)
            or not isinstance(captured, str) or not captured
        ):
            raise TransactionError(
                "native provider page is missing rows, a screenshot "
                "hash, or a capture time"
            )
        next_token = payload.get("next_page_token")
        if next_token is not None:
            if not isinstance(next_token, str) or not next_token:
                raise TransactionError(
                    "native provider returned an unusable next-page token"
                )
            if next_token in seen_tokens:
                raise TransactionError(
                    f"native provider pagination loop on token "
                    f"{next_token!r}"
                )
            seen_tokens.add(next_token)
        for row in page_rows:
            record = _native_row_record(
                row, page_index, captured, screenshot
            )
            if record["row_key"] in seen_keys:
                raise TransactionError(
                    f"duplicate native row key {record['row_key']!r}"
                )
            seen_keys.add(record["row_key"])
            rows.append(record)
        if next_token is None:
            return rows
        token = next_token
    raise TransactionError(
        "native provider pagination did not terminate"
    )


def cmd_record_native_errors(journal) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    if events[0]["journal_kind"] == "program":
        raise TransactionError(
            f"native errors cannot be recorded in a program journal: {path}"
        )
    rows = _native_error_rows()
    _append_event(path, "native_errors_recorded", {"rows": rows})
    _print_journal(path)
    return 0


# --- Process-group and Drive-process observation ---------------------------


def _reap_exited_children(pgid: int) -> None:
    """Reap this process's own exited children in one process group.

    Without this, a smoke service started and stopped by the same
    process would linger as a zombie that ps still lists, and the group
    could never read as exited.  Foreign processes are unaffected.
    """
    for process in list(_SMOKE_CHILDREN.values()):
        process.poll()
    while True:
        try:
            pid, _status = os.waitpid(-pgid, os.WNOHANG)
        except (ChildProcessError, OSError):
            return
        if pid == 0:
            return


def _process_group_members(pgid: int) -> list:
    _reap_exited_children(pgid)
    completed = _run_tool([PS, "-Ao", "pgid=,pid="])
    if completed.returncode != 0:
        raise TransactionError(
            f"ps -Ao pgid=,pid= failed (status {completed.returncode})"
        )
    members = []
    for line in completed.stdout.splitlines():
        parts = line.split()
        if len(parts) != 2:
            continue
        if parts[0] == str(pgid):
            try:
                members.append(int(parts[1]))
            except ValueError as error:
                raise TransactionError(
                    f"ps output is unreadable: {line!r}"
                ) from error
    return members


def _google_drive_pid() -> int:
    completed = _run_tool([PS, "-Axo", "pid=,comm="])
    if completed.returncode != 0:
        raise TransactionError(
            f"ps -Axo pid=,comm= failed (status {completed.returncode})"
        )
    pids = []
    for line in completed.stdout.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) != 2:
            continue
        pid_text, comm = parts
        if os.path.basename(comm) == "Google Drive":
            try:
                pids.append(int(pid_text))
            except ValueError as error:
                raise TransactionError(
                    f"ps output is unreadable: {line!r}"
                ) from error
    if len(pids) != 1:
        raise TransactionError(
            f"expected exactly one Google Drive process; found "
            f"{len(pids)}"
        )
    return pids[0]


# --- close-rollback-window -------------------------------------------------


def cmd_close_rollback_window(
    journal, baseline_journal, restart_before_pid: int
) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    header = events[0]
    baseline_path = _journal_abspath(baseline_journal)
    baseline_events = read_journal(baseline_path)
    if header["journal_kind"] == "path_repair":
        return _close_path_rollback_window(
            path, events, baseline_path, baseline_events, restart_before_pid
        )
    if header["journal_kind"] != "transaction":
        raise TransactionError(
            f"journal is a {header['journal_kind']} journal, not a "
            f"transaction journal: {path}"
        )
    name = header["workspace"]
    if _latest(events, "rollback_window_closed") is not None:
        raise TransactionError(
            f"the rollback window was already closed: {path}"
        )
    capture = _require_capture(events, path)
    _require_moved(events, path)
    materialized = _active(
        events, "generated_paths_materialized", "generated_paths_rolled_back"
    )
    if materialized is None:
        raise TransactionError(
            f"close-rollback-window requires an active "
            f"generated_paths_materialized event: {path}"
        )
    smokes = [
        event for event in events
        if event["event"] == "smoke"
        and event["payload"].get("completed") is True
        and event["sequence"] > materialized["sequence"]
    ]
    if len(smokes) != 1:
        raise TransactionError(
            f"exactly one successful run-smoke after materialization is "
            f"required; found {len(smokes)}"
        )
    smoke_sequence = smokes[0]["sequence"]
    if not any(
        event["event"] == "local_verified"
        and event["sequence"] > smoke_sequence
        for event in events
    ):
        raise TransactionError(
            "a successful verify-local after the accepted run-smoke is "
            "required"
        )
    if _latest(events, "consumers_verified") is None:
        raise TransactionError(
            "an explicit successful verify-consumers event is required "
            "(a workspace with no consumers still needs the no-op event)"
        )
    if _latest(events, "cloud_verified") is None:
        raise TransactionError(
            "a successful verify-cloud event is required"
        )
    record = _latest_cloud_record(events, path)
    baseline_native = _latest(baseline_events, "native_errors_recorded")
    if baseline_native is None:
        raise TransactionError(
            f"the baseline journal records no native_errors_recorded "
            f"evidence: {baseline_path}"
        )
    baseline_rows = {
        _native_row_identity(row)
        for row in baseline_native["payload"]["rows"]
    }
    source = header["source"]
    smoke_groups = sorted(
        {
            event["payload"]["pgid"]
            for event in events
            if event["event"] == "smoke_started"
        }
    )

    def observe() -> tuple:
        evidence = _require_provider_evidence(name)
        for row in _native_error_rows():
            if _native_row_identity(row) not in baseline_rows:
                raise TransactionError(
                    f"native error {row['row_key']!r} ({row['path']}) is "
                    f"not present in the baseline journal"
                )
        for consumer in capture["payload"]["consumers"]:
            content = _read_text(
                consumer["path"], f"consumer {consumer['name']!r}"
            )
            count = content.count(consumer["old"])
            if count:
                raise TransactionError(
                    f"consumer {consumer['name']!r} still contains "
                    f"{count} occurrence(s) of the old path: "
                    f"{consumer['path']}"
                )
        _require_no_live_source_users(source)
        reader = _CloudReader()
        _cloud_verification(name, reader, record)
        for pgid in smoke_groups:
            members = _process_group_members(pgid)
            if members:
                raise TransactionError(
                    f"smoke-start process group {pgid} is still live "
                    f"(pids {members})"
                )
        drive_pid = _google_drive_pid()
        if drive_pid == restart_before_pid:
            raise TransactionError(
                f"the Google Drive process ID {drive_pid} has not "
                f"changed; the required normal restart has not happened"
            )
        return evidence["queue_cursors"], drive_pid

    first_cursors, first_pid = observe()
    second_cursors, second_pid = observe()
    if first_cursors != second_cursors:
        raise TransactionError(
            "queue cursors are not stable across the "
            "close-rollback-window reads"
        )
    if first_pid != second_pid:
        raise TransactionError(
            "the Google Drive process changed between the "
            "close-rollback-window reads; a normal restart must settle "
            "before the window can close"
        )
    _append_event(
        path,
        "rollback_window_closed",
        {
            "workspace": name,
            "queue_cursors": second_cursors,
            "drive_pid": second_pid,
            "restart_before_pid": restart_before_pid,
            "baseline_journal": baseline_path,
            "baseline_final_hash": baseline_events[-1]["event_hash"],
        },
    )
    _print_journal(path)
    return 0


# --- Path repair -----------------------------------------------------------
#
# A path-repair transaction captures ONE in-Drive path (symlink, regular
# file, or directory), journals its exact preimage in a private mode-0700
# transaction directory, and can verify the intended final state and roll
# the path back locally and in the cloud.  Everything is fail-closed: an
# unknown object type, an escaped root, an unjournaled replacement, or
# missing pause evidence is a blocker, never a skipped check.

PATH_FINAL_TYPES = ("absent", "file", "directory")
GOOGLE_NATIVE_MIME_PREFIX = "application/vnd.google-apps."
FOLDER_MIME_TYPE = "application/vnd.google-apps.folder"


def _require_path_header(events: list, journal: str) -> dict:
    header = events[0]
    if header["journal_kind"] != "path_repair":
        raise TransactionError(
            f"journal is a {header['journal_kind']} journal, not a "
            f"path_repair journal: {journal}"
        )
    return header


def _require_path_capture(events: list, journal: str) -> dict:
    capture = _latest(events, "path_captured")
    if capture is None:
        raise TransactionError(
            f"journal has no path_captured event: {journal}"
        )
    return capture


def _require_journaled_root(path_abs: str) -> str:
    """The captured path's parent, required to be symlink-free."""
    parent = os.path.dirname(path_abs)
    if not os.path.isdir(parent):
        raise TransactionError(
            f"path parent is not a directory: {parent}"
        )
    real = os.path.realpath(parent)
    if real != parent:
        raise TransactionError(
            f"path resolves outside the journaled root: {parent} "
            f"traverses a symlink to {real}"
        )
    return parent


def _recheck_journaled_root(capture_payload: dict) -> None:
    parent = os.path.dirname(capture_payload["path"])
    real = os.path.realpath(parent)
    if real != capture_payload["root"]:
        raise TransactionError(
            f"path resolves outside the journaled root "
            f"{capture_payload['root']}: {real}"
        )


def _require_replacement_within_root(abs_replacement: str, root: str) -> None:
    """Require a sibling replacement to sit physically inside the root.

    Textual containment is not enough: a symlinked directory component
    would let the replacement physically escape the journaled root, so
    every existing component below the root must be a non-symlink and
    the fully resolved path must stay inside the resolved root.  Runs
    at capture AND again at verify/rollback, mirroring the root
    re-check, so a symlink introduced after capture is still a blocker.
    """
    if not _is_within(abs_replacement, root) or abs_replacement == root:
        raise TransactionError(
            f"replacement is outside the journaled root {root}: "
            f"{abs_replacement}"
        )
    current = root
    for component in os.path.relpath(abs_replacement, root).split(os.sep):
        current = os.path.join(current, component)
        try:
            info = os.lstat(current)
        except (FileNotFoundError, NotADirectoryError):
            # A missing component cannot be a symlink, and nothing can
            # exist below it; the leaf may legitimately not exist yet.
            break
        except OSError as error:
            raise TransactionError(
                f"replacement path cannot be observed: {current} "
                f"({error})"
            ) from error
        if stat.S_ISLNK(info.st_mode):
            raise TransactionError(
                f"replacement path traverses a symlink at {current}; it "
                f"escapes the journaled root: {abs_replacement}"
            )
    real_root = os.path.realpath(root)
    real = os.path.realpath(abs_replacement)
    if not _is_within(real, real_root) or real == real_root:
        raise TransactionError(
            f"replacement resolves outside the journaled root "
            f"{real_root}: {real}"
        )


def _path_git_observation(path_abs: str) -> dict | None:
    """Exact Git mode/status observation for one path, or None outside Git."""
    parent = os.path.dirname(path_abs)
    try:
        completed = subprocess.run(
            ["git", "-C", parent, "rev-parse", "--show-toplevel"],
            shell=False,
            check=False,
            capture_output=True,
            encoding="utf-8",
            errors="strict",
            env=dict(os.environ, GIT_OPTIONAL_LOCKS="0"),
        )
    except FileNotFoundError as error:
        raise TransactionError(
            f"git is unavailable for the path observation: {error}"
        ) from error
    except UnicodeDecodeError as error:
        raise TransactionError(
            f"git output is not valid UTF-8: {error}"
        ) from error
    if completed.returncode != 0:
        return None
    toplevel = completed.stdout.strip()
    rel = os.path.relpath(path_abs, toplevel)
    if rel.startswith(".."):
        return None
    ls_files = _run_git(Path(toplevel), ("ls-files", "-s", "-z", "--", rel))
    status = _run_git(
        Path(toplevel), ("status", "--porcelain=v2", "-z", "--", rel)
    )
    return {
        "toplevel": toplevel,
        "rel": rel,
        "ls_files": ls_files,
        "status": status,
        "tracked": bool(ls_files),
    }


def _git_status_entries(status_z: str) -> list:
    """Porcelain-v2 -z records; rename entries consume their second path."""
    tokens = status_z.split("\0")
    entries = []
    index = 0
    while index < len(tokens):
        token = tokens[index]
        index += 1
        if not token:
            continue
        entries.append(token)
        if token.startswith("2 "):
            index += 1
    return entries


def _require_clean_git_state(capture_payload: dict) -> dict | None:
    """Recompute the Git observation; any non-untracked entry is a blocker."""
    observation = _path_git_observation(capture_payload["path"])
    captured = capture_payload["git"]
    if (observation is None) != (captured is None):
        raise TransactionError(
            "Git repository membership changed since capture"
        )
    if observation is not None and observation["toplevel"] != captured["toplevel"]:
        raise TransactionError(
            f"Git toplevel changed since capture: "
            f"{observation['toplevel']!r} != {captured['toplevel']!r}"
        )
    if observation is not None:
        dirty = [
            entry for entry in _git_status_entries(observation["status"])
            if not entry.startswith("? ")
        ]
        if dirty:
            raise TransactionError(
                f"Git status for the path is not clean: {dirty!r}"
            )
    return observation


def _collect_directory_preimage(path_abs: str) -> tuple:
    """(entries, blobs) for a recursive directory preimage.

    Entries carry NUL-safe (strict-UTF-8, JSON-encoded) relative paths;
    sockets, devices, FIFOs, nested symlinks, hard links, and every other
    uncovered entry type are blockers rather than silently skipped.
    """
    entries: list[dict] = []
    blobs: dict[str, bytes] = {}
    pending = [path_abs]
    while pending:
        directory = pending.pop()
        for entry in _scan_sorted(Path(directory)):
            rel = os.path.relpath(entry.path, path_abs)
            try:
                rel.encode("utf-8", errors="strict")
            except UnicodeEncodeError as error:
                raise TransactionError(
                    f"preimage entry name cannot be read as UTF-8: "
                    f"{entry.path!r} ({error})"
                ) from error
            try:
                info = os.lstat(entry.path)
            except OSError as error:
                raise TransactionError(
                    f"preimage entry cannot be read: {entry.path} ({error})"
                ) from error
            mode = f"0o{stat.S_IMODE(info.st_mode):o}"
            if stat.S_ISDIR(info.st_mode):
                entries.append(
                    {"path": rel, "type": "directory", "mode": mode}
                )
                pending.append(entry.path)
            elif stat.S_ISREG(info.st_mode):
                if info.st_nlink > 1:
                    raise TransactionError(
                        f"preimage entry is a hard link (st_nlink="
                        f"{info.st_nlink}); an exact private preimage "
                        f"cannot cover it: {entry.path}"
                    )
                try:
                    data = Path(entry.path).read_bytes()
                except OSError as error:
                    raise TransactionError(
                        f"preimage content cannot be read: {entry.path} "
                        f"({error})"
                    ) from error
                digest = hashlib.sha256(data).hexdigest()
                blobs[digest] = data
                entries.append(
                    {
                        "path": rel,
                        "type": "file",
                        "mode": mode,
                        "size": info.st_size,
                        "sha256": digest,
                    }
                )
            else:
                raise TransactionError(
                    f"preimage entry type is not supported in a directory "
                    f"preimage: {entry.path}"
                )
    entries.sort(key=lambda record: record["path"])
    return entries, blobs


def _preimage_blob_root(journal_path: str) -> str:
    return os.path.join(os.path.dirname(journal_path), "preimage", "blobs")


def _write_preimage_blobs(journal_path: str, blobs: dict) -> None:
    """Write private mode-0600 fsynced preimage assets under the journal."""
    if not blobs:
        return
    blob_root = _preimage_blob_root(journal_path)
    os.makedirs(blob_root, mode=0o700)
    os.chmod(blob_root, 0o700)
    os.chmod(os.path.dirname(blob_root), 0o700)
    for digest in sorted(blobs):
        blob_path = os.path.join(blob_root, digest)
        fd = os.open(blob_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        try:
            os.fchmod(fd, 0o600)
            data = blobs[digest]
            if os.write(fd, data) != len(data):
                raise TransactionError(
                    f"preimage asset write was short: {blob_path}"
                )
            os.fsync(fd)
        finally:
            os.close(fd)


def _read_preimage_blob(blob_root: str, digest: str) -> bytes:
    blob_path = os.path.join(blob_root, digest)
    try:
        data = Path(blob_path).read_bytes()
    except OSError as error:
        raise TransactionError(
            f"private preimage asset is missing or unreadable: "
            f"{blob_path} ({error})"
        ) from error
    if hashlib.sha256(data).hexdigest() != digest:
        raise TransactionError(
            f"private preimage asset no longer matches its journaled "
            f"hash: {blob_path}"
        )
    return data


def cmd_capture_path(
    label: str, journal, path, replacements, final_type: str,
    target_policy: str,
) -> int:
    journal_path = _validate_new_journal_path(journal)
    path_abs = os.path.abspath(os.path.expanduser(str(path)))
    try:
        info = os.lstat(path_abs)
    except OSError as error:
        raise TransactionError(
            f"unknown current object: the path cannot be observed: "
            f"{path_abs} ({error})"
        ) from error
    root = _require_journaled_root(path_abs)
    if stat.S_ISLNK(info.st_mode):
        lstat_type = "symlink"
    elif stat.S_ISREG(info.st_mode):
        lstat_type = "file"
    elif stat.S_ISDIR(info.st_mode):
        lstat_type = "directory"
    else:
        raise TransactionError(
            f"unknown current object: only a symlink, regular file, or "
            f"directory can be captured: {path_abs}"
        )
    if target_policy == "disposable" and lstat_type != "symlink":
        raise TransactionError(
            "target_policy disposable applies only to a symlink preimage "
            "with an external target; declare retain instead"
        )
    replacement_paths: list[str] = []
    for replacement in replacements:
        abs_replacement = os.path.abspath(
            os.path.expanduser(str(replacement))
        )
        if not _is_within(abs_replacement, root) or abs_replacement == root:
            raise TransactionError(
                f"replacement is outside the journaled root {root}: "
                f"{abs_replacement}"
            )
        if abs_replacement != path_abs and not _is_within(
            abs_replacement, path_abs
        ):
            # Interior replacements live under the captured path itself
            # (a symlink until the repair lands) and are never renamed
            # independently; sibling replacements ARE renamed, so their
            # full component chain must be symlink-free.
            _require_replacement_within_root(abs_replacement, root)
        if abs_replacement in replacement_paths:
            raise TransactionError(
                f"replacement is declared twice: {abs_replacement}"
            )
        if abs_replacement != path_abs and os.path.lexists(abs_replacement):
            rinfo = os.lstat(abs_replacement)
            empty_file = (
                stat.S_ISREG(rinfo.st_mode) and rinfo.st_size == 0
            )
            empty_dir = (
                stat.S_ISDIR(rinfo.st_mode)
                and not os.listdir(abs_replacement)
            )
            if not (empty_file or empty_dir):
                raise TransactionError(
                    f"a nonempty replacement already occupies "
                    f"{abs_replacement}; capture refuses to journal over it"
                )
        replacement_paths.append(abs_replacement)
    mode = f"0o{stat.S_IMODE(info.st_mode):o}"
    blobs: dict[str, bytes] = {}
    if lstat_type == "symlink":
        link_text = os.readlink(path_abs)
        target = _resolve_link_target(
            Path(root), os.path.basename(path_abs), link_text
        )
        if not os.path.lexists(target):
            if target_policy == "disposable":
                raise TransactionError(
                    f"disposable link target is missing: {target}"
                )
            target_record = None
        else:
            tinfo = os.lstat(target)
            tmode = f"0o{stat.S_IMODE(tinfo.st_mode):o}"
            if stat.S_ISDIR(tinfo.st_mode) and not stat.S_ISLNK(
                tinfo.st_mode
            ):
                target_record = {
                    "path": target,
                    "lstat_type": "directory",
                    "lstat_mode": tmode,
                    "dev": tinfo.st_dev,
                    "ino": tinfo.st_ino,
                    "manifest": audit_filesystem(Path(target)),
                }
            elif stat.S_ISREG(tinfo.st_mode):
                target_record = {
                    "path": target,
                    "lstat_type": "file",
                    "lstat_mode": tmode,
                    "dev": tinfo.st_dev,
                    "ino": tinfo.st_ino,
                    "size": tinfo.st_size,
                    "sha256": _sha256_file(Path(target)),
                }
            else:
                raise TransactionError(
                    f"unknown current object: the link target type is "
                    f"unsupported: {target}"
                )
        source = {
            "lstat_type": "symlink",
            "lstat_mode": mode,
            "link_text": link_text,
            "target": target_record,
        }
    elif lstat_type == "file":
        if info.st_nlink > 1:
            raise TransactionError(
                f"the path is a hard link (st_nlink={info.st_nlink}); an "
                f"exact private preimage cannot cover it: {path_abs}"
            )
        try:
            data = Path(path_abs).read_bytes()
        except OSError as error:
            raise TransactionError(
                f"path content cannot be read: {path_abs} ({error})"
            ) from error
        digest = hashlib.sha256(data).hexdigest()
        blobs[digest] = data
        source = {
            "lstat_type": "file",
            "lstat_mode": mode,
            "size": info.st_size,
            "sha256": digest,
        }
    else:
        entries, blobs = _collect_directory_preimage(path_abs)
        source = {
            "lstat_type": "directory",
            "lstat_mode": mode,
            "entries": entries,
        }
    git_observation = _path_git_observation(path_abs)
    payload = {
        "label": label,
        "path": path_abs,
        "root": root,
        "final_type": final_type,
        "target_policy": target_policy,
        "replacements": replacement_paths,
        "source": source,
        "git": git_observation,
        "tracked": bool(git_observation and git_observation["tracked"]),
        "cloud_preimage": None,
    }
    _create_journal(
        journal_path,
        journal_kind="path_repair",
        label=label,
        source=path_abs,
    )
    _write_preimage_blobs(journal_path, blobs)
    _append_event(journal_path, "path_captured", payload)
    _print_journal(journal_path)
    return 0


def cmd_confirm_path_paused(journal) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    header = _require_path_header(events, path)
    _require_path_capture(events, path)
    evidence = _require_pause_evidence(header["label"])
    _append_event(
        path, "drive_paused",
        {"label": header["label"], "evidence": evidence},
    )
    _print_journal(path)
    return 0


def _load_content_manifest(manifest_path) -> dict:
    """Parse a NUL-safe SHA-256 content manifest into {relpath: sha256}."""
    absolute = os.path.abspath(os.path.expanduser(str(manifest_path)))
    try:
        data = Path(absolute).read_bytes()
    except OSError as error:
        raise TransactionError(
            f"content manifest cannot be read: {absolute} ({error})"
        ) from error
    if not data or not data.endswith(b"\0"):
        raise TransactionError(
            f"content manifest records must be nonempty and "
            f"NUL-terminated: {absolute}"
        )
    hashes: dict[str, str] = {}
    for record in data.split(b"\0")[:-1]:
        try:
            text = record.decode("utf-8", errors="strict")
        except UnicodeDecodeError as error:
            raise TransactionError(
                f"content manifest record is not valid UTF-8: {absolute} "
                f"({error})"
            ) from error
        digest, separator, rel = text.partition("  ")
        if not separator or not SHA256_HEX_RE.fullmatch(digest) or not rel:
            raise TransactionError(
                f"content manifest record is malformed: {text!r}"
            )
        if rel in hashes:
            raise TransactionError(
                f"content manifest repeats the path {rel!r}"
            )
        hashes[rel] = digest
    return hashes


def _check_content_manifest(capture_payload: dict, manifest_path) -> str:
    """Require the final content to match the manifest exactly."""
    final_type = capture_payload["final_type"]
    if final_type == "absent":
        raise TransactionError(
            "a content manifest can never verify an absent final state"
        )
    expected = _load_content_manifest(manifest_path)
    path_abs = capture_payload["path"]
    actual: dict[str, str] = {}
    if final_type == "file":
        actual["."] = _sha256_file(Path(path_abs))
    else:
        pending = [path_abs]
        while pending:
            directory = pending.pop()
            for entry in _scan_sorted(Path(directory)):
                info = os.lstat(entry.path)
                rel = os.path.relpath(entry.path, path_abs)
                if stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(
                    info.st_mode
                ):
                    pending.append(entry.path)
                elif stat.S_ISREG(info.st_mode):
                    actual[rel] = _sha256_file(Path(entry.path))
                else:
                    raise TransactionError(
                        f"the final directory contains an entry type the "
                        f"content manifest cannot cover: {entry.path}"
                    )
    if actual != expected:
        missing = sorted(set(expected) - set(actual))
        extra = sorted(set(actual) - set(expected))
        changed = sorted(
            rel for rel in set(actual) & set(expected)
            if actual[rel] != expected[rel]
        )
        raise TransactionError(
            f"content manifest mismatch: missing={missing} extra={extra} "
            f"changed={changed}"
        )
    return hashlib.sha256(
        Path(os.path.abspath(os.path.expanduser(str(manifest_path))))
        .read_bytes()
    ).hexdigest()


def cmd_verify_path_local(journal, manifest) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_path_header(events, path)
    capture = _require_path_capture(events, path)
    payload = capture["payload"]
    _recheck_journaled_root(payload)
    target_path = payload["path"]
    final_type = payload["final_type"]
    if final_type == "absent":
        if os.path.lexists(target_path):
            raise TransactionError(
                f"the declared final type is absent but something still "
                f"occupies {target_path}"
            )
    else:
        try:
            info = os.lstat(target_path)
        except OSError as error:
            raise TransactionError(
                f"the declared final type is {final_type} but the path "
                f"is missing: {target_path} ({error})"
            ) from error
        if stat.S_ISLNK(info.st_mode):
            raise TransactionError(
                f"a symlink is never accepted as a {final_type}: "
                f"{target_path}"
            )
        if final_type == "file" and not stat.S_ISREG(info.st_mode):
            raise TransactionError(
                f"the declared final type is file but the path is not a "
                f"regular file: {target_path}"
            )
        if final_type == "directory" and not stat.S_ISDIR(info.st_mode):
            raise TransactionError(
                f"the declared final type is directory but the path is "
                f"not a directory: {target_path}"
            )
    for replacement in payload["replacements"]:
        if _is_within(replacement, target_path):
            continue
        _require_replacement_within_root(replacement, payload["root"])
        if not os.path.lexists(replacement):
            raise TransactionError(
                f"journaled replacement is missing: {replacement}"
            )
        if os.path.islink(replacement):
            raise TransactionError(
                f"journaled replacement is a symlink: {replacement}"
            )
    observation = _require_clean_git_state(payload)
    manifest_sha = None
    if manifest is not None:
        manifest_sha = _check_content_manifest(payload, manifest)
    _append_event(
        path,
        "path_local_verified",
        {
            "label": payload["label"],
            "final_type": final_type,
            "git": observation,
            "manifest_sha256": manifest_sha,
        },
    )
    _print_journal(path)
    return 0


def _path_preimage_intact(target_path: str, source: dict) -> bool:
    """Whether the exact captured preimage still occupies the path."""
    if not os.path.lexists(target_path):
        return False
    info = os.lstat(target_path)
    kind = source["lstat_type"]
    if kind == "symlink":
        return (
            stat.S_ISLNK(info.st_mode)
            and os.readlink(target_path) == source["link_text"]
            and f"0o{stat.S_IMODE(info.st_mode):o}" == source["lstat_mode"]
        )
    if stat.S_ISLNK(info.st_mode):
        return False
    if f"0o{stat.S_IMODE(info.st_mode):o}" != source["lstat_mode"]:
        return False
    if kind == "file":
        if not stat.S_ISREG(info.st_mode):
            return False
        return _sha256_file(Path(target_path)) == source["sha256"]
    if not stat.S_ISDIR(info.st_mode):
        return False
    try:
        entries, _blobs = _collect_directory_preimage(target_path)
    except TransactionError:
        return False
    return entries == source["entries"]


def _require_journaled_occupant(target_path: str, payload: dict) -> None:
    """Only a journaled (or empty) replacement may be moved to Trash."""
    info = os.lstat(target_path)
    final_type = payload["final_type"]
    replacements = payload["replacements"]
    if stat.S_ISLNK(info.st_mode):
        if (
            payload["source"]["lstat_type"] == "symlink"
            and os.readlink(target_path)
            == payload["source"]["link_text"]
        ):
            # The journaled preimage link with a drifted mode: provably
            # this transaction's own object, so it may move to Trash and
            # be restored with the exact recorded mode.
            return
        raise TransactionError(
            f"an unjournaled symlink occupies the path; refusing to "
            f"trash it: {target_path}"
        )
    if target_path in replacements:
        if final_type == "file" and not stat.S_ISREG(info.st_mode):
            raise TransactionError(
                f"the same-path replacement changed type (final type is "
                f"file); refusing: {target_path}"
            )
        if final_type == "directory" and not stat.S_ISDIR(info.st_mode):
            raise TransactionError(
                f"the same-path replacement changed type (final type is "
                f"directory); refusing: {target_path}"
            )
        return
    interior = [
        replacement for replacement in replacements
        if _is_within(replacement, target_path)
        and replacement != target_path
    ]
    if stat.S_ISDIR(info.st_mode) and interior:
        entries, _blobs = _collect_directory_preimage(target_path)
        for record in entries:
            if record["type"] != "file":
                continue
            absolute = os.path.join(target_path, record["path"])
            if not any(
                absolute == replacement
                or _is_within(absolute, replacement)
                for replacement in interior
            ):
                raise TransactionError(
                    f"nonempty unjournaled replacement content at "
                    f"{absolute}; refusing to trash it"
                )
        return
    if stat.S_ISREG(info.st_mode) and info.st_size == 0:
        return
    if stat.S_ISDIR(info.st_mode) and not os.listdir(target_path):
        return
    raise TransactionError(
        f"a nonempty unjournaled replacement occupies the path; refusing "
        f"to trash it: {target_path}"
    )


def _discard_restore_staging(staging: str) -> None:
    """Remove the tool's own partially built restore staging area."""
    try:
        if os.path.islink(staging) or os.path.isfile(staging):
            os.unlink(staging)
        elif os.path.isdir(staging):
            shutil.rmtree(staging)
    except OSError:
        pass


def _restore_path_preimage(
    target_path: str, source: dict, journal_path: str
) -> None:
    """Atomically rebuild the exact preimage at the captured path."""
    if os.path.lexists(target_path):
        raise TransactionError(
            f"the path is still occupied; the replacement move did not "
            f"complete: {target_path}"
        )
    parent = os.path.dirname(target_path)
    staging = os.path.join(
        parent, f".drive-workspace-restore-{uuid.uuid4().hex}"
    )
    blob_root = _preimage_blob_root(journal_path)
    kind = source["lstat_type"]
    mode = int(source["lstat_mode"], 8)
    try:
        if kind == "symlink":
            os.symlink(source["link_text"], staging)
            if os.chmod in os.supports_follow_symlinks:
                os.chmod(staging, mode, follow_symlinks=False)
            current = stat.S_IMODE(os.lstat(staging).st_mode)
            if current != mode:
                raise TransactionError(
                    f"cannot restore the exact symlink mode "
                    f"{source['lstat_mode']} at {target_path}"
                )
        elif kind == "file":
            data = _read_preimage_blob(blob_root, source["sha256"])
            fd = os.open(
                staging, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600
            )
            try:
                if os.write(fd, data) != len(data):
                    raise TransactionError(
                        f"preimage restore write was short: {staging}"
                    )
                os.fsync(fd)
            finally:
                os.close(fd)
            os.chmod(staging, mode)
        else:
            os.mkdir(staging, 0o700)
            directories = [(staging, mode)]
            for record in source["entries"]:
                full = os.path.join(staging, record["path"])
                if record["type"] == "directory":
                    os.mkdir(full, 0o700)
                    directories.append((full, int(record["mode"], 8)))
                else:
                    data = _read_preimage_blob(blob_root, record["sha256"])
                    fd = os.open(
                        full, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600
                    )
                    try:
                        if os.write(fd, data) != len(data):
                            raise TransactionError(
                                f"preimage restore write was short: {full}"
                            )
                        os.fsync(fd)
                    finally:
                        os.close(fd)
                    os.chmod(full, int(record["mode"], 8))
            for full, directory_mode in reversed(directories):
                os.chmod(full, directory_mode)
        os.rename(staging, target_path)
    except OSError as error:
        _discard_restore_staging(staging)
        raise TransactionError(
            f"preimage restore failed: {target_path} ({error})"
        ) from error
    except TransactionError:
        _discard_restore_staging(staging)
        raise
    if not _path_preimage_intact(target_path, source):
        raise TransactionError(
            f"preimage restore postcondition failed: {target_path}"
        )


def cmd_rollback_path_local(journal) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    header = _require_path_header(events, path)
    capture = _require_path_capture(events, path)
    payload = capture["payload"]
    if _latest(events, "rollback_window_closed") is not None:
        raise TransactionError(
            f"the rollback window is closed; local rollback is "
            f"deliberately unavailable: {path}"
        )
    if _latest(events, "private_preimage_finalized") is not None:
        raise TransactionError(
            f"the private preimage was finalized; local rollback is no "
            f"longer possible: {path}"
        )
    if _latest(events, "path_local_rolled_back") is not None:
        raise TransactionError(
            f"the path was already rolled back: {path}"
        )
    paused = _latest(events, "drive_paused")
    if paused is None or paused["sequence"] < capture["sequence"]:
        raise TransactionError(
            "fresh pause evidence is missing: confirm-path-paused must "
            "succeed after capture and before rollback"
        )
    evidence = _require_pause_evidence(header["label"])
    _recheck_journaled_root(payload)
    target_path = payload["path"]
    source = payload["source"]
    preimage_intact = _path_preimage_intact(target_path, source)
    plans: list[str] = []
    if not preimage_intact and os.path.lexists(target_path):
        _require_journaled_occupant(target_path, payload)
        plans.append(target_path)
    for replacement in payload["replacements"]:
        if replacement == target_path or _is_within(
            replacement, target_path
        ):
            continue
        _require_replacement_within_root(replacement, payload["root"])
        if os.path.lexists(replacement):
            if os.path.islink(replacement):
                raise TransactionError(
                    f"the sibling replacement changed into a symlink; "
                    f"refusing to trash it: {replacement}"
                )
            plans.append(replacement)
    trash_records = []
    if plans:
        trash = _trash_directory(path, "replacements")
        for index, item in enumerate(plans):
            trash_path = trash / f"{index:03d}-{os.path.basename(item)}"
            if os.path.lexists(trash_path):
                raise TransactionError(
                    f"trash entry already exists: {trash_path}"
                )
            os.rename(item, trash_path)
            trash_records.append(
                {"path": item, "trash_path": str(trash_path)}
            )
    if not preimage_intact:
        _restore_path_preimage(target_path, source, path)
    _append_event(
        path,
        "path_local_rolled_back",
        {
            "label": header["label"],
            "restored": source["lstat_type"],
            "trash": trash_records,
            "pause_evidence": evidence,
        },
    )
    _print_journal(path)
    return 0


def cmd_record_path_cloud(journal) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    header = _require_path_header(events, path)
    capture = _require_path_capture(events, path)
    if _latest(events, "path_cloud_recorded") is not None:
        raise TransactionError(
            f"the cloud preimage was already recorded: {path}"
        )
    payload = capture["payload"]
    _recheck_journaled_root(payload)
    if not _path_preimage_intact(payload["path"], payload["source"]):
        raise TransactionError(
            "the local path no longer matches its captured preimage; "
            "record-path-cloud must snapshot the cloud before any local "
            "mutation"
        )
    name = os.path.basename(payload["path"])
    reader = _CloudReader()
    root = reader.get_file("root")
    root_id = root.get("id")
    if not isinstance(root_id, str) or not root_id:
        raise TransactionError("the cloud root has no usable ID")
    candidates = []
    for hit in _cloud_live_name_hits(reader, name):
        hit_root = _chain_root_id(reader, hit)
        if hit_root != root_id:
            raise TransactionError(
                f"computer-backup route: live object {hit.get('id')!r} "
                f"shares the name under machine root {hit_root!r}"
            )
        candidates.append(hit)
    if len(candidates) > 1:
        raise TransactionError(
            f"ambiguous name matches: {len(candidates)} live objects are "
            f"named {name!r} under My Drive; refusing to guess a preimage"
        )
    preimage = None
    parent_id = None
    chain = None
    if candidates:
        obj = reader.get_file(candidates[0]["id"])
        parents = obj.get("parents")
        if not isinstance(parents, list) or len(parents) != 1:
            raise TransactionError(
                f"cloud object {obj.get('id')!r} has an ambiguous parent "
                f"set: {parents!r}"
            )
        if obj.get("ownedByMe") is not True or obj.get("driveId"):
            raise TransactionError(
                f"cloud object {obj.get('id')!r} is not in My Drive "
                f"(is_my_drive must be 1)"
            )
        chain = _parent_chain(reader, obj)
        if not chain or chain[-1]["id"] != root_id:
            raise TransactionError(
                f"cloud object {obj.get('id')!r} does not chain to the "
                f"My Drive root {root_id!r}"
            )
        parent_id = parents[0]
        preimage = {
            "id": obj["id"],
            "name": obj.get("name"),
            "parents": parents,
            "mimeType": obj.get("mimeType"),
            "md5Checksum": obj.get("md5Checksum"),
        }
    _append_event(
        path,
        "path_cloud_recorded",
        {
            "label": header["label"],
            "name": name,
            "root_id": root_id,
            "cloud_preimage": preimage,
            "parent_id": parent_id,
            "parent_chain": chain,
        },
    )
    _print_journal(path)
    return 0


def _require_path_cloud_record(events: list, journal: str) -> dict:
    record = _latest(events, "path_cloud_recorded")
    if record is None:
        raise TransactionError(
            f"journal has no path_cloud_recorded event; record-path-cloud "
            f"must run first: {journal}"
        )
    return record["payload"]


def _path_cloud_verification(
    reader: _CloudReader, capture_payload: dict, record: dict
) -> dict:
    """The full fail-closed cloud check for one path repair."""
    final_type = capture_payload["final_type"]
    name = record["name"]
    root = reader.get_file("root")
    if root.get("id") != record["root_id"]:
        raise TransactionError(
            f"cloud root ID mismatch: {root.get('id')!r} is not the "
            f"journaled root {record['root_id']!r}"
        )
    preimage = record["cloud_preimage"]
    my_drive_hits = []
    for hit in _cloud_live_name_hits(reader, name):
        hit_root = _chain_root_id(reader, hit)
        if hit_root != record["root_id"]:
            raise TransactionError(
                f"computer-backup route: live object {hit.get('id')!r} "
                f"shares the name under machine root {hit_root!r}"
            )
        my_drive_hits.append(hit)
    old = None
    if preimage is not None:
        old = reader.get_file(preimage["id"])
        if old.get("parents") != preimage["parents"]:
            raise TransactionError(
                f"old cloud object {preimage['id']} has a changed parent "
                f"{old.get('parents')!r}; the journaled parent is "
                f"{record['parent_id']!r}"
            )
        if old.get("ownedByMe") is not True or old.get("driveId"):
            raise TransactionError(
                f"old cloud object {preimage['id']} is not in My Drive "
                f"(is_my_drive must be 1)"
            )
        if final_type == "absent" and old.get("trashed") is not True:
            raise TransactionError(
                f"old cloud object {preimage['id']} is not trashed"
            )
    final_id = None
    if final_type == "absent":
        for hit in my_drive_hits:
            hit_id = hit.get("id")
            if preimage is not None and hit_id == preimage["id"]:
                raise TransactionError(
                    f"old cloud object {hit_id} appears live in the name "
                    f"listing; it is not trashed"
                )
            if record["parent_id"] is not None and record["parent_id"] in (
                hit.get("parents") or []
            ):
                raise TransactionError(
                    f"a live object occupies the journaled cloud path: "
                    f"{hit_id!r}"
                )
            if preimage is None:
                raise TransactionError(
                    f"unexpected cloud creation: live object {hit_id!r} "
                    f"is named {name!r} but the journal records "
                    f"cloud_preimage: null"
                )
            raise TransactionError(
                f"duplicate live cloud object {hit_id!r} shares the name "
                f"under the journaled root"
            )
    else:
        if preimage is not None:
            candidates = [
                hit for hit in my_drive_hits
                if (hit.get("parents") or []) == preimage["parents"]
            ]
            for hit in my_drive_hits:
                if hit not in candidates:
                    raise TransactionError(
                        f"duplicate live cloud object {hit.get('id')!r} "
                        f"shares the name under the journaled root"
                    )
        else:
            candidates = my_drive_hits
        if len(candidates) != 1:
            raise TransactionError(
                f"the final cloud representation is ambiguous or missing: "
                f"{len(candidates)} live object(s) named {name!r} at the "
                f"expected parent"
            )
        final_obj = reader.get_file(candidates[0]["id"])
        final_id = final_obj.get("id")
        mime = final_obj.get("mimeType")
        if final_type == "directory":
            if mime != FOLDER_MIME_TYPE:
                raise TransactionError(
                    f"the final cloud object {final_id!r} is not a "
                    f"folder: {mime!r}"
                )
        else:
            if mime == FOLDER_MIME_TYPE:
                raise TransactionError(
                    f"a folder can never verify as the final file: "
                    f"{final_id!r}"
                )
            if isinstance(mime, str) and mime.startswith(
                GOOGLE_NATIVE_MIME_PREFIX
            ):
                if preimage is None or final_id != preimage["id"]:
                    raise TransactionError(
                        f"Google-native file {final_id!r} has no "
                        f"journaled ID; refusing the ambiguity"
                    )
            else:
                md5 = final_obj.get("md5Checksum")
                if not isinstance(md5, str) or not md5:
                    raise TransactionError(
                        f"unsupported hash coverage: the API exposes no "
                        f"content hash for {final_id!r}"
                    )
                local_path = capture_payload["path"]
                try:
                    local_info = os.lstat(local_path)
                except OSError as error:
                    raise TransactionError(
                        f"the local final file cannot be observed for "
                        f"the hash comparison: {local_path} ({error})"
                    ) from error
                if stat.S_ISLNK(local_info.st_mode) or not stat.S_ISREG(
                    local_info.st_mode
                ):
                    raise TransactionError(
                        f"the local final path is not a regular file; "
                        f"refusing to hash through it: {local_path}"
                    )
                try:
                    local_bytes = Path(local_path).read_bytes()
                except OSError as error:
                    raise TransactionError(
                        f"the local final file cannot be read for the "
                        f"hash comparison: {local_path} ({error})"
                    ) from error
                local_md5 = hashlib.md5(local_bytes).hexdigest()
                if md5 != local_md5:
                    raise TransactionError(
                        f"content hash mismatch for {final_id!r}: cloud "
                        f"md5 {md5} != local {local_md5}"
                    )
        if (
            old is not None
            and old.get("trashed") is not True
            and old.get("id") != final_id
        ):
            raise TransactionError(
                f"duplicate: the old cloud object {old.get('id')!r} is "
                f"still live beside the final object {final_id!r}"
            )
    return {
        "label": capture_payload["label"],
        "final_type": final_type,
        "name": name,
        "object_id": final_id,
        "root_id": record["root_id"],
        "machine_root_count": 0,
    }


def cmd_verify_path_cloud(journal, manifest) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_path_header(events, path)
    capture = _require_path_capture(events, path)
    record = _require_path_cloud_record(events, path)
    if manifest is not None:
        _check_content_manifest(capture["payload"], manifest)
    reader = _CloudReader()
    summary = _path_cloud_verification(reader, capture["payload"], record)
    _append_event(path, "path_cloud_verified", summary)
    _print_journal(path)
    return 0


def cmd_restore_path_cloud(journal) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    header = _require_path_header(events, path)
    _require_path_capture(events, path)
    record = _require_path_cloud_record(events, path)
    preimage = record["cloud_preimage"]
    if preimage is None:
        raise TransactionError(
            "the journal records cloud_preimage: null; there is no "
            "journaled preimage ID to restore"
        )
    evidence = _require_pause_evidence(header["label"])
    reader = _CloudReader()
    object_id = preimage["id"]
    old = reader.get_file(object_id)
    if old.get("trashed") is not True:
        raise TransactionError(
            f"old cloud object {object_id} is not in Trash; there is "
            f"nothing to restore"
        )
    if old.get("parents") != preimage["parents"]:
        raise TransactionError(
            f"old cloud object {object_id} has a changed parent "
            f"{old.get('parents')!r}; the journaled parent is "
            f"{record['parent_id']!r}"
        )
    for hit in _cloud_live_name_hits(reader, record["name"]):
        raise TransactionError(
            f"a live duplicate blocks the cloud restore: {hit.get('id')!r}"
        )
    reader.clear_trashed(object_id)
    refetched = reader.get_file(object_id)
    if (
        refetched.get("id") != object_id
        or refetched.get("trashed") is not False
        or refetched.get("parents") != preimage["parents"]
    ):
        raise TransactionError(
            f"the restored cloud object did not refetch at its original "
            f"parent: {refetched!r}"
        )
    _append_event(
        path,
        "path_cloud_restored",
        {
            "label": header["label"],
            "object_id": object_id,
            "parents": refetched.get("parents"),
            "pause_evidence": evidence,
        },
    )
    _print_journal(path)
    return 0


def _close_path_rollback_window(
    path: str, events: list, baseline_path: str, baseline_events: list,
    restart_before_pid: int,
) -> int:
    """Path-repair variant of close-rollback-window.

    Reuses the Task 5 evidence pattern: baseline native error rows, two
    stable provider observations, the live-user gates, a fresh cloud
    verification, and a Google Drive process that provably restarted.
    """
    header = events[0]
    label = header["label"]
    if _latest(events, "rollback_window_closed") is not None:
        raise TransactionError(
            f"the rollback window was already closed: {path}"
        )
    capture = _require_path_capture(events, path)
    verified = _latest(events, "path_local_verified")
    if verified is None or verified["sequence"] < capture["sequence"]:
        raise TransactionError(
            "a successful verify-path-local after capture is required"
        )
    if _latest(events, "path_cloud_verified") is None:
        raise TransactionError(
            "a successful verify-path-cloud event is required"
        )
    record = _require_path_cloud_record(events, path)
    baseline_native = _latest(baseline_events, "native_errors_recorded")
    if baseline_native is None:
        raise TransactionError(
            f"the baseline journal records no native_errors_recorded "
            f"evidence: {baseline_path}"
        )
    baseline_rows = {
        _native_row_identity(row)
        for row in baseline_native["payload"]["rows"]
    }

    def observe() -> tuple:
        evidence = _require_provider_evidence(label)
        for row in _native_error_rows():
            if _native_row_identity(row) not in baseline_rows:
                raise TransactionError(
                    f"native error {row['row_key']!r} ({row['path']}) is "
                    f"not present in the baseline journal"
                )
        _require_no_live_source_users(capture["payload"]["path"])
        reader = _CloudReader()
        _path_cloud_verification(reader, capture["payload"], record)
        drive_pid = _google_drive_pid()
        if drive_pid == restart_before_pid:
            raise TransactionError(
                f"the Google Drive process ID {drive_pid} has not "
                f"changed; the required normal restart has not happened"
            )
        return evidence["queue_cursors"], drive_pid

    first_cursors, first_pid = observe()
    second_cursors, second_pid = observe()
    if first_cursors != second_cursors:
        raise TransactionError(
            "queue cursors are not stable across the "
            "close-rollback-window reads"
        )
    if first_pid != second_pid:
        raise TransactionError(
            "the Google Drive process changed between the "
            "close-rollback-window reads; a normal restart must settle "
            "before the window can close"
        )
    _append_event(
        path,
        "rollback_window_closed",
        {
            "label": label,
            "queue_cursors": second_cursors,
            "drive_pid": second_pid,
            "restart_before_pid": restart_before_pid,
            "baseline_journal": baseline_path,
            "baseline_final_hash": baseline_events[-1]["event_hash"],
        },
    )
    _print_journal(path)
    return 0


def cmd_finalize_path(journal) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_path_header(events, path)
    capture = _require_path_capture(events, path)
    payload = capture["payload"]
    if _latest(events, "rollback_window_closed") is None:
        raise TransactionError(
            "rollback_window_closed has not been recorded; the preimage "
            "and target stay recoverable until the rollback window is "
            "closed"
        )
    if _latest(events, "private_preimage_finalized") is not None:
        raise TransactionError(
            f"the path repair was already finalized: {path}"
        )
    source = payload["source"]
    if payload["target_policy"] == "disposable":
        target = source["target"]
        target_path = target["path"]
        try:
            info = os.lstat(target_path)
        except OSError as error:
            raise TransactionError(
                f"target changed since capture (now missing): "
                f"{target_path} ({error})"
            ) from error
        if info.st_dev != target["dev"] or info.st_ino != target["ino"]:
            raise TransactionError(
                f"target changed since capture; refusing to finalize: "
                f"{target_path}"
            )
        if target["lstat_type"] == "directory":
            if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
                raise TransactionError(
                    f"target changed since capture (not a directory): "
                    f"{target_path}"
                )
            if audit_filesystem(Path(target_path)) != target["manifest"]:
                raise TransactionError(
                    f"target manifest changed since capture; refusing to "
                    f"finalize: {target_path}"
                )
        else:
            if not stat.S_ISREG(info.st_mode):
                raise TransactionError(
                    f"target changed since capture (not a regular file): "
                    f"{target_path}"
                )
            if _sha256_file(Path(target_path)) != target["sha256"]:
                raise TransactionError(
                    f"target hash changed since capture; refusing to "
                    f"finalize: {target_path}"
                )
        real_target = os.path.realpath(target_path)
        for link in scan_symlinks(Path(payload["root"])):
            resolved = os.path.realpath(link)
            if resolved == real_target or _is_within(
                resolved, real_target
            ):
                # A link to the target OR to anything inside it would
                # dangle if the target moved to Trash.
                raise TransactionError(
                    f"target is still referenced by the live symlink "
                    f"{link}: {target_path}"
                )
        trash = _trash_directory(path, "targets")
        trash_path = trash / f"000-{os.path.basename(target_path)}"
        if os.path.lexists(trash_path):
            raise TransactionError(
                f"trash entry already exists: {trash_path}"
            )
        os.rename(target_path, trash_path)
        _append_event(
            path,
            "path_target_finalized",
            {"target": target_path, "trash_path": str(trash_path)},
        )
    assets = []
    preimage_root = os.path.join(os.path.dirname(path), "preimage")
    if os.path.isdir(preimage_root):
        pending = [preimage_root]
        while pending:
            directory = pending.pop()
            for entry in _scan_sorted(Path(directory)):
                if entry.is_dir(follow_symlinks=False):
                    pending.append(entry.path)
                else:
                    assets.append(
                        {
                            "path": os.path.relpath(
                                entry.path, preimage_root
                            ),
                            "sha256": _sha256_file(Path(entry.path)),
                        }
                    )
        assets.sort(key=lambda record: record["path"])
        shutil.rmtree(preimage_root)
    _append_event(path, "private_preimage_finalized", {"assets": assets})
    _print_journal(path)
    return 0


# --- Smoke services --------------------------------------------------------


def _capture_service(capture: dict, service_name: str) -> dict:
    services = capture["payload"].get("runtime_services")
    if not isinstance(services, list):
        raise TransactionError(
            "the journal capture records no runtime services"
        )
    for service in services:
        if service.get("name") == service_name:
            return service
    raise TransactionError(
        f"no runtime service named {service_name!r} is journaled"
    )


def _active_smoke_start(events: list, service_name: str):
    started = [
        event for event in events
        if event["event"] == "smoke_started"
        and event["payload"].get("service") == service_name
    ]
    if not started:
        return None
    last = started[-1]
    stopped = [
        event for event in events
        if event["event"] == "smoke_stopped"
        and event["payload"].get("service") == service_name
        and event["sequence"] > last["sequence"]
    ]
    return None if stopped else last


def _require_port_bindable(port: int, message: str) -> None:
    probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        # SO_REUSEADDR keeps a lingering TIME_WAIT connection from
        # blocking the probe; a live listener is caught by the lsof
        # check in _require_port_free, which every caller uses.
        probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        probe.bind(("127.0.0.1", port))
    except OSError as error:
        raise TransactionError(f"{message} ({error})") from error
    finally:
        probe.close()


def _require_port_free(port: int, message: str) -> None:
    """Require no listener on the port at all, wildcard included.

    The SO_REUSEADDR bind probe alone would let a 0.0.0.0 listener pass
    a 127.0.0.1 bind, so the lsof listener sweep is also required to be
    empty.
    """
    _require_port_bindable(port, message)
    listeners = _port_listeners(port)
    if listeners:
        raise TransactionError(
            f"{message} (listening pids "
            f"{sorted(pid for pid, _pgid in listeners)})"
        )


def cmd_smoke_start(name: str, service_name: str, journal) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    capture = _require_capture(events, path)
    _require_moved(events, path)
    service = _capture_service(capture, service_name)
    if _active_smoke_start(events, service_name) is not None:
        raise TransactionError(
            f"smoke service {service_name!r} was already started and "
            f"not stopped: {path}"
        )
    port = service["port"]
    _require_port_free(
        port,
        f"an existing listener occupies port {port}; a pre-existing "
        f"listener can never satisfy a smoke",
    )
    destination = events[0]["destination"]
    cwd = os.path.normpath(os.path.join(destination, service["cwd"]))
    if not os.path.isdir(cwd):
        raise TransactionError(f"smoke service cwd is missing: {cwd}")
    log_path = os.path.join(
        os.path.dirname(path), f"smoke-{service_name}-{len(events)}.log"
    )
    fd = os.open(log_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    try:
        os.fchmod(fd, 0o600)
        try:
            process = subprocess.Popen(
                list(service["argv"]),
                cwd=cwd,
                stdin=subprocess.DEVNULL,
                stdout=fd,
                stderr=fd,
                shell=False,
                start_new_session=True,
            )
        except (OSError, ValueError) as error:
            raise TransactionError(
                f"smoke service could not start: {service['argv']!r} "
                f"({error})"
            ) from error
    finally:
        os.close(fd)
    try:
        pgid = os.getpgid(process.pid)
    except ProcessLookupError:
        # start_new_session=True made the child its own group leader, so
        # its group ID equals its PID even if it already exited.
        pgid = process.pid
    _SMOKE_CHILDREN[process.pid] = process
    _append_event(
        path,
        "smoke_started",
        {
            "service": service_name,
            "pid": process.pid,
            "pgid": pgid,
            "port": port,
            "log": log_path,
        },
    )
    _print_journal(path)
    return 0


def _port_listeners(port: int) -> list:
    """(pid, pgid) pairs for every listener on one loopback TCP port."""
    completed = _run_tool(
        [LSOF, "-nP", "-a", f"-iTCP:{port}", "-sTCP:LISTEN", "-Fpg"]
    )
    if completed.returncode == 1 and not completed.stdout.strip():
        return []
    if completed.returncode != 0:
        raise TransactionError(
            f"lsof listener query failed (status {completed.returncode})"
        )
    pairs = []
    pid = None
    for line in completed.stdout.splitlines():
        try:
            if line.startswith("p"):
                pid = int(line[1:])
            elif line.startswith("g") and pid is not None:
                pairs.append((pid, int(line[1:])))
        except ValueError as error:
            raise TransactionError(
                f"lsof output is unreadable: {line!r}"
            ) from error
    return pairs


def _check_service_http(service: dict, port: int) -> dict:
    url = f"http://127.0.0.1:{port}/"
    try:
        with urllib.request.urlopen(url, timeout=10) as response:
            status = response.status
            body = response.read(1 << 20)
    except (urllib.error.URLError, OSError) as error:
        raise TransactionError(
            f"smoke HTTP check failed: {url} ({error})"
        ) from error
    http_spec = service["http"]
    if "json_keys" in http_spec:
        try:
            payload = json.loads(body.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise TransactionError(
                f"smoke response is not valid JSON: {url} ({error})"
            ) from error
        if not isinstance(payload, dict) or set(payload) != set(
            http_spec["json_keys"]
        ):
            raise TransactionError(
                f"smoke response JSON keys "
                f"{sorted(payload) if isinstance(payload, dict) else None} "
                f"do not equal the manifest json_keys "
                f"{sorted(http_spec['json_keys'])}"
            )
        return {"status": status, "json_keys": sorted(payload)}
    if status != http_spec["status"]:
        raise TransactionError(
            f"smoke response status {status} is not the manifest's "
            f"exact {http_spec['status']}"
        )
    try:
        text = body.decode("utf-8")
    except UnicodeDecodeError as error:
        raise TransactionError(
            f"smoke response is not UTF-8 text: {url} ({error})"
        ) from error
    if http_spec["content_marker"] not in text:
        raise TransactionError(
            f"smoke response does not contain the manifest content "
            f"marker {http_spec['content_marker']!r}"
        )
    return {"status": status, "content_marker": http_spec["content_marker"]}


def cmd_smoke_check(name: str, service_name: str, journal) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    capture = _require_capture(events, path)
    started = _active_smoke_start(events, service_name)
    if started is None:
        raise TransactionError(
            f"no journaled smoke-start is active for service "
            f"{service_name!r}; a pre-existing listener can never "
            f"satisfy a smoke: {path}"
        )
    service = _capture_service(capture, service_name)
    port = started["payload"]["port"]
    pgid = started["payload"]["pgid"]
    listeners = _port_listeners(port)
    if not listeners:
        raise TransactionError(
            f"no process is listening on port {port} for service "
            f"{service_name!r}"
        )
    foreign = [
        listener_pid
        for listener_pid, listener_pgid in listeners
        if listener_pgid != pgid
    ]
    if foreign:
        raise TransactionError(
            f"the listener on port {port} is not owned by the journaled "
            f"process group {pgid} (pids {foreign})"
        )
    summary = _check_service_http(service, port)
    _append_event(
        path,
        "smoke_checked",
        {
            "service": service_name,
            "pgid": pgid,
            "port": port,
            "http": summary,
        },
    )
    _print_journal(path)
    return 0


def _await_group_exit(pgid: int, timeout: float) -> bool:
    deadline = time.monotonic() + timeout
    while True:
        if not _process_group_members(pgid):
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.1)


def cmd_smoke_stop(name: str, service_name: str, journal) -> int:
    path = _journal_abspath(journal)
    events = read_journal(path)
    _require_transaction_header(events, name, path)
    _require_capture(events, path)
    started = _active_smoke_start(events, service_name)
    if started is None:
        raise TransactionError(
            f"no journaled smoke-start is active for service "
            f"{service_name!r}: {path}"
        )
    pgid = started["payload"]["pgid"]
    port = started["payload"]["port"]
    try:
        os.killpg(pgid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    except PermissionError as error:
        raise TransactionError(
            f"cannot signal the journaled process group {pgid}: {error}"
        ) from error
    forced = False
    if not _await_group_exit(pgid, SMOKE_STOP_TIMEOUT):
        forced = True
        try:
            os.killpg(pgid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        except PermissionError as error:
            raise TransactionError(
                f"cannot signal the journaled process group {pgid}: "
                f"{error}"
            ) from error
        if not _await_group_exit(pgid, 5.0):
            raise TransactionError(
                f"process group {pgid} is still alive after SIGKILL"
            )
    _require_port_free(
        port,
        f"port {port} is still occupied by a listener after stopping "
        f"service {service_name!r}",
    )
    _append_event(
        path,
        "smoke_stopped",
        {"service": service_name, "pgid": pgid, "forced": forced},
    )
    _print_journal(path)
    return 0


# --- Command-line surface --------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="drive-workspace",
        description=(
            "Fail-closed tooling for migrating repositories out of Google Drive."
        ),
    )
    subparsers = parser.add_subparsers(dest="command")
    audit_parser = subparsers.add_parser(
        "audit",
        help="Audit filesystem and Git state read-only; nonzero if any "
        "symlink remains under the Drive root.",
    )
    audit_parser.add_argument(
        "--manifest", required=True, type=Path,
        help="Path to the migration manifest.",
    )

    def add_command(
        command: str,
        help_text: str,
        *,
        name_arg: bool = True,
        manifest: bool = False,
    ) -> argparse.ArgumentParser:
        subparser = subparsers.add_parser(command, help=help_text)
        if name_arg:
            subparser.add_argument(
                "name", help="Workspace name from the manifest."
            )
        subparser.add_argument(
            "--journal", required=True, help="Path to the journal."
        )
        if manifest:
            subparser.add_argument(
                "--manifest", required=True, type=Path,
                help="Path to the migration manifest.",
            )
        return subparser

    add_command(
        "capture",
        "Create the transaction journal and record audit state plus exact "
        "consumer preimages.",
        manifest=True,
    )
    init_parser = add_command(
        "init-journal",
        "Create an observation or program journal.",
        name_arg=False,
    )
    init_parser.add_argument(
        "--kind", required=True, choices=("observation", "program")
    )
    init_parser.add_argument("--label", required=True)
    add_command(
        "verify-journal",
        "Validate a journal's full hash chain read-only.",
        name_arg=False,
    )
    add_command(
        "record-drive-state",
        "Record provider-observed native Drive state and queue cursors.",
    )
    add_command(
        "confirm-drive-paused",
        "Require fresh provider evidence that Drive is paused with no "
        "outbound queue advancement.",
    )
    add_command(
        "move",
        "Atomically move the workspace after re-running every preflight "
        "gate.",
        manifest=True,
    )
    add_command(
        "apply-consumers",
        "Apply the journaled old/new consumer substitutions atomically.",
        manifest=True,
    )
    add_command(
        "verify-consumers",
        "Require no old value and exact new occurrence counts.",
        manifest=True,
    )
    add_command(
        "stage-consumers",
        "Stage exactly the manifest-owned hunks with git apply --cached.",
        manifest=True,
    )
    add_command(
        "verify-local",
        "Require every captured link intact (or its declared post-smoke "
        "type) at the destination.",
        manifest=True,
    )
    add_command(
        "materialize-generated-paths",
        "Move classified generated links to the recoverable trash.",
        manifest=True,
    )
    add_command(
        "run-smoke",
        "Run the manifest smoke records with an external per-transaction "
        "temporary root.",
        manifest=True,
    )
    add_command(
        "rollback-generated-paths",
        "Restore materialized generated links from the recoverable trash.",
        manifest=True,
    )
    add_command(
        "finalize-generated-paths",
        "After the rollback window closes, move unreferenced disposable "
        "targets to the recoverable trash.",
        manifest=True,
    )
    add_command(
        "rollback-consumers",
        "Restore consumer preimages and unstage manifest-owned hunks.",
        manifest=True,
    )
    add_command(
        "rollback-local",
        "Move the workspace back and require the exact captured snapshot.",
        manifest=True,
    )
    verify_rollback_parser = add_command(
        "verify-rollback",
        "After Drive resumes, verify the complete rollback and append the "
        "terminal event.",
        manifest=True,
    )
    verify_rollback_parser.add_argument(
        "--baseline-journal", required=True,
        help="Observation journal holding the native baseline.",
    )
    add_command(
        "request-rollback-drill",
        "Record the sole accepted deliberate-failure event after "
        "convergence checks.",
        manifest=True,
    )
    gate_parser = add_command(
        "record-program-gate",
        "Verify a transaction journal's evidence and record a program gate.",
        name_arg=False,
    )
    gate_parser.add_argument("--gate", required=True, choices=PROGRAM_GATES)
    gate_parser.add_argument("--evidence-journal", required=True)
    add_command(
        "record-cloud",
        "Record the old cloud object ID and parent chain via the Drive "
        "v3 reader.",
    )
    add_command(
        "verify-cloud",
        "Require the exact old object trashed, no live old path, no "
        "duplicate, and a matching root.",
    )
    add_command(
        "restore-cloud",
        "Clear only the journaled object's trashed field and refetch it "
        "at its original parent.",
    )
    subparsers.add_parser(
        "native-preflight",
        help="Run the JXA provider preflight; permission denial is a "
        "hard blocker.",
    )
    add_command(
        "record-native-errors",
        "Enumerate every visible native error row through the JXA "
        "provider.",
        name_arg=False,
    )
    close_parser = add_command(
        "close-rollback-window",
        "Re-run every live gate and append rollback_window_closed.",
        name_arg=False,
    )
    close_parser.add_argument(
        "--baseline-journal", required=True,
        help="Journal holding the native error baseline.",
    )
    close_parser.add_argument(
        "--restart-before-pid", required=True, type=int,
        help="Google Drive PID captured immediately before the required "
        "normal restart.",
    )
    capture_path_parser = subparsers.add_parser(
        "capture-path",
        help="Create a path-repair journal capturing one in-Drive path's "
        "exact preimage, target manifest, Git state, and replacements.",
    )
    capture_path_parser.add_argument(
        "label", help="Short label naming this path repair."
    )
    capture_path_parser.add_argument(
        "--journal", required=True,
        help="Path to the new path-repair journal below the state root.",
    )
    capture_path_parser.add_argument(
        "--path", required=True,
        help="Absolute path to capture; observed with lstat, never "
        "followed.",
    )
    capture_path_parser.add_argument(
        "--replacement", action="append", default=[], dest="replacements",
        help="Exact replacement path (repeatable); must resolve inside "
        "the journaled root.",
    )
    capture_path_parser.add_argument(
        "--final-type", required=True, choices=PATH_FINAL_TYPES,
        help="The intended final state of the path after the repair.",
    )
    capture_path_parser.add_argument(
        "--target-policy", required=True,
        choices=("disposable", "retain"),
        help="Whether finalize-path may move the symlink target to Trash.",
    )

    def add_path_command(
        command: str, help_text: str, *, content_manifest: bool = False
    ) -> argparse.ArgumentParser:
        subparser = subparsers.add_parser(command, help=help_text)
        subparser.add_argument(
            "--journal", required=True,
            help="Path to the path-repair journal.",
        )
        if content_manifest:
            subparser.add_argument(
                "--manifest",
                help="Optional NUL-safe SHA-256 content manifest: records "
                "of '<sha256><two spaces><relative path>' each terminated "
                "by NUL.  This is NOT the workspace migration manifest.",
            )
        return subparser

    add_path_command(
        "confirm-path-paused",
        "Require fresh characterized pause evidence for a path repair.",
    )
    add_path_command(
        "verify-path-local",
        "Require the declared final type, exact Git mode/status, and the "
        "optional content manifest.",
        content_manifest=True,
    )
    add_path_command(
        "rollback-path-local",
        "While paused, trash only journaled replacements and restore the "
        "exact recorded preimage.",
    )
    add_path_command(
        "record-path-cloud",
        "Snapshot the path's cloud preimage identity (or cloud_preimage: "
        "null) before mutation.",
    )
    add_path_command(
        "verify-path-cloud",
        "Require the final absent or regular cloud representation, "
        "content hashes, no duplicate, and no computer-backup route.",
        content_manifest=True,
    )
    add_path_command(
        "restore-path-cloud",
        "Clear trashed on only the journaled preimage IDs at their "
        "original parents.",
    )
    add_path_command(
        "finalize-path",
        "After the rollback window closes, trash a disposable target and "
        "remove only private preimage assets.",
    )
    for command, help_text in (
        ("smoke-start", "Start one manifest runtime service in its own "
         "process group with a journaled log."),
        ("smoke-check", "Require the journaled process group to own the "
         "listener and the manifest's exact HTTP contract."),
        ("smoke-stop", "Terminate only the journaled process group and "
         "require the port released."),
    ):
        smoke_parser = add_command(command, help_text)
        smoke_parser.add_argument(
            "--service", required=True,
            help="Runtime service name from the manifest.",
        )
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    arguments = parser.parse_args(argv)
    if arguments.command is None:
        parser.print_help(sys.stderr)
        return 2
    if arguments.command == "audit":
        return run_audit(arguments.manifest)
    handlers = {
        "capture": lambda a: cmd_capture(a.name, a.journal, a.manifest),
        "init-journal": lambda a: cmd_init_journal(a.journal, a.kind, a.label),
        "verify-journal": lambda a: cmd_verify_journal(a.journal),
        "record-drive-state": lambda a: cmd_record_drive_state(
            a.name, a.journal
        ),
        "confirm-drive-paused": lambda a: cmd_confirm_drive_paused(
            a.name, a.journal
        ),
        "move": lambda a: cmd_move(a.name, a.journal, a.manifest),
        "apply-consumers": lambda a: cmd_apply_consumers(
            a.name, a.journal, a.manifest
        ),
        "verify-consumers": lambda a: cmd_verify_consumers(
            a.name, a.journal, a.manifest
        ),
        "stage-consumers": lambda a: cmd_stage_consumers(
            a.name, a.journal, a.manifest
        ),
        "verify-local": lambda a: cmd_verify_local(
            a.name, a.journal, a.manifest
        ),
        "materialize-generated-paths": lambda a: (
            cmd_materialize_generated_paths(a.name, a.journal, a.manifest)
        ),
        "run-smoke": lambda a: cmd_run_smoke(a.name, a.journal, a.manifest),
        "rollback-generated-paths": lambda a: (
            cmd_rollback_generated_paths(a.name, a.journal, a.manifest)
        ),
        "finalize-generated-paths": lambda a: (
            cmd_finalize_generated_paths(a.name, a.journal, a.manifest)
        ),
        "rollback-consumers": lambda a: cmd_rollback_consumers(
            a.name, a.journal, a.manifest
        ),
        "rollback-local": lambda a: cmd_rollback_local(
            a.name, a.journal, a.manifest
        ),
        "verify-rollback": lambda a: cmd_verify_rollback(
            a.name, a.journal, a.baseline_journal, a.manifest
        ),
        "request-rollback-drill": lambda a: cmd_request_rollback_drill(
            a.name, a.journal, a.manifest
        ),
        "record-program-gate": lambda a: cmd_record_program_gate(
            a.journal, a.gate, a.evidence_journal
        ),
        "record-cloud": lambda a: cmd_record_cloud(a.name, a.journal),
        "verify-cloud": lambda a: cmd_verify_cloud(a.name, a.journal),
        "restore-cloud": lambda a: cmd_restore_cloud(a.name, a.journal),
        "native-preflight": lambda a: cmd_native_preflight(),
        "record-native-errors": lambda a: cmd_record_native_errors(
            a.journal
        ),
        "close-rollback-window": lambda a: cmd_close_rollback_window(
            a.journal, a.baseline_journal, a.restart_before_pid
        ),
        "capture-path": lambda a: cmd_capture_path(
            a.label, a.journal, a.path, a.replacements, a.final_type,
            a.target_policy,
        ),
        "confirm-path-paused": lambda a: cmd_confirm_path_paused(a.journal),
        "verify-path-local": lambda a: cmd_verify_path_local(
            a.journal, a.manifest
        ),
        "rollback-path-local": lambda a: cmd_rollback_path_local(a.journal),
        "record-path-cloud": lambda a: cmd_record_path_cloud(a.journal),
        "verify-path-cloud": lambda a: cmd_verify_path_cloud(
            a.journal, a.manifest
        ),
        "restore-path-cloud": lambda a: cmd_restore_path_cloud(a.journal),
        "finalize-path": lambda a: cmd_finalize_path(a.journal),
        "smoke-start": lambda a: cmd_smoke_start(
            a.name, a.service, a.journal
        ),
        "smoke-check": lambda a: cmd_smoke_check(
            a.name, a.service, a.journal
        ),
        "smoke-stop": lambda a: cmd_smoke_stop(
            a.name, a.service, a.journal
        ),
    }
    try:
        return handlers[arguments.command](arguments)
    except (ManifestError, AuditError, JournalError, TransactionError) as error:
        print(f"drive-workspace: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
