+# --- 1Password output policy -------------------------------------------------
+# Agents invoke 1Password through the `op-automations` and `op-desktop` brokers
+# as a matter of course; the guard's job is to keep a secret from reaching
+# agent output, not to forbid the invocation. Raw `op` stays denied for the
+# Touch ID routing reason documented in context/secrets.md. Each rule below
+# names a form whose stdout would carry a credential, and only those are denied.
+# (2026-09-02: the previous blanket denial of every broker call was an audit
+# agent's decision, not the owner's; it blocked `op-automations run` and drove
+# sessions to route around the guard.)
+
+OP_BROKER_RE='([^;&|[:space:]]*/)?(op-automations|op-desktop)'
+OP_WRAPPER_RE='(([^;&|[:space:]]*/)?(command|env|sudo|timeout|nice|exec|nohup|time|builtin)([[:space:]]+[^;&|[:space:]]+)*[[:space:]]+|[A-Za-z_][A-Za-z0-9_]*=[^;&|[:space:]]*[[:space:]]+)'
+
+op_policy_prepare() {
+  # Quoted literals are data; stderr redirects do not contain stdout; a
+  # command substitution captures its stdout, so its opening `$(` is replaced
+  # by a marker that no segment boundary matches.
+  mask_op_quoted_literals "$1" | sed -E \
+    -e 's/2>&1//g' \
+    -e 's/2>[[:space:]]*[^[:space:];&|]+//g' \
+    -e 's/\$\(/SUBST_/g'
+}
+
+op_policy_segments() {
+  # One simple command per line: split on newlines, `;`, `&&`, `||`, `&`.
+  # Pipes are kept inside a segment so its stdout destination stays visible.
+  printf '%s\n' "$1" | awk '{ gsub(/\|\||&&|;|&/, "\n"); print }'
+}
+
+op_segment_prints_secret() {
+  # Return 0 when a broker invocation in this segment would print a secret.
+  local seg="$1" rest sub program
+  rest=$(printf '%s' "$seg" | sed -E "s#^[[:space:]]*(${OP_WRAPPER_RE})*${OP_BROKER_RE}##")
+  [ "$rest" = "$seg" ] && return 1
+  case "$rest" in
+    [!\ \	]*) return 1 ;;  # a longer word such as op-desktop-foo
+  esac
+  # Global flags precede the subcommand. A flag without `=` takes the next
+  # word as its value unless that word is itself a subcommand.
+  sub="${rest#"${rest%%[![:space:]]*}"}"
+  local flag next
+  while [ "${sub#-}" != "$sub" ]; do
+    flag="${sub%%[[:space:]]*}"
+    sub="${sub#"$flag"}"; sub="${sub#"${sub%%[![:space:]]*}"}"
+    case "$flag" in *=*) continue ;; esac
+    next="${sub%%[[:space:]]*}"
+    case "$next" in
+      ""|read|run|inject|item|document|vault|user|group|whoami|signin|signout|account|connect|events-api|service-account|plugin|completion|update) ;;
+      *) sub="${sub#"$next"}"; sub="${sub#"${sub%%[![:space:]]*}"}" ;;
+    esac
+  done
+  local contained=1 jq_filtered=1 out_file=1
+  printf '%s' "$seg" | grep -qE '(^|[^0-9&])>|^[[:space:]]*[^|]*[^|&]\|([^|]|$)' && contained=0
+  printf '%s' "$seg" | grep -qE '\|[[:space:]]*jq([[:space:]]|$)' && jq_filtered=0
+  printf '%s' "$seg" | grep -qE -- '(^|[[:space:]])(-o|--out-file)([[:space:]=]|$)' && out_file=0
+  printf '%s' "$seg" | grep -qE -- '(^|[[:space:]])--reveal([^[:alnum:]_-]|$)' && return 0
+  case "$sub" in
+    read|read[\ \	]*)
+      [ $contained -eq 0 ] || return 0 ;;
+    item[\ \	]*list*|item[\ \	]*get*)
+      # Item summaries can carry secret-valued URL fields; JSON carries values.
+      { [ $jq_filtered -eq 0 ] || [ $contained -eq 0 ]; } || return 0 ;;
+    item[\ \	]*create*|item[\ \	]*edit*)
+      printf '%s' "$seg" | grep -qE -- '(^|[[:space:]])--format([[:space:]=]|$)' && \
+        [ $contained -ne 0 ] && return 0 ;;
+    item[\ \	]*share*) return 0 ;;
+    document[\ \	]*get*)
+      { [ $out_file -eq 0 ] || [ $contained -eq 0 ]; } || return 0 ;;
+    inject|inject[\ \	]*)
+      { [ $out_file -eq 0 ] || [ $contained -eq 0 ]; } || return 0 ;;
+    run|run[\ \	]*)
+      printf '%s' "$seg" | grep -qE -- '(^|[[:space:]])--no-masking([^[:alnum:]_-]|$)' && return 0
+      # The provisioned program itself must not dump its environment.
+      program=$(printf '%s' "$seg" | grep -oE '[[:space:]]--[[:space:]]+[^[:space:];&|]+' | head -1 | sed -E 's/^[[:space:]]--[[:space:]]+//')
+      case "${program##*/}" in
+        env|printenv|set|export|declare|typeset) return 0 ;;
+      esac ;;
+    service-account[\ \	]*create*|connect[\ \	]*token[\ \	]*create*|connect[\ \	]*server[\ \	]*create*|events-api[\ \	]*create*)
+      return 0 ;;
+  esac
+  return 1
+}
