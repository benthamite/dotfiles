#!/bin/bash

# Define the function to sync mail using mbsync
sync_channel() {
    channel="$1"
    echo "Starting sync for $channel"
    if mbsync -q "$channel"; then
        echo "Finished sync for $channel"
    else
        status=$?
        echo "Failed sync for $channel (exit $status)" >&2
        return "$status"
    fi
}

export -f sync_channel

# Check if the first argument is 'include-gmail-all'
include_gmail_all=false
if [ "$1" == "include-gmail-all" ]; then
    include_gmail_all=true
fi

# Generate a list of mbsync channels, excluding epoch (handled by gmail-maildir-sync)
if [ "$include_gmail_all" = true ]; then
    channels=$(grep '^Channel ' ~/.mbsyncrc | awk '{print $2}' | grep -v '^epoch-' | sort -u)
else
    channels=$(grep '^Channel ' ~/.mbsyncrc | awk '{print $2}' | grep -v '^epoch-' | grep -v -- '-all$' | sort -u)
fi

# Read the IMAP password once, from the personal 1Password Automation vault
# through its read-only service account, into a private temp file, so the
# parallel mbsync jobs below make one request instead of one per channel.
# mbsync-passcmd reads from this file when MBSYNC_PASSFILE is set. mu4e runs
# this every five minutes, so the read is the broker's cached one; see
# mbsync-passcmd for the reference.
MBSYNC_PASSFILE=$(mktemp -t mbsync-pass.XXXXXX)
chmod 600 "$MBSYNC_PASSFILE"
trap 'rm -f "$MBSYNC_PASSFILE"' EXIT
env -u MBSYNC_PASSFILE mbsync-passcmd > "$MBSYNC_PASSFILE"
export MBSYNC_PASSFILE

# Run gmail-maildir-sync for each Gmail-API account in background (no GPG
# needed), mbsync in foreground (mbsync needs GPG/pinentry which requires a TTY)
gmail-maildir-sync --account epoch sync &
EPOCH_PID=$!
gmail-maildir-sync --account forethought sync &
FORETHOUGHT_PID=$!

echo "$channels" | parallel --will-cite sync_channel
MBSYNC_STATUS=$?

# Wait on each PID so every account's failure is seen, not just the last one.
wait $EPOCH_PID
EPOCH_STATUS=$?
wait $FORETHOUGHT_PID
FORETHOUGHT_STATUS=$?

# Report each mailbox that synced to the shared heartbeat monitor, which
# alerts when one has not synced for two hours (claude/context/alerting.md).
# A failed report is printed but does not change the sync's exit status.
report_synced() {
    if [ "$2" -eq 0 ]; then
        "$HOME/repos/launchd/bin/launchd-heartbeat.py" send "mail-sync-$1" ||
            echo "Failed to report mail-sync-$1 heartbeat" >&2
    fi
}
report_synced personal "$MBSYNC_STATUS"
report_synced epoch "$EPOCH_STATUS"
report_synced forethought "$FORETHOUGHT_STATUS"

for status in "$EPOCH_STATUS" "$FORETHOUGHT_STATUS"; do
    if [ "$status" -ne 0 ]; then
        exit "$status"
    fi
done
exit "$MBSYNC_STATUS"
