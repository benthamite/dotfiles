#!/usr/bin/env python3
"""Copy a Slack draft to the Emacs kill ring and optionally prefill a reply."""

import argparse
import contextlib
import importlib.util
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path


class UncertainResult(RuntimeError):
    """The client did not prove whether the operation changed Emacs."""


def run_emacs_eval(expr: str, socket: str) -> str:
    expr = f"(let ((debug-on-error nil)) (condition-case nil {expr} (error 'draft-stage-failed)))"
    try:
        result = subprocess.run(
            ["emacsclient", "--socket-name", socket,
             "--alternate-editor", "false", "--eval", expr],
            check=False, capture_output=True, text=True, timeout=65,
        )
    except subprocess.TimeoutExpired:
        raise TimeoutError("Emacs result uncertain; do not retry") from None
    except (UnicodeError, subprocess.SubprocessError):
        raise UncertainResult("Emacs result could not be decoded") from None
    except OSError:
        raise RuntimeError("Emacs client failed") from None
    out = (result.stdout or "").strip()
    if result.returncode != 0 or out not in {
        "draft-ring-staged", "draft-composer-staged", "draft-opened"
    }:
        raise UncertainResult("Emacs staging was not acknowledged")
    return out


def elisp_string(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def copy_to_kill_ring(path: Path, socket: str) -> None:
    expr = f"""(condition-case nil
      (let* ((draft (with-temp-buffer
                     (let ((coding-system-for-read 'utf-8-unix))
                       (insert-file-contents {elisp_string(str(path))}))
                     (buffer-string)))
             (interprogram-cut-function nil)
             (interprogram-paste-function nil)
             (save-interprogram-paste-before-kill nil)
             (original-transform kill-transform-function)
             (accepted nil)
             (kill-transform-function
              (lambda (text)
                (let ((value (if original-transform
                                 (funcall original-transform text) text)))
                  (setq accepted (and (stringp value) (equal-including-properties value draft)))
                  (and accepted value)))))
        (kill-new (copy-sequence draft))
        (unless (and accepted (equal-including-properties (car kill-ring) draft)
                     (eq kill-ring-yank-pointer kill-ring))
          (error "Staging rejected"))
        'draft-ring-staged)
      (error 'draft-ring-failed))"""
    if run_emacs_eval(expr, socket) != "draft-ring-staged":
        raise UncertainResult("Kill-ring staging was not acknowledged")


def permalink_info(permalink: str) -> dict:
    spec = importlib.util.spec_from_file_location("draft_slack_parser", Path(__file__).with_name("slack.py"))
    module = importlib.util.module_from_spec(spec)
    # Compile source directly: importing this sibling must not write a cache
    # beside the maintained scripts inside Drive.
    exec(compile(Path(spec.origin).read_bytes(), spec.origin, "exec"), module.__dict__)
    module._workspace = "epoch"
    return module.parse_permalink(permalink)


def composer_expression(expr: str) -> str:
    # Cancellation must not re-run the hook that caused an insertion mismatch.
    return """(progn (require 'cl-lib)
      (cl-macrolet ((draft-atomic (&rest body)
        `(let ((draft-group (prepare-change-group)))
           (unwind-protect
               (progn (activate-change-group draft-group)
                      ,@body
                      (accept-change-group draft-group)
                      (setq draft-group nil))
             (when draft-group
               (let ((inhibit-modification-hooks t))
                 (cancel-change-group draft-group)))))))
    """ + expr.replace("(atomic-change-group", "(draft-atomic") + "))"


def prefill_slack_reply(permalink: str, path: Path | None, socket: str) -> str:
    info = permalink_info(permalink)
    expr = f"""
(progn
  (require 'cl-lib)
  (require 'eieio)
  (require 'subr-x)
  (require 'slack-team nil t)
  (unless (fboundp 'slack-conversations-replies)
    (require 'slack-conversations nil t))
  (unless (fboundp 'slack-conversations-replies)
    (error "slack-conversations-replies is not available"))
  (unless (fboundp 'slack-create-thread-message-buffer)
    (require 'slack-thread-message-buffer nil t))
  (unless (fboundp 'slack-create-thread-message-buffer)
    (error "slack-create-thread-message-buffer is not available"))
  (let* ((info (list :team-domain {elisp_string(info['team_domain'])}
                     :room-id {elisp_string(info['channel'])}
                     :ts {elisp_string(info['message_ts'])}
                     :thread-ts {elisp_string(info['thread_ts']) if info['thread_ts'] else 'nil'}))
         (team-domain (plist-get info :team-domain))
         (room-id (plist-get info :room-id))
         (ts (plist-get info :ts))
         (thread-ts (plist-get info :thread-ts))
         (target-ts (or thread-ts ts))
         (team (slack-team-find-by-domain team-domain)))
    (unless (and team-domain room-id ts)
      (error "Could not resolve Slack permalink: %s"
             {elisp_string(permalink)}))
    (unless team
      (error "No registered Slack team for %s" team-domain))
    (unless (slack-team-connectedp team)
      (error "Epoch Slack is disconnected"))
    (let ((room (slack-room-find room-id team)))
      (unless room
        (error "Slack room %s is not loaded for team %s"
               room-id (oref team name)))
      (let ((deadline (+ (float-time) 30))
            result
            failure
            done)
        (cl-labels
            ((finish-with-error
             (err)
              (unless done
                (setq failure err
                      done t)))
             (safe-error-value
              (value)
              (cond
               ((stringp value) value)
               ((symbolp value) (symbol-name value))))
             (request-error
              (&rest args)
              (let* ((data (plist-get args :data))
                     (detail
                      (or
                       (and
                        (listp data)
                        (safe-error-value
                         (plist-get data :error)))
                       (safe-error-value
                        (plist-get args :symbol-status))
                       (safe-error-value
                        (plist-get args :error-thrown))
                       (safe-error-value (car args))
                       "request failed")))
                ;; Never format the complete response object: request.el keeps
                ;; request headers, including Slack credentials, inside it.
                (finish-with-error
                 (list
                  'error
                  (format
                   "Slack failed to fetch reply target %s in %s: %s"
                   target-ts room-id detail)))))
             (stage
              (messages _next-cursor has-more)
              (unless done
                ;; The request can finish while the wait loop is crossing its
                ;; deadline.  Check again before touching Slack or Emacs state.
                (if (>= (float-time) deadline)
                    (setq done 'expired)
                  (condition-case err
                      (progn
                        (unless messages
                          (error
                           "Slack returned no message for %s in %s"
                           target-ts room-id))
                        (unless (cl-some (lambda (message) (equal (slack-ts message) ts)) messages)
                          (error "Linked message was not verified in the fetched thread page"))
                        (slack-room-set-messages room messages team)
                        (slack-message-set-replies
                         room target-ts messages)
                        (let ((parent
                               (slack-room-find-message
                                room target-ts)))
                          (unless parent
                            (error
                             "Slack did not load message %s in %s"
                             target-ts room-id))
                          (let* ((thread
                                  (slack-create-thread-message-buffer
                                   room team target-ts has-more))
                                 (buf
                                  (progn
                                    ;; A cached object may predate this fetch.
                                    (when (eieio-object-p thread)
                                      (setf
                                       (slot-value thread 'has-more)
                                       has-more))
                                    (slack-thread--sync-buffer
                                     thread parent room)
                                    (slack-buffer-buffer thread)))
                                 (draft
                                  (when { 't' if path else 'nil' }
                                   (with-temp-buffer
                                    (let ((coding-system-for-read 'utf-8-unix))
                                      (insert-file-contents
                                       {elisp_string(str(path))}))
                                    (buffer-string)))))
                            (unless (buffer-live-p buf)
                              (error
                               "Slack reply buffer is not live for %s in %s"
                               target-ts room-id))
                            (if (null draft)
                                (progn (let ((slack-debug t)) (slack-buffer-display thread))
                                       (unless (eq (window-buffer (selected-window)) buf)
                                         (error "Target was not selected"))
                                       (setq result 'draft-opened done t))
                             (with-current-buffer buf
                              (unless
                                  (and
                                   (markerp lui-input-marker)
                                   (eq
                                    (marker-buffer lui-input-marker)
                                    buf))
                                (error
                                 "Slack reply input is not available in %s"
                                 (buffer-name buf)))
                              (let ((existing
                                     (buffer-substring-no-properties
                                      lui-input-marker (point-max))))
                                (unless
                                    (or
                                     (string-empty-p existing)
                                     (equal existing draft))
                                  (error
                                   "Slack reply input in %s already contains unsent text"
                                   (buffer-name buf)))
                                (atomic-change-group
                                      (unless (equal existing draft)
                                        (goto-char lui-input-marker)
                                        (insert draft))
                                      (let ((staged
                                             (buffer-substring-no-properties
                                              lui-input-marker
                                              (point-max))))
                                        (unless (equal staged draft)
                                          (error
                                           "Slack reply input in %s does not exactly match the draft"
                                           (buffer-name buf)))))
                                ;; Display may run user hooks: never roll back
                                ;; newer input that arrives after insertion.
                                (let ((slack-debug t)) (slack-buffer-display thread))
                                (unless (eq (window-buffer (selected-window)) buf)
                                  (error "Target was not selected"))
                                (unless (equal draft (buffer-substring-no-properties
                                                       lui-input-marker (point-max)))
                                  (error "Composer changed after insertion"))
                                (setq result 'draft-composer-staged
                                      done t)))))))
                    (error (finish-with-error err)))))))
          (condition-case err
              (slack-conversations-replies
               room target-ts team
               :after-success #'stage
               :on-error #'request-error)
            (error (finish-with-error err)))
          (while (and (not done)
                      (< (float-time) deadline))
            (accept-process-output nil 0.1))
          (unless done
            (setq done 'expired))
          (cond
           (failure
            (signal (car failure) (cdr failure)))
           ((eq done 'expired)
            (error
             "Timed out waiting for Slack reply target %s in %s"
             target-ts room-id))
           (t result)))))))
""".strip()
    return run_emacs_eval(composer_expression(expr), socket)


def prefill_channel_message(channel: str, path: Path | None, socket: str) -> str:
    """Open the exact loaded Epoch room; stage PATH unless this is open-only."""
    expr = f"""
(progn
  (require 'cl-lib)
  (require 'subr-x)
  (require 'slack-team nil t)
  (unless (fboundp 'slack-create-message-buffer)
    (require 'slack-message-buffer nil t))
  (unless (fboundp 'slack-create-message-buffer)
    (error "slack-create-message-buffer is not available"))
  (let* ((channel-id {elisp_string(channel)})
         (team (or (slack-team-find-by-domain "epochai")
                   (error "Epoch Slack team is not registered")))
         (room (slack-room-find channel-id team)))
    (unless room (error "Epoch Slack room is not loaded"))
    (unless (slack-team-connectedp team)
      (error "Epoch Slack is disconnected"))
    ;; The cursor slot is typed as a string. Passing nil happens to work when a
    ;; buffer for this room is already cached and blows up with "Invalid slot
    ;; type" when one has to be constructed, which is exactly the first time
    ;; any given DM is opened.
    (let* ((buffer (slack-create-message-buffer room "" team))
           (buf (slack-buffer-buffer buffer))
           (draft (when { 't' if path else 'nil' } (with-temp-buffer
                    (let ((coding-system-for-read 'utf-8-unix))
                      (insert-file-contents {elisp_string(str(path))}))
                    (buffer-string)))))
      (unless (buffer-live-p buf)
        (error "Slack message buffer is not live for %s" channel-id))
      (when draft (with-current-buffer buf
        (unless (and (markerp lui-input-marker)
                     (eq (marker-buffer lui-input-marker) buf))
          (error "Slack message input is not available in %s" (buffer-name buf)))
        (let ((existing (buffer-substring-no-properties
                         lui-input-marker (point-max))))
          (unless (or (string-empty-p existing) (equal existing draft))
            (error "Slack message input in %s already contains unsent text"
                   (buffer-name buf)))
          (atomic-change-group
            (unless (equal existing draft)
              (goto-char lui-input-marker)
              (insert draft))
            (unless (equal draft (buffer-substring-no-properties
                                 lui-input-marker (point-max)))
              (error "Composer insertion mismatch"))))))
      (let ((slack-debug t)) (slack-buffer-display buffer))
      (unless (eq (window-buffer (selected-window)) buf)
        (error "Target was not selected"))
      (when draft (with-current-buffer buf
        (unless (equal draft (buffer-substring-no-properties
                              lui-input-marker (point-max)))
          (error "Composer changed after insertion"))))
      (if draft 'draft-composer-staged 'draft-opened))))
""".strip()
    return run_emacs_eval(composer_expression(expr), socket)


def default_socket() -> str | None:
    """Return the running Emacs server's default owned socket, or None."""
    uid = os.getuid()
    candidates = []
    explicit = os.environ.get("EMACS_SOCKET_NAME")
    if explicit:
        candidates.append(Path(explicit))
    for base in (os.environ.get("TMPDIR"), "/tmp"):
        if base:
            candidates.append(Path(base) / f"emacs{uid}" / "server")
    for candidate in candidates:
        try:
            info = candidate.stat()
        except OSError:
            continue
        if stat.S_ISSOCK(info.st_mode) and info.st_uid == uid:
            return str(candidate)
    return None


def validate_socket(value: str) -> str:
    path = Path(value)
    if not path.is_absolute():
        raise ValueError("An absolute existing Emacs socket is required")
    info = path.stat()
    if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
        raise ValueError("An owned existing Emacs socket is required")
    return str(path)


@contextlib.contextmanager
def draft_snapshot(value: str):
    path = Path(value).expanduser().absolute()
    parent = path.parent.resolve()
    if parent.is_relative_to(Path.home() / "My Drive"):
        raise ValueError("Draft files must be outside Drive")
    directory_info = parent.stat()
    if directory_info.st_uid != os.getuid() or directory_info.st_mode & 0o077:
        raise ValueError("Draft parent must be an owned private directory")
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(descriptor, "rb") as source:
        before = os.fstat(source.fileno())
        if not stat.S_ISREG(before.st_mode) or before.st_uid != os.getuid() or before.st_mode & 0o077:
            raise ValueError("Draft must be an owned private regular file")
        raw = source.read()
        after = os.fstat(source.fileno())
        if (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
            raise ValueError("Draft changed while reading")
    text = raw.decode("utf-8")
    if text.startswith("\ufeff") or not text.strip() or "\x00" in text:
        raise ValueError("Draft must be nonempty UTF-8 without BOM or NUL")
    directory = Path(tempfile.mkdtemp(prefix="slack-draft-", dir="/tmp"))
    snapshot = directory / "draft.txt"
    retain = False
    try:
        descriptor = os.open(snapshot, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "wb") as output:
            output.write(raw)
        yield snapshot
    except (TimeoutError, KeyboardInterrupt, UncertainResult):
        retain = True
        sys.stderr.write(f"Recovery snapshot retained: {snapshot}\n")
        raise
    finally:
        if not retain:
            shutil.rmtree(directory)


@contextlib.contextmanager
def stdin_draft():
    """Write stdin to an owned private file so the draft never enters Lisp or a shell argument."""
    raw = sys.stdin.buffer.read()
    if raw.endswith(b"\n"):
        raw = raw[:-1]
    directory = Path(tempfile.mkdtemp(prefix="slack-draft-stdin-", dir="/tmp"))
    try:
        path = directory / "draft.txt"
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "wb") as output:
            output.write(raw)
        yield str(path)
    finally:
        shutil.rmtree(directory, ignore_errors=True)


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Copy a Slack draft to the Emacs kill ring and prefill its reply."
        )
    )
    parser.add_argument("--file", help="Owned private UTF-8 draft file outside Drive")
    parser.add_argument("--stdin", action="store_true",
                        help="Read the draft from stdin (one trailing newline is stripped)")
    parser.add_argument("--socket", help="Absolute existing Emacs socket (default: the running server's)")
    parser.add_argument("--open-only", action="store_true", help="Open target without changing composer or kill ring")
    parser.add_argument(
        "--permalink",
        help=(
            "Slack permalink of the message to reply to. Opens the thread in "
            "Emacs and prefills its reply input."
        ),
    )
    parser.add_argument(
        "--channel",
        help=(
            "Slack channel ID for a top-level post (not a thread reply). "
            "Opens the channel in Emacs and prefills its message input."
        ),
    )
    parser.add_argument(
        "--no-open",
        action="store_true",
        help=(
            "Mutate only the kill ring; do not open or prefill Slack."
        ),
    )
    args = parser.parse_args()

    result = {"status": "failed", "stage": "validation", "opened": False, "composer": False, "ring": False}
    try:
        if args.open_only and (args.file or args.stdin or args.no_open):
            raise ValueError("Open-only cannot stage text")
        if args.file and args.stdin:
            raise ValueError("Use either --file or --stdin")
        if not args.open_only and not (args.file or args.stdin):
            raise ValueError("A draft file or --stdin is required")
        if args.no_open and (args.permalink or args.channel):
            raise ValueError("Ring-only cannot specify a target")
        if not args.no_open and bool(args.permalink) == bool(args.channel):
            raise ValueError("Specify exactly one target")
        if args.permalink:
            permalink_info(args.permalink)
        if args.channel and not re.fullmatch(r"[CGD][A-Z0-9]{8,}", args.channel):
            raise ValueError("Invalid channel ID")
        socket = validate_socket(args.socket) if args.socket else default_socket()
        if socket is None:
            raise ValueError("No running Emacs server socket found; supply --socket")
        with contextlib.ExitStack() as stack:
            source = args.file
            if args.stdin:
                source = stack.enter_context(stdin_draft())
            snapshot = None if args.open_only else stack.enter_context(draft_snapshot(source))
            if not args.no_open:
                result["stage"] = "open" if args.open_only else "composer"
                stage = prefill_channel_message if args.channel else prefill_slack_reply
                ack = stage(args.channel or args.permalink, snapshot, socket)
                expected = "draft-opened" if args.open_only else "draft-composer-staged"
                if ack != expected:
                    raise UncertainResult("Composer staging was not acknowledged")
                result.update(opened=True, composer=not args.open_only)
            if not args.open_only:
                result["stage"] = "ring"
                copy_to_kill_ring(snapshot, socket)
                result["ring"] = True
        result["status"] = "ok"
        result["stage"] = "complete"
        return 0
    except (TimeoutError, KeyboardInterrupt, UncertainResult):
        result["status"] = "uncertain"
        return 1
    except (OSError, UnicodeError, ValueError, RuntimeError):
        return 1
    finally:
        print(json.dumps(result, sort_keys=True))


if __name__ == "__main__":
    raise SystemExit(main())
