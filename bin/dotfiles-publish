#!/usr/bin/env python3
"""Guarded publication for the public dotfiles repository.

Ordinary pushes are refused.  Publication happens only through this program,
which captures the exact outgoing boundary, scans it, requires an exhaustive
review of every outgoing unit, and then authorizes one short-lived, exact,
single-use push.

Two environment variables change behaviour and both are deliberate:

``DOTFILES_PUBLISH_NOW``
    Fixed clock for expiry and staleness tests.  Honoured only when
    ``DOTFILES_PUBLISH_TESTING=1``, so production always uses the real clock.

``DOTFILES_PUBLISH_GITLEAKS``
    Path to the scanner.  Ungated, because a caller who can set it can already
    set ``PATH``; it grants no authority the caller did not already hold.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import hmac
import json
import math
import os
import re
import secrets
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from contextlib import contextmanager
from dataclasses import dataclass, field
from pathlib import Path

SCHEMA = 4

EXIT_OK = 0
EXIT_REFUSED = 1
EXIT_FINDINGS = 2
EXIT_FAILURE = 3

STATE_DIRECTORY_NAME = "dotfiles-publish"
DIRECTORY_MODE = 0o700
FILE_MODE = 0o600

MIN_KNOWN_VALUE_CHARS = 4
MAX_REVIEW_FIELD_CHARS = 4096
MAX_REVIEW_FINDINGS = 256
MAX_REVIEW_FINDINGS_BYTES = 64 * 1024
MAX_INCIDENT_EVIDENCE_BYTES = 64 * 1024
MAX_KNOWN_VALUE_CHECK_WORK = 10_000_000

AUTHORIZATION_LIFETIME_SECONDS = 300
FULL_AUDIT_MAX_AGE_SECONDS = 30 * 86400

RECOVERY_REF_PREFIX = "refs/dotfiles-publish/recovery"
AUDIT_REF_PREFIX = "refs/dotfiles-publish/audit"

BLOCKED_PUSH_URL = "dotfiles-blocked::origin"
BLOCKED_PUSH_MESSAGE = "Push blocked: use publish-dotfiles so outgoing history is reviewed."

RULESET_POLICY_FILES = (
    ".gitleaks.toml",
    ".gitignore",
    ".gitattributes",
    "bin/dotfiles-publish",
)

MODES = ("publish", "release", "full-audit", "readiness")
INCIDENT_RESOLUTIONS = ("rotated", "revoked", "invalid", "accepted-risk")


class PublishError(Exception):
    """A refusal or failure that stops the current command."""

    def __init__(self, message, code=EXIT_FAILURE):
        super().__init__(message)
        self.code = code


# --------------------------------------------------------------------------
# Git plumbing
# --------------------------------------------------------------------------


@dataclass
class GitResult:
    code: int
    out: bytes
    err: bytes

    @property
    def text(self):
        return self.out.decode("utf-8", "replace")

    @property
    def error_text(self):
        return self.err.decode("utf-8", "replace")


def run_git(repo, *args, input_bytes=None, check=True):
    """Run one Git command with an argument vector; never through a shell."""
    command = ["git"]
    if repo is not None:
        command += ["-C", str(repo)]
    command += [str(argument) for argument in args]
    completed = subprocess.run(
        command,
        input=input_bytes,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    result = GitResult(completed.returncode, completed.stdout, completed.stderr)
    if check and result.code != 0:
        raise PublishError(
            "git %s failed (%d): %s"
            % (" ".join(str(argument) for argument in args), result.code, result.error_text.strip())
        )
    return result


# --------------------------------------------------------------------------
# Clock, digests, and atomic state files
# --------------------------------------------------------------------------


def now_epoch():
    override = os.environ.get("DOTFILES_PUBLISH_NOW")
    if override and os.environ.get("DOTFILES_PUBLISH_TESTING") == "1":
        try:
            return float(override)
        except ValueError:
            parsed = time.strptime(override.replace("Z", "UTC"), "%Y-%m-%dT%H:%M:%S%Z")
            return float(calendar_timegm(parsed))
    return time.time()


def calendar_timegm(parsed):
    import calendar

    return calendar.timegm(parsed)


def rfc3339(epoch):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))


def sha256_of(*parts):
    digest = hashlib.sha256()
    for part in parts:
        if isinstance(part, str):
            part = part.encode("utf-8")
        digest.update(part)
        digest.update(b"\x00")
    return digest.hexdigest()


def write_json(path, payload, mode=FILE_MODE):
    """Write JSON atomically through a sibling temporary file."""
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.parent / ("." + path.name + ".tmp")
    descriptor = os.open(str(temporary), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
    except BaseException:
        temporary.unlink(missing_ok=True)
        raise
    os.chmod(str(temporary), mode)
    os.replace(str(temporary), str(path))


def read_json(path):
    return json.loads(Path(path).read_text(encoding="utf-8"))


def read_bounded_json(path, limit, description):
    """Read a small regular JSON file through one no-follow descriptor."""
    descriptor = None
    try:
        descriptor = os.open(
            str(path),
            os.O_RDONLY
            | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_NONBLOCK", 0),
        )
        source_stat = os.fstat(descriptor)
        if not stat.S_ISREG(source_stat.st_mode) or source_stat.st_size > limit:
            raise PublishError("the %s file is too large" % description, EXIT_REFUSED)
        chunks = []
        remaining = limit + 1
        while remaining:
            chunk = os.read(descriptor, min(65536, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        payload = b"".join(chunks)
        if len(payload) > limit:
            raise PublishError("the %s file is too large" % description, EXIT_REFUSED)
        return payload, json.loads(payload.decode("utf-8"))
    except OSError as error:
        raise PublishError(
            "could not read the %s file: %s" % (description, error), EXIT_REFUSED
        )
    except (UnicodeDecodeError, json.JSONDecodeError):
        raise PublishError("the %s file is not valid UTF-8 JSON" % description, EXIT_REFUSED)
    finally:
        if descriptor is not None:
            os.close(descriptor)


# --------------------------------------------------------------------------
# Repository discovery
# --------------------------------------------------------------------------


@dataclass
class Repository:
    root: Path
    git_dir: Path
    branch: str
    remote_name: str
    remote_ref: str
    fetch_url: str

    @property
    def state_dir(self):
        return self.git_dir / STATE_DIRECTORY_NAME


def discover_repository(start=None):
    start = Path(start or os.getcwd())
    probe = run_git(start, "rev-parse", "--show-toplevel", check=False)
    if probe.code != 0:
        raise PublishError("not inside a Git repository: %s" % start)
    root = Path(probe.text.strip())
    git_dir = Path(run_git(root, "rev-parse", "--absolute-git-dir").text.strip())

    head = run_git(root, "symbolic-ref", "--quiet", "--short", "HEAD", check=False)
    if head.code != 0:
        raise PublishError("HEAD is detached; check out the branch you want to publish")
    branch = head.text.strip()

    upstream = run_git(
        root,
        "for-each-ref",
        "--format=%(upstream:remotename)%09%(upstream)",
        "refs/heads/" + branch,
    ).text.strip()
    if "\t" not in upstream or not upstream.split("\t")[0]:
        raise PublishError(
            "branch %s has no configured upstream; set one before publishing" % branch
        )
    remote_name, upstream_ref = upstream.split("\t", 1)
    if not upstream_ref.startswith("refs/remotes/%s/" % remote_name):
        raise PublishError("unsupported upstream reference: %s" % upstream_ref)
    remote_branch = upstream_ref[len("refs/remotes/%s/" % remote_name) :]
    remote_ref = "refs/heads/" + remote_branch

    fetch_url = run_git(root, "remote", "get-url", remote_name).text.strip()
    if not fetch_url:
        raise PublishError("remote %s has no fetch URL" % remote_name)

    return Repository(
        root=root,
        git_dir=git_dir,
        branch=branch,
        remote_name=remote_name,
        remote_ref=remote_ref,
        fetch_url=fetch_url,
    )


# --------------------------------------------------------------------------
# Local state
# --------------------------------------------------------------------------


def ensure_state_dir(repo):
    directory = repo.state_dir
    if directory.is_symlink():
        raise PublishError("publication state directory is a symlink: %s" % directory)
    directory.mkdir(parents=True, exist_ok=True)
    os.chmod(str(directory), DIRECTORY_MODE)
    return directory


@contextmanager
def scan_workspace(repo):
    """Yield a private temporary workspace outside the synced source tree."""
    state = ensure_state_dir(repo).resolve()
    root = repo.root.resolve()
    parent = state if root != state and root not in state.parents else None
    with tempfile.TemporaryDirectory(
        prefix="dotfiles-publish-scan-",
        dir=str(parent) if parent is not None else None,
    ) as temporary:
        work = Path(temporary).resolve()
        if work == root or root in work.parents:
            raise PublishError(
                "scanner temporary directory is inside the repository", EXIT_FAILURE
            )
        os.chmod(str(work), DIRECTORY_MODE)
        yield work


def fingerprint_key(repo):
    """Return the local HMAC key, creating it exactly once."""
    directory = ensure_state_dir(repo)
    path = directory / "fingerprint.key"
    if path.is_symlink():
        raise PublishError("fingerprint key is a symlink: %s" % path)
    if path.exists():
        mode = stat.S_IMODE(path.stat().st_mode)
        if mode & 0o077:
            raise PublishError(
                "fingerprint key %s is group- or world-accessible (mode %o)" % (path, mode)
            )
        material = path.read_bytes()
        if len(material) < 32:
            raise PublishError("fingerprint key %s is too short" % path)
        return material
    material = secrets.token_bytes(32)
    descriptor = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL, FILE_MODE)
    with os.fdopen(descriptor, "wb") as handle:
        handle.write(material)
        handle.flush()
        os.fsync(handle.fileno())
    return material


def fingerprint(key, *parts):
    """Keyed short fingerprint; a bare hash of a secret would be guessable."""
    message = b"\x00".join(
        part.encode("utf-8") if isinstance(part, str) else part for part in parts
    )
    return hmac.new(key, message, hashlib.sha256).hexdigest()[:20]


def value_hmac(key, value):
    if isinstance(value, str):
        value = value.encode("utf-8")
    return hmac.new(key, b"value\x00" + value, hashlib.sha256).hexdigest()


# --------------------------------------------------------------------------
# Ruleset identity
# --------------------------------------------------------------------------


def ruleset_identity(root):
    """Digest of the policy that a review was performed under."""
    digest = hashlib.sha256()
    digest.update(b"dotfiles-publish-ruleset\x00")
    digest.update(str(SCHEMA).encode("utf-8") + b"\x00")
    for name in RULESET_POLICY_FILES:
        digest.update(name.encode("utf-8") + b"\x00")
        path = root / name
        if path.is_file() and not path.is_symlink():
            digest.update(b"PRESENT\x00")
            digest.update(hashlib.sha256(path.read_bytes()).digest())
        else:
            digest.update(b"MISSING\x00")
        digest.update(b"\x00")
    return digest.hexdigest()


# --------------------------------------------------------------------------
# Publication boundary
# --------------------------------------------------------------------------


@dataclass
class Boundary:
    remote_oid: str
    candidate_oid: str


def resolve_boundary(repo, fetch=True, fetch_missing_objects=False):
    if fetch:
        fetched = run_git(repo.root, "fetch", "--quiet", repo.remote_name, check=False)
        if fetched.code != 0:
            raise PublishError(
                "could not fetch %s before capturing the boundary: %s"
                % (repo.remote_name, fetched.error_text.strip())
            )
    listing = run_git(repo.root, "ls-remote", repo.fetch_url, repo.remote_ref)
    lines = [line for line in listing.text.splitlines() if line.strip()]
    if not lines:
        raise PublishError(
            "%s does not exist on %s; this workflow publishes existing branches only"
            % (repo.remote_ref, repo.fetch_url)
        )
    remote_oid = lines[0].split()[0]
    present = run_git(repo.root, "cat-file", "-e", remote_oid + "^{commit}", check=False)
    if present.code != 0 and fetch_missing_objects:
        fetched = run_git(
            repo.root,
            "fetch", "--quiet", "--no-write-fetch-head", "--no-tags",
            "--no-prune", "--no-recurse-submodules", "--no-auto-maintenance",
            "--refmap=", repo.fetch_url, repo.remote_ref,
            check=False,
        )
        if fetched.code != 0:
            raise PublishError(
                "could not fetch the remote tip without changing refs: %s"
                % fetched.error_text.strip()
            )
        present = run_git(
            repo.root, "cat-file", "-e", remote_oid + "^{commit}", check=False
        )
    if present.code != 0:
        raise PublishError("remote tip %s is not present locally; fetch first" % remote_oid)

    candidate_oid = run_git(repo.root, "rev-parse", "HEAD^{commit}").text.strip()
    ancestry = run_git(
        repo.root, "merge-base", "--is-ancestor", remote_oid, candidate_oid, check=False
    )
    if ancestry.code != 0:
        raise PublishError(
            "remote tip %s is not an ancestor of %s; synchronize instead of force-pushing"
            % (remote_oid[:12], candidate_oid[:12])
        )
    return Boundary(remote_oid=remote_oid, candidate_oid=candidate_oid)


def outgoing_commits(repo, boundary):
    listing = run_git(
        repo.root,
        "rev-list",
        "--reverse",
        "%s..%s" % (boundary.remote_oid, boundary.candidate_oid),
    )
    return [line.strip() for line in listing.text.splitlines() if line.strip()]


# --------------------------------------------------------------------------
# Run records
# --------------------------------------------------------------------------

RUN_IDENTITY_FIELDS = (
    "schema",
    "mode",
    "run_id",
    "repository",
    "remote_name",
    "remote_url",
    "remote_ref",
    "remote_oid",
    "candidate_oid",
    "ruleset_id",
    "release_tag",
)


def compute_run_id(mode, repo, boundary, ruleset_id, tag, notes_digest):
    return sha256_of(
        "dotfiles-publish-run",
        str(SCHEMA),
        mode,
        str(repo.root),
        repo.fetch_url,
        repo.remote_ref,
        boundary.remote_oid,
        boundary.candidate_oid,
        ruleset_id,
        tag or "",
        notes_digest or "",
    )[:32]


def run_directory(repo, run_id):
    return ensure_state_dir(repo) / "runs" / run_id


def load_run(repo, run_id):
    path = run_directory(repo, run_id) / "run.json"
    if not path.exists():
        raise PublishError("unknown run %s; start with a scan" % run_id, EXIT_REFUSED)
    record = read_json(path)
    if record.get("schema") != SCHEMA:
        raise PublishError(
            "run %s predates safe scanner redaction; scan again" % run_id,
            EXIT_REFUSED,
        )
    return record


def store_run(repo, record):
    directory = run_directory(repo, record["run_id"])
    directory.mkdir(parents=True, exist_ok=True)
    os.chmod(str(directory.parent), DIRECTORY_MODE)
    os.chmod(str(directory), DIRECTORY_MODE)
    path = directory / "run.json"
    if path.exists():
        existing = read_json(path)
        for field in RUN_IDENTITY_FIELDS:
            if existing.get(field) != record.get(field):
                raise PublishError(
                    "run %s already exists with a different %s; a changed input needs a new run"
                    % (record["run_id"], field)
                )
        record["created_at"] = existing.get("created_at", record["created_at"])
    write_json(path, record)
    return path


def notes_digest_of(path):
    if not path:
        return ""
    notes = Path(path)
    if not notes.is_file():
        raise PublishError("release notes file not found: %s" % path)
    return hashlib.sha256(notes.read_bytes()).hexdigest()


# --------------------------------------------------------------------------
# Full-audit receipts
# --------------------------------------------------------------------------


def full_audit_receipt(repo):
    path = repo.state_dir / "full-audit.json"
    if not path.exists():
        return None
    return read_json(path)


def full_audit_staleness(repo, ruleset_id, now):
    """Return the reason a full audit is due, or None when the receipt holds."""
    receipt = full_audit_receipt(repo)
    if receipt is None:
        return "no full audit has been recorded"
    if receipt.get("incident_flag"):
        return "an incident was recorded after the last full audit"
    if receipt.get("incident_digest") != incident_state_digest(repo):
        return "the incident state changed or was not captured by the last full audit"
    if receipt.get("ruleset_id") != ruleset_id:
        return "the ruleset changed since the last full audit"
    completed = receipt.get("completed_epoch")
    if not isinstance(completed, (int, float)):
        return "the full audit receipt has no completion time"
    if now - completed > FULL_AUDIT_MAX_AGE_SECONDS:
        return "the last full audit is older than 30 days"
    if not receipt.get("scan_id") or not receipt.get("manifest_id"):
        return "the full audit receipt has no scan and manifest binding"
    try:
        record = load_run(repo, receipt["run_id"])
        manifest = load_manifest(repo, receipt["run_id"])
    except (KeyError, OSError, ValueError, PublishError):
        return "the full audit scan or manifest is unavailable; scan and review again"
    if (
        record.get("mode") != "full-audit"
        or record.get("scan_id") != receipt["scan_id"]
        or record.get("manifest_id") != receipt["manifest_id"]
        or manifest.get("manifest_id") != receipt["manifest_id"]
        or record.get("scanned_epoch") != completed
        or record.get("ruleset_id") != receipt["ruleset_id"]
        or record.get("incident_digest") != receipt["incident_digest"]
    ):
        return "the full audit scan or manifest was replaced; scan and review again"
    return None


# --------------------------------------------------------------------------
# Redaction
# --------------------------------------------------------------------------

# Each rule keeps the surrounding structure and replaces the capturing group
# that holds the sensitive part.  These run even when no scanner value is
# known, so an unrecognized credential shape is still blunted.
STRUCTURAL_RULES = (
    re.compile(
        r"(?i)((?:authorization|proxy-authorization|x-api-key|x-auth-token|x-session-token|cookie|set-cookie)"
        r"[ \t]*:[ \t]*(?:bearer[ \t]+|basic[ \t]+|token[ \t]+)?)([A-Za-z0-9\-\._~\+/=]{16,})"
    ),
    re.compile(
        r"(?i)(\b(?:api[_-]?key|api[_-]?secret|auth[_-]?token|access[_-]?token|refresh[_-]?token"
        r"|client[_-]?secret|secret[_-]?key|token|secret|passwd|password|passphrase)\b[ \t]*(?:[:=]|=>)[ \t]*[\"']?)"
        r"([^\s\"'#;,)]{12,})"
    ),
    # The scheme is length-bounded on purpose: an unbounded prefix makes this
    # rule quadratic, and a long run of ordinary characters then hangs the scan.
    re.compile(r"(\b[a-zA-Z][a-zA-Z0-9+.\-]{0,15}://[^\s:@/]+:)([^\s:@/\"']{6,})(?=@)"),
    re.compile(
        r"(-----BEGIN (?:[A-Z]+ )*PRIVATE KEY(?: BLOCK)?-----)([\s\S]*?)(?=-----END|\Z)"
    ),
)

STRUCTURAL_TOKEN = "[REDACTED:structural]"


def structural_redaction(text):
    for rule in STRUCTURAL_RULES:
        text = rule.sub(lambda match: match.group(1) + STRUCTURAL_TOKEN, text)
    return text


class Redactor:
    """Replaces values the scanners found, then blunts credential shapes."""

    def __init__(self, key):
        self.key = key
        self.values = {}
        self.known_values = set()

    def learn(self, value, token=None, *, scrub=True):
        if value and len(value) >= MIN_KNOWN_VALUE_CHARS:
            self.known_values.add(value)
            if scrub:
                if not token:
                    raise PublishError("a scrubbed scanner value needs a fingerprint")
                self.values[value] = token

    @property
    def value_signatures(self):
        return sorted(
            (
                {"length": len(value), "hmac": value_hmac(self.key, value)}
                for value in self.known_values
                if len(value) <= MAX_REVIEW_FIELD_CHARS
            ),
            key=lambda signature: (signature["length"], signature["hmac"]),
        )

    def knows(self, candidate):
        return candidate in self.known_values

    def scrub(self, text):
        if text is None:
            return None
        if isinstance(text, bytes):
            text = text.decode("utf-8", "replace")
        for value in sorted(self.values, key=len, reverse=True):
            text = text.replace(value, "[REDACTED:%s]" % self.values[value])
        return structural_redaction(text)


def clip(text, limit=200):
    if text is None:
        return ""
    text = text.strip()
    return text if len(text) <= limit else text[:limit] + "…"


# --------------------------------------------------------------------------
# Findings
# --------------------------------------------------------------------------


def finding_record(source, rule_id, path, commit, line, column, print_key, context, classification="outgoing"):
    return {
        "source": source,
        "rule_id": rule_id,
        "path": path,
        "commit": commit,
        "line": line,
        "column": column,
        "fingerprint": print_key,
        "context": context,
        "classification": classification,
    }


def format_finding(record):
    location = "-"
    if record.get("line"):
        location = "%s:%s" % (record["line"], record.get("column") or "?")
    return "finding: %s %s %s %s %s %s" % (
        record["source"],
        record["rule_id"],
        record["path"] or "-",
        (record["commit"] or "-")[:12],
        location,
        record["fingerprint"],
    )


# --------------------------------------------------------------------------
# Gitleaks
# --------------------------------------------------------------------------


def gitleaks_executable():
    configured = os.environ.get("DOTFILES_PUBLISH_GITLEAKS")
    if configured:
        return configured
    found = shutil.which("gitleaks")
    if not found:
        raise PublishError(
            "gitleaks is not installed; install it with 'brew install gitleaks'"
        )
    return found


def gitleaks_config_argument(repo):
    config = repo.root / ".gitleaks.toml"
    return ["--config", str(config)] if config.is_file() else []


def run_gitleaks(repo, work, *, git_range=None, directory=None):
    """Run one scan and return its raw results; the report never outlives this call."""
    report = Path(work) / "gitleaks-report.json"
    try:
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
        descriptor = os.open(str(report), flags, FILE_MODE)
        try:
            os.fchmod(descriptor, FILE_MODE)
            original = os.fstat(descriptor)
            if not stat.S_ISREG(original.st_mode):
                raise PublishError(
                    "gitleaks report could not be secured", EXIT_FAILURE
                )
        finally:
            os.close(descriptor)

        command = [gitleaks_executable(), "dir" if directory else "git"]
        command += gitleaks_config_argument(repo)
        command += [
            "--no-banner",
            "--exit-code=2",
            "--report-format",
            "json",
            "--report-path",
            str(report),
        ]
        if git_range:
            command.append("--log-opts=%s" % git_range)
        command.append(str(directory or repo.root))
        try:
            completed = subprocess.run(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                umask=0o077,
            )
        except OSError:
            raise PublishError("could not execute gitleaks", EXIT_FAILURE)
        if completed.returncode not in (0, 2):
            raise PublishError(
                "gitleaks failed with exit code %d" % completed.returncode,
                EXIT_FAILURE,
            )
        try:
            read_descriptor = os.open(
                str(report), os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
            )
        except OSError:
            raise PublishError(
                "gitleaks report was not a private regular file", EXIT_FAILURE
            )
        try:
            current = os.fstat(read_descriptor)
            if (
                not stat.S_ISREG(current.st_mode)
                or stat.S_IMODE(current.st_mode) != FILE_MODE
            ):
                raise PublishError(
                    "gitleaks report was not a private regular file", EXIT_FAILURE
                )
            with os.fdopen(read_descriptor, "r", encoding="utf-8") as handle:
                read_descriptor = None
                report_text = handle.read()
        finally:
            if read_descriptor is not None:
                os.close(read_descriptor)
        if not report_text:
            raise PublishError("gitleaks report was empty", EXIT_FAILURE)
        try:
            payload = json.loads(report_text)
        except json.JSONDecodeError:
            raise PublishError("gitleaks report was not valid JSON", EXIT_FAILURE)
        if not isinstance(payload, list):
            raise PublishError("gitleaks report was not a JSON list", EXIT_FAILURE)
        if completed.returncode == 0 and payload:
            raise PublishError("gitleaks returned findings with a success status", EXIT_FAILURE)
        if completed.returncode == 2 and not payload:
            raise PublishError("gitleaks returned a finding status without findings", EXIT_FAILURE)
        return payload
    finally:
        report.unlink(missing_ok=True)


def repository_relative(path, strip_prefix):
    """Report a tree-scan hit at its repository path, not its extraction path.

    The fingerprint is keyed on the location, so a temporary directory name in
    it would change every run and no incident receipt could ever match.
    """
    if not strip_prefix:
        return path
    prefix = str(strip_prefix).rstrip(os.sep) + os.sep
    resolved = os.path.realpath(path) if os.path.isabs(path) else path
    for candidate in (path, resolved):
        if candidate.startswith(prefix):
            return candidate[len(prefix) :]
    return path


def gitleaks_report_values(result):
    """Return raw values carried safely inside the private scanner report."""
    scrub_values = []
    review_candidates = []
    for candidate in (result.get("Secret"), result.get("Match"), result.get("Line")):
        if candidate and candidate != "REDACTED":
            scrub_values.append(candidate)
    line = result.get("Line")
    if isinstance(line, str) and line:
        for source_line in line.splitlines():
            if source_line:
                scrub_values.append(source_line)
                review_candidates.extend(TOKEN_PATTERN.findall(source_line))
    return scrub_values, review_candidates


GIT_HUNK_HEADER = re.compile(rb"^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@")


def gitleaks_git_patch_values(repo, result):
    """Recover decoded raw source from the same zero-context Git patch stream."""
    start = result.get("StartLine")
    end = result.get("EndLine") or start
    commit = result.get("Commit") or ""
    path = result.get("File") or ""
    if (
        not isinstance(start, int)
        or not isinstance(end, int)
        or start < 1
        or end < start
        or not isinstance(commit, str)
        or not re.fullmatch(r"[0-9a-fA-F]{40,64}", commit)
        or not path
    ):
        raise PublishError("gitleaks returned invalid Git patch coordinates", EXIT_FAILURE)

    shown = run_git(
        repo.root,
        "--literal-pathspecs",
        "show",
        "--format=",
        "--patch",
        "-U0",
        commit,
        "--",
        path,
        check=False,
    )
    if shown.code != 0:
        raise PublishError(
            "could not recover a decoded gitleaks finding from its Git patch",
            EXIT_FAILURE,
        )
    patch = shown.out
    added = {}
    position = None
    for patch_line in patch.splitlines():
        header = GIT_HUNK_HEADER.match(patch_line)
        if header:
            position = int(header.group(1))
            continue
        if position is None:
            continue
        if patch_line.startswith(b"+"):
            added[position] = patch_line[1:]
            position += 1
        elif patch_line.startswith(b" "):
            position += 1
        elif patch_line.startswith(b"-") or patch_line.startswith(b"\\"):
            continue
        else:
            position = None

    selected = [added.get(line_number) for line_number in range(start, end + 1)]
    if not selected or any(line is None for line in selected):
        raise PublishError(
            "could not recover a decoded gitleaks finding from its Git patch",
            EXIT_FAILURE,
        )
    return gitleaks_selected_line_values(result, selected)


def gitleaks_selected_line_values(result, selected):
    """Learn complete source lines and an advisory byte-column span."""
    start = result.get("StartLine")
    end = result.get("EndLine") or start
    start_column = result.get("StartColumn")
    end_column = result.get("EndColumn")
    decoded_lines = [line.decode("utf-8", "replace") for line in selected]
    scrub_values = [*decoded_lines]
    review_candidates = []
    for line in decoded_lines:
        review_candidates.extend(TOKEN_PATTERN.findall(line))

    span = None
    if start == end:
        if (
            isinstance(start_column, int)
            and isinstance(end_column, int)
            and 1 <= start_column <= end_column <= len(selected[0])
        ):
            span = selected[0][start_column - 1 : end_column]
    elif (
        isinstance(start_column, int)
        and isinstance(end_column, int)
        and 1 <= start_column <= len(selected[0]) + 1
        and 1 <= end_column <= len(selected[-1])
    ):
        span = b"\n".join(
            [
                selected[0][start_column - 1 :],
                *selected[1:-1],
                selected[-1][:end_column],
            ]
        )
    if span is not None:
        decoded_span = span.decode("utf-8", "replace")
        scrub_values.append(decoded_span)
        review_candidates.extend(TOKEN_PATTERN.findall(decoded_span))
    return scrub_values, review_candidates


def gitleaks_source_values(result, *, directory):
    """Return authoritative directory lines and HMAC-only review candidates."""
    start = result.get("StartLine")
    end = result.get("EndLine") or start
    reported_path = result.get("File") or ""
    if not isinstance(start, int) or not isinstance(end, int) or start < 1 or end < start:
        raise PublishError("gitleaks returned invalid source coordinates", EXIT_FAILURE)
    if not reported_path:
        raise PublishError("gitleaks returned a finding without a source path", EXIT_FAILURE)

    root = Path(directory).resolve()
    candidate = Path(reported_path)
    if not candidate.is_absolute():
        candidate = root / candidate
    try:
        if candidate.is_symlink():
            raise OSError("symlink")
        resolved = candidate.resolve(strict=True)
        if resolved == root or root not in resolved.parents:
            raise OSError("outside scan root")
        descriptor = os.open(
            str(resolved), os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
        )
        try:
            source_stat = os.fstat(descriptor)
            if not stat.S_ISREG(source_stat.st_mode):
                raise OSError("not regular")
            with os.fdopen(descriptor, "rb") as handle:
                descriptor = None
                data = handle.read()
        finally:
            if descriptor is not None:
                os.close(descriptor)
    except OSError:
        raise PublishError("could not read gitleaks source coordinates", EXIT_FAILURE)

    lines = data.splitlines()
    if end > len(lines):
        raise PublishError("gitleaks source coordinates exceeded the file", EXIT_FAILURE)
    selected = lines[start - 1 : end]
    return gitleaks_selected_line_values(result, selected)


def convert_gitleaks_results(
    results,
    key,
    redactor,
    source,
    repo,
    default_commit="",
    strip_prefix=None,
    directory=None,
):
    """Learn the raw values in memory, then persist only redacted records."""
    for result in results:
        commit = result.get("Commit") or default_commit
        scrub_values, review_candidates = gitleaks_report_values(result)
        if directory is not None:
            source_scrub_values, source_review_candidates = gitleaks_source_values(
                result, directory=directory
            )
            scrub_values.extend(source_scrub_values)
            review_candidates.extend(source_review_candidates)
        elif not result.get("Line") and any(
            isinstance(tag, str) and tag.startswith("decoded:")
            for tag in (result.get("Tags") or [])
        ):
            source_scrub_values, source_review_candidates = gitleaks_git_patch_values(
                repo, result
            )
            scrub_values.extend(source_scrub_values)
            review_candidates.extend(source_review_candidates)
        path = repository_relative(result.get("File") or "", strip_prefix)
        result["File"] = path
        rule = result.get("RuleID") or "unknown"
        line = result.get("StartLine") or None
        token = fingerprint(
            key,
            "gitleaks",
            result.get("Fingerprint") or "",
            commit,
            path,
            rule,
            str(line or ""),
        )
        for raw_value in scrub_values:
            redactor.learn(raw_value, token)
        for raw_value in review_candidates:
            redactor.learn(raw_value, scrub=False)
        result["_token"] = token

    records = []
    for result in results:
        commit = result.get("Commit") or default_commit
        records.append(
            finding_record(
                source,
                result.get("RuleID") or "unknown",
                result.get("File") or "",
                commit,
                result.get("StartLine") or None,
                result.get("StartColumn") or None,
                result["_token"],
                clip(redactor.scrub(result.get("Match") or "")),
            )
        )
        for field in ("Secret", "Match", "Line"):
            result.pop(field, None)
    return records


# --------------------------------------------------------------------------
# Deterministic object detectors
# --------------------------------------------------------------------------

RISKY_PATH_RULES = (
    (re.compile(r"(^|/)\.env($|\.)"), "risky-dotenv-file"),
    (re.compile(r"(?i)(^|/)[^/]*history[^/]*$"), "risky-history-file"),
    (re.compile(r"(?i)\.log$"), "risky-log-file"),
    (re.compile(r"(?i)(^|/)[^/]*cookie[^/]*$"), "risky-cookie-file"),
    (re.compile(r"(?i)(^|/)[^/]*session[^/]*$"), "risky-session-file"),
    (re.compile(r"(?i)(^|/)[^/]*credential[^/]*$"), "risky-credential-file"),
    (re.compile(r"(?i)(^|/)[^/]*auth[-_]?state[^/]*$"), "risky-auth-state-file"),
    (
        re.compile(
            r"(?i)(^|/)(id_(rsa|dsa|ecdsa|ed25519)|[^/]*\.(pem|key|p12|pfx|jks|keystore|kdbx))$"
        ),
        "risky-private-key-file",
    ),
)

ARCHIVE_SUFFIXES = (
    ".zip",
    ".tar",
    ".tgz",
    ".gz",
    ".bz2",
    ".xz",
    ".7z",
    ".rar",
    ".jar",
    ".dmg",
)

LARGE_BLOB_LIMIT = 2 * 1024 * 1024
AUDIT_REVIEW_CHUNK_LIMIT = 128 * 1024
GIT_CRYPT_HEADER = b"\x00GITCRYPT\x00"


def changed_entries(repo, commit):
    raw = run_git(
        repo.root,
        "diff-tree",
        "--root",
        "--diff-merges=separate",
        "--no-commit-id",
        "--name-status",
        "-r",
        "-z",
        commit,
    ).out
    tokens = raw.split(b"\x00")
    entries = []
    index = 0
    while index < len(tokens):
        status = tokens[index].decode("utf-8", "replace")
        index += 1
        if not status:
            continue
        if status[0] in ("R", "C"):
            if index + 1 >= len(tokens):
                break
            index += 1
            path = tokens[index].decode("utf-8", "replace")
            index += 1
        else:
            if index >= len(tokens):
                break
            path = tokens[index].decode("utf-8", "replace")
            index += 1
        entries.append((status, path))
    return entries


def tree_entry(repo, commit, path):
    result = run_git(repo.root, "ls-tree", "-z", commit, "--", path, check=False)
    if result.code != 0 or not result.out.strip():
        return None
    record = result.out.split(b"\x00")[0].decode("utf-8", "replace")
    metadata = record.split("\t", 1)[0]
    parts = metadata.split()
    if len(parts) < 3:
        return None
    return parts[0], parts[1], parts[2]


def blob_size(repo, oid):
    result = run_git(repo.root, "cat-file", "-s", oid, check=False)
    if result.code != 0:
        return 0
    return int(result.text.strip() or 0)


def blob_bytes(repo, oid, limit=None):
    result = run_git(repo.root, "cat-file", "blob", oid, check=False)
    if result.code != 0:
        return b""
    return result.out[:limit] if limit else result.out


def looks_binary(data):
    return b"\x00" in data[:8000]


def filter_attributes(repo, commit, paths):
    if not paths:
        return {}
    stdin = b"".join(path.encode("utf-8", "replace") + b"\x00" for path in paths)
    result = run_git(
        repo.root, "check-attr", "--source=%s" % commit, "-z", "filter", "--stdin", input_bytes=stdin, check=False
    )
    if result.code != 0:
        return {}
    tokens = result.out.split(b"\x00")
    mapping = {}
    for index in range(0, max(0, len(tokens) - 2), 3):
        path = tokens[index].decode("utf-8", "replace")
        value = tokens[index + 2].decode("utf-8", "replace")
        mapping[path] = value
    return mapping


def inspect_paths(repo, commit, paths, key, redactor, source):
    """Deterministic findings for object shape, risky names, and encryption."""
    records = []
    attributes = filter_attributes(repo, commit, paths)
    for path in paths:
        entry = tree_entry(repo, commit, path)
        if entry is None:
            continue
        mode, kind, oid = entry

        def add(rule_id, detail):
            records.append(
                finding_record(
                    source,
                    rule_id,
                    path,
                    commit,
                    None,
                    None,
                    fingerprint(key, rule_id, commit, path, oid),
                    detail,
                )
            )

        if mode == "120000":
            target = blob_bytes(repo, oid, 4096).decode("utf-8", "replace")
            add("symlink-in-outgoing-history", "symlink target %s" % clip(redactor.scrub(target), 80))
            continue
        if kind == "commit":
            add("submodule-in-outgoing-history", "gitlink %s" % oid[:12])
            continue
        if kind != "blob":
            continue

        for pattern, rule_id in RISKY_PATH_RULES:
            if pattern.search(path):
                add(rule_id, "risky path name requires inspection")

        lowered = path.lower()
        if lowered.endswith(ARCHIVE_SUFFIXES):
            add("archive-file", "archive contents are not scannable in place")

        size = blob_size(repo, oid)
        if size > LARGE_BLOB_LIMIT:
            add("large-file", "%d bytes exceeds the 2 MiB inspection limit" % size)

        head = blob_bytes(repo, oid, 8192)
        binary = looks_binary(head)
        if binary:
            add("binary-file", "%d bytes of binary content require inspection" % size)

        if attributes.get(path) == "git-crypt":
            if not head.startswith(GIT_CRYPT_HEADER):
                add(
                    "git-crypt-plaintext-blob",
                    "a git-crypt path is stored without the git-crypt header",
                )
    return records


def tree_paths(repo, commit):
    listing = run_git(repo.root, "ls-tree", "-r", "--name-only", "-z", commit)
    return [
        token.decode("utf-8", "replace")
        for token in listing.out.split(b"\x00")
        if token.strip()
    ]


def export_tree(repo, commit, destination):
    """Write the exact committed bytes of every blob in one tree.

    ``git archive`` is not usable here: it runs blobs through the smudge
    filter, so a git-crypt path would be exported as plaintext and the scan
    would read something the public never sees. Raw blobs are what get
    published, so raw blobs are what get scanned. Symlinks and gitlinks are
    skipped; the object detectors report those separately.
    """
    destination = Path(destination).resolve()
    listing = run_git(repo.root, "ls-tree", "-r", "-z", commit)
    wanted = {}
    for record in listing.out.split(b"\x00"):
        if not record.strip():
            continue
        metadata, _, name = record.partition(b"\t")
        parts = metadata.split()
        if len(parts) < 3:
            continue
        mode, kind, oid = parts[0].decode(), parts[1].decode(), parts[2].decode()
        if kind != "blob" or mode == "120000":
            continue
        wanted.setdefault(oid, []).append(name.decode("utf-8", "replace"))

    resolved = cat_file_batch(repo, sorted(wanted), head_bytes=None)
    for oid, paths in wanted.items():
        entry = resolved.get(oid)
        if entry is None:
            continue
        data = entry[3]
        for path in paths:
            target = (destination / path).resolve()
            if destination not in target.parents:
                raise PublishError("tree entry escapes the extraction directory: %s" % path)
            target.parent.mkdir(parents=True, exist_ok=True)
            descriptor = os.open(str(target), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, FILE_MODE)
            with os.fdopen(descriptor, "wb") as handle:
                handle.write(data)
    return destination


# --------------------------------------------------------------------------
# Scanning
# --------------------------------------------------------------------------


@dataclass
class ScanResult:
    findings: list = field(default_factory=list)
    redactor: object = None
    commits: list = field(default_factory=list)


def scan_outgoing(repo, boundary, key):
    """Scan the outgoing patch range, the candidate tree, and every object."""
    redactor = Redactor(key)
    findings = []
    commits = outgoing_commits(repo, boundary)
    with scan_workspace(repo) as work:
        range_expression = "%s..%s" % (boundary.remote_oid, boundary.candidate_oid)
        results = run_gitleaks(repo, work, git_range=range_expression)
        findings += convert_gitleaks_results(
            results, key, redactor, "gitleaks-range", repo
        )

        extracted = work / "candidate-tree"
        extracted.mkdir(mode=DIRECTORY_MODE)
        export_tree(repo, boundary.candidate_oid, extracted)
        tree_results = run_gitleaks(repo, work, directory=extracted)
        findings += convert_gitleaks_results(
            tree_results,
            key,
            redactor,
            "gitleaks-tree",
            repo,
            boundary.candidate_oid,
            strip_prefix=extracted,
            directory=extracted,
        )

    for commit in commits:
        paths = [path for status, path in changed_entries(repo, commit) if status[0] != "D"]
        findings += inspect_paths(repo, commit, paths, key, redactor, "objects")

    findings += inspect_paths(
        repo,
        boundary.candidate_oid,
        tree_paths(repo, boundary.candidate_oid),
        key,
        redactor,
        "candidate-tree",
    )

    findings = classify_tree_findings(repo, boundary, deduplicate(findings))
    return ScanResult(findings=findings, redactor=redactor, commits=commits)


TREE_SOURCES = ("gitleaks-tree", "candidate-tree")


def classify_tree_findings(repo, boundary, findings):
    """Say plainly when a tree finding is already public.

    A tree scan attributes its hits to the candidate, so an inherited secret
    looks outgoing. Calling it outgoing invites a rewrite of unpublished
    commits, which remediates nothing for a value the remote already serves.
    Range findings keep their classification: their blob differs somewhere in
    the outgoing commits by construction.
    """
    published = {}
    for finding in findings:
        if finding["source"] not in TREE_SOURCES or not finding["path"]:
            continue
        path = finding["path"]
        if path not in published:
            candidate = run_git(
                repo.root, "rev-parse", "--quiet", "--verify",
                "%s:%s" % (boundary.candidate_oid, path), check=False,
            )
            remote = run_git(
                repo.root, "rev-parse", "--quiet", "--verify",
                "%s:%s" % (boundary.remote_oid, path), check=False,
            )
            published[path] = (
                candidate.code == 0
                and remote.code == 0
                and candidate.text.strip() == remote.text.strip()
            )
        if published[path]:
            finding["classification"] = "public-incident"
    return findings


def deduplicate(records):
    seen = set()
    unique = []
    for record in records:
        identity = (record["rule_id"], record["commit"], record["path"], record["fingerprint"])
        if identity in seen:
            continue
        seen.add(identity)
        unique.append(record)
    return unique


def store_findings(repo, run_id, result):
    write_json(
        run_directory(repo, run_id) / "findings.json",
        {
            "schema": SCHEMA,
            "run_id": run_id,
            "findings": result.findings,
            "value_signatures": result.redactor.value_signatures,
        },
    )


# --------------------------------------------------------------------------
# Complete-history audit
# --------------------------------------------------------------------------

PULL_REF = re.compile(r"^refs/pull/(\d+)/head$")

AUDIT_SURFACE = (
    "--branches",
    "--tags",
    "--remotes",
    "--glob=%s/*" % AUDIT_REF_PREFIX,
)


def cat_file_batch(repo, requests, head_bytes=8192):
    """Resolve many objects through one git cat-file process."""
    if not requests:
        return {}
    process = subprocess.Popen(
        ["git", "-C", str(repo.root), "cat-file", "--batch"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    results = {}
    try:
        for request in requests:
            process.stdin.write((request + "\n").encode("utf-8", "replace"))
            process.stdin.flush()
            header = process.stdout.readline().decode("utf-8", "replace").strip()
            parts = header.split()
            if len(parts) != 3:
                results[request] = None
                continue
            size = int(parts[2])
            data = process.stdout.read(size)
            process.stdout.read(1)
            results[request] = (
                parts[0],
                parts[1],
                size,
                data if head_bytes is None else data[:head_bytes],
            )
    finally:
        process.stdin.close()
        process.stdout.close()
        process.wait()
    return results


def audit_ref_for(number):
    return "%s/pull/%s/head" % (AUDIT_REF_PREFIX, number)


def remove_audit_refs(repo):
    listing = run_git(
        repo.root, "for-each-ref", "--format=%(refname)", AUDIT_REF_PREFIX + "/", check=False
    )
    removed = []
    for ref in listing.text.split():
        run_git(repo.root, "update-ref", "-d", ref, check=False)
        removed.append(ref)
    return removed


def fetch_public_refs(repo):
    """Fetch branches, tags, and pull-request heads into temporary audit refs."""
    fetched = run_git(repo.root, "fetch", "--quiet", "--tags", repo.remote_name, check=False)
    if fetched.code != 0:
        raise PublishError(
            "could not fetch %s for the audit: %s" % (repo.remote_name, fetched.error_text.strip())
        )
    listing = run_git(repo.root, "ls-remote", repo.fetch_url)
    remote_refs = {}
    for line in listing.text.splitlines():
        oid, _, ref = line.partition("\t")
        ref = ref.strip()
        if not ref or ref == "HEAD":
            continue
        remote_refs[ref] = oid.strip()

    pull_refs = sorted(ref for ref in remote_refs if PULL_REF.match(ref))
    audit_refs = []
    for start in range(0, len(pull_refs), 50):
        chunk = pull_refs[start : start + 50]
        refspecs = []
        for ref in chunk:
            number = PULL_REF.match(ref).group(1)
            refspecs.append("+%s:%s" % (ref, audit_ref_for(number)))
            audit_refs.append(audit_ref_for(number))
        result = run_git(repo.root, "fetch", "--quiet", repo.fetch_url, *refspecs, check=False)
        if result.code != 0:
            raise PublishError(
                "could not fetch pull-request heads for the audit: %s"
                % result.error_text.strip()
            )
    return remote_refs, audit_refs


def present_objects(repo, oids):
    present = []
    missing = []
    for oid in sorted(oids):
        if run_git(repo.root, "cat-file", "-e", oid, check=False).code == 0:
            present.append(oid)
        else:
            missing.append(oid)
    if missing:
        raise PublishError(
            "full audit is incomplete: %d advertised public tip objects are missing locally; "
            "fetch the missing refs and scan again" % len(missing)
        )
    return present


def reachable_commits(repo, tips):
    if not tips:
        return set()
    listing = run_git(repo.root, "rev-list", *tips)
    return set(listing.text.split())


def audit_commits(repo):
    listing = run_git(repo.root, "rev-list", "--topo-order", "--reverse", *AUDIT_SURFACE)
    return [line.strip() for line in listing.text.splitlines() if line.strip()]


def audit_tip_trees(repo):
    listing = run_git(
        repo.root, "for-each-ref", "--format=%(objectname)", *[
            "refs/heads/", "refs/remotes/", "refs/tags/", AUDIT_REF_PREFIX + "/"
        ]
    )
    trees = {}
    for oid in {line.strip() for line in listing.text.splitlines() if line.strip()}:
        resolved = run_git(repo.root, "rev-parse", "--quiet", "--verify", oid + "^{tree}", check=False)
        if resolved.code == 0:
            trees.setdefault(resolved.text.strip(), oid)
    return trees


def inspect_audit_objects(repo, commits, key, redactor):
    """Deterministic object findings across history, deduplicated by blob."""
    requests = []
    origin = {}
    attributes_by_commit = {}
    for commit in commits:
        paths = [path for status, path in changed_entries(repo, commit) if status[0] != "D"]
        if not paths:
            continue
        attributes_by_commit[commit] = filter_attributes(repo, commit, paths)
        for path in paths:
            request = "%s:%s" % (commit, path)
            requests.append(request)
            origin[request] = (commit, path)

    resolved = cat_file_batch(repo, requests)
    records = []
    seen = set()
    for request, entry in resolved.items():
        if entry is None:
            continue
        oid, kind, size, head = entry
        commit, path = origin[request]
        if (oid, path) in seen:
            continue
        seen.add((oid, path))

        def add(rule_id, detail):
            records.append(
                finding_record(
                    "objects",
                    rule_id,
                    path,
                    commit,
                    None,
                    None,
                    fingerprint(key, rule_id, commit, path, oid),
                    detail,
                )
            )

        if kind != "blob":
            add("submodule-in-history", "non-blob object %s at a tracked path" % kind)
            continue
        for pattern, rule_id in RISKY_PATH_RULES:
            if pattern.search(path):
                add(rule_id, "risky path name requires inspection")
        if path.lower().endswith(ARCHIVE_SUFFIXES):
            add("archive-file", "archive contents are not scannable in place")
        if size > LARGE_BLOB_LIMIT:
            add("large-file", "%d bytes exceeds the 2 MiB inspection limit" % size)
        if looks_binary(head):
            add("binary-file", "%d bytes of binary content require inspection" % size)
        if attributes_by_commit.get(commit, {}).get(path) == "git-crypt":
            if not head.startswith(GIT_CRYPT_HEADER):
                add(
                    "git-crypt-plaintext-blob",
                    "a git-crypt path is stored without the git-crypt header",
                )
    return records


def classify_findings(findings, public_commits):
    for finding in findings:
        commit = finding.get("commit") or ""
        if commit and commit in public_commits:
            finding["classification"] = "public-incident"
        else:
            finding["classification"] = "unpublished"
    return findings


def scan_full_audit(repo, key):
    """Scan every commit reachable from local, remote, tag, and pull-request refs."""
    redactor = Redactor(key)
    findings = []
    try:
        remote_refs, _ = fetch_public_refs(repo)
        public_tips = present_objects(repo, set(remote_refs.values()))
        public_commits = reachable_commits(repo, public_tips)
        commits = audit_commits(repo)
        missing_commits = public_commits - set(commits)
        if missing_commits:
            raise PublishError(
                "full audit is incomplete: %d public commits are outside the audited ref surface; "
                "fetch the missing refs and scan again" % len(missing_commits)
            )

        with scan_workspace(repo) as work:
            results = run_gitleaks(repo, work, git_range=" ".join(AUDIT_SURFACE))
            findings += convert_gitleaks_results(
                results, key, redactor, "gitleaks-history", repo
            )

            for ordinal, (tree, tip) in enumerate(sorted(audit_tip_trees(repo).items())):
                extracted = work / ("tip-%d" % ordinal)
                extracted.mkdir(mode=DIRECTORY_MODE)
                export_tree(repo, tree, extracted)
                tip_results = run_gitleaks(repo, work, directory=extracted)
                findings += convert_gitleaks_results(
                    tip_results,
                    key,
                    redactor,
                    "gitleaks-tree",
                    repo,
                    tip,
                    strip_prefix=extracted,
                    directory=extracted,
                )

        findings += inspect_audit_objects(repo, commits, key, redactor)
        findings = classify_findings(deduplicate(findings), public_commits)
        public_refs = sorted(
            "%s %s" % (ref, oid) for ref, oid in remote_refs.items() if not ref.endswith("^{}")
        )
        return ScanResult(findings=findings, redactor=redactor, commits=commits), public_refs
    finally:
        remove_audit_refs(repo)


def split_utf8_chunks(text, limit):
    """Split text without cutting a UTF-8 sequence or exceeding a byte limit."""
    if limit <= 0:
        raise ValueError("the chunk limit must be positive")
    pieces = []
    current = []
    current_size = 0
    for line in text.splitlines(keepends=True):
        while line:
            encoded_size = len(line.encode("utf-8"))
            if encoded_size <= limit - current_size:
                current.append(line)
                current_size += encoded_size
                line = ""
                continue
            if current:
                pieces.append("".join(current))
                current = []
                current_size = 0
                continue
            low, high = 1, len(line)
            while low < high:
                middle = (low + high + 1) // 2
                if len(line[:middle].encode("utf-8")) <= limit:
                    low = middle
                else:
                    high = middle - 1
            pieces.append(line[:low])
            line = line[low:]
    if current:
        pieces.append("".join(current))
    return pieces or [""]


def audit_commit_review_text(repo, commit, redactor):
    """Return one commit's metadata and patch without invoking textconv drivers."""
    shown = run_git(
        repo.root,
        "show",
        "--root",
        "--no-ext-diff",
        "--no-textconv",
        "--diff-merges=separate",
        "--find-renames",
        "--format=commit %H%nauthor %an <%ae>%ndate %aI%nparents %P%nsubject %s%n%n%b",
        "--patch",
        commit,
    ).text
    return redactor.scrub(shown)


def audit_history_units(repo, commits, redactor):
    """Bundle complete commit metadata and patches into bounded review units."""
    units = []
    content = []
    content_size = 0
    content_commits = []
    ordinal = 0
    payload_limit = AUDIT_REVIEW_CHUNK_LIMIT - 256

    def flush():
        nonlocal content, content_size, content_commits, ordinal
        if not content:
            return
        units.append(
            make_unit(
                "patch",
                content_commits[0],
                "full-history",
                ordinal,
                "".join(content),
                {
                    "commit_count": len(content_commits),
                    "first_commit": content_commits[0],
                    "last_commit": content_commits[-1],
                },
            )
        )
        ordinal += 1
        content = []
        content_size = 0
        content_commits = []

    for commit in commits:
        pieces = split_utf8_chunks(audit_commit_review_text(repo, commit, redactor), payload_limit)
        for part, piece in enumerate(pieces, 1):
            marker = "\n=== AUDIT COMMIT %s PART %d/%d ===\n" % (commit, part, len(pieces))
            framed = marker + piece
            framed_size = len(framed.encode("utf-8"))
            if content and content_size + framed_size > AUDIT_REVIEW_CHUNK_LIMIT:
                flush()
            content.append(framed)
            content_size += framed_size
            if not content_commits or content_commits[-1] != commit:
                content_commits.append(commit)
    flush()
    return units


def finding_source_excerpt(finding, resolved, redactor):
    """Return bounded source context with every scanner-known value redacted."""
    if finding.get("source") == "gitleaks-history":
        return "Git patch coordinates are not blob coordinates; scanner context: %s" % (
            finding.get("context") or "redacted context unavailable"
        )
    commit = finding.get("commit")
    path = finding.get("path")
    line_number = finding.get("line")
    entry = resolved.get("%s:%s" % (commit, path)) if commit and path else None
    if not entry or not isinstance(line_number, int) or line_number < 1:
        return "source excerpt unavailable"
    _, kind, size, head = entry
    if kind != "blob" or looks_binary(head):
        return "source excerpt unavailable for non-text object"
    lines = head.decode("utf-8", "replace").splitlines()
    if line_number > len(lines):
        suffix = " (file exceeds review excerpt limit)" if size > len(head) else ""
        return "source excerpt unavailable%s" % suffix
    start = max(0, line_number - 3)
    end = min(len(lines), line_number + 2)
    excerpt = "\n".join("%d: %s" % (index + 1, lines[index]) for index in range(start, end))
    return redactor.scrub(excerpt)


def build_audit_manifest(repo, run_id, result):
    """Bounded history patches, high-risk files, and findings for review."""
    redactor = result.redactor
    units = audit_history_units(repo, result.commits, redactor)

    requests = []
    origin = {}
    for commit in result.commits:
        for ordinal, (status, path) in enumerate(changed_entries(repo, commit)):
            if status[0] == "D" or not is_risky_path(path):
                continue
            request = "%s:%s" % (commit, path)
            requests.append(request)
            origin.setdefault(request, (commit, path, ordinal, status))

    resolved = cat_file_batch(repo, requests, head_bytes=LARGE_BLOB_LIMIT)
    seen = set()
    for request, entry in resolved.items():
        if entry is None:
            continue
        oid, kind, size, head = entry
        commit, path, ordinal, status = origin[request]
        if (oid, path) in seen:
            continue
        seen.add((oid, path))
        if kind == "blob" and is_risky_path(path):
            content = blob_content(repo, oid, size, redactor)
            units.append(
                make_unit("high-risk-file", commit, path, 0, content, {"object": oid, "size": size})
            )

    finding_requests = sorted(
        {
            "%s:%s" % (finding.get("commit"), finding.get("path"))
            for finding in result.findings
            if finding.get("commit")
            and finding.get("path")
            and finding.get("source") != "gitleaks-history"
        }
    )
    finding_objects = cat_file_batch(repo, finding_requests, head_bytes=LARGE_BLOB_LIMIT)
    for ordinal, finding in enumerate(result.findings):
        content = json.dumps(finding, indent=2, sort_keys=True)
        content += "\n\nsource excerpt:\n" + finding_source_excerpt(
            finding, finding_objects, redactor
        )
        units.append(
            make_unit(
                "deterministic-finding",
                finding["commit"],
                finding["path"],
                ordinal,
                content,
                {"fingerprint": finding["fingerprint"], "classification": finding["classification"]},
            )
        )

    counts = {kind: 0 for kind in MANIFEST_KINDS}
    for unit in units:
        counts[unit["kind"]] = counts.get(unit["kind"], 0) + 1
    digest = hashlib.sha256()
    digest.update(b"dotfiles-publish-manifest\x00")
    for unit in units:
        digest.update(unit["unit_id"].encode("utf-8") + b"\x00")
        digest.update(hashlib.sha256(unit["content"].encode("utf-8")).digest())
    return {
        "schema": SCHEMA,
        "run_id": run_id,
        "manifest_id": digest.hexdigest(),
        "counts": counts,
        "units": units,
    }


# --------------------------------------------------------------------------
# Incidents
# --------------------------------------------------------------------------


def load_incidents(repo):
    path = incidents_path(repo)
    if not path.exists():
        return {"schema": SCHEMA, "incidents": {}}
    data = read_json(path)
    data.setdefault("incidents", {})
    return data


def incident_state_digest(repo):
    """Bind an audit to the exact incident ledger it scanned after."""
    payload = json.dumps(load_incidents(repo), sort_keys=True).encode("utf-8")
    return hashlib.sha256(payload).hexdigest()


def flag_incident(repo):
    """Invalidate the current full-audit receipt after triage."""
    path = repo.state_dir / "full-audit.json"
    if not path.exists():
        return
    receipt = read_json(path)
    receipt["incident_flag"] = True
    write_json(path, receipt)


def command_incident_record(args):
    repo = discover_repository()
    key = fingerprint_key(repo)
    record = load_run(repo, args.run)
    if record["mode"] != "full-audit":
        raise PublishError(
            "incidents are recorded against a full-audit run", EXIT_REFUSED
        )
    findings = load_findings(repo, args.run)
    matching = [
        finding
        for finding in findings.get("findings", [])
        if finding["fingerprint"] == args.fingerprint
    ]
    if not matching:
        raise PublishError(
            "run %s has no finding with fingerprint %s" % (args.run, args.fingerprint),
            EXIT_REFUSED,
        )
    if matching[0].get("classification") != "public-incident":
        raise PublishError(
            "fingerprint %s is not published, so remove it from history instead of "
            "recording an incident" % args.fingerprint,
            EXIT_REFUSED,
        )

    evidence_path = Path(args.evidence)
    evidence_bytes, evidence = read_bounded_json(
        evidence_path, MAX_INCIDENT_EVIDENCE_BYTES, "incident evidence"
    )
    if not isinstance(evidence, dict):
        raise PublishError("the evidence file must contain one JSON object", EXIT_REFUSED)
    if "value" in evidence or "secret" in evidence:
        raise PublishError(
            "the evidence contains a value field; record only redacted evidence", EXIT_REFUSED
        )
    for required in ("fingerprint", "action_time", "verification"):
        if not evidence.get(required):
            raise PublishError("the evidence is missing %s" % required, EXIT_REFUSED)
    if evidence["fingerprint"] != args.fingerprint:
        raise PublishError(
            "the evidence names a different fingerprint than the finding", EXIT_REFUSED
        )
    if args.resolution == "accepted-risk":
        for required in ("rationale", "authorization"):
            value = evidence.get(required)
            if not isinstance(value, str) or not value.strip():
                raise PublishError(
                    "accepted-risk evidence requires %s" % required, EXIT_REFUSED
                )
    for broad in ("path", "rule_id", "paths", "rules"):
        if evidence.get(broad) in ("*", ["*"]):
            raise PublishError(
                "a path-wide or rule-wide incident exception is forbidden", EXIT_REFUSED
            )
    reject_known_values(evidence, findings.get("value_signatures") or [], key)

    incidents = load_incidents(repo)
    incidents["incidents"][args.fingerprint] = {
        "resolution": args.resolution,
        "resolved_at": rfc3339(now_epoch()),
        "evidence_sha256": hashlib.sha256(evidence_bytes).hexdigest(),
        "rule_id": matching[0]["rule_id"],
    }
    if args.resolution == "accepted-risk":
        incidents["incidents"][args.fingerprint]["evidence"] = evidence
    write_json(incidents_path(repo), incidents)
    flag_incident(repo)
    print("incident: %s %s" % (args.fingerprint, args.resolution))
    print("full-audit-invalidated: true")
    return EXIT_OK


# --------------------------------------------------------------------------
# Review manifest
# --------------------------------------------------------------------------

MANIFEST_KINDS = (
    "commit",
    "path",
    "patch",
    "new-file",
    "high-risk-file",
    "deterministic-finding",
    "public-text",
)

FINDING_FIELDS = {
    "source",
    "rule_id",
    "path",
    "commit",
    "line",
    "column",
    "fingerprint",
    "context",
    "classification",
}


def unit_identifier(kind, commit, path, ordinal):
    return sha256_of(
        "dotfiles-publish-unit", str(SCHEMA), kind, commit, path, str(ordinal)
    )[:32]


def make_unit(kind, commit, path, ordinal, content, detail=None):
    return {
        "unit_id": unit_identifier(kind, commit, path, ordinal),
        "kind": kind,
        "commit": commit,
        "path": path,
        "ordinal": ordinal,
        "content": content,
        "detail": detail or {},
    }


def split_patch_hunks(patch_text):
    hunks = []
    path = ""
    current = None
    for line in patch_text.splitlines(keepends=True):
        if line.startswith("diff --git "):
            path = ""
            current = None
            continue
        if line.startswith("--- "):
            candidate = line[4:].strip()
            if not path and candidate != "/dev/null":
                path = candidate[2:] if candidate.startswith("a/") else candidate
            continue
        if line.startswith("+++ "):
            candidate = line[4:].strip()
            if candidate != "/dev/null":
                path = candidate[2:] if candidate.startswith("b/") else candidate
            continue
        if line.startswith("@@"):
            header = line.rstrip("\n")
            coordinates = re.match(r"^@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@", header)
            current = {
                "path": path,
                "header": header,
                "old_start": int(coordinates.group(1)) if coordinates else None,
                "new_start": int(coordinates.group(2)) if coordinates else None,
                "body": [],
            }
            hunks.append(current)
            continue
        if current is not None:
            current["body"].append(line)
    return hunks


def bounded_hunk(hunk):
    """Keep a reviewable hunk whole; mark an oversized one instead of hiding it."""
    body = "".join(hunk["body"])
    if len(body) <= LARGE_BLOB_LIMIT:
        return hunk["header"] + "\n" + body
    return "%s\n%s\n[hunk truncated: %d bytes; the large-file finding covers the rest]" % (
        hunk["header"],
        body[:LARGE_BLOB_LIMIT],
        len(body),
    )


def blob_content(repo, oid, size, redactor):
    """Full text for reviewable blobs; an identified placeholder otherwise."""
    if size > LARGE_BLOB_LIMIT:
        data = blob_bytes(repo, oid, 4096)
        return "[blob omitted: %d bytes exceeds the 2 MiB review limit, object %s]\n%s" % (
            size,
            oid,
            redactor.scrub(data.decode("utf-8", "replace")),
        )
    data = blob_bytes(repo, oid)
    if looks_binary(data):
        return "[binary blob: %d bytes, object %s, sha256 %s]" % (
            size,
            oid,
            hashlib.sha256(data).hexdigest(),
        )
    return redactor.scrub(data.decode("utf-8", "replace"))


def is_risky_path(path):
    return any(pattern.search(path) for pattern, _ in RISKY_PATH_RULES)


def commit_units(repo, commit, redactor):
    fields = run_git(
        repo.root,
        "show",
        "--no-patch",
        "--format=%H%x00%an <%ae>%x00%aI%x00%P%x00%s%x00%b",
        commit,
    ).out.split(b"\x00")
    values = [item.decode("utf-8", "replace") for item in fields]
    while len(values) < 6:
        values.append("")
    detail = {
        "author": values[1],
        "date": values[2],
        "parents": values[3].split(),
        "subject": values[4].strip(),
    }
    content = redactor.scrub(
        "commit %s\nauthor %s\ndate %s\nparents %s\nsubject %s\n\n%s"
        % (commit, detail["author"], detail["date"], " ".join(detail["parents"]), detail["subject"], values[5])
    )
    return make_unit("commit", commit, "", 0, content, detail)


def build_manifest(repo, run_id, boundary, result, mode, tag, release_notes):
    redactor = result.redactor
    units = []

    for commit in result.commits:
        units.append(commit_units(repo, commit, redactor))

        entries = changed_entries(repo, commit)
        for ordinal, (status, path) in enumerate(entries):
            entry = tree_entry(repo, commit, path)
            description = ["status %s" % status, "path %s" % path]
            detail = {"status": status}
            if entry:
                mode_bits, kind, oid = entry
                description.append("mode %s" % mode_bits)
                description.append("object %s %s" % (kind, oid))
                description.append("size %d" % blob_size(repo, oid))
                if kind == "blob" and mode_bits != "120000":
                    detail["object"] = oid
            else:
                description.append("object removed at this commit")
            unit = make_unit("path", commit, path, ordinal, "\n".join(description), detail)
            if entry and entry[1] == "blob" and entry[0] != "120000":
                unit["blob"] = blob_content(repo, entry[2], blob_size(repo, entry[2]), redactor)
            units.append(unit)

        patch = run_git(
            repo.root, "diff-tree", "--root", "--find-renames", "--format=", "--patch", commit
        ).text
        for ordinal, hunk in enumerate(split_patch_hunks(patch)):
            units.append(
                make_unit(
                    "patch",
                    commit,
                    hunk["path"],
                    ordinal,
                    redactor.scrub(bounded_hunk(hunk)),
                    {"old_start": hunk["old_start"], "new_start": hunk["new_start"]},
                )
            )

        for status, path in entries:
            if status[0] == "D":
                continue
            entry = tree_entry(repo, commit, path)
            if not entry or entry[1] != "blob" or entry[0] == "120000":
                continue
            mode_bits, _, oid = entry
            size = blob_size(repo, oid)
            if status[0] in ("A", "C"):
                units.append(
                    make_unit(
                        "new-file",
                        commit,
                        path,
                        0,
                        blob_content(repo, oid, size, redactor),
                        {"object": oid, "size": size},
                    )
                )
            if is_risky_path(path):
                units.append(
                    make_unit(
                        "high-risk-file",
                        commit,
                        path,
                        0,
                        blob_content(repo, oid, size, redactor),
                        {"object": oid, "size": size},
                    )
                )

    for ordinal, finding in enumerate(result.findings):
        units.append(
            make_unit(
                "deterministic-finding",
                finding["commit"],
                finding["path"],
                ordinal,
                json.dumps(finding, indent=2, sort_keys=True),
                {"fingerprint": finding["fingerprint"], "rule_id": finding["rule_id"]},
            )
        )

    if mode == "release":
        if release_notes:
            units.append(
                make_unit(
                    "public-text",
                    boundary.candidate_oid,
                    str(release_notes),
                    0,
                    redactor.scrub(Path(release_notes).read_text(encoding="utf-8")),
                    {"purpose": "release notes"},
                )
            )
        if tag:
            units.append(
                make_unit(
                    "public-text",
                    boundary.candidate_oid,
                    "refs/tags/%s" % tag,
                    1,
                    redactor.scrub(tag),
                    {"purpose": "release tag"},
                )
            )

    counts = {kind: 0 for kind in MANIFEST_KINDS}
    for unit in units:
        counts[unit["kind"]] = counts.get(unit["kind"], 0) + 1

    digest = hashlib.sha256()
    digest.update(b"dotfiles-publish-manifest\x00")
    for unit in units:
        digest.update(unit["unit_id"].encode("utf-8") + b"\x00")
        encoded = json.dumps(unit, sort_keys=True, separators=(",", ":")).encode("utf-8")
        digest.update(hashlib.sha256(encoded).digest())
    manifest_id = digest.hexdigest()

    return {
        "schema": SCHEMA,
        "run_id": run_id,
        "manifest_id": manifest_id,
        "counts": counts,
        "units": units,
    }


def store_manifest(repo, run_id, manifest):
    write_json(run_directory(repo, run_id) / "manifest.json", manifest)


def load_manifest(repo, run_id):
    load_run(repo, run_id)
    path = run_directory(repo, run_id) / "manifest.json"
    if not path.exists():
        raise PublishError("run %s has no manifest; scan again" % run_id, EXIT_REFUSED)
    manifest = read_json(path)
    if manifest.get("schema") != SCHEMA:
        raise PublishError(
            "run %s predates safe scanner redaction; scan again" % run_id,
            EXIT_REFUSED,
        )
    return manifest


def load_findings(repo, run_id):
    path = run_directory(repo, run_id) / "findings.json"
    if not path.exists():
        return {"findings": [], "value_signatures": []}
    findings = read_json(path)
    if findings.get("schema") != SCHEMA:
        raise PublishError(
            "run %s predates safe scanner redaction; scan again" % run_id,
            EXIT_REFUSED,
        )
    return findings


# --------------------------------------------------------------------------
# Review records
# --------------------------------------------------------------------------


def review_path(repo, run_id):
    return run_directory(repo, run_id) / "review.json"


@contextmanager
def review_write_lock(repo, run_id):
    """Serialize immutable review updates so concurrent agents cannot lose one."""
    path = run_directory(repo, run_id) / "review.lock"
    descriptor = os.open(str(path), os.O_RDWR | os.O_CREAT, FILE_MODE)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def load_review(repo, run_id, manifest):
    path = review_path(repo, run_id)
    if not path.exists():
        return {
            "schema": SCHEMA,
            "run_id": run_id,
            "manifest_id": manifest["manifest_id"],
            "entries": {},
        }
    review = read_json(path)
    review.setdefault("entries", {})
    return review


def findings_digest(records):
    return hashlib.sha256(json.dumps(records, sort_keys=True).encode("utf-8")).hexdigest()


TOKEN_PATTERN = re.compile(r"[A-Za-z0-9_\-\.\+/=]{8,}")


def signature_index(signatures):
    """Validate persisted signatures and group their HMACs by character length."""
    indexed = {}
    for signature in signatures:
        if not isinstance(signature, dict):
            raise PublishError("scanner value signatures are invalid; scan again", EXIT_REFUSED)
        length = signature.get("length")
        digest = signature.get("hmac")
        if (
            not isinstance(length, int)
            or not MIN_KNOWN_VALUE_CHARS <= length <= MAX_REVIEW_FIELD_CHARS
            or not isinstance(digest, str)
            or not re.fullmatch(r"[0-9a-f]{64}", digest)
        ):
            raise PublishError("scanner value signatures are invalid; scan again", EXIT_REFUSED)
        indexed.setdefault(length, set()).add(digest)
    return indexed


def string_values(value):
    """Yield strings from JSON-compatible evidence without JSON escaping them."""
    if isinstance(value, str):
        yield value
    elif isinstance(value, dict):
        for item in value.values():
            yield from string_values(item)
    elif isinstance(value, list):
        for item in value:
            yield from string_values(item)


def reject_known_values(value, signatures, key):
    indexed = signature_index(signatures)
    if not indexed:
        return
    texts = list(string_values(value))
    work = 0
    for text in texts:
        if len(text) > MAX_REVIEW_FIELD_CHARS:
            raise PublishError(
                "a review evidence field is too long; keep only concise redacted evidence",
                EXIT_REFUSED,
            )
        for length in indexed:
            if length <= len(text):
                # Four is the maximum UTF-8 byte length of one Unicode scalar.
                # This conservative preflight bounds both slices and bytes hashed.
                work += (len(text) - length + 1) * length * 4
                if work > MAX_KNOWN_VALUE_CHECK_WORK:
                    raise PublishError(
                        "review evidence requires too much secret-comparison work; keep it concise",
                        EXIT_REFUSED,
                    )
    for text in texts:
        for length, digests in indexed.items():
            if length > len(text):
                continue
            for offset in range(len(text) - length + 1):
                if value_hmac(key, text[offset : offset + length]) in digests:
                    raise PublishError(
                        "the review record contains a value the scanner detected; report the fingerprint instead",
                        EXIT_REFUSED,
                    )


def validate_review_findings(records, signatures, key, unit):
    if not isinstance(records, list):
        raise PublishError("a findings file must contain a list of finding records", EXIT_REFUSED)
    if len(records) > MAX_REVIEW_FINDINGS:
        raise PublishError(
            "a findings file contains too many records; split the review into smaller units",
            EXIT_REFUSED,
        )
    for index, record in enumerate(records):
        if not isinstance(record, dict):
            raise PublishError("finding %d is not an object" % index, EXIT_REFUSED)
        unknown = set(record) - FINDING_FIELDS
        if "value" in record or "secret" in record:
            raise PublishError(
                "finding %d contains a value field; record only redacted evidence" % index,
                EXIT_REFUSED,
            )
        if unknown:
            raise PublishError(
                "finding %d has unsupported fields: %s" % (index, ", ".join(sorted(unknown))),
                EXIT_REFUSED,
            )
        for field_name, value in record.items():
            if field_name in ("line", "column"):
                if value is not None and not isinstance(value, int):
                    raise PublishError(
                        "finding %d field %s must be an integer" % (index, field_name),
                        EXIT_REFUSED,
                    )
                continue
            if value is not None and not isinstance(value, str):
                raise PublishError(
                    "finding %d field %s must be a string" % (index, field_name),
                    EXIT_REFUSED,
                )
            if isinstance(value, str) and len(value) > MAX_REVIEW_FIELD_CHARS:
                raise PublishError(
                    "finding %d field %s is too long" % (index, field_name),
                    EXIT_REFUSED,
                )
    # Budget the complete payload before hashing any reviewer-controlled text.
    reject_known_values(records, signatures, key)

    validated = []
    for record in records:
        complete = {
            "source": record.get("source") or "review",
            "rule_id": record.get("rule_id") or "review-finding",
            "path": record.get("path") or unit["path"],
            "commit": record.get("commit") or unit["commit"],
            "line": record.get("line"),
            "column": record.get("column"),
            "fingerprint": record.get("fingerprint")
            or fingerprint(key, "review", unit["unit_id"], record.get("rule_id") or "review-finding"),
            "context": clip(structural_redaction(record.get("context") or "")),
            "classification": record.get("classification") or "outgoing",
        }
        validated.append(complete)
    return validated


def command_review_list(args):
    repo = discover_repository()
    manifest = load_manifest(repo, args.run)
    for unit in manifest["units"]:
        print(
            "%s %s %s %s"
            % (unit["unit_id"], unit["kind"], (unit["commit"] or "-")[:12], unit["path"] or "-")
        )
    return EXIT_OK


def command_review_show(args):
    repo = discover_repository()
    manifest = load_manifest(repo, args.run)
    for unit in manifest["units"]:
        if unit["unit_id"] == args.unit:
            print(json.dumps(resolved_unit(repo, unit), indent=2, sort_keys=True))
            return EXIT_OK
    raise PublishError("unknown review unit %s" % args.unit, EXIT_REFUSED)


def resolved_unit(repo, unit):
    """Show the redacted path snapshot captured during the scan.

    Older manifests resolved the raw object here, after the scanner-known
    values had left memory.  Refuse those units instead of risking disclosure.
    """
    if unit["kind"] != "path":
        return unit
    oid = (unit.get("detail") or {}).get("object")
    if not oid:
        return unit
    if "blob" not in unit:
        raise PublishError(
            "path unit predates safe redaction; scan again before review",
            EXIT_REFUSED,
        )
    return unit


def command_review_record(args):
    repo = discover_repository()
    key = fingerprint_key(repo)
    manifest = load_manifest(repo, args.run)
    units = {unit["unit_id"]: unit for unit in manifest["units"]}
    if args.unit not in units:
        raise PublishError("unknown review unit %s" % args.unit, EXIT_REFUSED)

    records = []
    if args.verdict == "finding":
        if not args.findings:
            raise PublishError("--findings is required for a finding verdict", EXIT_REFUSED)
        signatures = load_findings(repo, args.run).get("value_signatures") or []
        _, payload = read_bounded_json(
            args.findings, MAX_REVIEW_FINDINGS_BYTES, "review findings"
        )
        if isinstance(payload, dict):
            payload = payload.get("findings", [])
        records = validate_review_findings(payload, signatures, key, units[args.unit])
        if not records:
            raise PublishError("a finding verdict needs at least one finding record", EXIT_REFUSED)
    elif args.findings:
        raise PublishError("--findings is only meaningful with a finding verdict", EXIT_REFUSED)

    digest = findings_digest(records)
    with review_write_lock(repo, args.run):
        review = load_review(repo, args.run, manifest)
        if os.environ.get("DOTFILES_PUBLISH_TESTING") == "1":
            delay = float(os.environ.get("DOTFILES_PUBLISH_TEST_REVIEW_DELAY", "0"))
            if delay > 0:
                time.sleep(delay)
        existing = review["entries"].get(args.unit)
        if existing and (
            existing.get("verdict") != args.verdict or existing.get("digest") != digest
        ):
            raise PublishError(
                "unit %s already has a different verdict; start a new run instead of revising one"
                % args.unit,
                EXIT_REFUSED,
            )
        review["manifest_id"] = manifest["manifest_id"]
        review["entries"][args.unit] = {
            "verdict": args.verdict,
            "digest": digest,
            "findings": records,
            "recorded_at": rfc3339(now_epoch()),
        }
        write_json(review_path(repo, args.run), review)
    print("recorded: %s %s" % (args.unit, args.verdict))
    return EXIT_OK


@dataclass
class ReviewStatus:
    run_id: str
    scan_id: str
    manifest_id: str
    total: int
    recorded: int
    missing: list
    extra: list
    unit_findings: list
    deterministic: list

    @property
    def clean(self):
        return not (self.missing or self.extra or self.unit_findings or self.deterministic)


def deterministic_is_resolved(finding, units_by_id, entries, resolved):
    """A scanner hit stops blocking once the review has adjudicated it.

    Every deterministic finding gets its own manifest unit precisely so the
    review can judge it. Ignoring that verdict would make the second layer
    decorative: a detector that fires on a file *about* credentials could never
    be cleared, and the guard would refuse every publication forever.

    A clean verdict means the reviewer judged there is no secret here, so there
    is nothing to rotate and nothing to remove. The public-incident
    classification governs which remedy applies once a finding is judged real;
    it does not make a false positive unclearable.
    """
    if finding["fingerprint"] in resolved:
        return True
    for unit in units_by_id.values():
        if unit["kind"] != "deterministic-finding":
            continue
        if (unit.get("detail") or {}).get("fingerprint") != finding["fingerprint"]:
            continue
        entry = entries.get(unit["unit_id"])
        return bool(entry) and entry.get("verdict") == "clean"
    return False


def entry_is_resolved(entry, unit, resolved):
    """A recorded finding stops blocking once triage resolved its fingerprint.

    Without this, a run whose id is a pure function of the boundary could never
    go clean again: the verdict is immutable, so a public incident would keep
    blocking every future audit even after the credential was rotated.
    """
    if not resolved:
        return False
    fingerprints = {
        finding.get("fingerprint")
        for finding in entry.get("findings") or []
        if finding.get("fingerprint")
    }
    if unit and unit.get("kind") == "deterministic-finding":
        recorded = (unit.get("detail") or {}).get("fingerprint")
        if recorded:
            fingerprints.add(recorded)
    return bool(fingerprints) and fingerprints.issubset(resolved)


def review_status(repo, run_id):
    record = load_run(repo, run_id)
    resolved = resolved_fingerprints(repo) if record["mode"] == "full-audit" else frozenset()
    manifest = load_manifest(repo, run_id)
    if record.get("manifest_id") != manifest["manifest_id"]:
        raise PublishError(
            "the scan and manifest changed during review; scan and review again",
            EXIT_REFUSED,
        )
    review = load_review(repo, run_id, manifest)
    expected = [unit["unit_id"] for unit in manifest["units"]]
    recorded = set(review["entries"])
    if review.get("manifest_id") and review["manifest_id"] != manifest["manifest_id"]:
        raise PublishError(
            "the review was recorded against a different manifest; scan and review again",
            EXIT_REFUSED,
        )
    missing = [unit_id for unit_id in expected if unit_id not in recorded]
    extra = sorted(recorded - set(expected))
    units_by_id = {unit["unit_id"]: unit for unit in manifest["units"]}
    unit_findings = sorted(
        unit_id
        for unit_id, entry in review["entries"].items()
        if entry.get("verdict") == "finding"
        and not entry_is_resolved(entry, units_by_id.get(unit_id), resolved)
    )
    deterministic = [
        finding["fingerprint"]
        for finding in load_findings(repo, run_id).get("findings", [])
        if not deterministic_is_resolved(finding, units_by_id, review["entries"], resolved)
    ]
    return ReviewStatus(
        run_id=run_id,
        scan_id=record.get("scan_id", ""),
        manifest_id=manifest["manifest_id"],
        total=len(expected),
        recorded=len(recorded),
        missing=missing,
        extra=extra,
        unit_findings=unit_findings,
        deterministic=deterministic,
    )


def record_full_audit(repo, run_id, status):
    """A clean, exhaustive audit review is what writes the receipt."""
    record = load_run(repo, run_id)
    if record["mode"] != "full-audit" or not status.clean:
        return None
    manifest = load_manifest(repo, run_id)
    if (
        status.run_id != run_id
        or not status.scan_id
        or status.scan_id != record.get("scan_id")
        or status.manifest_id != record.get("manifest_id")
        or status.manifest_id != manifest["manifest_id"]
    ):
        raise PublishError(
            "the full-audit scan or manifest changed after review; review the current scan",
            EXIT_REFUSED,
        )
    scanned = record.get("scanned_epoch")
    now = now_epoch()
    if (
        not isinstance(scanned, (int, float))
        or isinstance(scanned, bool)
        or not math.isfinite(scanned)
        or scanned > now
        or now - scanned > FULL_AUDIT_MAX_AGE_SECONDS
    ):
        raise PublishError(
            "the full audit has no recent scan time; scan again before recording a receipt",
            EXIT_REFUSED,
        )
    if record.get("incident_digest") != incident_state_digest(repo):
        raise PublishError(
            "the incident state changed after this full-audit scan; scan again before recording a receipt",
            EXIT_REFUSED,
        )
    if record["ruleset_id"] != ruleset_identity(repo.root):
        raise PublishError(
            "the ruleset changed after this full-audit scan; scan again before recording a receipt",
            EXIT_REFUSED,
        )
    receipt = {
        "schema": SCHEMA,
        "completed_at": rfc3339(scanned),
        "completed_epoch": scanned,
        "ruleset_id": record["ruleset_id"],
        "run_id": run_id,
        "scan_id": status.scan_id,
        "manifest_id": status.manifest_id,
        "public_refs": record.get("public_refs") or [],
        "incident_flag": False,
        "incident_digest": record["incident_digest"],
    }
    if full_audit_receipt(repo) != receipt:
        write_json(repo.state_dir / "full-audit.json", receipt)
    return receipt


def command_review_status(args):
    repo = discover_repository()
    status = review_status(repo, args.run)
    print("units: %d" % status.total)
    print("recorded: %d" % status.recorded)
    for unit_id in status.missing:
        print("missing-unit: %s" % unit_id)
    for unit_id in status.extra:
        print("extra-unit: %s" % unit_id)
    for unit_id in status.unit_findings:
        print("review-finding: %s" % unit_id)
    for print_key in status.deterministic:
        print("deterministic-finding: %s" % print_key)
    print("clean: %s" % ("yes" if status.clean else "no"))
    receipt = record_full_audit(repo, args.run, status)
    if receipt:
        print("full-audit-recorded: %s" % receipt["completed_at"])
    return EXIT_OK if status.clean else EXIT_REFUSED


# --------------------------------------------------------------------------
# scan
# --------------------------------------------------------------------------


def command_scan(args):
    repo = discover_repository()
    if args.mode not in MODES:
        raise PublishError("unknown mode: %s" % args.mode)
    if args.tag and args.mode != "release":
        raise PublishError("--tag is only meaningful in release mode")

    ruleset_id = ruleset_identity(repo.root)
    key = fingerprint_key(repo)
    boundary = resolve_boundary(
        repo,
        fetch=args.mode != "readiness",
        fetch_missing_objects=args.mode == "readiness",
    )
    notes_digest = notes_digest_of(args.release_notes)
    run_id = compute_run_id(args.mode, repo, boundary, ruleset_id, args.tag, notes_digest)
    now = now_epoch()
    staleness = full_audit_staleness(repo, ruleset_id, now)
    incident_digest = incident_state_digest(repo)

    public_refs = []
    if args.mode == "full-audit":
        result, public_refs = scan_full_audit(repo, key)
        manifest = build_audit_manifest(repo, run_id, result)
        receipt = full_audit_receipt(repo)
        if not staleness and receipt and receipt.get("run_id") == run_id:
            # Storing this generation will replace the scan backing the current
            # receipt, even when the manifest and scan timestamp are unchanged.
            staleness = "the new full-audit scan is pending review"
    else:
        result = scan_outgoing(repo, boundary, key)
        manifest = build_manifest(
            repo, run_id, boundary, result, args.mode, args.tag, args.release_notes
        )
    record = {
        "schema": SCHEMA,
        "mode": args.mode,
        "run_id": run_id,
        "created_at": rfc3339(now),
        "scanned_epoch": now,
        "scan_id": secrets.token_hex(16),
        "repository": str(repo.root),
        "remote_name": repo.remote_name,
        "remote_url": repo.fetch_url,
        "remote_ref": repo.remote_ref,
        "remote_oid": boundary.remote_oid,
        "candidate_oid": boundary.candidate_oid,
        "ruleset_id": ruleset_id,
        "manifest_id": manifest["manifest_id"],
        "full_audit_due": staleness is not None,
        "public_refs": public_refs,
        "incident_digest": incident_digest,
        "release_tag": args.tag,
    }
    store_run(repo, record)
    store_findings(repo, run_id, result)
    store_manifest(repo, run_id, manifest)

    print("run: %s" % run_id)
    print("mode: %s" % args.mode)
    print("repository: %s" % repo.root)
    print("remote: %s %s %s" % (repo.remote_name, repo.remote_ref, boundary.remote_oid))
    print("candidate: %s" % boundary.candidate_oid)
    print("ruleset: %s" % ruleset_id)
    print("outgoing-commits: %d" % len(result.commits))
    for finding in result.findings:
        print(format_finding(finding))
    print("findings: %d" % len(result.findings))
    print("units: %d" % len(manifest["units"]))
    incidents = [
        finding
        for finding in result.findings
        if finding.get("classification") == "public-incident"
    ]
    if incidents:
        print("handoff: gitguardian-triage")
        print(
            "handoff-order: rotate or revoke the credential, then remove it from the "
            "source, then consider public-history cleanup"
        )
        for finding in incidents:
            print(
                "public-incident: %s %s %s %s"
                % (
                    finding["rule_id"],
                    finding["path"] or "-",
                    (finding["commit"] or "-")[:12],
                    finding["fingerprint"],
                )
            )
    print("full-audit-due: %s" % ("true" if staleness else "false"))
    if staleness:
        print("full-audit-reason: %s" % staleness)
    return EXIT_FINDINGS if result.findings else EXIT_OK


# --------------------------------------------------------------------------
# History repair
# --------------------------------------------------------------------------


def repairs_path(repo):
    return repo.state_dir / "repairs.json"


def load_repairs(repo):
    path = repairs_path(repo)
    if not path.exists():
        return {"schema": SCHEMA, "repairs": {}}
    data = read_json(path)
    data.setdefault("repairs", {})
    return data


def recovery_ref_for(run_id):
    return "%s/%s" % (RECOVERY_REF_PREFIX, run_id)


def remote_tip_of(repo, url, ref):
    listing = run_git(repo.root, "ls-remote", url, ref)
    lines = [line for line in listing.text.splitlines() if line.strip()]
    return lines[0].split()[0] if lines else None


def clear_recovery_refs(repo, remote_oid):
    """Drop repair protection only once the repaired history is published."""
    repairs = load_repairs(repo)
    removed = []
    for run_id, entry in list(repairs["repairs"].items()):
        if entry.get("remote_oid") == remote_oid:
            run_git(repo.root, "update-ref", "-d", entry["recovery_ref"], check=False)
            removed.append(entry["recovery_ref"])
            del repairs["repairs"][run_id]
    if removed:
        write_json(repairs_path(repo), repairs)
    return removed


def command_repair_start(args):
    repo = discover_repository()
    fingerprint_key(repo)
    record = load_run(repo, args.run)
    if record["mode"] == "readiness":
        raise PublishError("a readiness run cannot start a history repair", EXIT_REFUSED)
    status = review_status(repo, args.run)
    if not (status.deterministic or status.unit_findings):
        raise PublishError(
            "run %s has no blocking finding, so there is nothing to repair" % args.run,
            EXIT_REFUSED,
        )

    ref = recovery_ref_for(args.run)
    existing = run_git(repo.root, "rev-parse", "--verify", "--quiet", ref, check=False)
    if existing.code == 0 and existing.text.strip() != record["candidate_oid"]:
        raise PublishError(
            "recovery ref %s already protects %s; resolve that repair first"
            % (ref, existing.text.strip()[:12]),
            EXIT_REFUSED,
        )
    run_git(repo.root, "update-ref", ref, record["candidate_oid"])

    findings = load_findings(repo, args.run).get("findings", [])
    locations = [
        {
            "rule_id": finding["rule_id"],
            "path": finding["path"],
            "commit": finding["commit"],
            "line": finding["line"],
            "fingerprint": finding["fingerprint"],
        }
        for finding in findings
    ]
    repairs = load_repairs(repo)
    repairs["repairs"][args.run] = {
        "run_id": args.run,
        "recovery_ref": ref,
        "original_candidate": record["candidate_oid"],
        "original_tree": run_git(
            repo.root, "rev-parse", record["candidate_oid"] + "^{tree}"
        ).text.strip(),
        "remote_oid": record["remote_oid"],
        "remote_ref": record["remote_ref"],
        "remote_url": record["remote_url"],
        "started_at": rfc3339(now_epoch()),
        "status": "started",
        "finding_locations": locations,
    }
    write_json(repairs_path(repo), repairs)

    print("recovery-ref: %s" % ref)
    print("original-candidate: %s" % record["candidate_oid"])
    for location in locations:
        print(
            "repair-target: %s %s %s %s"
            % (
                location["rule_id"],
                location["path"] or "-",
                (location["commit"] or "-")[:12],
                location["fingerprint"],
            )
        )
    for unit_id in status.unit_findings:
        print("repair-target: review-finding - - %s" % unit_id)
    return EXIT_OK


def command_repair_verify(args):
    repo = discover_repository()
    key = fingerprint_key(repo)
    redactor = Redactor(key)
    repairs = load_repairs(repo)
    entry = repairs["repairs"].get(args.run)
    if not entry:
        raise PublishError("run %s has no repair in progress" % args.run, EXIT_REFUSED)
    if not args.allowed_path:
        raise PublishError(
            "--allowed-path is required at least once so the rewrite stays bounded",
            EXIT_REFUSED,
        )
    protected = run_git(
        repo.root, "rev-parse", "--verify", "--quiet", entry["recovery_ref"], check=False
    )
    if protected.code != 0 or protected.text.strip() != entry["original_candidate"]:
        raise PublishError(
            "the recovery ref no longer protects the original candidate",
            EXIT_REFUSED,
        )

    current = remote_tip_of(repo, entry["remote_url"], entry["remote_ref"])
    if current != entry["remote_oid"]:
        raise PublishError(
            "the remote tip advanced during repair (%s != %s); start again from a fresh scan"
            % ((current or "missing")[:12], entry["remote_oid"][:12]),
            EXIT_REFUSED,
        )

    original = entry["original_candidate"]
    new_candidate = run_git(repo.root, "rev-parse", "HEAD^{commit}").text.strip()
    if new_candidate == original:
        raise PublishError("HEAD still points at the original candidate", EXIT_REFUSED)
    ancestry = run_git(
        repo.root, "merge-base", "--is-ancestor", entry["remote_oid"], new_candidate, check=False
    )
    if ancestry.code != 0:
        raise PublishError(
            "the repaired candidate does not descend from the published remote tip", EXIT_REFUSED
        )

    changed = [
        token.decode("utf-8", "replace")
        for token in run_git(
            repo.root, "diff", "--name-only", "-z", original, new_candidate
        ).out.split(b"\x00")
        if token.strip()
    ]
    allowed = set(args.allowed_path)
    unexpected = sorted(path for path in changed if path not in allowed)
    if unexpected:
        raise PublishError(
            "the repair changed paths outside the allowlist: %s" % ", ".join(unexpected),
            EXIT_REFUSED,
        )

    comparison = run_git(
        repo.root,
        "range-diff",
        "--no-patch",
        "%s..%s" % (entry["remote_oid"], original),
        "%s..%s" % (entry["remote_oid"], new_candidate),
        check=False,
    )
    statistics = run_git(repo.root, "diff", "--stat", original, new_candidate, check=False)

    entry["status"] = "verified"
    entry["new_candidate"] = new_candidate
    entry["verified_at"] = rfc3339(now_epoch())
    entry["allowed_paths"] = sorted(allowed)
    write_json(repairs_path(repo), repairs)

    print("original-candidate: %s" % original)
    print("new-candidate: %s" % new_candidate)
    for path in sorted(changed):
        print("changed-path: %s" % path)
    for line in redactor.scrub(comparison.text).splitlines():
        print("range-diff: %s" % line)
    for line in redactor.scrub(statistics.text).splitlines():
        print("diff-stat: %s" % line)
    print("recovery-ref: %s" % entry["recovery_ref"])
    print("review-invalidated: true")
    print("next: scan")
    return EXIT_OK


