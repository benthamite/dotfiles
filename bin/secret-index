#!/usr/bin/env python3
"""Build and query the keyed-fingerprint index of this machine's secrets.

    secret-index refresh [--account A ...] [--skip-1password]
        Rebuild the index from 1Password (concealed fields of every item in
        every vault of each account; one Touch ID through op-desktop), from
        .zshenv-secrets, and from known credential files. Prints counts only.
    secret-index add --label LABEL     Add one value read from stdin.
    secret-index status                Index size, age and sources.
    secret-index prune                 Drop fingerprints of public identifiers (username, paths...).
    secret-index audit                 Report matches in ordinary text (false positives), by label.
    secret-index check                 Count known secrets in stdin.
    secret-index mask                  Copy stdin to stdout with known secrets masked.
    secret-index contains              Guard helper: exit 0 (labels) / 1 (none) / 2 (error).

Run `refresh` yourself (it needs Touch ID); agents use `status`, `check` and
`mask`. No subcommand ever prints a secret value. See lib/python/secret_index.py
and docs/secret-guard.md.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib/python"))
import secret_index as si  # noqa: E402

HOME = Path.home()
DOTFILES = Path(__file__).resolve().parents[1]
ACCOUNTS = ("my.1password.com", "tln-team.1password.com", "epoch-team.1password.com")
SECRET_KEY = re.compile(r"(token|secret|passw|passwd|pwd|api[_-]?key|apikey|credential|auth|cookie|session|private[_-]?key)", re.I)
NOT_SECRET_KEY = re.compile(r"(_uri|_url|url|_path|path|_file|file|_type|type|expir|_at|scope|_id$|^id$|username|user$|email|name$"
                            r"|prompt|date|time|count|first|last)", re.I)
# Identifier-shaped keys such as lastSessionId (case-sensitive: `Id`, `ID`).
NOT_SECRET_KEY_CASED = re.compile(r"(Id|ID|Ids|IDs)$")
CREDENTIAL_FILES = [
    "~/.config/gh/hosts.yml", "~/.config/exercism/user.json", "~/.config/Jackett/ServerConfig.json",
    "~/.config/qBittorrent/qBittorrent.ini", "~/.config/internetarchive/ia.ini", "~/.config/cookies.txt",
    "~/.netrc", "~/.npmrc", "~/.pypirc", "~/.aws/credentials", "~/.docker/config.json",
    "~/.codex/config.toml", "~/.claude.json",
]
CREDENTIAL_GLOBS = [
    ("~/.config/gcloud", "**/*.json"), ("~/.config/gdoc", "**/*.json"), ("~/.gmail-mcp-epoch", "**/*.json"),
    ("~/.config/taiga", "**/*"), ("~/.config", "*-mcp/**/*.json"), ("~/.config/op", "**/*.json"),
    ("~/.config/emacs-profiles", "*/gdocs/tokens/*.json"),
]


def _secret_key(key: str) -> bool:
    return bool(SECRET_KEY.search(key)) and not NOT_SECRET_KEY.search(key) and not NOT_SECRET_KEY_CASED.search(key)


def _plausible(value: object) -> bool:
    if not isinstance(value, str):
        return False
    v = value.strip()
    if not si.MIN_LEN <= len(v) <= si.MAX_LEN or " " in v.strip() and len(v.split()) > 6:
        return False
    if re.match(r"^(https?://|/|~|\$)", v) and "@" not in v:
        return False
    return True


def _walk_json(data: object, label: str, out: list, key: str = "") -> None:
    if isinstance(data, dict):
        for k, v in data.items():
            _walk_json(v, label, out, str(k))
    elif isinstance(data, list):
        for v in data:
            _walk_json(v, label, out, key)
    elif _secret_key(key) and _plausible(data):
        out.append((data.strip(), label))


def _key_values(text: str, label: str, out: list) -> None:
    """key = value / key: value / netrc `password X` lines."""
    for line in text.splitlines():
        m = re.match(r"\s*(?:export\s+)?([A-Za-z0-9_.\-]+)\s*[:=]\s*(.+?)\s*$", line)
        if m and _secret_key(m.group(1)):
            value = m.group(2).strip().strip("'\"")
            if _plausible(value):
                out.append((value, label))
        for m in re.finditer(r"\b(?:password|passwd|token)\s+(\S+)", line):
            if _plausible(m.group(1)):
                out.append((m.group(1), label))


def collect_file(path: Path, out: list) -> int:
    before = len(out)
    try:
        text = path.read_text(errors="replace")
    except (OSError, UnicodeError):
        return 0
    label = f"file:{path.name}"
    try:
        _walk_json(json.loads(text), label, out)
    except ValueError:
        _key_values(text, label, out)
    return len(out) - before


def collect_files(out: list) -> int:
    count = 0
    for name in CREDENTIAL_FILES:
        p = Path(os.path.expanduser(name))
        if p.is_file():
            count += collect_file(p, out)
    for base, pattern in CREDENTIAL_GLOBS:
        b = Path(os.path.expanduser(base))
        if b.is_dir():
            for p in b.glob(pattern):
                if p.is_file() and p.stat().st_size < 2_000_000:
                    count += collect_file(p, out)
    return count


def collect_zshenv(out: list) -> int:
    before = len(out)
    path = DOTFILES / "shell/.zshenv-secrets"
    try:
        text = path.read_text()
    except OSError:
        return 0
    for line in text.splitlines():
        m = re.match(r"\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$", line)
        if m:
            value = m.group(2).strip().strip("'\"")
            if _plausible(value):
                out.append((value, "zshenv"))
    return len(out) - before


def _op(args: list[str], stdin: str | None = None) -> str:
    result = subprocess.run(["op-desktop", *args], input=stdin, capture_output=True, text=True, timeout=1800)
    if result.returncode != 0:
        # stderr from op names items and errors, never values; keep only its first line.
        raise RuntimeError((result.stderr.strip().splitlines() or ["op-desktop failed"])[0][:200])
    return result.stdout


def _json_stream(text: str):
    decoder, i = json.JSONDecoder(), 0
    while True:
        while i < len(text) and text[i].isspace():
            i += 1
        if i >= len(text):
            return
        obj, i = decoder.raw_decode(text, i)
        yield obj


def collect_1password(account: str, out: list) -> int:
    before = len(out)
    listing = _op(["item", "list", "--account", account, "--format", "json"])
    items = json.loads(listing or "[]")
    if not items:
        return 0
    detail = _op(["item", "get", "-", "--account", account, "--format", "json"], stdin=listing)
    short = account.split(".")[0]
    for item in _json_stream(detail):
        for obj in item if isinstance(item, list) else [item]:
            for field in obj.get("fields", []):
                if field.get("type") in ("CONCEALED", "OTP", "SSHKEY") and _plausible(field.get("value")):
                    out.append((field["value"].strip(), f"1password:{short}:{obj.get('id', '?')}"))
    return len(out) - before


def ordinary_text_hits(index) -> dict[str, int]:
    """Matches in text that holds no secrets by construction: dotfiles READMEs
    and docs, recent commit messages, home-directory file names and repository names. Any hit
    is a false positive that would mask that text and deny commands naming it."""
    corpus = []
    for p in list(DOTFILES.glob("**/README.org")) + list((DOTFILES / "docs").glob("**/*.md")):
        if ".git" not in p.parts:
            corpus.append(p.read_text(errors="replace"))
    for repo in (DOTFILES, HOME / "repos/stafforini.com"):
        corpus.append(subprocess.run(["git", "-C", str(repo), "log", "-1500", "--format=%an %ae %s%n%b"],
                                     capture_output=True, text=True).stdout)
    corpus.append(subprocess.run(["find", str(HOME), "-maxdepth", "3", "-not", "-path", "*/Library/*"],
                                 capture_output=True, text=True).stdout)
    corpus.append("\n".join(sorted(si.repository_names())))
    hits: dict[str, int] = {}
    for text in corpus:
        for _, _, label in index.find(text):
            hits[label] = hits.get(label, 0) + 1
    return hits


def cmd_audit(args) -> int:
    index = si.Index.load()
    if index is None:
        print("no index")
        return 1
    hits = ordinary_text_hits(index)
    if not hits:
        print("ordinary text: no matches")
        return 0
    for label, n in sorted(hits.items(), key=lambda x: -x[1]):
        print(f"ordinary text: {n} matches for {label}")
    print("these are false positives; report them so the exclusion rules can be fixed", file=sys.stderr)
    return 1


def cmd_refresh(args) -> int:
    values: list[tuple[str, str]] = []
    sources: dict[str, int] = {}
    if not args.skip_1password:
        for account in args.account or ACCOUNTS:
            try:
                sources[account] = collect_1password(account, values)
            except Exception as error:  # noqa: BLE001 - report, keep other sources
                print(f"{account}: FAILED ({error})", file=sys.stderr)
                sources[account] = -1
            print(f"{account}: {sources[account]} concealed values")
    sources["zshenv"] = collect_zshenv(values)
    sources["files"] = collect_files(values)
    print(f"zshenv: {sources['zshenv']}  credential files: {sources['files']}")
    key = si.read_key(create=True)
    entries = si.build_entries(key, values)
    # Gate: a new index goes live only if it matches nothing in text that holds
    # no secrets. On 2026-10-01 an ungated refresh indexed the username and
    # every agent session was denied commands naming a home path.
    hits = ordinary_text_hits(si.Index(key, entries))
    if hits:
        for label, n in sorted(hits.items(), key=lambda x: -x[1]):
            print(f"REFUSED: {n} matches in ordinary text for {label} (false positive)", file=sys.stderr)
        print("new index NOT installed; the previous index (if any) stays in use", file=sys.stderr)
        return 1
    path = si.write(entries, sources)
    subprocess.run(["tmutil", "addexclusion", str(path.parent)], capture_output=True)
    print(f"index: {sum(len(v) for v in entries.values())} fingerprints from {len(values)} values -> {path}")
    print("ordinary-text check: clean")
    if any(v == -1 for v in sources.values()):
        print("some 1Password accounts failed; their secrets are NOT indexed", file=sys.stderr)
        return 1
    return 0


def cmd_add(args) -> int:
    value = sys.stdin.read().strip()
    if len(value) < si.MIN_LEN:
        print(f"refused: values shorter than {si.MIN_LEN} characters are not indexed", file=sys.stderr)
        return 1
    added = si.add(value, args.label)
    print(f"added {added} fingerprints")
    return 0


def cmd_prune(args) -> int:
    print(f"removed {si.prune()} fingerprints of public identifiers")
    return 0


def cmd_status(args) -> int:
    path = si.index_path()
    try:
        data = json.loads(path.read_text())
    except FileNotFoundError:
        print(f"no index at {path}; run `secret-index refresh`")
        return 1
    count = sum(len(v) for v in data["entries"].values())
    print(f"{count} fingerprints, refreshed {data.get('refreshed')}, sources {json.dumps(data.get('sources'))}")
    try:
        si.read_key()
        print("key: present in Keychain")
    except si.IndexError_ as error:
        print(f"key: {error}")
        return 1
    return 0


def cmd_check(args) -> int:
    index = si.Index.load()
    if index is None:
        print("no index")
        return 1
    print(len(index.find(sys.stdin.read())))
    return 0


def cmd_contains(args) -> int:
    """Guard helper: 0 and the labels if stdin holds a known secret, 1 if not, 2 on error."""
    try:
        index = si.Index.load()
        if index is None:
            return 1
        spans = index.find(sys.stdin.read())
    except Exception:  # noqa: BLE001 - the guard denies on 2
        return 2
    if not spans:
        return 1
    print(", ".join(sorted({label for _, _, label in spans})))
    return 0


def cmd_mask(args) -> int:
    if not args.stream:
        masked, _ = si.mask_text(sys.stdin.read())
        sys.stdout.write(masked)
        return 0
    # Line by line, flushing, so wrapped long-running commands still stream.
    # On any failure stop copying (fail closed) and say so on stderr.
    try:
        index = si.Index.load()
        for line in sys.stdin:
            sys.stdout.write(index.mask(line)[0] if index is not None else line)
            sys.stdout.flush()
    except si.IndexError_ as error:
        print(f"[output withheld: known-secret masking failed: {error}]", file=sys.stderr)
        return 2
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    refresh = sub.add_parser("refresh")
    refresh.add_argument("--account", action="append")
    refresh.add_argument("--skip-1password", action="store_true")
    add = sub.add_parser("add")
    add.add_argument("--label", required=True)
    sub.add_parser("status")
    sub.add_parser("prune")
    sub.add_parser("audit")
    sub.add_parser("check")
    mask = sub.add_parser("mask")
    mask.add_argument("--stream", action="store_true")
    sub.add_parser("contains")
    args = parser.parse_args()
    return {"refresh": cmd_refresh, "add": cmd_add, "status": cmd_status,
            "check": cmd_check, "mask": cmd_mask, "contains": cmd_contains, "prune": cmd_prune, "audit": cmd_audit}[args.command](args)


if __name__ == "__main__":
    sys.exit(main())
