;;; dump-bbdb.el --- Strict read-only BBDB format-9 projection -*- lexical-binding: t -*-

(require 'cl-lib)
(require 'json)
(require 'lisp-mode)
(require 'subr-x)

(defconst bbdb-dump-max-bytes (* 16 1024 1024)
  "Maximum supported BBDB input size in bytes.")

(defconst bbdb-dump-max-records 50000
  "Maximum supported number of BBDB records.")

(defun bbdb-dump-read (file)
  "Return the complete supported format-9 projection from FILE.
Never load BBDB, evaluate forms, repair input, or return a partial prefix."
  (unless (and (stringp file) (file-regular-p file)
               (<= (file-attribute-size (file-attributes file))
                   bbdb-dump-max-bytes))
    (error "Unsupported BBDB input file"))
  (with-temp-buffer
    (let ((coding-system-for-read 'utf-8-unix)
          (read-symbol-shorthands nil)
          (count 0)
          (format-count 0)
          (identifiers (make-hash-table :test #'equal))
          records)
      (set-syntax-table emacs-lisp-mode-syntax-table)
      (insert-file-contents file)
      (when (> (1- (position-bytes (point-max))) bbdb-dump-max-bytes)
        (error "BBDB input grew beyond the supported limit"))
      (goto-char (point-min))
      (while (looking-at "[ \t]*\\(?:;.*\\)?$")
        (when (looking-at ";+[ \t]*file-format:[ \t]*\\([0-9]+\\)[ \t]*$")
          (unless (equal (match-string 1) "9")
            (error "Only BBDB file format 9 is supported"))
          (setq format-count (1+ format-count)))
        (if (eobp) (error "No BBDB records") (forward-line 1)))
      (unless (= format-count 1)
        (error "Exactly one BBDB format-9 header is required"))
      (while (not (eobp))
        (if (looking-at "[ \t]*\\(?:;.*\\)?$")
            (progn
              (while (and (not (eobp)) (looking-at "[ \t]*\\(?:;.*\\)?$"))
                (forward-line 1))
              (unless (eobp)
                (error "Blank or comment lines between records are unsupported")))
          (unless (looking-at "\\[")
            (error "BBDB records must start with a column-zero bracket"))
          (let* ((line (line-number-at-pos))
                 (record (let ((read-circle nil)) (read (current-buffer)))))
            (unless (and (= line (line-number-at-pos))
                         (looking-at "[ \t]*\\(?:;.*\\)?$"))
              (error "Unsupported multiline record or trailing data"))
            (setq count (1+ count))
            (when (> count bbdb-dump-max-records)
              (error "BBDB record limit exceeded"))
            (push (bbdb-dump--record record identifiers) records)
            (forward-line 1))))
      (vconcat (nreverse records)))))

(defun bbdb-dump--record (record identifiers)
  "Project supported fields from format-9 RECORD using IDENTIFIERS.
Reject malformed fields and duplicate UUIDs in IDENTIFIERS."
  (unless (and (vectorp record) (= (length record) 13) (null (aref record 12))
               (cl-every (lambda (index)
                           (or (null (aref record index))
                               (stringp (aref record index))))
                         '(0 1 10 11))
               (stringp (aref record 9))
               (not (string-empty-p (string-trim (aref record 9)))))
    (error "Unsupported format-9 record structure or UUID"))
  (when (gethash (aref record 9) identifiers)
    (error "Duplicate BBDB UUID"))
  (puthash (aref record 9) t identifiers)
  (dolist (index '(2 3 4 7))
    (unless (and (proper-list-p (aref record index))
                 (cl-every #'stringp (aref record index)))
      (error "Unsupported BBDB string-list field")))
  (unless (and (proper-list-p (aref record 6))
               (cl-every (lambda (address)
                           (and (vectorp address) (= (length address) 6)))
                         (aref record 6)))
    (error "Unsupported BBDB address structure"))
  (let ((xfields (aref record 8)))
    (unless (and (proper-list-p xfields)
                 (cl-every (lambda (field)
                             (and (consp field) (symbolp (car field))))
                           xfields))
      (error "Unsupported BBDB xfield structure"))
    (dolist (label '(url birthday))
      (when (> (cl-count label xfields :key #'car) 1)
        (error "Duplicate projected BBDB xfield")))
    (let ((url (cdr (assq 'url xfields)))
          (birthday (cdr (assq 'birthday xfields))))
      (unless (or (null url) (stringp url))
        (error "Unsupported BBDB URL field"))
      (list (cons 'first (or (aref record 0) ""))
            (cons 'last (or (aref record 1) ""))
            (cons 'affix (vconcat (aref record 2)))
            (cons 'aka (vconcat (aref record 3)))
            (cons 'org (vconcat (aref record 4)))
            (cons 'phones (bbdb-dump--phones (aref record 5)))
            (cons 'mail (vconcat (aref record 7)))
            (cons 'url (or url ""))
            (cons 'birthday (if (or (null birthday) (stringp birthday))
                                (or birthday "")
                              (prin1-to-string birthday)))
            (cons 'birthday_type (cond ((null birthday) "absent")
                                       ((stringp birthday) "string")
                                       (t "unsupported")))
            (cons 'uuid (aref record 9))))))

(defun bbdb-dump--phones (phones)
  "Return supported PHONES as label, number and original-component alists."
  (unless (proper-list-p phones)
    (error "Unsupported BBDB phone list"))
  (vconcat
   (mapcar
    (lambda (phone)
      (unless (and (vectorp phone) (memq (length phone) '(2 5))
                   (stringp (aref phone 0))
                   (if (= (length phone) 2)
                       (stringp (aref phone 1))
                     (cl-every (lambda (value)
                                 (and (integerp value) (>= value 0)))
                               (cdr (append phone nil)))))
        (error "Unsupported BBDB phone structure"))
      (list (cons 'label (aref phone 0))
            (cons 'number
                  (if (= (length phone) 2) (aref phone 1)
                    (format "%03d-%03d-%04d%s"
                            (aref phone 1) (aref phone 2) (aref phone 3)
                            (if (= (aref phone 4) 0) ""
                              (format " x%d" (aref phone 4))))))
            (cons 'raw_components phone)))
    phones)))

(condition-case nil
    (princ (json-encode (bbdb-dump-read (getenv "BBDB_FILE"))))
  (error
   (message "BBDB dump failed: unsupported or corrupt input; no partial output")
   (kill-emacs 2)))

;;; dump-bbdb.el ends here
