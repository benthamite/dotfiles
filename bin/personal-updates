#!/usr/bin/env python3

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timedelta, timezone
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[1]
DEFAULT_POLICY_DIR = REPO_ROOT / "macos/personal-updates"
DEFAULT_STATE_FILE = Path.home() / ".local/state/personal-updates/state.json"
DEFAULT_LOG_DIR = Path.home() / ".local/state/personal-updates/logs"
DEFAULT_HOLD_FILE = DEFAULT_POLICY_DIR / "hold.txt"
DEFAULT_EXCLUDED_CASKS_FILE = DEFAULT_POLICY_DIR / "excluded-casks.txt"
DEFAULT_FAST_BREW_FILE = DEFAULT_POLICY_DIR / "fast-brew.txt"
DEFAULT_FAST_BREW_PACKAGES = ("claude-code@latest", "codex")
DEFAULT_MIN_AGE_DAYS = 7
KINDS = ("brew_formula", "brew_cask")
BREW_HELPER = Path(__file__).with_name("personal-updates-brew.rb")


def now_utc():
    return datetime.now(timezone.utc)


def merge_scan(state, updates, now):
    merged = {}
    timestamp = now.isoformat()
    for kind in KINDS:
        previous = state.get(kind, {})
        current = {}
        for update in updates.get(kind, []):
            name = update["name"]
            old_entry = previous.get(name)
            if old_entry and old_entry.get("available") == update["available"]:
                first_seen = old_entry["first_seen"]
            else:
                first_seen = timestamp
            current[name] = {
                "installed": update.get("installed", ""),
                "available": update["available"],
                "first_seen": first_seen,
                **{key: update[key] for key in ("installed_receipt", "version_check_error") if key in update},
            }
        if current or kind in state:
            merged[kind] = current
    return merged


def parse_holds(text):
    holds = set()
    for line in text.splitlines():
        stripped = line.strip()
        if stripped and not stripped.startswith("#"):
            holds.add(stripped)
    return holds


def load_holds(path):
    if not path.exists():
        return set()
    return parse_holds(path.read_text())


def load_excluded_casks(path):
    if not path.exists():
        return set()
    return parse_holds(path.read_text())


def load_fast_brew_packages(path):
    packages = list(DEFAULT_FAST_BREW_PACKAGES)
    if path.exists():
        packages.extend(sorted(parse_holds(path.read_text())))
    return sorted(dict.fromkeys(packages))


def is_held(kind, name, holds):
    return name in holds or f"{kind}/{name}" in holds


def eligible_updates(state, min_age_days, now, holds=None, excluded_casks=None):
    holds = holds or set()
    excluded_casks = excluded_casks or set()
    cutoff = now - timedelta(days=min_age_days)
    eligible = {}
    for kind in KINDS:
        names = []
        for name, entry in state.get(kind, {}).items():
            if is_held(kind, name, holds):
                continue
            if kind == "brew_cask" and name in excluded_casks:
                continue
            first_seen = datetime.fromisoformat(entry["first_seen"])
            if first_seen <= cutoff:
                names.append(name)
        if names:
            eligible[kind] = sorted(names)
    return eligible


def load_json(path, default):
    if not path.exists():
        return default
    with path.open() as handle:
        return json.load(handle)


def save_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = path.with_suffix(path.suffix + ".tmp")
    with tmp_path.open("w") as handle:
        json.dump(data, handle, indent=2, sort_keys=True)
        handle.write("\n")
    tmp_path.replace(path)


def run(command, *, check=True, env_overrides=None):
    env = os.environ.copy()
    env["HOMEBREW_NO_INSTALL_CLEANUP"] = "1"
    env.update(env_overrides or {})
    return subprocess.run(command, check=check, text=True, capture_output=True, env=env)


def brew_update(run_command=run):
    run_command(["brew", "update-reset", "-q"], check=False)
    run_command(["brew", "update"])


def brew_outdated(*, refresh=True):
    if refresh:
        brew_update()
    result = run(["brew", "outdated", "--json=v2", "--greedy-auto-updates"], check=False,
                 env_overrides={"HOMEBREW_NO_AUTO_UPDATE": "1"})
    if result.returncode not in (0, 1):
        raise RuntimeError(result.stderr.strip() or result.stdout.strip())
    data = json.loads(result.stdout or "{}")
    # Read installed bundles independently of receipts: an application can
    # update itself, and even a current receipt can describe an older bundle.
    info = run(["brew", "info", "--json=v2", "--cask", "--installed"],
               env_overrides={"HOMEBREW_NO_AUTO_UPDATE": "1"})
    casks = cask_updates(data.get("casks", []), json.loads(info.stdout)["casks"])
    return {
        "brew_formula": [
            {
                "name": item["name"],
                "installed": ", ".join(item.get("installed_versions", [])),
                "available": item["current_version"],
            }
            for item in data.get("formulae", [])
        ],
        "brew_cask": casks,
    }


def numeric_version(value):
    """Comparable numeric release components, ignoring trailing zeroes."""
    if not value or not re.fullmatch(r"\d+(?:[.-]\d+)*", value):
        return None
    parts = tuple(int(part) for part in re.split(r"[.-]", value))
    while len(parts) > 1 and parts[-1] == 0:
        parts = parts[:-1]
    return parts


def cask_bundle_comparison(item):
    """Return installed-versus-available ordering or an explicit check error."""
    available, *builds = item["version"].split(",")
    short, build = item.get("bundle_short_version"), item.get("bundle_version")
    if not short:
        return None, "installed application bundle version is unavailable"
    installed = short
    # Brave's macOS legacy bundle prefixes its release with Chromium's major
    # version (147.1.89.132); the cask release is 1.89.132 or 1.89.132.0.
    if item["token"] in ("brave-browser", "brave-browser@beta", "brave-browser@nightly"):
        parts = short.split(".")
        release = available.split(".")
        if len(parts) == 4 and parts[0].isdigit() and int(parts[0]) >= 100 and parts[1] == release[0]:
            installed = ".".join(parts[1:])
    if "-" in available and numeric_version(available) is not None and build:
        installed = f"{installed}-{build}"
    # A full release can live in CFBundleVersion while the short field is
    # abbreviated (Plex), and equal opaque versions need no ordering rule.
    if installed == available or build == available:
        comparison = 0
    else:
        actual, target = numeric_version(installed), numeric_version(available)
        if actual is None or target is None:
            return None, "installed and available version formats cannot be compared"
        full_build = numeric_version(build)
        if len(actual) < len(target) and full_build is not None and len(full_build) == len(target):
            actual = full_build
        comparison = (actual > target) - (actual < target)
    if comparison == 0 and builds and numeric_version(builds[0]) is not None:
        actual_build = numeric_version(build)
        if actual_build is None:
            return None, "installed application build version is unavailable or incomparable"
        target_build = numeric_version(builds[0])
        # A numeric CSV suffix is not necessarily CFBundleVersion (Keyboard
        # Maestro uses 1111 for release 11.1.1). Compare only matching shapes.
        if len(actual_build) == len(target_build):
            comparison = (actual_build > target_build) - (actual_build < target_build)
    return comparison, None


def cask_updates(outdated, installed):
    """Keep actual stale bundles; explicitly defer unverifiable self-updaters."""
    candidates = {item["name"]: item for item in outdated}
    updates = []
    for item in installed:
        name = item["token"]
        if not item.get("installed") or (not item.get("auto_updates") and name not in candidates):
            continue
        entry = {"name": name, "installed": item["installed"], "available": item["version"]}
        if item.get("auto_updates"):
            comparison, error = cask_bundle_comparison(item)
            if error:
                entry["version_check_error"] = error
            elif comparison >= 0:
                continue
            elif item["installed"] == item["version"]:
                entry["version_check_error"] = (
                    "installed bundle is older than its current Homebrew receipt; a verified reinstall is required")
            entry["installed_receipt"] = item["installed"]
            entry["installed"] = item.get("bundle_short_version") or "unknown"
        updates.append(entry)
    return updates


def brew_helper(mode, request, upgrade_args=()):
    # Never put generated request files under the Drive-backed repository.
    with tempfile.TemporaryDirectory(prefix="personal-updates-", dir="/private/tmp") as directory:
        request_path = Path(directory) / "request.json"
        with open(request_path, "x", opener=lambda path, flags: os.open(path, flags, 0o600)) as handle:
            json.dump(request, handle)
        result = run(["brew", "ruby", "--", str(BREW_HELPER), mode, str(request_path), *upgrade_args], check=False,
                   env_overrides={"HOMEBREW_NO_AUTO_UPDATE": "1", "HOMEBREW_NO_ASK": "1",
                                  "HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK": "1",
                                  "HOMEBREW_NO_ANALYTICS": "1", "HOMEBREW_DEV_CMD_RUN": "1"})
        if result.returncode:
            reasons = [line for line in result.stderr.splitlines() if "Delayed update refused:" in line]
            raise RuntimeError("; ".join(reasons) or f"Homebrew {mode} failed (exit {result.returncode}); no unguarded retry was attempted")
        return result


def observe_artifacts(updates):
    return json.loads(brew_helper("observe", updates).stdout)


def merge_observations(previous, observed, now):
    result = {}
    for kind in KINDS:
        result[kind] = {}
        for name, entry in observed.get(kind, {}).items():
            old = previous.get(kind, {}).get(name, {})
            unchanged = old.get("artifact") and old.get("artifact") == entry.get("artifact")
            result[kind][name] = {**entry, "first_seen": old["first_seen"] if unchanged else now.isoformat()}
    return result


def age_qualified_artifacts(observations, min_age_days, now, holds, excluded_casks):
    cutoff = now - timedelta(days=min_age_days)
    allowed = {kind: {} for kind in KINDS}
    for kind in KINDS:
        for alias, entry in observations.get(kind, {}).items():
            name = entry["name"]
            short_name = name.rsplit("/", 1)[-1]
            if any(is_held(kind, n, holds) for n in (alias, name, short_name)):
                continue
            if kind == "brew_cask" and {alias, name, short_name} & excluded_casks:
                continue
            if entry.get("artifact") and datetime.fromisoformat(entry["first_seen"]) <= cutoff:
                allowed[kind][name] = entry
    return allowed


def dependency_blockers(kind, name, observations, allowed):
    """Transitive dependencies Homebrew would install with the item that are not age-qualified.

    Observations record, per item, the dependencies that would be installed or
    upgraded alongside it. A dependency without an observation counts as
    unchecked. The in-Homebrew guard still verifies the actual installer objects.
    """
    blockers = []
    seen = set()
    stack = [(kind, name)]
    while stack:
        current_kind, current_name = stack.pop()
        for reference in observations.get(current_kind, {}).get(current_name, {}).get("pending_deps", []):
            dep_kind, dep_name = reference.split("/", 1)
            if (dep_kind, dep_name) in seen:
                continue
            seen.add((dep_kind, dep_name))
            if dep_name not in allowed.get(dep_kind, {}):
                blockers.append(reference)
            stack.append((dep_kind, dep_name))
    return sorted(blockers)


def upgrade_brew(eligible, allowed):
    for command in brew_upgrade_commands_for_eligible(eligible):
        brew_helper("upgrade", allowed, command[2:])
    run(["brew", "doctor"], check=False)


def brew_upgrade_commands_for_eligible(eligible):
    commands = []
    for name in eligible.get("brew_formula", []):
        commands.append(["brew", "upgrade", "--formula", name])
    for name in eligible.get("brew_cask", []):
        commands.append(["brew", "upgrade", "--cask", "--greedy", "--require-sha", name])
    return commands


def brew_upgrade_commands(packages):
    return [["brew", "upgrade", package] for package in packages]


def upgrade_fast_brew(packages):
    for command in brew_upgrade_commands(packages):
        run(command)


def append_log(log_dir, message):
    log_dir.mkdir(parents=True, exist_ok=True)
    log_path = log_dir / f"{now_utc().date().isoformat()}.log"
    with log_path.open("a") as handle:
        handle.write(message.rstrip() + "\n")


def command_scan(args):
    state = load_json(args.state_file, {})
    updates = brew_outdated()
    new_state = merge_scan(state, updates, now_utc())
    new_state["observations"] = merge_observations(
        state.get("observations", {}), observe_artifacts(updates), now_utc())
    save_json(args.state_file, new_state)
    append_log(args.log_dir, f"scan recorded {sum(len(new_state.get(k, {})) for k in KINDS)} pending updates")
    print(json.dumps(new_state, indent=2, sort_keys=True))


def command_delayed(args, now=None):
    state = load_json(args.state_file, {})
    now = now or now_utc()
    # Reconcile saved eligibility with today's candidates. The in-process Ruby
    # guard below also covers changes after this check and implicit dependencies.
    updates = brew_outdated(refresh=False)
    current = merge_scan(state, updates, now)
    observations = merge_observations(state.get("observations", {}), observe_artifacts(updates), now)
    current["observations"] = observations
    holds = load_holds(args.hold_file)
    excluded_casks = load_excluded_casks(args.excluded_casks_file)
    allowed = age_qualified_artifacts(observations, args.min_age_days, now, holds, excluded_casks)
    eligible = eligible_updates(
        current,
        args.min_age_days,
        now,
        holds,
        excluded_casks,
    )
    deferred = [f"{kind}/{name}: {entry['version_check_error']}"
                for kind in KINDS for name, entry in current.get(kind, {}).items()
                if entry.get("version_check_error")]
    for kind, names in eligible.items():
        accepted = []
        for name in names:
            version_error = current.get(kind, {}).get(name, {}).get("version_check_error")
            if version_error:
                continue
            observed = observations.get(kind, {}).get(name, {})
            if observed.get("name") not in allowed[kind]:
                deferred.append(f"{kind}/{name}: artifact is unchecked or has not completed the waiting period")
                continue
            blockers = dependency_blockers(kind, name, observations, allowed)
            if blockers:
                deferred.append(f"{kind}/{name}: dependencies {', '.join(blockers)} are unchecked "
                                "or have not completed the waiting period")
                continue
            accepted.append(name)
        eligible[kind] = accepted
    eligible = {kind: names for kind, names in eligible.items() if names}
    if args.dry_run:
        print(json.dumps({"eligible": eligible, "deferred": deferred}, indent=2, sort_keys=True))
        return
    save_json(args.state_file, current)
    for reason in deferred:
        append_log(args.log_dir, f"delayed deferred {reason}")
        print(f"Delayed update deferred: {reason}", file=sys.stderr)
    if not eligible:
        append_log(args.log_dir, "delayed found 0 eligible updates")
        return
    upgrade_brew(eligible, allowed)
    append_log(args.log_dir, f"delayed upgraded {sum(len(v) for v in eligible.values())} updates")
    command_scan(args)


def command_fast(args):
    run(["softwareupdate", "--install", "--recommended"])
    append_log(args.log_dir, "fast lane installed recommended macOS updates")


def command_fast_brew(args):
    packages = load_fast_brew_packages(args.fast_brew_file)
    if args.dry_run:
        print(json.dumps(packages, indent=2, sort_keys=True))
        return
    upgrade_fast_brew(packages)
    append_log(args.log_dir, f"fast brew upgraded {', '.join(packages)}")


def build_parser():
    parser = argparse.ArgumentParser(description="Apply a delayed personal update policy.")
    parser.add_argument("--state-file", type=Path, default=DEFAULT_STATE_FILE)
    parser.add_argument("--log-dir", type=Path, default=DEFAULT_LOG_DIR)
    parser.add_argument("--hold-file", type=Path, default=DEFAULT_HOLD_FILE)
    parser.add_argument("--excluded-casks-file", type=Path, default=DEFAULT_EXCLUDED_CASKS_FILE)
    parser.add_argument("--fast-brew-file", type=Path, default=DEFAULT_FAST_BREW_FILE)
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("scan")

    delayed = subparsers.add_parser("delayed")
    delayed.add_argument("--min-age-days", type=int, default=DEFAULT_MIN_AGE_DAYS)
    delayed.add_argument("--dry-run", action="store_true")

    subparsers.add_parser("fast")

    fast_brew = subparsers.add_parser("fast-brew")
    fast_brew.add_argument("--dry-run", action="store_true")
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        if args.command == "scan":
            command_scan(args)
        elif args.command == "delayed":
            command_delayed(args)
        elif args.command == "fast":
            command_fast(args)
        elif args.command == "fast-brew":
            command_fast_brew(args)
    except Exception as error:
        append_log(args.log_dir, f"error: {error}")
        print(error, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
