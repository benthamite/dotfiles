#!/bin/bash
# Validate emacs/config.org: every tangled Elisp block must read as
# balanced Lisp, every :hook in a use-package, use-feature or
# use-personal-package form must name a hook variable, and the
# profile-aware tangle must succeed in the active Emacs session.  Used
# as the evidence check for config.org commits (see
# claude/bin/elisp-check-evidence).
# Pass --snapshot when that runner uses --staged: inputs then come from
# its indexed checkout and generated files stay outside the active profile.
# Pass --static FILE to run only the block checks, on FILE, without
# tangling: a way to test the checks against a copy.

set -euo pipefail

root=$(cd -- "$(dirname -- "$0")/.." && pwd)
config="$root/emacs/config.org"
snapshot=false
static=false
case "${1:-}" in
  --snapshot) snapshot=true; shift ;;
  --static)
    if [ "$#" -ge 2 ] && [ -f "$2" ]; then
      static=true
      config=$2
      shift 2
    fi
    ;;
esac
if [ "$#" -ne 0 ]; then
  echo "Usage: check-config-org [--snapshot | --static FILE]" >&2
  exit 2
fi
config_lisp=$(python3 -c 'import json, sys; print(json.dumps(sys.argv[1]))' "$config")

# config.org sets `use-package-hook-name-suffix' to nil, so use-package
# adds a :hook function to the symbol exactly as written.  A name without
# its -hook suffix is a variable nothing runs, and the function never
# fires.  The names are read with use-package's own :hook normalizer, so
# every spec shape it accepts is covered.  The read is not a command
# substitution because macOS's bash 3.2 misparses quotes in a heredoc
# inside one.
IFS= read -r -d '' block_checks <<'EOF' || true
(progn
  (require 'org)
  (require 'use-package)
  (defun check-config-org-hook-problems (form file line)
    "Return a message for each bad :hook in use-package-style FORM.
FORM is read from the block at LINE of FILE.  A :hook name is bad
when it lacks a hook variable's suffix or use-package rejects it."
    (let (problems)
      (dolist (spec (check-config-org-use-package-forms form))
        (dolist (args (check-config-org-hook-sections spec))
          (condition-case err
              (dolist (hook (check-config-org-hook-names (cadr spec) args))
                (unless (string-match-p "-\\(?:hooks?\\|functions\\)\\'"
                                        (symbol-name hook))
                  (push (format "%s block at line %d: (%s %s ...) :hook names `%s', which is not a hook variable"
                                file line (car spec) (cadr spec) hook)
                        problems)))
            (error
             (push (format "%s block at line %d: (%s %s ...) has an invalid :hook: %s"
                           file line (car spec) (cadr spec)
                           (error-message-string err))
                   problems)))))
      (nreverse problems)))
  (defun check-config-org-use-package-forms (form)
    "Return FORM and the forms nested in it that call a use-package macro."
    (when (consp form)
      (let ((found (and (memq (car form)
                              '(use-package use-feature use-personal-package))
                        (proper-list-p form)
                        (list form))))
        (while (consp form)
          (setq found (append found (check-config-org-use-package-forms (car form))))
          (setq form (cdr form)))
        found)))
  (defun check-config-org-hook-sections (spec)
    "Return the arguments of each :hook keyword in use-package-style SPEC."
    (let (sections args in-hook)
      (dolist (element (cddr spec))
        (cond ((keywordp element)
               (when in-hook (push (nreverse args) sections))
               (setq in-hook (eq element :hook)
                     args nil))
              (in-hook (push element args))))
      (when in-hook (push (nreverse args) sections))
      (nreverse sections)))
  (defun check-config-org-hook-names (name args)
    "Return the hook symbols that :hook ARGS name in the form for NAME."
    (mapcan (lambda (pair)
              (copy-sequence
               (use-package-hook-handler-normalize-mode-symbols (car pair))))
            (use-package-normalize/:hook name :hook args)))
  (find-file check-config-org-file)
  (let ((file (file-name-nondirectory check-config-org-file))
        (count 0) line problems)
    (org-babel-map-src-blocks nil
      (when (and (string= lang "emacs-lisp")
                 (not (string-match-p ":tangle +no" (or header-args ""))))
        (setq count (1+ count))
        (setq line (line-number-at-pos beg-block))
        (let (forms)
          (with-temp-buffer
            (emacs-lisp-mode)
            (insert body)
            (goto-char (point-min))
            (condition-case err
                (while (progn (forward-comment (buffer-size)) (not (eobp)))
                  (push (read (current-buffer)) forms))
              (error (error "%s block at line %d: %s"
                            file line (error-message-string err)))))
          (dolist (form (nreverse forms))
            (setq problems (nconc problems (check-config-org-hook-problems
                                            form file line)))))))
    (when problems
      (dolist (problem problems)
        (message "%s" problem))
      (message "%s: name the full hook variable in each :hook spec above; use-package-hook-name-suffix is nil"
               file)
      (kill-emacs 1))
    (message "%s: %d Elisp blocks parsed, :hook names checked" file count)))
EOF
emacs --batch -Q --eval "(defvar check-config-org-file $config_lisp)" --eval "$block_checks"
if [ "$static" = true ]; then
  exit 0
fi

if [ "$snapshot" = true ]; then
  # The evidence runner materializes indexed bytes beside this script. Keep
  # the active builder, but give it isolated inputs and output paths.
  form=$(cat <<EOF
(let ((input $config_lisp)
      (previous-buffers (buffer-list))
      (temporary (make-temp-file "config-org-check-" t)))
  (unwind-protect
      (progn
        (when (or init-post-build-hook org-babel-post-tangle-hook)
          (user-error "Snapshot validation requires reviewed build hooks"))
        (dolist (file (list input init-user-config-file))
          (when file
            (when-let ((buffer (find-buffer-visiting file)))
              (with-current-buffer buffer
                (when (or (buffer-modified-p)
                          (not (verify-visited-file-modtime buffer)))
                  (user-error "Configuration buffer has unsaved or stale data"))))))
        (let ((paths-file-config input)
              (init-user-config-file
               (when init-user-config-file
                 (let ((copy (expand-file-name "user-config.org" temporary)))
                   (copy-file init-user-config-file copy)
                   copy)))
              (init-file-early-init init-file-early-init)
              (init-file-user-init init-file-user-init)
              (init-file-late-init init-file-late-init)
              (init-file-paths-override init-file-paths-override)
              (init-file-code-override init-file-code-override)
              (init-file-excluded-packages init-file-excluded-packages)
              (init-excluded-packages (copy-tree init-excluded-packages)))
          (save-window-excursion
            (init-build-profile temporary))
          (unless (file-exists-p (expand-file-name "init.el" temporary))
            (error "Snapshot profile build did not produce init.el"))
          (dolist (file (directory-files temporary t "\\\\.el\\\\'"))
            (with-temp-buffer
              (emacs-lisp-mode)
              (insert-file-contents file)
              (goto-char (point-min))
              (condition-case err
                  (while (progn (forward-comment (buffer-size)) (not (eobp)))
                    (read (current-buffer)))
                (error (error "Snapshot output %s: %s"
                              (file-name-nondirectory file)
                              (error-message-string err)))))))
        t)
    (dolist (buffer (buffer-list))
      (when-let ((file (buffer-file-name buffer)))
        (when (and (not (memq buffer previous-buffers))
                   (or (equal file input) (file-in-directory-p file temporary)))
          (with-current-buffer buffer (set-buffer-modified-p nil))
          (kill-buffer buffer))))
    (delete-directory temporary t)))
EOF
)
else
  form="(progn
    (unless (file-equal-p paths-file-config $config_lisp)
      (error \"Checker input is not the running profile's configuration\"))
    (init-build-profile (file-name-directory user-init-file))
    t)"
fi
if emacsclient -e "$form" >/dev/null; then
  echo "config.org: profile tangle completed (snapshot=$snapshot)"
else
  echo "config.org: profile tangle failed" >&2
  exit 1
fi
