#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: elpaca-package-path <package> [relative-path]" >&2
}

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  usage
  exit 2
fi

identifier=$1
relative=${2:-}
script_dir=$(cd -- "$(dirname -- "$0")" && pwd)
resolution=$("$script_dir/elpaca-package-resolve" "$identifier")
base=$(printf '%s' "$resolution" | jq -er '.source')

if [ -n "$relative" ]; then
  printf '%s\n' "$base/$relative"
else
  printf '%s\n' "$base"
fi
