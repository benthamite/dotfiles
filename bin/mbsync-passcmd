#!/bin/bash

# PassCmd helper for mbsync.
#
# If MBSYNC_PASSFILE is set and readable, read the password from there. This is
# how mbsync-parallel reads it once for all the channels it runs concurrently.
#
# Otherwise read it on demand from the personal 1Password Automation vault, so
# direct invocations like `mbsync gmail-inbox` still work. The read is cached
# for a day (mu4e syncs every five minutes); after changing the password, run
# `op-automations @personal cache forget` with the reference below.

set -eu

# Item "smtp.gmail.com", the Gmail app password "mac-mail" that Emacs smtpmail
# also reads.
ref=op://Automation/smtp.gmail.com/password

if [ -n "${MBSYNC_PASSFILE:-}" ] && [ -r "$MBSYNC_PASSFILE" ]; then
    cat "$MBSYNC_PASSFILE"
else
    op-automations @personal cache read "$ref"
fi
