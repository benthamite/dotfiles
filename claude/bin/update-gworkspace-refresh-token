#!/usr/bin/env python3
"""Refresh a Google Workspace OAuth token and update the matching env var.

This helper intentionally prints only status metadata, never token values.
"""

from pathlib import Path
import argparse
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request

from google_auth_oauthlib.flow import InstalledAppFlow


TOKEN_VARS = {
    "epoch": "GOOGLE_WORKSPACE_REFRESH_TOKEN",
    "personal": "GOOGLE_WORKSPACE_REFRESH_TOKEN_PERSONAL",
    "forethought": "GOOGLE_WORKSPACE_REFRESH_TOKEN_FORETHOUGHT",
    "baish": "GOOGLE_WORKSPACE_REFRESH_TOKEN_BAISH",
}

ACCOUNT_EMAILS = {
    "epoch": "pablo@epoch.ai",
    "personal": "pablo.stafforini@gmail.com",
    "forethought": "pablo@forethought.org",
    "baish": "pablostafforini@baish.com.ar",
}

TOKEN_OP_ENTRIES = {
    "epoch": {
        "account": "epoch-team.1password.com",
        "vault": "Automations",
        "item": "Google Workspace OAuth - Pablo Epoch",
        "field": "credential",
    },
    "personal": {
        "account": "my.1password.com",
        "vault": "Automation",
        "item": "google-workspace-refresh-token-personal",
        "field": "password",
    },
    # Forethought has no Automation vault; see the exception in
    # claude/context/secrets.md.
    "forethought": {
        "account": "my.1password.com",
        "vault": "Automation",
        "item": "google-workspace-refresh-token-forethought",
        "field": "password",
    },
    # BAISH has no 1Password of its own; same exception as Forethought.
    "baish": {
        "account": "my.1password.com",
        "vault": "Automation",
        "item": "google-workspace-refresh-token-baish",
        "field": "password",
    },
}

CLIENT_ID_ENV = "GOOGLE_WORKSPACE_CLIENT_ID"
CLIENT_SECRET_ENV = "GOOGLE_WORKSPACE_CLIENT_SECRET"
# Items in the personal 1Password Automation vault.
CLIENT_ID_ITEM = "google-workspace-client-id"
CLIENT_SECRET_ITEM = "google-workspace-client-secret"

SCOPES = {
    "epoch": [
        "https://mail.google.com/",
        "https://www.googleapis.com/auth/calendar",
        "https://www.googleapis.com/auth/drive",
        "https://www.googleapis.com/auth/documents",
        "https://www.googleapis.com/auth/spreadsheets",
    ],
    "personal": [
        "https://www.googleapis.com/auth/gmail.modify",
        "https://www.googleapis.com/auth/calendar.app.created",
        "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
        "https://www.googleapis.com/auth/spreadsheets",
    ],
    "forethought": [
        "https://mail.google.com/",
    ],
    "baish": [
        "https://www.googleapis.com/auth/gmail.modify",
        "https://www.googleapis.com/auth/spreadsheets",
    ],
}


def update_env_file(var, value, path):
    text = path.read_text() if path.exists() else ""
    new_line = f'export {var}="{value}"\n'
    lines = text.splitlines(keepends=True)
    for i, line in enumerate(lines):
        if line.startswith(f"export {var}="):
            lines[i] = new_line
            break
    else:
        if text and not text.endswith("\n"):
            lines.append("\n")
        lines.append(new_line)
    path.write_text("".join(lines))


def read_personal_automation(title):
    """Return the password field of TITLE in the personal Automation vault."""
    result = subprocess.run(
        ["op-automations", "@personal", "item", "get", title, "--vault", "Automation",
         "--fields", "label=password", "--reveal"],
        capture_output=True,
        check=False,
        text=True,
        timeout=45,
    )
    if result.returncode == 0 and result.stdout:
        return result.stdout.splitlines()[0]
    return ""


def op_inject(spec, value):
    # 1Password writes need the desktop-authorized broker: the ambient
    # OP_SERVICE_ACCOUNT_TOKEN is read-only, so bare `op item edit` fails.
    op_desktop = Path(__file__).resolve().parents[2] / "bin" / "op-desktop"
    env = os.environ.copy()
    env.pop("OP_SERVICE_ACCOUNT_TOKEN", None)
    location = ["--vault", spec["vault"], "--account", spec["account"]]
    assignment = f"{spec['field']}={value}"
    result = subprocess.run(
        [str(op_desktop), "item", "edit", spec["item"], *location, assignment],
        capture_output=True,
        text=True,
        env=env,
    )
    if result.returncode != 0 and "isn't an item" in (result.stderr or ""):
        # First grant for this account: create the item instead.
        result = subprocess.run(
            [str(op_desktop), "item", "create", "--category", "password",
             "--title", spec["item"], *location, assignment],
            capture_output=True,
            text=True,
            env=env,
        )
    if result.returncode != 0:
        # Never raise CalledProcessError here: its message embeds argv,
        # which carries the credential.
        stderr = (result.stderr or "").replace(value, "[REDACTED]").strip()
        sys.exit(
            f"1Password write failed (exit {result.returncode}): "
            f"{stderr or 'no stderr'}\n"
            "The new refresh token was NOT stored; re-run this helper."
        )


def authorized_email(access_token):
    """Return the Gmail address ACCESS_TOKEN authenticates as, or None."""
    request = urllib.request.Request(
        "https://gmail.googleapis.com/gmail/v1/users/me/profile",
        headers={"Authorization": f"Bearer {access_token}"},
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.load(response).get("emailAddress")
    except (urllib.error.URLError, ValueError):
        return None


def forget_cached_token(spec):
    """Drop op-automations' cached copy of the old token so timers read the new one."""
    selector = [] if spec["vault"] == "Automations" else ["@personal"]
    ref = f"op://{spec['vault']}/{spec['item']}/{spec['field']}"
    subprocess.run(
        ["op-automations", *selector, "cache", "forget", ref],
        capture_output=True,
        check=False,
        timeout=45,
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--account", choices=sorted(TOKEN_VARS), required=True)
    parser.add_argument("--port", type=int, default=8080)
    parser.add_argument(
        "--no-browser",
        action="store_true",
        help="Print the consent URL instead of opening the default browser, "
        "so it can be opened in the right Chrome profile",
    )
    args = parser.parse_args()

    var = TOKEN_VARS[args.account]
    client_id = os.environ.get(CLIENT_ID_ENV) or read_personal_automation(CLIENT_ID_ITEM)
    client_secret = os.environ.get(CLIENT_SECRET_ENV) or read_personal_automation(CLIENT_SECRET_ITEM)
    flow = InstalledAppFlow.from_client_config(
        {
            "installed": {
                "client_id": client_id,
                "client_secret": client_secret,
                "redirect_uris": ["http://localhost"],
                "auth_uri": "https://accounts.google.com/o/oauth2/auth",
                "token_uri": "https://oauth2.googleapis.com/token",
            }
        },
        SCOPES[args.account],
    )
    # Incremental authorization can return previously granted scopes in
    # addition to the scopes requested above. oauthlib rejects that valid
    # superset unless relaxed scope matching is enabled; our explicit
    # missing-scope check below still fails closed if a requested scope is
    # absent.
    os.environ.setdefault("OAUTHLIB_RELAX_TOKEN_SCOPE", "1")
    creds = flow.run_local_server(
        port=args.port,
        open_browser=not args.no_browser,
        include_granted_scopes="true",
        prompt="consent",
        login_hint=ACCOUNT_EMAILS[args.account],
    )
    granted_scopes = set(creds.granted_scopes or creds.scopes or [])
    missing_scopes = set(SCOPES[args.account]) - granted_scopes
    if not creds.refresh_token:
        sys.exit("Google did not return a refresh token; the old token was not changed")
    if missing_scopes:
        sys.exit(
            "Google did not grant every requested scope; the old token was not changed: "
            + ", ".join(sorted(missing_scopes))
        )
    # Store a token only for the account it was requested for: a consent
    # completed in the wrong browser profile must not overwrite another
    # account's slot.
    email = authorized_email(creds.token)
    expected = ACCOUNT_EMAILS[args.account]
    if (email or "").lower() != expected:
        sys.exit(
            f"Consent was granted as {email or 'an unknown account'}, not {expected}; "
            "the old token was not changed"
        )
    if args.account in TOKEN_OP_ENTRIES:
        spec = TOKEN_OP_ENTRIES[args.account]
        op_inject(spec, creds.refresh_token)
        forget_cached_token(spec)
        print(
            f"Updated {var} in 1Password item {spec['vault']}/{spec['item']}/{spec['field']}",
            file=sys.stderr,
        )
    else:
        secrets = Path.home() / "My Drive" / "dotfiles" / "shell" / ".zshenv-secrets"
        update_env_file(var, creds.refresh_token, secrets)
        print(f"Updated {var} in {secrets}", file=sys.stderr)


if __name__ == "__main__":
    main()
