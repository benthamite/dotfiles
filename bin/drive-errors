#!/usr/bin/env python3
"""Read Google Drive's error panel and inventory sync-hostile paths."""

from __future__ import annotations

from collections import Counter
import json
import os
from pathlib import Path
import subprocess
import sys
from typing import Any, Protocol


REASONS = (
    "Can’t upload some Google files",
    "Can’t upload some files",
)
GENERATED_NAMES = {
    "node_modules",
    "__pycache__",
    ".pytest_cache",
    ".venv",
    "venv",
    ".next",
    ".ruff_cache",
}
DRIVE_ROOT = Path(
    os.environ.get("DRIVE_ERRORS_DRIVE_ROOT", str(Path.home() / "My Drive"))
)
JXA_TIMEOUT_SECONDS = 30


OPEN_ERROR_LIST_JXA = r'''
var se = Application("System Events");
var proc = se.processes.byName("Google Drive");
var traversalFailed = false;

function roleOf(el) {
  try { return String(el.role()); }
  catch (_) { traversalFailed = true; return ""; }
}
function titleOf(el) {
  var titleRead = false, valueRead = false;
  try { var value = el.title(); titleRead = true; if (value) return String(value); }
  catch (_) {}
  try { var value = el.value(); valueRead = true; if (value) return String(value); }
  catch (_) {}
  if (!titleRead || !valueRead) traversalFailed = true;
  return "";
}
function childrenOf(el) {
  try { return el.uiElements(); }
  catch (_) { traversalFailed = true; return []; }
}
function descendants(el, depth) {
  if (depth > 14) { traversalFailed = true; return []; }
  var out = [], children = childrenOf(el);
  for (var i = 0; i < children.length; i++) {
    out.push(children[i]);
    out = out.concat(descendants(children[i], depth + 1));
  }
  return out;
}
function windowNamed(name) {
  var windows = proc.windows();
  for (var i = 0; i < windows.length; i++) {
    if (titleOf(windows[i]) === name) return windows[i];
  }
  return null;
}
function waitForWindowAbsent(name) {
  for (var attempt = 0; attempt < 20; attempt++) {
    traversalFailed = false;
    if (windowNamed(name) === null && !traversalFailed) return true;
    delay(0.25);
  }
  return false;
}
function waitForWindowPresent(name) {
  for (var attempt = 0; attempt < 20; attempt++) {
    traversalFailed = false;
    var found = windowNamed(name);
    if (found !== null && !traversalFailed) return found;
    delay(0.25);
  }
  return null;
}
function closeExistingErrorList() {
  traversalFailed = false;
  var errorWindow = windowNamed("Google Drive Error list");
  if (errorWindow === null) {
    if (traversalFailed) throw new Error("Could not determine whether a Google Drive Error list was open");
    return;
  }
  var children = childrenOf(errorWindow);
  for (var i = 0; i < children.length; i++) {
    var subrole = "";
    try { subrole = String(children[i].subrole()); } catch (_) {}
    if (subrole === "AXCloseButton") {
      children[i].click();
      if (!waitForWindowAbsent("Google Drive Error list")) {
        throw new Error("Existing Google Drive Error list did not close");
      }
      return;
    }
  }
  throw new Error("An existing Google Drive Error list could not be closed safely");
}

closeExistingErrorList();
traversalFailed = false;
if (windowNamed("Google Drive") === null) {
  try { proc.menuBars[1].menuBarItems[0].click(); } catch (error) {
    throw new Error("Could not click the Google Drive menu-bar item: " + error);
  }
  delay(4);
}

var summary = null, errorCount = null, sawUpToDate = false;
for (var scan = 0; scan < 3 && summary === null && !sawUpToDate; scan++) {
  traversalFailed = false;
  var windows = proc.windows();
  for (var wi = 0; wi < windows.length && summary === null; wi++) {
    if (titleOf(windows[wi]) !== "Google Drive") continue;
    var all = descendants(windows[wi], 0);
    for (var ai = 0; ai < all.length; ai++) {
      var role = roleOf(all[ai]), title = titleOf(all[ai]);
      if (title === "Up to date") sawUpToDate = true;
      var match = title.match(/^(\d+) errors?$/);
      if ((role === "AXGroup" || role === "AXLandmarkRegion") && match) {
        summary = all[ai];
        errorCount = Number(match[1]);
        break;
      }
    }
  }
  if (summary === null && !sawUpToDate) delay(0.5);
}

if (summary === null) {
  JSON.stringify({state: sawUpToDate && !traversalFailed ? "clean" : "unrecognized",
                  traversalFailed: traversalFailed});
} else {
  if (traversalFailed) throw new Error("Google Drive summary traversal was incomplete");
  var view = null, inside = descendants(summary, 0);
  for (var vi = 0; vi < inside.length; vi++) {
    var title = titleOf(inside[vi]);
    if (roleOf(inside[vi]) === "AXButton" && title === "View") {
      view = inside[vi];
      break;
    }
  }
  if (view === null) throw new Error("Found the error summary but not its View button");
  if (traversalFailed) throw new Error("Google Drive summary traversal was incomplete");
  view.click();
  if (waitForWindowPresent("Google Drive Error list") === null) {
    throw new Error("Google Drive Error list did not open");
  }
  JSON.stringify({state: "errors", errorCount: errorCount, traversalFailed: traversalFailed});
}
'''


READ_PAGE_JXA = r'''
var se = Application("System Events");
var proc = se.processes.byName("Google Drive");
var reasons = ["Can’t upload some Google files", "Can’t upload some files"];
var traversalFailed = false;

function roleOf(el) {
  try { return String(el.role()); }
  catch (_) { traversalFailed = true; return ""; }
}
function titleOf(el) {
  var titleRead = false, valueRead = false;
  try { var value = el.title(); titleRead = true; if (value) return String(value); }
  catch (_) {}
  try { var value = el.value(); valueRead = true; if (value) return String(value); }
  catch (_) {}
  if (!titleRead || !valueRead) traversalFailed = true;
  return "";
}
function childrenOf(el) {
  try { return el.uiElements(); }
  catch (_) { traversalFailed = true; return []; }
}
function descendants(el, depth) {
  if (depth > 14) { traversalFailed = true; return []; }
  var out = [], children = childrenOf(el);
  for (var i = 0; i < children.length; i++) {
    out.push(children[i]);
    out = out.concat(descendants(children[i], depth + 1));
  }
  return out;
}
function reasonUnder(el) {
  var all = [el].concat(descendants(el, 0));
  var reason = null;
  for (var i = 0; i < all.length; i++) {
    var title = titleOf(all[i]);
    if (reasons.indexOf(title) !== -1) {
      if (reason !== null && reason !== title) traversalFailed = true;
      reason = title;
    }
  }
  return reason;
}
function collectRows(el, rows, depth) {
  if (depth > 14) { traversalFailed = true; return; }
  var children = childrenOf(el);
  for (var i = 0; i + 1 < children.length; i++) {
    if (roleOf(children[i]) === "AXLink" && roleOf(children[i + 1]) === "AXGroup") {
      var reason = reasonUnder(children[i + 1]);
      var name = titleOf(children[i]);
      if (reason !== null && name !== "") rows.push({name: name, reason: reason});
      else traversalFailed = true;
    }
  }
  for (var j = 0; j < children.length; j++) collectRows(children[j], rows, depth + 1);
}

var target = null, windows = proc.windows();
for (var wi = 0; wi < windows.length && target === null; wi++) {
  var all = [windows[wi]].concat(descendants(windows[wi], 0));
  for (var ai = 0; ai < all.length; ai++) {
    var title = titleOf(all[ai]);
    if (title === "Google Drive Error list") { target = windows[wi]; break; }
  }
}
if (target === null) throw new Error("Google Drive Error list is not open");

var page = null, total = null, previous = false, next = false;
var controls = descendants(target, 0);
for (var ci = 0; ci < controls.length; ci++) {
  var title = titleOf(controls[ci]);
  if (roleOf(controls[ci]) === "AXButton" && title === "Previous page") previous = true;
  if (roleOf(controls[ci]) === "AXButton" && title === "Next page") next = true;
  var match = title.match(/^(\d+)\/(\d+)$/);
  if (match) {
    var foundPage = Number(match[1]), foundTotal = Number(match[2]);
    if (page !== null && (page !== foundPage || total !== foundTotal)) {
      traversalFailed = true;
    }
    page = foundPage;
    total = foundTotal;
  }
}
if (page === null || !previous || !next) {
  throw new Error("Could not identify the error-list pagination controls");
}
var rows = [];
collectRows(target, rows, 0);
JSON.stringify({page: page, total: total, rows: rows, traversalFailed: traversalFailed});
'''


NEXT_PAGE_JXA = r'''
var se = Application("System Events");
var proc = se.processes.byName("Google Drive");
var traversalFailed = false;
function roleOf(el) { try { return String(el.role()); } catch (_) { traversalFailed = true; return ""; } }
function titleOf(el) {
  var titleRead = false, valueRead = false;
  try { var value = el.title(); titleRead = true; if (value) return String(value); } catch (_) {}
  try { var value = el.value(); valueRead = true; if (value) return String(value); } catch (_) {}
  if (!titleRead || !valueRead) traversalFailed = true;
  return "";
}
function childrenOf(el) { try { return el.uiElements(); } catch (_) { traversalFailed = true; return []; } }
function descendants(el, depth) {
  if (depth > 14) { traversalFailed = true; return []; }
  var out = [], children = childrenOf(el);
  for (var i = 0; i < children.length; i++) {
    out.push(children[i]);
    out = out.concat(descendants(children[i], depth + 1));
  }
  return out;
}
var windows = proc.windows(), target = null, next = null;
for (var wi = 0; wi < windows.length && target === null; wi++) {
  var windowElements = [windows[wi]].concat(descendants(windows[wi], 0));
  for (var ei = 0; ei < windowElements.length; ei++) {
    var title = titleOf(windowElements[ei]);
    if (title === "Google Drive Error list") { target = windows[wi]; break; }
  }
}
if (target === null) throw new Error("Google Drive Error list is not open");
var all = descendants(target, 0);
for (var ai = 0; ai < all.length; ai++) {
  var title = titleOf(all[ai]);
  if (roleOf(all[ai]) === "AXButton" && title === "Next page") {
    next = all[ai];
    break;
  }
}
if (next === null) throw new Error("Could not reacquire the Next page button");
if (traversalFailed) throw new Error("Google Drive pagination traversal was incomplete");
next.click();
delay(2);
JSON.stringify({clicked: true, traversalFailed: false});
'''


class Panel(Protocol):
    def open_error_list(self) -> int | None: ...

    def read_page(self) -> dict[str, Any]: ...

    def next_page(self) -> None: ...


def require_complete_traversal(result: dict[str, Any]) -> None:
    if result.get("traversalFailed") is not False:
        raise RuntimeError("Google Drive accessibility traversal was incomplete or unknown")


def summary_count(result: Any) -> int | None:
    if not isinstance(result, dict):
        raise RuntimeError("Google Drive returned malformed panel data")
    state = result.get("state")
    if state not in ("errors", "clean"):
        raise RuntimeError("Google Drive panel state was unrecognized; refusing to report it clean")
    require_complete_traversal(result)
    error_count = result.get("errorCount")
    if state == "clean":
        if "errorCount" in result and (type(error_count) is not int or error_count != 0):
            raise RuntimeError("Google Drive clean summary contradicted its error count")
        return None
    if type(error_count) is not int or error_count < 1:
        raise RuntimeError("Google Drive error summary had an invalid count")
    return error_count


class AccessibilityPanel:
    @staticmethod
    def _run_jxa(source: str) -> dict[str, Any]:
        try:
            result = subprocess.run(
                ["osascript", "-l", "JavaScript", "-e", source],
                text=True,
                capture_output=True,
                check=False,
                timeout=JXA_TIMEOUT_SECONDS,
            )
        except subprocess.TimeoutExpired:
            raise RuntimeError("Google Drive accessibility request timed out; result is inconclusive") from None
        except (OSError, UnicodeError):
            raise RuntimeError("Could not run Google Drive accessibility request") from None
        if result.returncode != 0:
            raise RuntimeError("Google Drive accessibility request failed; panel state is inconclusive")
        try:
            parsed = json.loads(result.stdout)
        except (ValueError, TypeError):
            raise RuntimeError("Google Drive returned malformed panel data") from None
        if not isinstance(parsed, dict):
            raise RuntimeError("Google Drive returned malformed panel data")
        return parsed

    def open_error_list(self) -> int | None:
        return summary_count(self._run_jxa(OPEN_ERROR_LIST_JXA))

    def read_page(self) -> dict[str, Any]:
        return self._run_jxa(READ_PAGE_JXA)

    def next_page(self) -> None:
        result = self._run_jxa(NEXT_PAGE_JXA)
        require_complete_traversal(result)
        if result.get("clicked") is not True:
            raise RuntimeError("Google Drive did not confirm the next-page action")


class FixturePanel:
    def __init__(self, fixture: dict[str, Any]) -> None:
        self.fixture = fixture
        self.error_count = summary_count(fixture)
        self.pages = fixture.get("pages", [])
        if not isinstance(self.pages, list) or any(not isinstance(page, dict) for page in self.pages):
            raise RuntimeError("Fixture pages must be an array of page objects")
        if self.error_count is None:
            if self.pages:
                raise RuntimeError("Fixture clean state contradicted its error pages")
        elif not self.pages or self.pages[0].get("total") != len(self.pages):
            raise RuntimeError("Fixture pagination does not contain all declared pages")
        self.index = 0

    def open_error_list(self) -> int | None:
        return self.error_count

    def read_page(self) -> dict[str, Any]:
        if self.index >= len(self.pages):
            raise RuntimeError("Fixture pagination ran out of pages")
        return self.pages[self.index]

    def next_page(self) -> None:
        self.index += 1


def collect_rows(panel: Panel) -> list[dict[str, str]]:
    expected_count = panel.open_error_list()
    if expected_count is None:
        return []
    if type(expected_count) is not int or expected_count < 1:
        raise RuntimeError("Google Drive error summary had an invalid count")
    rows: list[dict[str, str]] = []
    expected_page = 1
    expected_total: int | None = None
    while True:
        page_data = panel.read_page()
        if not isinstance(page_data, dict):
            raise RuntimeError("Invalid page data from Google Drive")
        require_complete_traversal(page_data)
        page = page_data.get("page")
        total = page_data.get("total")
        if (type(page) is not int or type(total) is not int
                or not 1 <= page <= total <= expected_count):
            raise RuntimeError("Invalid pagination metadata from Google Drive")
        if page != expected_page or (expected_total is not None and total != expected_total):
            raise RuntimeError("Google Drive error-list pagination was not sequential")
        expected_total = total
        page_rows = page_data.get("rows")
        if not isinstance(page_rows, list):
            raise RuntimeError("Invalid row data from Google Drive")
        if not page_rows:
            raise RuntimeError(
                "Google Drive error-list page contained no rows; refusing to report it clean"
            )
        for row in page_rows:
            if not isinstance(row, dict) or row.get("reason") not in REASONS:
                raise RuntimeError("Unexpected Google Drive error row")
            name = row.get("name")
            if not isinstance(name, str) or not name:
                raise RuntimeError("Google Drive error row has no filename")
            rows.append({"name": name, "reason": row["reason"]})
        if len(rows) > expected_count:
            raise RuntimeError("Google Drive error-list rows exceeded its summary count")
        if page == total:
            if len(rows) != expected_count:
                raise RuntimeError(
                    f"Google Drive summary expected {expected_count} rows, "
                    f"but accessibility returned {len(rows)}"
                )
            return rows
        expected_page += 1
        panel.next_page()


def walk_entries(root: Path):
    def fail_on_walk_error(error: OSError) -> None:
        raise RuntimeError(f"Could not traverse Drive root: {error}") from error

    for directory, dirnames, filenames in os.walk(
        root, followlinks=False, onerror=fail_on_walk_error
    ):
        base = Path(directory)
        for name in dirnames:
            yield base / name
        for name in filenames:
            yield base / name


def candidate_paths(root: Path, names: set[str]) -> dict[str, list[Path]]:
    matches = {name: [] for name in names}
    for path in walk_entries(root):
        if path.name in matches:
            matches[path.name].append(path)
    for paths in matches.values():
        paths.sort(key=lambda path: str(path))
    return matches


def relative(path: Path, root: Path) -> str:
    try:
        return str(path.relative_to(root))
    except ValueError:
        return str(path)


def panel_from_environment() -> Panel:
    fixture = os.environ.get("DRIVE_ERRORS_PANEL_FIXTURE")
    if fixture is None:
        return AccessibilityPanel()
    try:
        parsed = json.loads(fixture)
    except json.JSONDecodeError as error:
        raise RuntimeError("DRIVE_ERRORS_PANEL_FIXTURE is not valid JSON") from error
    if not isinstance(parsed, dict):
        raise RuntimeError("DRIVE_ERRORS_PANEL_FIXTURE must be a JSON object")
    return FixturePanel(parsed)


def cmd_list(root: Path) -> int:
    print("=== Drive error panel ===")
    panel = panel_from_environment()
    if isinstance(panel, FixturePanel):
        print("FIXTURE mode: synthetic panel data, not live Google Drive evidence.")
    else:
        print("Scope: observed Drive panel only; not account-bound and not all accounts.")
    print(f"Candidate filesystem root (independent of panel account): {root}")
    rows = collect_rows(panel)
    if not rows:
        print("No error rows found in the panel.")
        return 0

    print("Raw rows (panel order; duplicates preserved):")
    for index, row in enumerate(rows, 1):
        print(f"  {index}. {row['name']} — {row['reason']}")

    counts = Counter(row["reason"] for row in rows)
    print("Reason summary:")
    for reason in REASONS:
        print(f"  {reason}: {counts[reason]}")

    print("Candidate filesystem paths (basename matches; not exact-instance proof):")
    names = {row["name"] for row in rows}
    matches = candidate_paths(root, names)
    for name in sorted(names):
        paths = matches[name]
        print(f"  {name}: {len(paths)} candidate paths")
        for path in paths:
            print(f"    {relative(path, root)}")
    return 0


def cmd_locate(root: Path) -> int:
    entries = list(walk_entries(root))
    symlinks = sorted(
        (path for path in entries if path.is_symlink()), key=lambda path: str(path)
    )
    generated = sorted(
        (
            path
            for path in entries
            if path.name in GENERATED_NAMES and path.is_dir() and not path.is_symlink()
        ),
        key=lambda path: str(path),
    )
    print("=== symlinks under Drive (potential sync-hostile paths; inspect each candidate) ===")
    for path in symlinks:
        print(relative(path, root))
    print()
    print("=== real generated directories matching the helper's known-name set ===")
    for path in generated:
        print(relative(path, root))
    return 0


def main(argv: list[str]) -> int:
    command = argv[1] if len(argv) > 1 else "both"
    if command not in {"list", "locate", "both"} or len(argv) > 2:
        print("usage: drive-errors [list|locate|both]", file=sys.stderr)
        return 2
    try:
        if not DRIVE_ROOT.is_dir() or not os.access(
            DRIVE_ROOT, os.R_OK | os.X_OK
        ):
            raise RuntimeError(f"Drive root is not an accessible directory: {DRIVE_ROOT}")
        if command in {"list", "both"}:
            cmd_list(DRIVE_ROOT)
        if command == "both":
            print()
        if command in {"locate", "both"}:
            cmd_locate(DRIVE_ROOT)
    except RuntimeError as error:
        print(f"drive-errors: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
