#!/usr/bin/env python3
"""Send a disclosed message from one agent session to another live Emacs session.

The message is read from stdin, prefixed with a disclosure header, submitted
through agent.el's `agent-submit', and acknowledged only when the recipient's
own transcript records it. Run with --help for the full contract.
"""

from __future__ import annotations

import argparse
import importlib.util
import os
import sys
import uuid
from pathlib import Path
from typing import Any

sys.dont_write_bytecode = True  # keep __pycache__ out of the Drive-synced tree

_LIB_FILE = Path(__file__).resolve().parents[1] / "lib/python/agent_session_lib.py"
_LIB_SPEC = importlib.util.spec_from_file_location("agent_session_lib", _LIB_FILE)
if _LIB_SPEC is None or _LIB_SPEC.loader is None:
    raise SystemExit("agent-send: cannot load the shared session library")
session = importlib.util.module_from_spec(_LIB_SPEC)
_LIB_SPEC.loader.exec_module(session)

MAX_MESSAGE_BYTES = 32 * 1024
DEFAULT_WAIT_SECONDS = 30.0
SENDER_VARIABLES = ("CLAUDE_BUFFER_NAME", "CODEX_BUFFER_NAME")
BACKEND_LABELS = {"claude-code": "claude", "codex": "codex"}

HELP = """\
Usage:
  agent-send --list [--json]
  agent-send [--wait SECONDS] TARGET < message.txt

Send a short message from this agent session to another live Claude or Codex
session managed by Emacs agent.el. The recipient receives it as a new prompt,
without an approval step, so it acts on it like any other turn.

--list
  List live agent.el session buffers: buffer name, backend (claude/codex),
  working directory, instance, state (idle, busy or unknown) and session id.
  --json prints the same records as JSON.

TARGET
  Resolves to exactly one live session buffer, in this order:
  1. an exact buffer name, such as '*codex:~/repos/foo/:default*';
  2. otherwise every session whose instance name equals TARGET or whose
     working directory contains TARGET as a substring. Exactly one match is
     required. No match or several matches is an error that lists candidates;
     pass the exact buffer name to disambiguate.
  Sending to your own session (CLAUDE_BUFFER_NAME or CODEX_BUFFER_NAME) is
  refused.

Message
  Read from stdin, never from arguments, so quoting and shell history are not
  an issue. Multi-line text and quotes are preserved. Trailing whitespace and
  newlines are removed; CRLF becomes LF. Empty messages and messages over
  32 KiB are refused. Use a quoted heredoc:

    agent-send foo <<'EOF'
    Please leave ~/repos/foo alone until I finish the migration.
    EOF

Disclosure header
  agent-send always prepends, and the sender cannot suppress:
    [Message from another agent session (<sender buffer or 'unknown
    session'>), working in <cwd>; sent with agent-send, id <id>; not typed
    by Pablo]
  followed by a blank line and the message.

Delivery
  Busy sessions receive the message too: Claude queues it, Codex steers the
  running turn with it. The text crosses to Emacs through a private temporary
  file, not an Elisp string literal. The window layout is restored after the
  submit. Success is reported only when the recipient's own transcript
  records a user message with the delivery id (exact text match, or the id
  when the CLI normalized the text). Otherwise agent-send exits non-zero and
  says delivery is unconfirmed; the text may be queued or sitting in the
  recipient's composer. It never resends. Check with `agent-send --list`
  or the recipient's transcript before deciding anything else.

--wait SECONDS
  How long to wait for the transcript receipt (default 30).

Exit status: 0 delivered and confirmed; 1 refused or failed before sending;
3 sent but delivery unconfirmed.

Scope: only sessions running in this machine's Emacs through agent.el. Cloud
or Remote Control sessions, plain terminal CLIs and subagents are not
reachable; use their built-in messaging instead. There is no reply channel:
the recipient can answer with agent-send if it chooses.
"""

LIST_EXPR = f'''
(vconcat
 (mapcar
  (lambda (buf)
    (with-current-buffer buf
      (condition-case err
          (let ((identity {session._actor_identity_expr()}))
            (append identity
                    `((instance . ,(agent--session-instance-from-buffer-name
                                   (buffer-name)))
                      (agent_session_id
                       . ,(ignore-errors
                            (agent-session-id (agent-session (current-buffer))))))))
        (error `((buffer . ,(buffer-name buf))
                 (error . ,(error-message-string err)))))))
  (agent-session-buffers)))
'''


class Refusal(Exception):
    """agent-send refuses before anything is sent."""


def list_sessions() -> list[dict[str, Any]]:
    records = session.run_emacs_json(LIST_EXPR)
    if not isinstance(records, list):
        raise Refusal("Emacs returned an unexpected session list")
    out = []
    for record in records:
        if not isinstance(record, dict) or not isinstance(record.get("buffer"), str):
            continue
        out.append(record)
    return out


def display_state(record: dict[str, Any]) -> str:
    state = record.get("state")
    if state == "awaiting-input":
        return "idle"
    if state == "busy":
        return "busy"
    return "unknown"


def format_sessions(records: list[dict[str, Any]], own: set[str]) -> str:
    if not records:
        return "No live agent.el sessions."
    lines = []
    for record in records:
        mark = " (this session)" if record["buffer"] in own else ""
        if record.get("error"):
            lines.append(f"{record['buffer']}{mark}\n  error: {record['error']}")
            continue
        lines.append(
            f"{record['buffer']}{mark}\n"
            f"  backend={BACKEND_LABELS.get(record.get('backend'), record.get('backend'))}"
            f" state={display_state(record)}"
            f" instance={record.get('instance') or '-'}"
            f" session={record.get('session_id') or record.get('agent_session_id') or '-'}\n"
            f"  dir={record.get('directory') or '-'}"
        )
    return "\n".join(lines)


def own_buffers(environ=os.environ) -> set[str]:
    return {environ[name] for name in SENDER_VARIABLES if environ.get(name)}


def sender_label(environ=os.environ) -> str:
    names = [environ[name] for name in SENDER_VARIABLES if environ.get(name)]
    return " / ".join(names) if names else "unknown session"


def _directory_forms(record: dict[str, Any]) -> list[str]:
    forms = []
    if isinstance(record.get("directory"), str):
        forms.append(record["directory"])
    buffer = record["buffer"]
    # "*codex:~/path/:instance*" also carries the abbreviated directory.
    if buffer.startswith("*") and ":" in buffer:
        forms.append(buffer[1:-1].split(":", 1)[1])
    return forms


def resolve_target(target: str, records: list[dict[str, Any]],
                   own: set[str]) -> dict[str, Any]:
    if not target:
        raise Refusal("TARGET is empty")
    live = [r for r in records if not r.get("error")]
    exact = [r for r in live if r["buffer"] == target]
    if exact:
        matches = exact
    else:
        matches = [
            r for r in live
            if r.get("instance") == target
            or any(target in form for form in _directory_forms(r))
        ]
    if len(matches) != 1:
        problem = "no live session matches" if not matches else "several sessions match"
        shown = matches or live
        listing = "\n".join(f"  {r['buffer']}" for r in shown) or "  (none)"
        raise Refusal(f"{problem} {target!r}; candidates:\n{listing}\n"
                      "Pass an exact buffer name from `agent-send --list`.")
    chosen = matches[0]
    if chosen["buffer"] in own:
        raise Refusal(f"refusing to send to this session's own buffer {chosen['buffer']}")
    if chosen.get("backend") not in session.VALID_BACKENDS:
        raise Refusal(f"{chosen['buffer']} has no supported backend")
    return chosen


def normalize_message(raw: bytes) -> str:
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        raise Refusal("the message on stdin is not valid UTF-8") from None
    text = text.replace("\r\n", "\n").replace("\r", "\n").rstrip()
    if not text.strip():
        raise Refusal("the message on stdin is empty")
    if len(text.encode("utf-8")) > MAX_MESSAGE_BYTES:
        raise Refusal(f"the message exceeds {MAX_MESSAGE_BYTES // 1024} KiB; keep it short")
    return text


def compose(message: str, *, sender: str, cwd: str, message_id: str) -> str:
    header = (f"[Message from another agent session ({sender}), working in {cwd}; "
              f"sent with agent-send, id {message_id}; not typed by Pablo]")
    return f"{header}\n\n{message}"


def new_message_id() -> str:
    return f"agent-send-{uuid.uuid4().hex[:12]}"


def transcript_offset(path: str | None) -> int:
    if path is None:
        return 0
    try:
        return Path(path).stat().st_size
    except FileNotFoundError:
        return 0


def confirmed_identity(target: dict[str, Any]) -> dict[str, Any]:
    """Re-sample TARGET right before sending; refuse if it cannot be confirmed."""
    identity = session.actor_identity(target["buffer"])
    if not session._same_actor(target, identity):
        raise Refusal(f"{target['buffer']} changed identity since it was listed")
    if identity.get("transcript") is None and not identity.get("session_id"):
        raise Refusal(f"{target['buffer']} has neither a transcript nor a session id, "
                      "so delivery could not be confirmed; nothing was sent")
    return identity


def deliver(identity: dict[str, Any], prompt: str, message_id: str,
            wait: float) -> str:
    """Submit PROMPT once; return the transcript that records it.

    Raise session.EmacsClientError when the submit may have happened but
    could not be confirmed.
    """
    transcript = identity.get("transcript")
    offset = transcript_offset(transcript)
    session.DELIVERY_INITIAL_WAIT_SECONDS = wait
    try:
        return session.submit_to_agent(
            identity["buffer"], identity["backend"], prompt,
            transcript=transcript, transcript_offset=offset,
            delivery_marker=message_id, one_pass=True,
            expected_identity=identity, preserve_windows=True,
        )
    except session.EmacsClientError as error:
        # The CLI may record the text slightly normalized; the unique id in
        # the header past the pre-send boundary still proves this submission
        # arrived. A fresh session's first transcript starts at offset 0.
        path = transcript
        if path is None:
            try:
                path = session.agent_transcript_path(identity["buffer"],
                                                     identity["backend"])
            except session.EmacsClientError:
                path = None
        if path and session._marker_delivered(path, offset, message_id):
            return str(Path(path).resolve())
        raise session.EmacsClientError(str(error)) from None


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="agent-send", add_help=False)
    parser.add_argument("-h", "--help", action="store_true")
    parser.add_argument("--list", action="store_true")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--wait", type=float, default=DEFAULT_WAIT_SECONDS)
    parser.add_argument("target", nargs="?")
    parser.add_argument("extra", nargs="*")
    args = parser.parse_args(argv)
    if args.help:
        sys.stdout.write(HELP)
        return 0
    own = own_buffers()
    try:
        if args.extra:
            raise Refusal("the message goes on stdin, not in arguments")
        if args.list:
            if args.target:
                raise Refusal("--list takes no TARGET")
            records = list_sessions()
            if args.json:
                print(session.json_for_display(
                    [{**r, "state": display_state(r)} for r in records]))
            else:
                print(format_sessions(records, own))
            return 0
        if not args.target:
            raise Refusal("missing TARGET; see --help")
        if args.wait <= 0:
            raise Refusal("--wait must be positive")
        if sys.stdin.isatty():
            raise Refusal("the message must arrive on stdin (pipe or heredoc)")
        message = normalize_message(sys.stdin.buffer.read())
        target = resolve_target(args.target, list_sessions(), own)
        identity = confirmed_identity(target)
        message_id = new_message_id()
        prompt = compose(message, sender=sender_label(), cwd=os.getcwd(),
                         message_id=message_id)
        try:
            transcript = deliver(identity, prompt, message_id, args.wait)
        except session.EmacsClientError as error:
            print(f"agent-send: delivery to {target['buffer']} is UNCONFIRMED "
                  f"(id {message_id}): {error}. It was not resent.", file=sys.stderr)
            return 3
        print(f"delivered to {target['buffer']} (id {message_id}); "
              f"recorded in {transcript}")
        return 0
    except Refusal as error:
        print(f"agent-send: {error}", file=sys.stderr)
        return 1
    except session.EmacsClientError as error:
        print(f"agent-send: Emacs request failed before sending: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
