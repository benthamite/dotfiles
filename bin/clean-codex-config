#!/usr/bin/env python3
"""Remove stale machine-written trust tables from Codex config.toml."""

from __future__ import annotations

import argparse
import copy
import json
import os
import re
import stat
import sys
import tempfile
import tomllib
from functools import cache
from pathlib import Path


def plural(count: int, singular: str, plural_form: str) -> str:
    label = singular if count == 1 else plural_form
    return f"{count} {label}"


def snake_case(name: str) -> str:
    first_pass = re.sub(r"(.)([A-Z][a-z]+)", r"\1_\2", name)
    return re.sub(r"([a-z0-9])([A-Z])", r"\1_\2", first_pass).lower()


@cache
def load_hook_events(path_text: str) -> dict[str, list[object]] | None:
    path = Path(os.path.expanduser(path_text))
    if not path.is_file():
        return None
    with path.open("rb") as handle:
        payload = json.load(handle)
    if not isinstance(payload, dict):
        raise ValueError(f"{path}: top-level JSON value is not an object")
    hooks = payload.get("hooks", {})
    if not isinstance(hooks, dict):
        raise ValueError(f"{path}: top-level hooks value is not an object")
    return {snake_case(name): groups for name, groups in hooks.items()}


def hook_state_is_live(spec: str) -> bool:
    try:
        hooks_path, event, group_text, hook_text = spec.rsplit(":", 3)
        group_index = int(group_text)
        hook_index = int(hook_text)
    except ValueError:
        # Preserve unfamiliar state keys rather than guessing that they are stale.
        return True

    events = load_hook_events(hooks_path)
    if events is None:
        return False
    groups = events.get(event)
    if not isinstance(groups, list) or not 0 <= group_index < len(groups):
        return False
    group = groups[group_index]
    if not isinstance(group, dict):
        return False
    hooks = group.get("hooks")
    return isinstance(hooks, list) and 0 <= hook_index < len(hooks)


def stale_entries(config: dict[str, object]) -> tuple[list[str], list[str]]:
    projects = config.get("projects", {})
    if not isinstance(projects, dict):
        raise ValueError("projects must be a table")
    stale_projects = [
        path
        for path in projects
        if not Path(os.path.expanduser(path)).exists()
    ]

    hooks = config.get("hooks", {})
    if not isinstance(hooks, dict):
        raise ValueError("hooks must be a table")
    states = hooks.get("state", {})
    if not isinstance(states, dict):
        raise ValueError("hooks.state must be a table")
    stale_hooks = [spec for spec in states if not hook_state_is_live(spec)]
    return stale_projects, stale_hooks


HEADER_MARKER = "__clean_codex_config_table_marker__"


def header_path(line: str) -> tuple[str, ...] | None:
    stripped = line.lstrip()
    if not stripped.startswith("["):
        return None
    if stripped.startswith("[["):
        return ()

    try:
        probe = tomllib.loads(
            f"{stripped.rstrip()}\n{HEADER_MARKER} = true\n"
        )
    except tomllib.TOMLDecodeError:
        # Bracket-prefixed lines inside multiline arrays or strings are values,
        # not document-level table declarations.
        return None

    def find_marker(value: object, path: tuple[str, ...]) -> tuple[str, ...] | None:
        if not isinstance(value, dict):
            return None
        if HEADER_MARKER in value:
            return path
        for key, child in value.items():
            found = find_marker(child, (*path, key))
            if found is not None:
                return found
        return None

    found = find_marker(probe, ())
    if found is None:
        raise ValueError(f"Cannot identify TOML table header: {line.rstrip()}")
    return found


def remove_tables(text: str, tables: set[tuple[str, ...]]) -> str:
    kept: list[str] = []
    skip = False
    for line in text.splitlines(keepends=True):
        path = header_path(line)
        if path is not None:
            skip = path in tables
        if not skip:
            kept.append(line)
    return "".join(kept)


def without_empty_tables(value: object) -> object:
    if not isinstance(value, dict):
        return value
    normalized = {
        key: without_empty_tables(child)
        for key, child in value.items()
    }
    return {
        key: child
        for key, child in normalized.items()
        if child != {}
    }


def validate_cleaned_config(
    original: dict[str, object],
    cleaned_text: str,
    stale_projects: list[str],
    stale_hooks: list[str],
) -> None:
    expected = copy.deepcopy(original)
    projects = expected.get("projects", {})
    for path in stale_projects:
        projects.pop(path)
    states = expected.get("hooks", {}).get("state", {})
    for spec in stale_hooks:
        states.pop(spec)

    actual = tomllib.loads(cleaned_text)
    if without_empty_tables(actual) != without_empty_tables(expected):
        raise ValueError(
            "cleaned TOML does not equal the original configuration minus "
            "the selected stale tables"
        )


def atomic_write(path: Path, text: str) -> None:
    mode = stat.S_IMODE(path.stat().st_mode)
    descriptor, temporary = tempfile.mkstemp(
        dir=path.parent,
        prefix=f".{path.name}.",
    )
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=__doc__,
    )
    parser.add_argument(
        "--config",
        type=Path,
        default=Path("~/.codex/config.toml").expanduser(),
        help="Codex config file (default: ~/.codex/config.toml)",
    )
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument(
        "--check",
        action="store_true",
        help="report stale entries without changing the file",
    )
    mode.add_argument(
        "--write",
        action="store_true",
        help="remove stale entries atomically",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    display_path = args.config.expanduser()
    try:
        config_path = display_path.resolve(strict=True)
        original = config_path.read_text(encoding="utf-8")
        parsed = tomllib.loads(original)
        stale_projects, stale_hooks = stale_entries(parsed)
    except (OSError, json.JSONDecodeError, tomllib.TOMLDecodeError, ValueError) as error:
        print(f"Error: {error}", file=sys.stderr)
        return 2

    if not stale_projects and not stale_hooks:
        print(f"No stale Codex config entries found in {display_path}")
        return 0

    project_count = plural(
        len(stale_projects),
        "stale project trust entry",
        "stale project trust entries",
    )
    hook_count = plural(
        len(stale_hooks),
        "stale hook trust entry",
        "stale hook trust entries",
    )
    if args.check:
        print(f"Found {project_count} and {hook_count} in {display_path}")
        return 1

    tables = {
        ("projects", path)
        for path in stale_projects
    }
    tables.update(
        ("hooks", "state", spec)
        for spec in stale_hooks
    )
    try:
        cleaned = remove_tables(original, tables)
        validate_cleaned_config(
            parsed,
            cleaned,
            stale_projects,
            stale_hooks,
        )
        atomic_write(config_path, cleaned)
    except (OSError, tomllib.TOMLDecodeError, ValueError) as error:
        print(f"Error: {error}", file=sys.stderr)
        return 2
    print(f"Removed {project_count} and {hook_count} from {display_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
