""",
        end="",
    )


def read_input_json() -> dict:
    raw = sys.stdin.read()
    if not raw.strip():
        return {}
    return json.loads(raw)


def run_git(args: list[str], repo: Path = ROOT) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(repo), *args],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )


def git_lines(args: list[str], repo: Path = ROOT) -> list[str]:
    proc = run_git(args, repo)
    if proc.returncode != 0:
        return []
    return [line for line in proc.stdout.splitlines() if line]


def real_path(path: Path) -> Path:
    try:
        return path.resolve()
    except OSError:
        return Path(os.path.realpath(path))


def same_path(left: Path, right: Path) -> bool:
    return real_path(left) == real_path(right)


def git_common_dir(repo: Path) -> Path | None:
    text = git_text(["rev-parse", "--git-common-dir"], repo)
    if text is None or not text.strip():
        return None
    common_dir = Path(text.strip())
    if not common_dir.is_absolute():
        common_dir = repo / common_dir
    return real_path(common_dir)


def same_git_repository(left: Path, right: Path) -> bool:
    left_common = git_common_dir(left)
    right_common = git_common_dir(right)
    return (
        left_common is not None
        and right_common is not None
        and left_common == right_common
    )


def nearest_existing_path(path: Path) -> Path:
    candidate = path if path.is_dir() else path.parent
    while not candidate.exists() and candidate != candidate.parent:
        candidate = candidate.parent
    return candidate


def git_root_for_dir(path: Path) -> Path | None:
    proc = subprocess.run(
        ["git", "-C", str(path), "rev-parse", "--show-toplevel"],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    if proc.returncode != 0:
        return None
    return Path(proc.stdout.strip())


def git_root_for_path(path: Path, fallback_cwd: Path | None = None) -> Path | None:
    root = git_root_for_dir(nearest_existing_path(path))
    if root is not None:
        return root
    if fallback_cwd is not None:
        return git_root_for_dir(nearest_existing_path(fallback_cwd))
    return None


def path_from_token(token: str, cwd: Path | None = None) -> Path:
    if cwd is None:
        cwd = Path.cwd()
    expanded = os.path.expanduser(token)
    path = Path(expanded)
    if not path.is_absolute():
        path = cwd / path
    return path


def tool_input_object(data: dict) -> dict:
    tool_input = data.get("tool_input") or {}
    if isinstance(tool_input, dict):
        return tool_input
    if isinstance(tool_input, str):
        try:
            parsed = json.loads(tool_input)
        except json.JSONDecodeError:
            return {"command": tool_input}
        if isinstance(parsed, dict):
            return parsed
        return {"command": tool_input}
    return {}


def relative_to_repo(path_text: str, cwd: Path, repo_root: Path) -> str:
    if not path_text:
        return ""
    if path_text in {".", ""}:
        return path_text

    path = path_from_token(path_text, cwd)
    try:
        return path.relative_to(repo_root).as_posix()
    except ValueError:
        pass

    try:
        return real_path(path).relative_to(real_path(repo_root)).as_posix()
    except ValueError:
        return ""


def local_sync_path(rel: str) -> bool:
    return Path(rel).name in {"CLAUDE.md", "AGENTS.md"} or rel.startswith((".claude/", ".codex/"))


def global_sync_path(rel: str) -> bool:
    return (
        rel.startswith(("claude/", "codex/"))
        or rel == MANIFEST
        or rel in SYNC_CONFIG_PATHS
        or rel in {GLOBAL_INSTRUCTION_CLAUDE, GLOBAL_INSTRUCTION_CODEX}
    )


def full_audit_gate_path(rel: str) -> bool:
    return (
        global_sync_path(rel)
        or local_sync_path(rel)
        or rel
        in {
            PRIVATE_MANIFEST,
            DISABLED_SKILLS_PATH.name,
            "agents/README.org",
            "bin/ai-config-sync",
            "bin/install-private-skills",
        }
    )


def sync_scope_for_path(
    path_text: str,
    cwd: Path | None = None,
    repo_root: Path | None = None,
) -> tuple[str, Path | None, str]:
    if not path_text:
        return "other", None, ""
    if cwd is None:
        cwd = Path.cwd()

    path = path_from_token(path_text, cwd)
    home = Path.home()
    if path == home / ".claude" / "settings.json":
        return "global", ROOT, str(path)
    if path == home / ".claude" / "settings.local.json":
        return "global", ROOT, str(path)

    root_real = real_path(ROOT)
    try:
        root_rel = real_path(path).relative_to(root_real).as_posix()
    except ValueError:
        root_rel = ""
    if root_rel and global_sync_path(root_rel):
        return "global", ROOT, root_rel

    local_root = repo_root or git_root_for_path(path, cwd)
    if local_root is None:
        return "other", None, path_text
    rel = relative_to_repo(path_text, cwd, local_root)
    if local_sync_path(rel):
        return "local", local_root, rel

    return "other", local_root, rel or path_text


def hook_cwd(data: dict) -> Path:
    tool_input = tool_input_object(data)
    for source in (tool_input, data):
        for key in ("cwd", "workdir", "working_dir"):
            value = source.get(key)
            if value:
                return path_from_token(str(value))
    return Path.cwd()


def direct_file_path(data: dict) -> str:
    tool_input = tool_input_object(data)
    for key in ("file_path", "filePath", "path", "notebook_path"):
        value = tool_input.get(key)
        if value:
            return str(value)
    return ""


def patch_text(data: dict) -> str:
    tool_input = tool_input_object(data)
    for key in ("patch", "command", "input", "text"):
        value = tool_input.get(key)
        if value:
            return str(value)
    return ""


def paths_from_patch(text: str) -> list[str]:
    paths: list[str] = []
    for line in text.splitlines():
        for prefix in (
            "*** Add File: ",
            "*** Update File: ",
            "*** Delete File: ",
            "*** Move to: ",
        ):
            if line.startswith(prefix):
                paths.append(line.removeprefix(prefix))
                break
        else:
            if line.startswith("diff --git a/"):
                parts = line.split()
                if len(parts) >= 4:
                    old = parts[2].removeprefix("a/")
                    new = parts[3].removeprefix("b/")
                    if old != "/dev/null":
                        paths.append(old)
                    if new != "/dev/null":
                        paths.append(new)
    return paths


def paths_from_codex_input(data: dict) -> list[str]:
    paths: list[str] = []
    direct = direct_file_path(data)
    if direct:
        paths.append(direct)
    patch = patch_text(data)
    if patch:
        paths.extend(paths_from_patch(patch))
    return paths


def global_sync_message_for_path(rel: str) -> str:
    if not rel:
        return ""

    home = str(Path.home())
    if rel.startswith("claude/skills/"):
        skill = rel.removeprefix("claude/skills/").split("/", 1)[0]
        return f"claude/skills/{skill} changed; update codex/skills/{skill} in the same session."
    if rel.startswith("codex/skills/"):
        skill = rel.removeprefix("codex/skills/").split("/", 1)[0]
        return f"codex/skills/{skill} changed; update claude/skills/{skill} in the same session."
    if rel.startswith("claude/private-skills/"):
        skill = rel.removeprefix("claude/private-skills/").split("/", 1)[0]
        return f"claude/private-skills/{skill} changed; update codex/private-skills/{skill} in the same session."
    if rel.startswith("codex/private-skills/"):
        skill = rel.removeprefix("codex/private-skills/").split("/", 1)[0]
        return f"codex/private-skills/{skill} changed; update claude/private-skills/{skill} in the same session."
    if rel.startswith("claude/hooks/"):
        hook = rel.removeprefix("claude/hooks/")
        if (ROOT / "codex" / "hooks" / hook).exists():
            return f"claude/hooks/{hook} changed; update codex/hooks/{hook} and the hook registration if needed."
        return f"claude/hooks/{hook} changed; add/adjust its Codex counterpart or record why it is unsupported in {MANIFEST}."
    if rel.startswith("codex/hooks/"):
        hook = rel.removeprefix("codex/hooks/")
        if (ROOT / "claude" / "hooks" / hook).exists():
            return f"codex/hooks/{hook} changed; update claude/hooks/{hook} and ~/.claude/settings.json if registration changed."
        return f"codex/hooks/{hook} changed; add/adjust its Claude counterpart or record why it is Codex-only in {MANIFEST}."
    if rel in {f"{home}/.claude/settings.json", f"{home}/.claude/settings.local.json"}:
        return f"{rel} changed; check codex/hooks.json, codex/config.toml, codex/rules/default.rules, and {MANIFEST} for matching policy changes."
    if rel == "codex/hooks.json":
        return f"codex/hooks.json changed; update ~/.claude/settings.json and {MANIFEST} if the global hook policy changed."
    if rel == "codex/config.toml":
        return f"codex/config.toml changed; update {MANIFEST} if instruction, skill, hook registration, or MCP wiring changed."
    if rel == "codex/rules/default.rules":
        return f"codex/rules/default.rules changed; update {MANIFEST} if the Codex-only policy changed."
    if rel == GLOBAL_INSTRUCTION_CLAUDE:
        return f"{GLOBAL_INSTRUCTION_CLAUDE} changed; update {GLOBAL_INSTRUCTION_CODEX} in the same session."
    if rel == GLOBAL_INSTRUCTION_CODEX:
        return f"{GLOBAL_INSTRUCTION_CODEX} changed; update {GLOBAL_INSTRUCTION_CLAUDE} in the same session."
    return ""


def local_sync_message_for_path(rel: str, repo_root: Path) -> str:
    if not rel:
        return ""

    if Path(rel).name == "CLAUDE.md":
        counterpart = Path(rel).with_name("AGENTS.md").as_posix()
        return f"Project-local {rel} changed; update {counterpart} in the same repo."
    if Path(rel).name == "AGENTS.md":
        counterpart = Path(rel).with_name("CLAUDE.md").as_posix()
        return f"Project-local {rel} changed; update {counterpart} in the same repo."
    if rel.startswith(".claude/skills/"):
        skill = rel.removeprefix(".claude/skills/").split("/", 1)[0]
        return (
            f"Project-local .claude/skills/{skill} changed; "
            f"update .codex/skills/{skill} in the same repo."
        )
    if rel.startswith(".codex/skills/"):
        skill = rel.removeprefix(".codex/skills/").split("/", 1)[0]
        return (
            f"Project-local .codex/skills/{skill} changed; "
            f"update .claude/skills/{skill} in the same repo."
        )
    if rel.startswith(".claude/hooks/"):
        hook = rel.removeprefix(".claude/hooks/")
        if (repo_root / ".codex" / "hooks" / hook).exists():
            return (
                f"Project-local .claude/hooks/{hook} changed; "
                f"update .codex/hooks/{hook} and .codex/hooks.json if registration changed."
            )
        return (
            f"Project-local .claude/hooks/{hook} changed; "
            "add/adjust its Codex counterpart under .codex/hooks/."
        )
    if rel.startswith(".codex/hooks/"):
        hook = rel.removeprefix(".codex/hooks/")
        if (repo_root / ".claude" / "hooks" / hook).exists():
            return (
                f"Project-local .codex/hooks/{hook} changed; "
                f"update .claude/hooks/{hook} and .claude/settings.json if registration changed."
            )
        return (
            f"Project-local .codex/hooks/{hook} changed; "
            "add/adjust its Claude counterpart under .claude/hooks/."
        )
    if rel in {".claude/settings.json", ".claude/settings.local.json"}:
        return (
            f"Project-local {rel} changed; "
            "check .codex/hooks.json and .codex/config.toml for matching policy changes."
        )
    if rel == ".codex/hooks.json":
        return (
            "Project-local .codex/hooks.json changed; "
            "update .claude/settings.json if the local hook policy changed."
        )
    if rel == ".codex/config.toml":
        return (
            "Project-local .codex/config.toml changed; "
            "check .mcp.json or the Claude project config if instruction, skill, hook policy, or MCP wiring changed."
        )
    if rel == ".mcp.json":
        return "Project-local .mcp.json changed; check .codex/config.toml for matching MCP wiring."
    if rel == ".codex/rules/default.rules":
        return (
            "Project-local .codex/rules/default.rules changed; "
            "update the Claude project config if the local policy changed."
        )
    return ""


def reminder_messages(paths: Iterable[str], cwd: Path | None = None) -> list[str]:
    messages = set()
    for path in paths:
        if not path:
            continue
        kind, root, rel = sync_scope_for_path(path, cwd)
        if kind == "global":
            messages.add(global_sync_message_for_path(rel))
        elif kind == "local" and root is not None:
            messages.add(local_sync_message_for_path(rel, root))
    return sorted(message for message in messages if message)


def print_reminders(paths: Iterable[str], cwd: Path | None = None) -> None:
    for message in reminder_messages(paths, cwd):
        print(message)


def print_post_tool_context_message(messages: Iterable[str]) -> None:
    text = "\n".join(message for message in messages if message)
    if not text:
        return
    print(
        json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": "PostToolUse",
                    "additionalContext": text,
                }
            },
            indent=2,
        )
    )


def remind_claude() -> None:
    data = read_input_json()
    path = direct_file_path(data)
    if path:
        print_post_tool_context_message(reminder_messages([path], hook_cwd(data)))


def remind_codex() -> None:
    data = read_input_json()
    print_post_tool_context_message(reminder_messages(paths_from_codex_input(data), hook_cwd(data)))


def shell_tokens(command: str) -> list[str]:
    lexer = shlex.shlex(command, posix=True, punctuation_chars="();<>|&\r\n")
    lexer.whitespace = " \t"
    lexer.whitespace_split = True
    return list(lexer)


def shell_segments_with_connectors(
    tokens: list[str],
) -> list[tuple[str | None, list[str]]]:
    segments: list[tuple[str | None, list[str]]] = []
    connector: str | None = None
    current: list[str] = []
    for token in tokens:
        if set(token) <= {"&", "|", ";", "(", ")", "\r", "\n"}:
            if current:
                segments.append((connector, current))
                current = []
            connector = token.strip("\r\n") or token
            continue
        current.append(token)
    if current:
        segments.append((connector, current))
    return segments


def is_git_executable_token(token: str) -> bool:
    return "=" not in token and Path(token).name == "git"


def env_utility_command(args: list[str], depth: int = 0) -> list[str]:
    """Return env's utility argv after leading options and assignments."""
    if depth > 4:
        return []

    no_value_options = {
        "-0",
        "-i",
        "--ignore-environment",
        "-v",
        "--debug",
    }
    value_options = {
        "-u",
        "--unset",
        "-C",
        "--chdir",
        "-P",
        "--argv0",
    }
    value_prefixes = (
        "--unset=",
        "--chdir=",
        "--argv0=",
    )
    assignment = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")

    i = 0
    while i < len(args):
        arg = args[i]
        if assignment.match(arg):
            i += 1
            continue
        if arg == "--":
            return args[i + 1 :]
        if arg in no_value_options:
            i += 1
            continue
        if arg in value_options:
            if i + 1 >= len(args):
                return []
            i += 2
            continue
        if arg.startswith(value_prefixes):
            i += 1
            continue
        if arg in {"-S", "--split-string"}:
            if i + 1 >= len(args):
                return []
            try:
                expanded = shlex.split(args[i + 1], posix=True)
            except ValueError:
                return []
            return env_utility_command(expanded + args[i + 2 :], depth + 1)
        if arg.startswith("--split-string="):
            try:
                expanded = shlex.split(arg.partition("=")[2], posix=True)
            except ValueError:
                return []
            return env_utility_command(expanded + args[i + 1 :], depth + 1)
        break
    return args[i:]


def git_invocation(segment: list[str], cwd: Path) -> tuple[str, list[str], Path] | None:
    if not segment or not is_git_executable_token(segment[0]):
        return None

    args = segment[1:]
    git_cwd = cwd
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "-C" and i + 1 < len(args):
            git_cwd = path_from_token(args[i + 1], git_cwd)
            i += 2
            continue
        if arg.startswith("-C") and len(arg) > 2:
            git_cwd = path_from_token(arg[2:], git_cwd)
            i += 1
            continue
        if arg in GIT_OPTIONS_WITH_VALUE:
            i += 2
            continue
        if arg.startswith("-"):
            i += 1
            continue
        return arg, args[i + 1 :], git_cwd
    return None


def unwrap_git_command(segment: list[str]) -> tuple[list[str], str | None]:
    """Unwrap exact safe shell wrappers and flag wrappers that can alter Git."""
    if not segment:
        return segment, None
    if is_git_executable_token(segment[0]):
        return segment, None
    if segment[0] == "env":
        if len(segment) >= 2 and is_git_executable_token(segment[1]):
            return segment[1:], None
        utility = env_utility_command(segment[1:])
        if utility and is_git_executable_token(utility[0]):
            return utility, (
                "Cannot safely model wrapped git commit with environment "
                "assignments or wrapper options."
            )
        return segment, None
    if segment[0] == "command":
        if len(segment) >= 2 and is_git_executable_token(segment[1]):
            return segment[1:], None
        for index, token in enumerate(segment[1:], start=1):
            if is_git_executable_token(token):
                return segment[index:], (
                    "Cannot safely model wrapped git commit with environment "
                    "assignments or wrapper options."
                )
    if "=" in segment[0]:
        for index, token in enumerate(segment[1:], start=1):
            if is_git_executable_token(token):
                return segment[index:], (
                    "Cannot safely model wrapped git commit with environment "
                    "assignments or wrapper options."
                )
    return segment, None


def dirty_paths(
    repo: Path = ROOT,
    include_untracked: bool = True,
    include_tracked: bool = True,
) -> set[str]:
    paths: set[str] = set()
    if include_tracked:
        paths.update(git_lines(["diff", "--name-only"], repo))
        paths.update(git_lines(["diff", "--cached", "--name-only"], repo))
    if include_untracked:
        paths.update(git_lines(["ls-files", "--others", "--exclude-standard"], repo))
    return paths


def staged_paths(repo: Path = ROOT) -> set[str]:
    return set(git_lines(["diff", "--cached", "--name-only"], repo))


def git_text(args: list[str], repo: Path = ROOT) -> str | None:
    proc = run_git(args, repo)
    if proc.returncode != 0:
        return None
    return proc.stdout


def git_bytes(args: list[str], repo: Path = ROOT) -> bytes | None:
    proc = subprocess.run(
        ["git", "-C", str(repo), *args],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    return proc.stdout if proc.returncode == 0 else None


def decode_utf8(
    data: bytes,
    label: str,
    problems: list[str],
) -> str | None:
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        problems.append(f"{label} must contain UTF-8 text")
        return None


def tracked_dirty_paths(repo: Path = ROOT) -> set[str]:
    return set(git_lines(["diff", "--name-only"], repo))


def tracked_deleted_paths(repo: Path = ROOT) -> set[str]:
    paths = set(git_lines(["diff", "--name-only", "--diff-filter=D"], repo))
    paths.update(git_lines(["diff", "--cached", "--name-only", "--diff-filter=D"], repo))
    return paths


def path_has_change(path: str, changed: set[str]) -> bool:
    if path in changed:
        return True
    prefix = path.rstrip("/") + "/"
    return any(item.startswith(prefix) for item in changed)


def expand_pathspec(rel: str, changed: set[str]) -> set[str]:
    if rel in {".", ""}:
        return set(changed)
    if path_has_change(rel, changed):
        prefix = rel.rstrip("/") + "/"
        expanded = {item for item in changed if item == rel or item.startswith(prefix)}
        return expanded or {rel}
    return {rel}


def paths_from_git_add(
    args: list[str],
    git_cwd: Path,
    repo_root: Path,
    changed: set[str],
) -> tuple[set[str], str | None]:
    paths: set[str] = set()
    include_all = False
    include_tracked = False
    i = 0

    separator_index = args.index("--") if "--" in args else len(args)
    options_before_separator = args[:separator_index]
    if any(
        arg in {"--dry-run", "--refresh", "-h", "--help"}
        or (arg.startswith("-") and not arg.startswith("--") and "n" in arg[1:])
        for arg in options_before_separator
    ):
        return set(), None

    while i < len(args):
        arg = args[i]
        if arg == "--":
            i += 1
            break
        if arg in {"-A", "--all", "--no-ignore-removal"}:
            include_all = True
            i += 1
            continue
        if arg in {"-u", "--update"}:
            include_tracked = True
            i += 1
            continue
        if arg in {"--pathspec-from-file", "--pathspec-file-nul"} or arg.startswith(
            "--pathspec-from-file="
        ):
            return set(), (
                "Cannot safely model a mutating git add that reads pathspecs "
                "from a file; stage deterministic explicit paths first."
            )
        if arg in {"-i", "--interactive", "-p", "--patch", "-e", "--edit"}:
            return set(), (
                "Cannot safely model an interactive git add before commit; "
                "stage deterministic explicit paths first."
            )
        if arg in {"-N", "--intent-to-add", "--renormalize"}:
            return set(), (
                f"Cannot safely model mutating git add option {arg}; "
                "stage deterministic explicit paths first."
            )
        if arg == "--chmod":
            if i + 1 >= len(args):
                return set(), f"Cannot safely model incomplete git add option {arg}."
            i += 2
            continue
        if arg.startswith("--chmod="):
            i += 1
            continue
        if arg in {
            "-f",
            "--force",
            "--ignore-errors",
            "--no-warn-embedded-repo",
            "--sparse",
            "-v",
            "--verbose",
            "-q",
            "--quiet",
        }:
            i += 1
            continue
        if arg in {"--ignore-removal", "--no-all"}:
            return set(), (
                f"Cannot safely model git add option {arg}; "
                "stage removals explicitly first."
            )
        if arg.startswith("-"):
            return set(), (
                f"Cannot safely model git add option {arg}; "
                "stage deterministic explicit paths first."
            )
        break

    raw_paths = args[i:]
    if any(raw_path.startswith("-") for raw_path in raw_paths):
        return set(), (
            "Cannot safely model git add options placed after path arguments; "
            "stage deterministic explicit paths first."
        )
    if any(
        raw_path.startswith(":") or any(char in raw_path for char in "*?[")
        for raw_path in raw_paths
    ):
        return set(), (
            "Cannot safely model git add pathspec magic, exclusions, or globs; "
            "stage deterministic explicit paths first."
        )

    if not raw_paths:
        if include_all:
            return set(changed), None
        if include_tracked:
            return tracked_dirty_paths(repo_root), None
        return set(), None

    eligible_changes = tracked_dirty_paths(repo_root) if include_tracked else changed
    for raw_path in raw_paths:
        rel = relative_to_repo(raw_path, git_cwd, repo_root)
        if not rel or rel.startswith("/"):
            return set(), (
                f"Cannot safely resolve git add path {raw_path!r} inside the repository."
            )
        if path_has_change(rel, eligible_changes):
            paths.update(expand_pathspec(rel, eligible_changes))
    return paths, None


def is_commit_all_arg(arg: str) -> bool:
    return arg in {"-a", "--all", "-am"} or arg.startswith("-am")


def commit_content_problem(args: list[str]) -> str | None:
    """Return why a commit's content cannot be represented by the candidate index."""
    unsupported = {
        "-p",
        "--patch",
        "--interactive",
        "-i",
        "--include",
        "-o",
        "--only",
        "--pathspec-from-file",
        "--pathspec-file-nul",
    }
    options_with_values = {
        "-m",
        "--message",
        "-F",
        "--file",
        "-C",
        "--reuse-message",
        "-c",
        "--reedit-message",
        "--author",
        "--date",
        "--cleanup",
        "--fixup",
        "--squash",
        "--trailer",
        "--template",
    }
    neutral_options = {
        "-a",
        "--all",
        "--amend",
        "--allow-empty",
        "--allow-empty-message",
        "--dry-run",
        "--no-edit",
        "--no-gpg-sign",
        "--no-post-rewrite",
        "--no-status",
        "--no-verify",
        "--porcelain",
        "--quiet",
        "-q",
        "--reset-author",
        "--short",
        "--signoff",
        "-s",
        "--status",
        "--verbose",
        "-v",
    }
    value_prefixes = tuple(f"{option}=" for option in options_with_values)
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            if i + 1 < len(args):
                return "Cannot safely model git commit with positional pathspecs."
            return None
        if arg in unsupported or arg.startswith("--pathspec-from-file="):
            return f"Cannot safely model git commit content option {arg}."
        if arg in options_with_values:
            if i + 1 >= len(args):
                return f"Cannot safely model incomplete git commit option {arg}."
            i += 2
            continue
        if arg.startswith(value_prefixes):
            i += 1
            continue
        if arg == "-am":
            if i + 1 >= len(args):
                return "Cannot safely model incomplete git commit option -am."
            i += 2
            continue
        if arg.startswith("-am") and len(arg) > 3:
            i += 1
            continue
        if arg.startswith("-m") and arg != "-m":
            i += 1
            continue
        if arg in neutral_options:
            i += 1
            continue
        if arg.startswith("--gpg-sign=") or arg.startswith("-S"):
            i += 1
            continue
        if arg.startswith("-"):
            return f"Cannot safely model git commit option {arg}."
        return "Cannot safely model git commit with positional pathspecs."
    return None


def command_paths_and_commit_repos(
    command: str,
    cwd: Path,
) -> tuple[dict[Path, set[str]], set[Path], dict[Path, list[str]]]:
    try:
        tokens = shell_tokens(command)
    except ValueError:
        repo = git_root_for_dir(nearest_existing_path(cwd))
        if repo is not None and "git commit" in command:
            return {}, {repo}, {}
        return {}, set(), {}

    current_dir = cwd
    pending_paths_by_repo: dict[Path, set[str]] = {}
    pending_problems_by_repo: dict[Path, list[str]] = {}
    commit_paths_by_repo: dict[Path, set[str]] = {}
    commit_problems_by_repo: dict[Path, list[str]] = {}
    commit_repos: set[Path] = set()
    dirty_cache: dict[Path, set[str]] = {}

    def repo_dirty(repo: Path) -> set[str]:
        if repo not in dirty_cache:
            dirty_cache[repo] = dirty_paths(repo)
        return dirty_cache[repo]

    planning_add_seen = False
    planning_chain_safe = True
    safe_prefix = True

    for connector, segment in shell_segments_with_connectors(tokens):
        if segment and segment[0] == "cd" and len(segment) >= 2:
            if planning_add_seen:
                planning_chain_safe = False
            current_dir = path_from_token(segment[1], current_dir)
            continue

        segment, wrapper_problem = unwrap_git_command(segment)
        invocation = git_invocation(segment, current_dir)
        if invocation is None:
            if planning_add_seen:
                planning_chain_safe = False
            else:
                safe_prefix = False
            continue

        command_name, args, git_cwd = invocation
        repo = git_root_for_dir(nearest_existing_path(git_cwd))
        if repo is None:
            continue
        if command_name == "add":
            if planning_add_seen and connector != "&&":
                planning_chain_safe = False
            planning_add_seen = True
            if wrapper_problem:
                planned, problem = set(), wrapper_problem
            else:
                planned, problem = paths_from_git_add(
                    args, git_cwd, repo, repo_dirty(repo)
                )
            pending_paths_by_repo.setdefault(repo, set()).update(planned)
            if problem:
                pending_problems_by_repo.setdefault(repo, []).append(problem)
            if not safe_prefix:
                planning_chain_safe = False
        elif command_name == "commit":
            if repo in commit_repos:
                commit_problems_by_repo.setdefault(repo, []).append(
                    "Cannot safely model multiple git commits in one guarded command."
                )
                continue
            commit_repos.add(repo)
            commit_paths = set(pending_paths_by_repo.get(repo, set()))
            commit_problems_by_repo[repo] = list(
                pending_problems_by_repo.get(repo, [])
            )
            if wrapper_problem:
                commit_problems_by_repo[repo].append(wrapper_problem)
            if commit_paths or commit_problems_by_repo[repo]:
                if connector != "&&" or not planning_chain_safe:
                    commit_problems_by_repo[repo].append(
                        "Cannot safely model git add content unless deterministic "
                        "adds lead directly to git commit through &&."
                    )
                    commit_paths.clear()
            commit_problem = commit_content_problem(args)
            if commit_problem:
                commit_problems_by_repo[repo].append(commit_problem)
            commit_paths_by_repo[repo] = commit_paths
            if any(is_commit_all_arg(arg) for arg in args):
                commit_paths_by_repo[repo].update(tracked_dirty_paths(repo))
        elif planning_add_seen:
            planning_chain_safe = False
        else:
            safe_prefix = False

    return commit_paths_by_repo, commit_repos, commit_problems_by_repo


def skip_runtime_path(path: str) -> bool:
    return any(fnmatch.fnmatchcase(path, pattern) for pattern in RUNTIME_PATTERNS)


@dataclass(frozen=True)
class PairedArtifactRoot:
    side: str
    counterpart_side: str
    path: str
    counterpart: str


def paired_artifact_root_for_path(path: str) -> PairedArtifactRoot | None:
    parts = Path(path).parts
    if not parts:
        return None

    if path == GLOBAL_INSTRUCTION_CLAUDE:
        return PairedArtifactRoot("Claude", "Codex", path, GLOBAL_INSTRUCTION_CODEX)
    if path == GLOBAL_INSTRUCTION_CODEX:
        return PairedArtifactRoot("Codex", "Claude", path, GLOBAL_INSTRUCTION_CLAUDE)

    if parts[0] in {"claude", "codex"} and len(parts) >= 3:
        side, counterpart_side, counterpart_root = (
            ("Claude", "Codex", "codex")
            if parts[0] == "claude"
            else ("Codex", "Claude", "claude")
        )
        if parts[1] in {"skills", "programmatic-skills", "private-skills"}:
            artifact = Path(parts[0], parts[1], parts[2]).as_posix()
            counterpart = Path(counterpart_root, parts[1], parts[2]).as_posix()
            return PairedArtifactRoot(side, counterpart_side, artifact, counterpart)
        if parts[1] == "hooks":
            artifact = Path(parts[0], parts[1], *parts[2:]).as_posix()
            counterpart = Path(counterpart_root, parts[1], *parts[2:]).as_posix()
            return PairedArtifactRoot(side, counterpart_side, artifact, counterpart)

    for index, part in enumerate(parts):
        if part not in {".claude", ".codex"}:
            continue
        if index + 1 >= len(parts):
            return None

        side, counterpart_side, counterpart_dir = (
            ("Claude", "Codex", ".codex")
            if part == ".claude"
            else ("Codex", "Claude", ".claude")
        )
        prefix = parts[:index]
        if parts[index + 1] in {"skills", "programmatic-skills"} and index + 3 < len(parts):
            artifact = Path(*prefix, part, parts[index + 1], parts[index + 2]).as_posix()
            counterpart = Path(
                *prefix,
                counterpart_dir,
                parts[index + 1],
                parts[index + 2],
            ).as_posix()
            return PairedArtifactRoot(side, counterpart_side, artifact, counterpart)
        if parts[index + 1] == "hooks" and index + 2 < len(parts):
            artifact = Path(*prefix, part, parts[index + 1], *parts[index + 2 :]).as_posix()
            counterpart = Path(
                *prefix,
                counterpart_dir,
                parts[index + 1],
                *parts[index + 2 :],
            ).as_posix()
            return PairedArtifactRoot(side, counterpart_side, artifact, counterpart)
        if part == ".claude" and parts[index + 1] == "settings.json":
            artifact = Path(*prefix, ".claude", "settings.json").as_posix()
            counterpart = Path(*prefix, ".codex", "hooks.json").as_posix()
            return PairedArtifactRoot(side, counterpart_side, artifact, counterpart)
        if part == ".codex" and parts[index + 1] == "hooks.json":
            artifact = Path(*prefix, ".codex", "hooks.json").as_posix()
            counterpart = Path(*prefix, ".claude", "settings.json").as_posix()
            return PairedArtifactRoot(side, counterpart_side, artifact, counterpart)

    if Path(path).name == "CLAUDE.md":
        return PairedArtifactRoot("Claude", "Codex", path, Path(path).with_name("AGENTS.md").as_posix())
    if Path(path).name == "AGENTS.md":
        return PairedArtifactRoot("Codex", "Claude", path, Path(path).with_name("CLAUDE.md").as_posix())
    return None


def tracked_root_has_non_deleted_files(repo: Path, root: str, deleted_paths: set[str]) -> bool:
    tracked = set(git_lines(["ls-files", "--", root], repo))
    return any(path not in deleted_paths for path in tracked)


def audit_tracked_pair_deletions(problems: list[str], repo: Path = ROOT) -> None:
    deleted_paths = tracked_deleted_paths(repo)
    reported: set[tuple[str, str]] = set()
    for path in sorted(deleted_paths):
        if skip_runtime_path(path):
            continue
        artifact = paired_artifact_root_for_path(path)
        if artifact is None:
            continue
        key = (artifact.path, artifact.counterpart)
        if key in reported:
            continue
        if not tracked_root_has_non_deleted_files(repo, artifact.counterpart, deleted_paths):
            continue
        reported.add(key)
        add_problem(
            problems,
            f"Tracked paired artifact deleted on {artifact.side} side while "
            f"{artifact.counterpart_side} side remains: {artifact.path} -> {artifact.counterpart}",
        )


def has_changed_prefix(prefix: str, paths: set[str], changed: set[str]) -> bool:
    prefix = prefix.rstrip("/") + "/"
    for path in paths:
        if path.startswith(prefix) and path_has_change(path, changed):
            return True
    return False


def parse_manifest_text(text: str, label: str, problems: list[str]) -> dict:
    try:
        manifest = json.loads(text)
    except json.JSONDecodeError as exc:
        problems.append(f"{label} is not valid JSON: {exc}")
        return {}
    if not isinstance(manifest, dict):
        problems.append(f"{label} must contain a top-level JSON object")
        return {}

    for section in (
        "hooks",
        "instructions",
        "mcp_servers",
        "private_skills",
        "registrations",
        "skills",
    ):
        items = manifest.get(section)
        if items is None:
            continue
        if not isinstance(items, list):
            problems.append(f"{label} section {section} must be a JSON array")
            manifest[section] = []
            continue
        valid_items = []
        for index, item in enumerate(items):
            if not isinstance(item, dict):
                problems.append(
                    f"{label} section {section} entry {index} must be a JSON object"
                )
                continue
            valid_items.append(item)
        manifest[section] = valid_items
    return manifest


def manifest_text_from_head(
    manifest: str = MANIFEST,
    manifest_path: Path = MANIFEST_PATH,
    problems: list[str] | None = None,
) -> str:
    data = git_bytes(["show", f"HEAD:{manifest}"])
    if data is not None:
        sink = problems if problems is not None else []
        return decode_utf8(data, f"HEAD:{manifest}", sink) or "{}"
    if manifest_path.exists():
        try:
            data = manifest_path.read_bytes()
        except OSError:
            return "{}"
        sink = problems if problems is not None else []
        return decode_utf8(data, str(manifest_path), sink) or "{}"
    return "{}"


def changed_manifest(
    manifest: str,
    manifest_path: Path,
    command_paths: set[str],
    staged: set[str],
    problems: list[str],
    candidate_tree: CommitCandidateTree | None = None,
) -> tuple[dict, dict]:
    base_text = manifest_text_from_head(manifest, manifest_path, problems)
    base = parse_manifest_text(base_text, f"HEAD:{manifest}", problems)

    candidate_changed = path_has_change(manifest, command_paths) or path_has_change(
        manifest, staged
    )
    if candidate_changed and candidate_tree is not None:
        candidate = candidate_manifest_from_tree(
            candidate_tree,
            manifest,
            f"candidate {manifest}",
            problems,
            allow_absent=False,
        )
        return base, candidate

    if path_has_change(manifest, command_paths):
        try:
            data = manifest_path.read_bytes()
        except OSError:
            data = b""
        candidate_text = decode_utf8(data, manifest, problems) or "{}"
        label = manifest
    elif path_has_change(manifest, staged):
        data = git_bytes(["show", f":{manifest}"])
        if data is None:
            problems.append(f"Could not read staged {manifest}")
            candidate_text = base_text
        else:
            candidate_text = decode_utf8(data, f"staged {manifest}", problems) or "{}"
        label = f"staged {manifest}"
    else:
        candidate_text = base_text
        label = f"HEAD:{manifest}"

    candidate = parse_manifest_text(candidate_text, label, problems)
    return base, candidate


def guard_manifests(
    command_paths: set[str],
    staged: set[str],
    problems: list[str],
    candidate_tree: CommitCandidateTree | None = None,
) -> tuple[dict, dict, dict, dict]:
    base, candidate = changed_manifest(
        MANIFEST,
        MANIFEST_PATH,
        command_paths,
        staged,
        problems,
        candidate_tree,
    )
    if PRIVATE_MANIFEST_PATH.exists():
        private_candidate = parse_manifest_text(
            PRIVATE_MANIFEST_PATH.read_text(), PRIVATE_MANIFEST, problems
        )
    else:
        private_candidate = {}
    return base, candidate, {}, private_candidate


def manifest_items(manifest: dict, section: str) -> list[dict]:
    if not isinstance(manifest, dict):
        return []
    items = manifest.get(section)
    if not isinstance(items, list):
        return []
    return [item for item in items if isinstance(item, dict)]


def manifest_item_by_name(manifest: dict, section: str, name: str) -> dict | None:
    for item in manifest_items(manifest, section):
        if item.get("name") == name:
            return item
    return None


def manifest_registration(manifest: dict, path: str) -> dict | None:
    for item in manifest_items(manifest, "registrations"):
        if item.get("path") == path:
            return item
    return None


def manifest_item_is_paired(item: dict | None) -> bool:
    if not item:
        return False
    status = str(item.get("status") or "")
    return bool(item.get("claude") and item.get("codex") and status.startswith(PEER_STATUS_PREFIXES))


def manifest_item_is_registered_pair(item: dict | None) -> bool:
    if not item:
        return False
    return bool(item.get("claude") and item.get("codex") and item.get("status") in REGISTERED_PAIR_STATUSES)


def manifest_item_is_explicitly_unpaired(item: dict | None) -> bool:
    if not item:
        return False
    status = str(item.get("status") or "")
    return bool(status) and not status.startswith(PEER_STATUS_PREFIXES)


def manifest_registration_changed(base: dict, candidate: dict, path: str) -> bool:
    return manifest_registration(base, path) != manifest_registration(candidate, path)


def manifest_item_changed(base: dict, candidate: dict, section: str, name: str) -> bool:
    return manifest_item_by_name(base, section, name) != manifest_item_by_name(candidate, section, name)


def manifest_skill_removed(base: dict, candidate: dict, skill: str) -> bool:
    return (
        manifest_item_by_name(base, "skills", skill) is not None
        and manifest_item_by_name(candidate, "skills", skill) is None
    )


def global_skill_files_absent(skill: str) -> bool:
    return not (ROOT / "claude" / "skills" / skill / "SKILL.md").exists() and not (
        ROOT / "codex" / "skills" / skill / "SKILL.md"
    ).exists()


def paired_skill_sync_problems(skill: str, claude_base: str, codex_base: str, label: str) -> list[str]:
    problems: list[str] = []
    claude_dir = ROOT / claude_base / skill
    codex_dir = ROOT / codex_base / skill
    claude_skill = claude_dir / "SKILL.md"
    codex_skill = codex_dir / "SKILL.md"

    if not claude_skill.exists():
        problems.append(f"Missing Claude {label} file: {claude_base}/{skill}/SKILL.md")
    if not codex_skill.exists():
        problems.append(f"Missing Codex {label} file: {codex_base}/{skill}/SKILL.md")
    if problems:
        return problems

    if normalized_skill_text(claude_skill) != normalized_skill_text(codex_skill):
        problems.append(f"{label.capitalize()} content drift after tool-specific frontmatter normalization: {skill}")

    claude_aux = skill_aux_files(claude_dir)
    codex_aux = skill_aux_files(codex_dir)
    for rel in sorted(set(claude_aux) - set(codex_aux)):
        problems.append(f"Auxiliary {label} file only in Claude tree: {skill}/{rel}")
    for rel in sorted(set(codex_aux) - set(claude_aux)):
        problems.append(f"Auxiliary {label} file only in Codex tree: {skill}/{rel}")
    for rel in sorted(set(claude_aux) & set(codex_aux)):
        if not filecmp.cmp(claude_aux[rel], codex_aux[rel], shallow=False):
            problems.append(f"Auxiliary {label} file drift: {skill}/{rel}")

    return problems


def explicit_skill_sync_problems(name: str, claude_rel: str, codex_rel: str, label: str) -> list[str]:
    problems: list[str] = []
    claude_skill = ROOT / claude_rel
    codex_skill = ROOT / codex_rel
    claude_dir = claude_skill.parent
    codex_dir = codex_skill.parent

    if not claude_skill.exists():
        problems.append(f"Missing Claude {label} file: {claude_rel}")
    if not codex_skill.exists():
        problems.append(f"Missing Codex {label} file: {codex_rel}")
    if problems:
        return problems

    if normalized_skill_text(claude_skill) != normalized_skill_text(codex_skill):
        problems.append(f"{label.capitalize()} content drift after tool-specific frontmatter normalization: {name}")

    claude_aux = skill_aux_files(claude_dir)
    codex_aux = skill_aux_files(codex_dir)
    for rel in sorted(set(claude_aux) - set(codex_aux)):
        problems.append(f"Auxiliary {label} file only in Claude tree: {name}/{rel}")
    for rel in sorted(set(codex_aux) - set(claude_aux)):
        problems.append(f"Auxiliary {label} file only in Codex tree: {name}/{rel}")
    for rel in sorted(set(claude_aux) & set(codex_aux)):
        if not filecmp.cmp(claude_aux[rel], codex_aux[rel], shallow=False):
            problems.append(f"Auxiliary {label} file drift: {name}/{rel}")

    return problems


def skill_sync_problems(skill: str) -> list[str]:
    return paired_skill_sync_problems(skill, "claude/skills", "codex/skills", "skill")


def project_local_skill_sync_problems(skill: str) -> list[str]:
    """Compare a repo-root .claude/.codex skill pair, evaluation files included."""
    claude_skill = ROOT / ".claude" / "skills" / skill / "SKILL.md"
    codex_skill = ROOT / ".codex" / "skills" / skill / "SKILL.md"
    if not claude_skill.exists() and not codex_skill.exists():
        return []
    return paired_skill_sync_problems(
        skill, ".claude/skills", ".codex/skills", "project-local skill"
    )


def private_skill_sync_problems(skill: str) -> list[str]:
    return paired_skill_sync_problems(
        skill, "claude/private-skills", "codex/private-skills", "private skill"
    )


def private_skill_item_sync_problems(item: dict) -> list[str]:
    return explicit_skill_sync_problems(
        item["name"], item["claude"], item["codex"], "private skill"
    )


def private_skill_pair_removed(dir_name: str, paths: set[str], changed: set[str]) -> bool:
    """True when a private skill directory was deleted on both sides in this
    change set. That is the un-privatize/retire path (e.g. the skill moved to
    the tracked public skills tree), so the missing private-manifest entry is
    expected rather than an error."""
    for side in ("claude", "codex"):
        prefix = f"{side}/private-skills/{dir_name}"
        if (ROOT / prefix).exists():
            return False
        if not has_changed_prefix(prefix, paths, changed):
            return False
    return True


def private_skill_item_for_path(manifest: dict, path: str, side: str) -> dict | None:
    for item in manifest_items(manifest, "private_skills"):
        rel = item.get(side)
        if not rel:
            continue
        private_dir = str(Path(rel).parent).rstrip("/") + "/"
        if path == rel or path.startswith(private_dir):
            return item
    return None


def local_skill_sync_problems(repo_root: Path, skill: str, skill_root: str = "skills") -> list[str]:
    problems: list[str] = []
    claude_dir = repo_root / ".claude" / skill_root / skill
    codex_dir = repo_root / ".codex" / skill_root / skill
    claude_skill = claude_dir / "SKILL.md"
    codex_skill = codex_dir / "SKILL.md"

    if not claude_skill.exists():
        problems.append(
            f"Missing Claude project-local skill file: .claude/{skill_root}/{skill}/SKILL.md"
        )
    if not codex_skill.exists():
        problems.append(
            f"Missing Codex project-local skill file: .codex/{skill_root}/{skill}/SKILL.md"
        )
    if problems:
        return problems

    if normalized_skill_text(claude_skill) != normalized_skill_text(codex_skill):
        problems.append(
            f"Project-local skill content drift after tool-specific frontmatter normalization: {skill}"
        )

    claude_aux = skill_aux_files(claude_dir)
    codex_aux = skill_aux_files(codex_dir)
    for rel in sorted(set(claude_aux) - set(codex_aux)):
        problems.append(f"Auxiliary project-local skill file only in Claude tree: {skill}/{rel}")
    for rel in sorted(set(codex_aux) - set(claude_aux)):
        problems.append(f"Auxiliary project-local skill file only in Codex tree: {skill}/{rel}")
    for rel in sorted(set(claude_aux) & set(codex_aux)):
        if not filecmp.cmp(claude_aux[rel], codex_aux[rel], shallow=False):
            problems.append(f"Auxiliary project-local skill file drift: {skill}/{rel}")

    return problems


def contained_non_symlink_regular_file(repo_root: Path, relative: str) -> bool:
    """Return whether `relative` is a regular file below `repo_root` without symlinks."""
    try:
        resolved_root = repo_root.resolve(strict=True)
        candidate = repo_root
        for part in relative.split("/"):
            candidate = candidate / part
            if candidate.is_symlink():
                return False
        if not candidate.is_file():
            return False
        candidate.resolve(strict=True).relative_to(resolved_root)
    except (OSError, RuntimeError, ValueError):
        return False
    return True


@dataclass(frozen=True)
class CommitCandidateTree:
    """The tree a guarded commit would create: index plus planned git-add paths."""

    repo_root: Path
    planned_paths: frozenset[str]

    @cached_property
    def index_entries(self) -> dict[str, tuple[str, str, str] | None]:
        proc = run_git(["ls-files", "--stage", "-z"], self.repo_root)
        if proc.returncode != 0:
            return {}
        entries: dict[str, tuple[str, str, str] | None] = {}
        for record in (item for item in proc.stdout.split("\0") if item):
            metadata, separator, path = record.partition("\t")
            fields = metadata.split()
            if not separator or len(fields) != 3:
                continue
            entry = (fields[0], fields[1], fields[2])
            entries[path] = None if path in entries else entry
        return entries

    def path_exists(self, relative: str) -> bool:
        if relative in self.planned_paths:
            return os.path.lexists(self.repo_root / relative)
        return relative in self.index_entries

    def is_regular_file(self, relative: str) -> bool:
        if relative in self.planned_paths:
            return contained_non_symlink_regular_file(self.repo_root, relative)
        entry = self.index_entries.get(relative)
        if entry is None:
            return False
        mode, _object_id, stage = entry
        return mode in {"100644", "100755"} and stage == "0"

    def regular_files_under(self, relative_dir: str) -> set[str]:
        prefix = relative_dir.rstrip("/") + "/"
        paths = {
            path
            for path, entry in self.index_entries.items()
            if path.startswith(prefix)
            and entry is not None
            and entry[0] in {"100644", "100755"}
            and entry[2] == "0"
        }
        for path in self.planned_paths:
            if not path.startswith(prefix):
                continue
            if contained_non_symlink_regular_file(self.repo_root, path):
                paths.add(path)
            else:
                paths.discard(path)
        return paths

    def nonregular_files_under(self, relative_dir: str) -> set[str]:
        prefix = relative_dir.rstrip("/") + "/"
        paths = {
            path
            for path, entry in self.index_entries.items()
            if path.startswith(prefix)
            and (
                entry is None
                or entry[0] not in {"100644", "100755"}
                or entry[2] != "0"
            )
        }
        for path in self.planned_paths:
            if not path.startswith(prefix):
                continue
            paths.discard(path)
            if self.path_exists(path) and not contained_non_symlink_regular_file(
                self.repo_root, path
            ):
                paths.add(path)
        return paths

    def read_regular_file_bytes(self, relative: str) -> bytes | None:
        if not self.is_regular_file(relative):
            return None
        if relative in self.planned_paths:
            try:
                return (self.repo_root / relative).read_bytes()
            except OSError:
                return None
        entry = self.index_entries.get(relative)
        if entry is None:
            return None
        proc = subprocess.run(
            ["git", "-C", str(self.repo_root), "cat-file", "blob", entry[1]],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        return proc.stdout if proc.returncode == 0 else None

    def read_regular_file(self, relative: str) -> str | None:
        data = self.read_regular_file_bytes(relative)
        if data is None:
            return None
        try:
            return data.decode()
        except UnicodeDecodeError:
            return None


def is_skill_auxiliary_relative(rel: str) -> bool:
    if rel == "SKILL.md" or Path(rel).name == ".DS_Store":
        return False
    if rel.startswith(("digests/", "last-run/", "vetted/")):
        return False
    return "node_modules/" not in rel


def candidate_skill_aux_files(
    candidate_tree: CommitCandidateTree,
    skill_dir: str,
) -> dict[str, bytes | None]:
    files: dict[str, bytes | None] = {}
    prefix = skill_dir.rstrip("/") + "/"
    for path in candidate_tree.regular_files_under(skill_dir):
        rel = path.removeprefix(prefix)
        if not is_skill_auxiliary_relative(rel):
            continue
        files[rel] = candidate_tree.read_regular_file_bytes(path)
    return files


def candidate_nonregular_skill_aux_files(
    candidate_tree: CommitCandidateTree,
    skill_dir: str,
) -> set[str]:
    prefix = skill_dir.rstrip("/") + "/"
    return {
        path.removeprefix(prefix)
        for path in candidate_tree.nonregular_files_under(skill_dir)
        if is_skill_auxiliary_relative(path.removeprefix(prefix))
    }


def candidate_local_skill_sync_problems(
    candidate_tree: CommitCandidateTree,
    skill: str,
    skill_root: str = "skills",
) -> list[str]:
    problems: list[str] = []
    claude_dir = f".claude/{skill_root}/{skill}"
    codex_dir = f".codex/{skill_root}/{skill}"
    claude_path = f"{claude_dir}/SKILL.md"
    codex_path = f"{codex_dir}/SKILL.md"
    claude_text = candidate_tree.read_regular_file(claude_path)
    codex_text = candidate_tree.read_regular_file(codex_path)

    if claude_text is None:
        problems.append(f"Missing Claude project-local skill file: {claude_path}")
    if codex_text is None:
        problems.append(f"Missing Codex project-local skill file: {codex_path}")
    if problems:
        return problems

    if normalized_skill_content(claude_text) != normalized_skill_content(codex_text):
        problems.append(
            "Project-local skill content drift after tool-specific frontmatter "
            f"normalization: {skill}"
        )

    for side, skill_dir in (("Claude", claude_dir), ("Codex", codex_dir)):
        for rel in sorted(candidate_nonregular_skill_aux_files(candidate_tree, skill_dir)):
            problems.append(
                "Auxiliary project-local skill file is not regular on "
                f"{side} side: {skill}/{rel}"
            )

    claude_aux = candidate_skill_aux_files(candidate_tree, claude_dir)
    codex_aux = candidate_skill_aux_files(candidate_tree, codex_dir)
    for rel in sorted(set(claude_aux) - set(codex_aux)):
        problems.append(
            f"Auxiliary project-local skill file only in Claude tree: {skill}/{rel}"
        )
    for rel in sorted(set(codex_aux) - set(claude_aux)):
        problems.append(
            f"Auxiliary project-local skill file only in Codex tree: {skill}/{rel}"
        )
    for rel in sorted(set(claude_aux) & set(codex_aux)):
        if (
            claude_aux[rel] is None
            or codex_aux[rel] is None
            or claude_aux[rel] != codex_aux[rel]
        ):
            problems.append(
                f"Auxiliary project-local skill file drift: {skill}/{rel}"
            )
    return problems


def candidate_manifest_from_tree(
    candidate_tree: CommitCandidateTree,
    relative: str,
    label: str,
    problems: list[str],
    *,
    allow_absent: bool,
) -> dict:
    if not candidate_tree.path_exists(relative):
        if not allow_absent:
            problems.append(f"{label} is missing from the candidate commit")
        return {}
    if not candidate_tree.is_regular_file(relative):
        problems.append(f"{label} must be a regular file in the candidate commit")
        return {}
    data = candidate_tree.read_regular_file_bytes(relative)
    if data is None:
        problems.append(f"Could not read {label} from the candidate commit")
        return {}
    text = decode_utf8(data, label, problems)
    if text is None:
        return {}
    return parse_manifest_text(text, label, problems)


def candidate_local_manifest(
    candidate_tree: CommitCandidateTree,
    problems: list[str],
) -> dict:
    """Return the local manifest from the guarded commit's candidate tree."""
    return candidate_manifest_from_tree(
        candidate_tree,
        MANIFEST,
        f"candidate {MANIFEST}",
        problems,
        allow_absent=True,
    )


def local_skill_readme_problems(
    changed_paths: set[str],
    skill: str,
    skill_root: str,
    repo_root: Path,
    manifest: dict | None = None,
    candidate_tree: CommitCandidateTree | None = None,
) -> list[str]:
    owner, mode = local_skill_documentation_policy(repo_root, manifest)
    generated_dotfiles_inventory = (
        mode == "generated"
        and owner == "agents/skill-inventory.org"
        and same_git_repository(repo_root, ROOT)
    )
    owner_is_regular = (
        candidate_tree.is_regular_file(owner)
        if candidate_tree is not None
        else contained_non_symlink_regular_file(repo_root, owner)
    )
    if generated_dotfiles_inventory or (
        owner in changed_paths
        and owner_is_regular
    ):
        return []
    return [
        f"Project-local {skill_root}/{skill} changed without documentation owner "
        f"{owner} in the same repo. Update {owner} in the same commit."
    ]


def local_manifest(repo_root: Path) -> dict:
    """Read a project-local ai-config-sync.json marker, or {} if absent/unreadable.

    Parse failures fail closed (return {}) so a malformed marker never silently
    suppresses the guard — enforcement stays on until the marker is valid.
    """
    path = repo_root / MANIFEST
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text())
    except (json.JSONDecodeError, OSError):
        return {}
    return data if isinstance(data, dict) else {}


def local_skill_documentation_policy(
    repo_root: Path,
    manifest: dict | None = None,
) -> tuple[str, str]:
    """Return the validated project-local skill documentation owner and mode."""
    default = ("README.org", "manual")
    source = local_manifest(repo_root) if manifest is None else manifest
    policy = source.get("policy")
    if not isinstance(policy, dict):
        return default

    owner = policy.get("project_local_documentation_owner", default[0])
    if not isinstance(owner, str) or not owner:
        return default
    if "\\" in owner or owner.startswith("/") or re.match(r"^[A-Za-z]:", owner):
        return default
    parts = owner.split("/")
    if any(part in {"", ".", ".."} for part in parts):
        return default

    mode = policy.get("project_local_documentation_mode", default[1])
    if not isinstance(mode, str) or mode not in {"manual", "generated"}:
        mode = default[1]
    return owner, mode


def local_artifact_single_agent(
    repo_root: Path,
    artifact: str,
    manifest: dict | None = None,
) -> bool:
    """True when the repo's ai-config-sync.json marks `artifact` (e.g. "skills")
    as deliberately single-agent, suppressing the counterpart and documentation
    guards for that artifact type in THIS repo only.

    Marker shape (repo root):
        { "local": { "skills": "claude-only" } }
    Any non-empty status that does not start with "paired" (the
    `manifest_item_is_explicitly_unpaired` convention) counts as an opt-out, so
    "claude-only" / "codex-only" both suppress. Default (no marker) = enforce, so
    a new skill is still forced to create its counterpart everywhere else.
    """
    source = local_manifest(repo_root) if manifest is None else manifest
    local = source.get("local")
    if not isinstance(local, dict):
        return False
    status = str(local.get(artifact) or "")
    return bool(status) and not status.startswith(PEER_STATUS_PREFIXES)


def local_skill_moved_between_roots(
    repo_root: Path,
    changed_paths: set[str],
    skill: str,
    source_root: str,
    target_root: str,
    candidate_tree: CommitCandidateTree | None = None,
) -> bool:
    source_claude = f".claude/{source_root}/{skill}/SKILL.md"
    source_codex = f".codex/{source_root}/{skill}/SKILL.md"
    if candidate_tree is not None:
        source_exists = candidate_tree.path_exists(
            source_claude
        ) or candidate_tree.path_exists(source_codex)
    else:
        source_exists = (repo_root / source_claude).exists() or (
            repo_root / source_codex
        ).exists()
    if source_exists:
        return False
    target_claude = f".claude/{target_root}/{skill}"
    target_codex = f".codex/{target_root}/{skill}"
    if not (
        has_changed_prefix(target_claude, changed_paths, changed_paths)
        and has_changed_prefix(target_codex, changed_paths, changed_paths)
    ):
        return False
    if candidate_tree is not None:
        return not candidate_local_skill_sync_problems(
            candidate_tree, skill, target_root
        )
    return not local_skill_sync_problems(repo_root, skill, target_root)


def local_skill_removed(
    repo_root: Path,
    skill: str,
    skill_root: str = "skills",
    candidate_tree: CommitCandidateTree | None = None,
) -> bool:
    claude_skill = f".claude/{skill_root}/{skill}/SKILL.md"
    codex_skill = f".codex/{skill_root}/{skill}/SKILL.md"
    if candidate_tree is not None:
        return not candidate_tree.path_exists(
            claude_skill
        ) and not candidate_tree.path_exists(codex_skill)
    return not (repo_root / claude_skill).exists() and not (
        repo_root / codex_skill
    ).exists()


def normalized_project_instruction_text(path: Path) -> str:
    text = path.read_text()
    text = re.sub(r"(?m)^@(\S+)[ \t]*$", r"`\1`", text)
    return "\n".join(line.rstrip() for line in text.splitlines()).strip() + "\n"


def codex_project_instruction_text_from_claude(path: Path) -> str:
    text = path.read_text()
    text = re.sub(r"(?m)^@(\S+)[ \t]*$", r"`\1`", text)
    if not text.endswith("\n"):
        text += "\n"
    return text


def local_instruction_sync_problems(repo_root: Path, rel_dir: str = ".") -> list[str]:
    problems: list[str] = []
    base_dir = repo_root if rel_dir in {"", "."} else repo_root / rel_dir
    claude_path = base_dir / "CLAUDE.md"
    codex_path = base_dir / "AGENTS.md"
    claude_rel = claude_path.relative_to(repo_root).as_posix()
    codex_rel = codex_path.relative_to(repo_root).as_posix()

    if not claude_path.exists() and not codex_path.exists():
        return problems
    if not claude_path.exists():
        problems.append(f"Missing project-local instruction file: {claude_rel}")
    if not codex_path.exists():
        problems.append(f"Missing project-local instruction file: {codex_rel}")
    if problems:
        return problems

    if normalized_project_instruction_text(claude_path) != normalized_project_instruction_text(codex_path):
        problems.append(
            f"Project-local instruction drift after tool-specific normalization: {claude_rel} / {codex_rel}"
        )
    return problems


def normalized_global_instruction_text(path: Path) -> str:
    text = path.read_text()
    root_text = str(ROOT)
    text = text.replace("# Global Claude Code conventions", "# Global agent conventions")
    text = text.replace("# Global Codex conventions", "# Global agent conventions")
    text = text.replace(f"{root_text}/", "")
    text = text.replace("`claude/context/mcp-servers.md`", "`context/mcp-servers.md`")
    text = text.replace("`claude/context/google-services.md`", "`context/google-services.md`")
    text = text.replace("`claude/context/secrets.md`", "`context/secrets.md`")
    text = text.replace("`claude/context/voice.md`", "`context/voice.md`")
    codex_secrets_rule = (
        "- **Secrets:** Read `context/secrets.md` before handling secrets. "
        "In particular, never echo or print secrets from `pass`, `.zshenv-secrets`, or MCP credential resolution; "
        "use full `pass` paths and `pass find`, not `pass ls` grep."
    )
    text = text.replace(codex_secrets_rule, "- @context/secrets.md")
    claude_self_serve_clause = (
        "including browser automation: if the session lacks browser tools, ask me to enable "
        "`claude-in-chrome` (type `/chrome`, or restart with `--chrome`) rather than asking me "
        "to perform the browser steps manually."
    )
    codex_self_serve_clause = "including browser automation where the session provides it."
    text = text.replace(claude_self_serve_clause, codex_self_serve_clause)
    return text


def global_instruction_sync_problems() -> list[str]:
    problems: list[str] = []
    codex_path = ROOT / GLOBAL_INSTRUCTION_CODEX
    if not (ROOT / GLOBAL_INSTRUCTION_CLAUDE).exists():
        problems.append(f"Missing Claude global instruction file: {GLOBAL_INSTRUCTION_CLAUDE}")
    if not codex_path.exists():
        problems.append(f"Missing Codex global instruction file: {GLOBAL_INSTRUCTION_CODEX}")
    if problems:
        return problems

    if normalized_global_instruction_text(ROOT / GLOBAL_INSTRUCTION_CLAUDE) != normalized_global_instruction_text(codex_path):
        problems.append("Global instruction semantic drift after tool-specific normalization.")
    actual_codex = codex_path.read_text()
    for forbidden in ("@context/", "`context/"):
        if forbidden in actual_codex:
            problems.append(f"Codex global instructions contain unresolved relative context reference: {forbidden}")
    return problems


def add_nested_problems(problems: list[str], header: str, nested: list[str]) -> None:
    problems.append(header)
    problems.extend(f"  - {problem}" for problem in nested)


def guard_changed_paths(
    repo_root: Path,
    changed_paths: set[str],
    paths: set[str],
    changed: set[str],
    problems: list[str],
    include_global: bool,
    base_manifest: dict,
    candidate_manifest: dict,
    base_private_manifest: dict,
    candidate_private_manifest: dict,
    local_candidate_manifest: dict | None = None,
    candidate_tree: CommitCandidateTree | None = None,
) -> None:
    processed_global_instructions = False
    processed_global_skills: set[str] = set()
    processed_global_private_skills: set[str] = set()
    processed_global_hooks: set[str] = set()
    processed_local_instruction_dirs: set[str] = set()
    processed_local_skills: set[str] = set()
    processed_local_hooks: set[str] = set()

    # Project-local opt-out: a repo may declare its skills single-agent (no
    # Claude<->Codex mirror) via ai-config-sync.json. Default is enforce, so a
    # new skill is still forced to create its counterpart unless this is set.
    local_skills_single_agent = local_artifact_single_agent(
        repo_root, "skills", local_candidate_manifest
    )
    # Same opt-out for instruction files: an upstream repo that deliberately
    # keeps only AGENTS.md (or only CLAUDE.md) must not be forced to grow the
    # counterpart just because a local commit touches the file. Marker:
    #     { "local": { "instructions": "codex-only" } }
    local_instructions_single_agent = local_artifact_single_agent(
        repo_root, "instructions", local_candidate_manifest
    )

    def documentation_problems(skill: str, skill_root: str) -> list[str]:
        if local_candidate_manifest is None and candidate_tree is None:
            return local_skill_readme_problems(
                changed_paths, skill, skill_root, repo_root
            )
        return local_skill_readme_problems(
            changed_paths,
            skill,
            skill_root,
            repo_root,
            manifest=local_candidate_manifest,
            candidate_tree=candidate_tree,
        )

    def paired_skill_problems(skill: str, skill_root: str) -> list[str]:
        if candidate_tree is not None:
            return candidate_local_skill_sync_problems(
                candidate_tree, skill, skill_root
            )
        return local_skill_sync_problems(repo_root, skill, skill_root)

    for path in sorted(changed_paths):
        if skip_runtime_path(path):
            continue

        if include_global and path in {GLOBAL_INSTRUCTION_CLAUDE, GLOBAL_INSTRUCTION_CODEX}:
            if processed_global_instructions:
                continue
            processed_global_instructions = True
            item = manifest_item_by_name(candidate_manifest, "instructions", GLOBAL_INSTRUCTION_NAME)
            if manifest_item_is_explicitly_unpaired(item):
                continue
            drift = global_instruction_sync_problems()
            if not drift:
                continue
            counterpart = (
                GLOBAL_INSTRUCTION_CODEX
                if path == GLOBAL_INSTRUCTION_CLAUDE
                else GLOBAL_INSTRUCTION_CLAUDE
            )
            if path_has_change(counterpart, changed_paths):
                add_nested_problems(
                    problems,
                    f"{GLOBAL_INSTRUCTION_CLAUDE} and {GLOBAL_INSTRUCTION_CODEX} are both changed, but the paired instructions still drift:",
                    drift,
                )
            else:
                add_nested_problems(
                    problems,
                    f"{path} changed without synchronized counterpart {counterpart} or an instruction-specific {MANIFEST} exemption:",
                    drift,
                )
        elif include_global and path.startswith("claude/skills/"):
            skill = path.removeprefix("claude/skills/").split("/", 1)[0]
            if skill in processed_global_skills:
                continue
            processed_global_skills.add(skill)
            if manifest_skill_removed(base_manifest, candidate_manifest, skill) and global_skill_files_absent(skill):
                continue
            drift = skill_sync_problems(skill)
            if not drift:
                continue
            item = manifest_item_by_name(candidate_manifest, "skills", skill)
            if manifest_item_is_explicitly_unpaired(item):
                continue
            counterpart = f"codex/skills/{skill}"
            if has_changed_prefix(counterpart, paths, changed):
                add_nested_problems(
                    problems,
                    f"claude/skills/{skill} and {counterpart} are both changed, but the paired skill still drifts:",
                    drift,
                )
            else:
                add_nested_problems(
                    problems,
                    f"claude/skills/{skill} changed without synchronized counterpart {counterpart} or a skill-specific {MANIFEST} exemption:",
                    drift,
                )
        elif include_global and path.startswith("codex/skills/"):
            skill = path.removeprefix("codex/skills/").split("/", 1)[0]
            if skill in processed_global_skills:
                continue
            processed_global_skills.add(skill)
            if manifest_skill_removed(base_manifest, candidate_manifest, skill) and global_skill_files_absent(skill):
                continue
            drift = skill_sync_problems(skill)
            if not drift:
                continue
            item = manifest_item_by_name(candidate_manifest, "skills", skill)
            if manifest_item_is_explicitly_unpaired(item):
                continue
            counterpart = f"claude/skills/{skill}"
            if has_changed_prefix(counterpart, paths, changed):
                add_nested_problems(
                    problems,
                    f"codex/skills/{skill} and {counterpart} are both changed, but the paired skill still drifts:",
                    drift,
                )
            else:
                add_nested_problems(
                    problems,
                    f"codex/skills/{skill} changed without synchronized counterpart {counterpart} or a skill-specific {MANIFEST} exemption:",
                    drift,
                )
        elif include_global and path.startswith("claude/private-skills/"):
            item = private_skill_item_for_path(candidate_private_manifest, path, "claude")
            key = item["name"] if item else path.removeprefix("claude/private-skills/").split("/", 1)[0]
            if key in processed_global_private_skills:
                continue
            processed_global_private_skills.add(key)
            if item is None:
                if private_skill_pair_removed(key, paths, changed):
                    continue
                problems.append(f"{path} changed but is missing from {PRIVATE_MANIFEST}")
                continue
            drift = private_skill_item_sync_problems(item)
            if not drift:
                continue
            if manifest_item_is_explicitly_unpaired(item):
                continue
            counterpart = str(Path(item["codex"]).parent)
            if has_changed_prefix(counterpart, paths, changed):
                add_nested_problems(
                    problems,
                    f"{path} and {counterpart} are both changed, but the paired private skill still drifts:",
                    drift,
                )
            else:
                add_nested_problems(
                    problems,
                    f"{path} changed without synchronized counterpart {counterpart} or a private-skill-specific {PRIVATE_MANIFEST} exemption:",
                    drift,
                )
        elif include_global and path.startswith("codex/private-skills/"):
            item = private_skill_item_for_path(candidate_private_manifest, path, "codex")
            key = item["name"] if item else path.removeprefix("codex/private-skills/").split("/", 1)[0]
            if key in processed_global_private_skills:
                continue
            processed_global_private_skills.add(key)
            if item is None:
                if private_skill_pair_removed(key, paths, changed):
                    continue
                problems.append(f"{path} changed but is missing from {PRIVATE_MANIFEST}")
                continue
            drift = private_skill_item_sync_problems(item)
            if not drift:
                continue
            if manifest_item_is_explicitly_unpaired(item):
                continue
            counterpart = str(Path(item["claude"]).parent)
            if has_changed_prefix(counterpart, paths, changed):
                add_nested_problems(
                    problems,
                    f"{path} and {counterpart} are both changed, but the paired private skill still drifts:",
                    drift,
                )
            else:
                add_nested_problems(
                    problems,
                    f"{path} changed without synchronized counterpart {counterpart} or a private-skill-specific {PRIVATE_MANIFEST} exemption:",
                    drift,
                )
        elif (
            include_global
            and path.startswith("claude/hooks/")
            and Path(path).name not in HOOK_DOCUMENTATION_NAMES
        ):
            hook = path.removeprefix("claude/hooks/")
            if hook in processed_global_hooks:
                continue
            processed_global_hooks.add(hook)
            counterpart = f"codex/hooks/{hook}"
            item = manifest_item_by_name(candidate_manifest, "hooks", hook)
            if manifest_item_is_explicitly_unpaired(item):
                continue
            if not path_has_change(counterpart, changed_paths) and not manifest_item_changed(
                base_manifest,
                candidate_manifest,
                "hooks",
                hook,
            ):
                problems.append(f"claude/hooks/{hook} changed without codex/hooks/{hook} or {MANIFEST}")
        elif (
            include_global
            and path.startswith("codex/hooks/")
            and Path(path).name not in HOOK_DOCUMENTATION_NAMES
        ):
            hook = path.removeprefix("codex/hooks/")
            if hook in processed_global_hooks:
                continue
            processed_global_hooks.add(hook)
            counterpart = f"claude/hooks/{hook}"
            item = manifest_item_by_name(candidate_manifest, "hooks", hook)
            if manifest_item_is_explicitly_unpaired(item):
                continue
            if not path_has_change(counterpart, changed_paths) and not manifest_item_changed(
                base_manifest,
                candidate_manifest,
                "hooks",
                hook,
            ):
                problems.append(f"codex/hooks/{hook} changed without claude/hooks/{hook} or {MANIFEST}")
        elif (
            include_global
            and path in SYNC_CONFIG_PATHS
            and not manifest_registration_changed(base_manifest, candidate_manifest, path)
        ):
            problems.append(f"{path} changed without a path-specific {MANIFEST} registration update")
        elif Path(path).name in {"CLAUDE.md", "AGENTS.md"}:
            if local_instructions_single_agent:
                continue
            rel_dir = Path(path).parent.as_posix()
            if rel_dir in processed_local_instruction_dirs:
                continue
            processed_local_instruction_dirs.add(rel_dir)
            drift = local_instruction_sync_problems(repo_root, rel_dir)
            if not drift:
                continue
            counterpart = (
                Path(path).with_name("AGENTS.md").as_posix()
                if Path(path).name == "CLAUDE.md"
                else Path(path).with_name("CLAUDE.md").as_posix()
            )
            if path_has_change(counterpart, changed_paths):
                add_nested_problems(
                    problems,
                    f"Project-local instruction files in {rel_dir} are both changed, but still drift:",
                    drift,
                )
            else:
                add_nested_problems(
                    problems,
                    f"Project-local {path} changed without synchronized counterpart {counterpart}:",
                    drift,
                )
        elif path.startswith(".claude/skills/"):
            skill = path.removeprefix(".claude/skills/").split("/", 1)[0]
            skill_key = f"skills/{skill}"
            if skill_key in processed_local_skills:
                continue
            processed_local_skills.add(skill_key)
            if local_skills_single_agent:
                continue
            drift = paired_skill_problems(skill, "skills")
            doc_drift = documentation_problems(skill, "skills")
            if drift and local_skill_moved_between_roots(
                repo_root,
                changed_paths,
                skill,
                "skills",
                "programmatic-skills",
                candidate_tree,
            ):
                continue
            if drift and local_skill_removed(
                repo_root, skill, candidate_tree=candidate_tree
            ):
                if doc_drift:
                    add_nested_problems(
                        problems,
                        f"Project-local .claude/skills/{skill} removed without a documentation owner update:",
                        doc_drift,
                    )
                continue
            if not drift:
                if doc_drift:
                    add_nested_problems(
                        problems,
                        f"Project-local .claude/skills/{skill} changed without a documentation owner update:",
                        doc_drift,
                    )
                continue
            counterpart = f".codex/skills/{skill}"
            if has_changed_prefix(counterpart, paths, changed):
                add_nested_problems(
                    problems,
                    f"Project-local .claude/skills/{skill} and {counterpart} are both changed, but the paired skill still drifts:",
                    drift + doc_drift,
                )
            else:
                add_nested_problems(
                    problems,
                    f"Project-local .claude/skills/{skill} changed without synchronized counterpart {counterpart}:",
                    drift + doc_drift,
                )
        elif path.startswith(".codex/skills/"):
            skill = path.removeprefix(".codex/skills/").split("/", 1)[0]
            skill_key = f"skills/{skill}"
            if skill_key in processed_local_skills:
                continue
            processed_local_skills.add(skill_key)
            if local_skills_single_agent:
                continue
            drift = paired_skill_problems(skill, "skills")
            doc_drift = documentation_problems(skill, "skills")
            if drift and local_skill_moved_between_roots(
                repo_root,
                changed_paths,
                skill,
                "skills",
                "programmatic-skills",
                candidate_tree,
            ):
                continue
            if drift and local_skill_removed(
                repo_root, skill, candidate_tree=candidate_tree
            ):
                if doc_drift:
                    add_nested_problems(
                        problems,
                        f"Project-local .codex/skills/{skill} removed without a documentation owner update:",
                        doc_drift,
                    )
                continue
            if not drift:
                if doc_drift:
                    add_nested_problems(
                        problems,
                        f"Project-local .codex/skills/{skill} changed without a documentation owner update:",
                        doc_drift,
                    )
                continue
            counterpart = f".claude/skills/{skill}"
            if has_changed_prefix(counterpart, paths, changed):
                add_nested_problems(
                    problems,
                    f"Project-local .codex/skills/{skill} and {counterpart} are both changed, but the paired skill still drifts:",
                    drift + doc_drift,
                )
            else:
                add_nested_problems(
                    problems,
                    f"Project-local .codex/skills/{skill} changed without synchronized counterpart {counterpart}:",
                    drift + doc_drift,
                )
        elif path.startswith(".claude/programmatic-skills/"):
            skill = path.removeprefix(".claude/programmatic-skills/").split("/", 1)[0]
            skill_key = f"programmatic-skills/{skill}"
            if skill_key in processed_local_skills:
                continue
            processed_local_skills.add(skill_key)
            drift = paired_skill_problems(skill, "programmatic-skills")
            doc_drift = documentation_problems(skill, "programmatic-skills")
            if drift and local_skill_removed(
                repo_root, skill, "programmatic-skills", candidate_tree
            ):
                if doc_drift:
                    add_nested_problems(
                        problems,
                        f"Project-local .claude/programmatic-skills/{skill} removed without a documentation owner update:",
                        doc_drift,
                    )
                continue
            if not drift:
                if doc_drift:
                    add_nested_problems(
                        problems,
                        f"Project-local .claude/programmatic-skills/{skill} changed without a documentation owner update:",
                        doc_drift,
                    )
                continue
            counterpart = f".codex/programmatic-skills/{skill}"
            if has_changed_prefix(counterpart, paths, changed):
                add_nested_problems(
                    problems,
                    f"Project-local .claude/programmatic-skills/{skill} and {counterpart} are both changed, but the paired skill still drifts:",
                    drift + doc_drift,
                )
            else:
                add_nested_problems(
                    problems,
                    f"Project-local .claude/programmatic-skills/{skill} changed without synchronized counterpart {counterpart}:",
                    drift + doc_drift,
                )
        elif path.startswith(".codex/programmatic-skills/"):
            skill = path.removeprefix(".codex/programmatic-skills/").split("/", 1)[0]
            skill_key = f"programmatic-skills/{skill}"
            if skill_key in processed_local_skills:
                continue
            processed_local_skills.add(skill_key)
            drift = paired_skill_problems(skill, "programmatic-skills")
            doc_drift = documentation_problems(skill, "programmatic-skills")
            if drift and local_skill_removed(
                repo_root, skill, "programmatic-skills", candidate_tree
            ):
                if doc_drift:
                    add_nested_problems(
                        problems,
                        f"Project-local .codex/programmatic-skills/{skill} removed without a documentation owner update:",
                        doc_drift,
                    )
                continue
            if not drift:
                if doc_drift:
                    add_nested_problems(
                        problems,
                        f"Project-local .codex/programmatic-skills/{skill} changed without a documentation owner update:",
                        doc_drift,
                    )
                continue
            counterpart = f".claude/programmatic-skills/{skill}"
            if has_changed_prefix(counterpart, paths, changed):
                add_nested_problems(
                    problems,
                    f"Project-local .codex/programmatic-skills/{skill} and {counterpart} are both changed, but the paired skill still drifts:",
                    drift + doc_drift,
                )
            else:
                add_nested_problems(
                    problems,
                    f"Project-local .codex/programmatic-skills/{skill} changed without synchronized counterpart {counterpart}:",
                    drift + doc_drift,
                )
        elif path.startswith(".claude/hooks/"):
            hook = path.removeprefix(".claude/hooks/")
            if hook in processed_local_hooks:
                continue
            processed_local_hooks.add(hook)
            counterpart = f".codex/hooks/{hook}"
            if not path_has_change(counterpart, changed_paths):
                problems.append(f"Project-local .claude/hooks/{hook} changed without .codex/hooks/{hook}")
        elif path.startswith(".codex/hooks/"):
            hook = path.removeprefix(".codex/hooks/")
            if hook in processed_local_hooks:
                continue
            processed_local_hooks.add(hook)
            counterpart = f".claude/hooks/{hook}"
            if not path_has_change(counterpart, changed_paths):
                problems.append(f"Project-local .codex/hooks/{hook} changed without .claude/hooks/{hook}")
        elif path == ".claude/settings.json":
            if not path_has_change(".codex/hooks.json", changed_paths):
                problems.append("Project-local .claude/settings.json changed without .codex/hooks.json")
        elif path == ".codex/hooks.json":
            if not path_has_change(".claude/settings.json", changed_paths):
                problems.append("Project-local .codex/hooks.json changed without .claude/settings.json")


def guard_commit() -> None:
    data = read_input_json()
    command = str(tool_input_object(data).get("command") or "")
    (
        paths_by_repo,
        commit_repos,
        command_problems_by_repo,
    ) = command_paths_and_commit_repos(command, hook_cwd(data))
    if not commit_repos:
        return

    problems: list[str] = []
    full_audit_required = False
    documentation_candidate: CommitCandidateTree | None = None
    for repo_root in sorted(commit_repos, key=str):
        problems.extend(command_problems_by_repo.get(repo_root, []))
        changed = dirty_paths(repo_root)
        staged = staged_paths(repo_root)
        command_paths = paths_by_repo.get(repo_root, set())
        candidate_tree = CommitCandidateTree(repo_root, frozenset(command_paths))
        paths = staged | command_paths
        changed_paths = {path for path in paths if path_has_change(path, changed)}
        if not changed_paths:
            continue

        include_global = same_path(repo_root, ROOT)
        if include_global:
            documentation_candidate = candidate_tree
            if any(full_audit_gate_path(path) for path in changed_paths):
                full_audit_required = True
            (
                base_manifest,
                candidate_manifest,
                base_private_manifest,
                candidate_private_manifest,
            ) = guard_manifests(command_paths, staged, problems, candidate_tree)
            local_candidate_manifest = candidate_manifest
        else:
            base_manifest, candidate_manifest = {}, {}
            base_private_manifest, candidate_private_manifest = {}, {}
            local_candidate_manifest = candidate_local_manifest(
                candidate_tree, problems
            )

        guard_changed_paths(
            repo_root,
            changed_paths,
            paths,
            changed,
            problems,
            include_global,
            base_manifest,
            candidate_manifest,
            base_private_manifest,
            candidate_private_manifest,
            local_candidate_manifest,
            candidate_tree,
        )

    if documentation_candidate is not None:
        documentation_drift = candidate_documentation_audit_problems(
            documentation_candidate
        )
        if documentation_drift:
            add_nested_problems(
                problems,
                "The documentation audit is not clean:",
                documentation_drift,
            )

    if full_audit_required:
        drift = audit_problems(include_documentation=False)
        if drift:
            add_nested_problems(
                problems,
                "The full AI config audit is not clean:",
                drift,
            )

    if not problems:
        return

    reason = (
        "BLOCKED: AI config sync guard found configuration problems.\n\n"
        + "\n".join(problems)
        + "\n\nMake the configuration and documentation audits clean before committing. "
        "Update the counterpart in this same session. For global dotfiles "
        f"artifacts, stage {MANIFEST} with an explicit status/exemption if the "
        "counterpart should not exist. When updating README.org files, document "
        "the behavior and paths for that README's own tool or project only; do "
        "not document the other agent's behavior in a tool-specific README."
    )
    print(
        json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": "deny",
                    "permissionDecisionReason": reason,
                }
            },
            indent=2,
        )
    )


def load_manifest() -> dict:
    return json.loads(MANIFEST_PATH.read_text())


def load_private_manifest() -> dict:
    if not PRIVATE_MANIFEST_PATH.exists():
        return {}
    return json.loads(PRIVATE_MANIFEST_PATH.read_text())


def add_problem(problems: list[str], message: str) -> None:
    problems.append(message)


def check_symlink(problems: list[str], target: Path, expected: Path, label: str) -> None:
    if not target.is_symlink():
        add_problem(problems, f"Missing live {label} symlink: {target} -> {expected}")
        return
    actual = Path(os.readlink(target))
    if actual != expected:
        add_problem(problems, f"Wrong live {label} symlink: {target} -> {actual}; expected {expected}")


def disabled_skill_records() -> dict:
    if not DISABLED_SKILLS_PATH.exists():
        return {}
    try:
        data = json.loads(DISABLED_SKILLS_PATH.read_text())
    except json.JSONDecodeError as exc:
        return {}
    return data.get("disabled") or {}


def disabled_skill_names() -> set[str]:
    return set(disabled_skill_records())


def check_native_disabled_skills(problems: list[str]) -> None:
    disabled_records = disabled_skill_records()
    disabled = set(disabled_records)

    claude_settings = Path.home() / ".claude" / "settings.local.json"
    try:
        claude_data = json.loads(claude_settings.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        add_problem(problems, f"Cannot read live Claude settings.local.json for disabled skills: {exc}")
        claude_data = {}
    overrides = claude_data.get("skillOverrides") or {}
    for name in sorted(disabled):
        if overrides.get(name) != "off":
            add_problem(problems, f"Disabled skill missing Claude skillOverrides off entry: {name}")
    # Reverse direction: an override with no backing record is stale state that
    # the forward check alone can never catch.
    for name in sorted(overrides):
        if overrides.get(name) == "off" and name not in disabled:
            add_problem(
                problems,
                f"Claude skillOverrides off entry has no skills-disabled.json record: {name}",
            )

    try:
        codex_data = tomllib.loads((ROOT / "codex" / "config.toml").read_text())
    except (OSError, tomllib.TOMLDecodeError) as exc:
        add_problem(problems, f"Cannot read Codex config for disabled skills: {exc}")
        return
    config_entries = ((codex_data.get("skills") or {}).get("config") or [])
    disabled_codex_paths = {
        real_path(path_from_token(str(entry.get("path")), ROOT))
        for entry in config_entries
        if entry.get("enabled") is False and entry.get("path")
    }
    record_codex_paths = set()
    for name in sorted(disabled):
        record = disabled_records.get(name) or {}
        codex_path = record.get("codex_path") or f"codex/skills/{name}/SKILL.md"
        expected = real_path(path_from_token(str(codex_path), ROOT))
        record_codex_paths.add(expected)
        if expected not in disabled_codex_paths:
            add_problem(problems, f"Disabled skill missing Codex skills.config disabled entry: {name}")
    for path in sorted(disabled_codex_paths - record_codex_paths):
        add_problem(
            problems,
            f"Codex skills.config disabled entry has no skills-disabled.json record: {path}",
        )


def load_mcp_config(path: Path) -> dict:
    if path.suffix == ".toml":
        return tomllib.loads(path.read_text())
    return json.loads(path.read_text())


def mcp_server_entry(data: dict, family: str, name: str) -> dict | None:
    key = "mcpServers" if family == "claude" else "mcp_servers"
    entry = (data.get(key) or {}).get(name)
    return entry if isinstance(entry, dict) else None


def public_mcp_entry(entry: dict) -> dict:
    return {
        key: entry.get(key)
        for key in ("command", "args", "transport", "url")
        if key in entry
    }


def run_identity_check(command: str | list[str], cwd: Path) -> subprocess.CompletedProcess[str]:
    if isinstance(command, list):
        return subprocess.run(
            [str(part) for part in command],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            cwd=str(cwd),
        )
    return subprocess.run(
        command,
        shell=True,
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        cwd=str(cwd),
    )


def audit_mcp_servers(problems: list[str], manifest: dict) -> None:
    for item in manifest.get("mcp_servers") or []:
        name = item.get("name", "mcp server")
        claude_config = path_from_token(str(item.get("claude_config")), ROOT)
        codex_config = path_from_token(str(item.get("codex_config")), ROOT)
        claude_name = item.get("claude_server", name)
        codex_name = item.get("codex_server", name)

        try:
            claude_data = load_mcp_config(claude_config)
        except (OSError, json.JSONDecodeError, tomllib.TOMLDecodeError) as exc:
            add_problem(problems, f"MCP {name}: cannot read Claude config {claude_config}: {exc}")
            continue
        try:
            codex_data = load_mcp_config(codex_config)
        except (OSError, json.JSONDecodeError, tomllib.TOMLDecodeError) as exc:
            add_problem(problems, f"MCP {name}: cannot read Codex config {codex_config}: {exc}")
            continue

        claude = mcp_server_entry(claude_data, "claude", str(claude_name))
        codex = mcp_server_entry(codex_data, "codex", str(codex_name))
        if claude is None:
            add_problem(problems, f"MCP {name}: missing Claude server {claude_name}")
        if codex is None:
            add_problem(problems, f"MCP {name}: missing Codex server {codex_name}")
        if claude is None or codex is None:
            continue

        if item.get("compare_public_config", True) and public_mcp_entry(claude) != public_mcp_entry(codex):
            add_problem(problems, f"MCP {name}: Claude and Codex command/args/transport/url differ")

        for key in item.get("required_env") or []:
            if key not in (claude.get("env") or {}):
                add_problem(problems, f"MCP {name}: Claude env missing {key}")
            if key not in (codex.get("env") or {}):
                add_problem(problems, f"MCP {name}: Codex env missing {key}")

        for check in item.get("identity_checks") or []:
            label = check.get("label", name) if isinstance(check, dict) else name
            command = check.get("command") if isinstance(check, dict) else check
            proc = run_identity_check(command, ROOT)
            if proc.returncode != 0:
                detail = (proc.stderr or proc.stdout).strip()
                add_problem(problems, f"MCP {name}: identity check failed ({label}): {detail or command}")


def path_is_inside(path: Path, parent: Path) -> bool:
    try:
        real_path(path).relative_to(real_path(parent))
    except ValueError:
        return False
    return True


@dataclass(frozen=True)
class InteractiveSkillRoot:
    path: Path
    tool: str
    source: str
    priority: int


@dataclass(frozen=True)
class InteractiveSkillFile:
    name: str
    path: Path
    root: InteractiveSkillRoot


def ancestors(cwd: Path) -> list[Path]:
    resolved = cwd.resolve()
    return [resolved, *resolved.parents]


def add_interactive_skill_root(
    roots: list[InteractiveSkillRoot],
    seen: set[tuple[str, str]],
    path: Path,
    tool: str,
    source: str,
    priority: int,
) -> None:
    if not path.is_dir():
        return
    key = (tool, str(real_path(path)))
    if key in seen:
        return
    seen.add(key)
    roots.append(InteractiveSkillRoot(path=path, tool=tool, source=source, priority=priority))


def plugin_path_is_orphaned(path: Path) -> bool:
    for parent in (path, *path.parents):
        if (parent / ".orphaned_at").exists():
            return True
        if parent.name == "cache":
            return False
    return False


def enabled_claude_plugins(claude_home: Path) -> list[str]:
    settings = claude_home / "settings.json"
    try:
        data = json.loads(settings.read_text())
    except (OSError, json.JSONDecodeError):
        return []
    enabled = data.get("enabledPlugins") or {}
    if not isinstance(enabled, dict):
        return []
    return sorted(plugin_id for plugin_id, active in enabled.items() if active)


def add_enabled_claude_plugin_roots(
    roots: list[InteractiveSkillRoot],
    seen: set[tuple[str, str]],
    claude_home: Path,
) -> None:
    cache = claude_home / "plugins" / "cache"
    for plugin_id in enabled_claude_plugins(claude_home):
        if "@" not in plugin_id:
            continue
        plugin, marketplace = plugin_id.rsplit("@", 1)
        plugin_cache = cache / marketplace / plugin
        if not plugin_cache.is_dir():
            continue
        for version_dir in sorted(path for path in plugin_cache.iterdir() if path.is_dir()):
            if (version_dir / ".orphaned_at").exists():
                continue
            add_interactive_skill_root(
                roots,
                seen,
                version_dir / "skills",
                "claude",
                f"claude-plugin-cache:{plugin_id}",
                200,
            )


def interactive_skill_roots(cwd: Path, tool: str) -> list[InteractiveSkillRoot]:
    roots: list[InteractiveSkillRoot] = []
    seen: set[tuple[str, str]] = set()

    for depth, parent in enumerate(ancestors(cwd)):
        if parent == Path.home():
            continue
        if tool == "codex":
            add_interactive_skill_root(
                roots,
                seen,
                parent / ".codex" / "skills",
                "codex",
                f"project-local:{parent}",
                10 + depth,
            )
        if tool == "claude":
            add_interactive_skill_root(
                roots,
                seen,
                parent / ".claude" / "skills",
                "claude",
                f"project-local:{parent}",
                10 + depth,
            )

    epoch_root = Path.home() / "My Drive" / "Epoch"
    if tool == "codex":
        add_interactive_skill_root(
            roots,
            seen,
            epoch_root / ".codex" / "skills",
            "codex",
            "epoch-workspace",
            40,
        )
        codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
        add_interactive_skill_root(roots, seen, codex_home / "skills", "codex", "CODEX_HOME", 100)
        add_interactive_skill_root(roots, seen, ROOT / "codex" / "skills", "codex", "dotfiles", 110)

        for skills_dir in codex_plugin_skill_roots(
            codex_home,
            load_codex_plugin_list(codex_home),
        ):
            add_interactive_skill_root(
                roots,
                seen,
                skills_dir,
                "codex",
                "codex-plugin-cache",
                200,
            )

    if tool == "claude":
        add_interactive_skill_root(
            roots,
            seen,
            epoch_root / ".claude" / "skills",
            "claude",
            "epoch-workspace",
            40,
        )
        claude_home = Path(os.environ.get("CLAUDE_HOME", Path.home() / ".claude"))
        add_interactive_skill_root(roots, seen, claude_home / "skills", "claude", "CLAUDE_HOME", 100)
        add_interactive_skill_root(roots, seen, ROOT / "claude" / "skills", "claude", "dotfiles", 110)
        add_enabled_claude_plugin_roots(roots, seen, claude_home)

    expanded: list[InteractiveSkillRoot] = []
    expanded_seen: set[tuple[str, str]] = set()
    for root in sorted(roots, key=lambda item: (item.priority, str(item.path))):
        add_interactive_skill_root(expanded, expanded_seen, root.path, root.tool, root.source, root.priority)
        add_interactive_skill_root(
            expanded,
            expanded_seen,
            root.path / ".system",
            root.tool,
            f"{root.source}:system",
            root.priority + 1,
        )
    return sorted(expanded, key=lambda item: (item.priority, str(item.path)))


def parse_skill_name(path: Path) -> str:
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return path.parent.name
    if not text.startswith("---"):
        return path.parent.name
    frontmatter = text.split("---", 2)
    if len(frontmatter) < 3:
        return path.parent.name
    for line in frontmatter[1].splitlines():
        match = re.match(r"\s*name:\s*(.+?)\s*$", line)
        if match:
            return match.group(1).strip().strip("\"'")
    return path.parent.name


def interactive_skill_files(cwd: Path, tool: str) -> list[InteractiveSkillFile]:
    skills: list[InteractiveSkillFile] = []
    seen_paths: set[str] = set()
    for root in interactive_skill_roots(cwd, tool):
        for path in sorted(root.path.glob("*/SKILL.md")):
            real = str(real_path(path))
            if real in seen_paths:
                continue
            seen_paths.add(real)
            skills.append(InteractiveSkillFile(name=parse_skill_name(path), path=path, root=root))
    return sorted(skills, key=lambda item: (item.root.priority, item.name, str(item.path)))


def display_path(path: Path) -> str:
    try:
        return path.relative_to(ROOT).as_posix()
    except ValueError:
        return str(path)


def audit_duplicate_skill_names(problems: list[str]) -> None:
    for tool in ("claude", "codex"):
        by_name: dict[str, list[InteractiveSkillFile]] = {}
        for skill in interactive_skill_files(ROOT, tool):
            by_name.setdefault(skill.name, []).append(skill)

        for name, matches in sorted(by_name.items()):
            if len(matches) <= 1:
                continue
            nested = [
                f"{display_path(skill.path)} [{skill.root.source}]"
                for skill in matches
            ]
            add_nested_problems(problems, f"Duplicate {tool} skill name: {name}", nested)


def audit_topology(problems: list[str]) -> None:
    forbidden_project_hooks = ROOT / ".codex" / "hooks.json"
    if forbidden_project_hooks.exists() or forbidden_project_hooks.is_symlink():
        add_problem(
            problems,
            "dotfiles/.codex/hooks.json exists; repo-root .codex is project-local, so global Codex hooks must live in codex/hooks.json.",
        )

    live_codex_hooks = Path.home() / ".codex" / "hooks.json"
    if live_codex_hooks.exists() and path_is_inside(live_codex_hooks, ROOT / ".codex"):
        add_problem(
            problems,
            f"Live Codex hooks resolve inside dotfiles/.codex: {live_codex_hooks}; use codex/hooks.json as the global symlink target.",
        )

    allowed_live_symlinks = {
        Path.home() / ".claude": {"CLAUDE.md", "programmatic-skills", "skills"},
        Path.home() / ".codex": {"AGENTS.md", "config.toml", "hooks.json", "programmatic-skills", "rules", "skills"},
    }
    for directory, allowed_names in allowed_live_symlinks.items():
        if not directory.is_dir():
            continue
        for child in directory.iterdir():
            if child.is_symlink() and child.name not in allowed_names:
                add_problem(problems, f"Undocumented live tool-home symlink: {child} -> {os.readlink(child)}")

    project_claude_skills = {
        path.parent.name for path in (ROOT / ".claude" / "skills").glob("*/SKILL.md")
    }
    project_codex_skills = {
        path.parent.name for path in (ROOT / ".codex" / "skills").glob("*/SKILL.md")
    }
    unexpected_project_local = (project_claude_skills | project_codex_skills) - DOTFILES_PROJECT_LOCAL_SKILLS
    for skill in sorted(unexpected_project_local):
        add_problem(
            problems,
            f"unexpected dotfiles project-local skill exists: {skill}; reusable skills belong in claude/skills and codex/skills, not repo-root .claude/.codex.",
        )

    for skill in sorted(project_claude_skills | project_codex_skills):
        drift = project_local_skill_sync_problems(skill)
        if drift:
            add_nested_problems(
                problems, f"Project-local skill pair is not synchronized: {skill}", drift
            )

    drift = local_instruction_sync_problems(ROOT)
    if drift:
        add_nested_problems(problems, "Dotfiles project instructions are not synchronized:", drift)


def audit_known_project_instruction_pairs(problems: list[str]) -> None:
    for root in KNOWN_PROJECT_INSTRUCTION_ROOTS:
        if not root.exists():
            continue
        drift = local_instruction_sync_problems(root)
        if drift:
            add_nested_problems(
                problems,
                f"Known project-local instruction pair is not synchronized: {root}",
                drift,
            )


def normalized_skill_content(text: str) -> str:
    if not text.startswith("---\n"):
        return text
    end = text.find("\n---\n", 4)
    if end < 0:
        return text
    frontmatter = text[4:end].splitlines()
    body = text[end + 5 :]
    kept = []
    for line in frontmatter:
        key = line.split(":", 1)[0].strip() if ":" in line else ""
        if key not in TOOL_SPECIFIC_SKILL_FRONTMATTER:
            kept.append(line)
    return "---\n" + "\n".join(kept) + "\n---\n" + body


def normalized_skill_text(path: Path) -> str:
    return normalized_skill_content(path.read_text())


def skill_aux_files(skill_dir: Path) -> dict[str, Path]:
    files: dict[str, Path] = {}
    for path in skill_dir.rglob("*"):
        if not path.is_file():
            continue
        rel = path.relative_to(skill_dir).as_posix()
        if rel == "SKILL.md" or path.name == ".DS_Store":
            continue
        if rel.startswith(("digests/", "last-run/", "vetted/")):
            continue
        if "node_modules/" in rel:
            continue
        files[rel] = path
    return files


INTERPRETER_TOKENS = {"bash", "sh", "zsh", "python", "python3", "uv", "env", "node"}


def command_executable(command: str) -> Path | None:
    try:
        parts = shlex.split(command)
    except ValueError:
        return None
    # Skip interpreter prefixes (e.g. `bash '/path with spaces/hook.sh'`) and
    # their flags so the script path, not the interpreter name, is checked.
    while parts and (Path(parts[0]).name in INTERPRETER_TOKENS or parts[0].startswith("-")):
        parts.pop(0)
    if not parts:
        return None
    return path_from_token(parts[0], ROOT)


def hook_commands(config: dict) -> list[str]:
    commands: list[str] = []
    for entries in (config.get("hooks") or {}).values():
        for entry in entries:
            for hook in entry.get("hooks") or []:
                command = hook.get("command")
                if command:
                    commands.append(command)
    return commands


def command_mentions_path(command: str, path: Path) -> bool:
    path_text = str(path)
    try:
        parts = shlex.split(command)
    except ValueError:
        return path_text in command
    return any(part == path_text or part == path_text.replace(str(Path.home()), "~") for part in parts) or path_text in command


def audit_instructions(problems: list[str], manifest: dict) -> None:
    instructions = manifest.get("instructions") or []
    item = manifest_item_by_name(manifest, "instructions", GLOBAL_INSTRUCTION_NAME)
    if item is None:
        add_problem(problems, f"Manifest instructions missing: {GLOBAL_INSTRUCTION_NAME}")
    else:
        if item.get("claude") != GLOBAL_INSTRUCTION_CLAUDE:
            add_problem(problems, f"Global instruction manifest has wrong Claude path: {item.get('claude')}")
        if item.get("codex") != GLOBAL_INSTRUCTION_CODEX:
            add_problem(problems, f"Global instruction manifest has wrong Codex path: {item.get('codex')}")
        if not manifest_item_is_paired(item):
            add_problem(problems, f"Global instruction manifest is not marked as a paired artifact: {GLOBAL_INSTRUCTION_NAME}")

    for item in instructions:
        if item.get("codex") == "AGENTS.md":
            add_problem(problems, "Manifest still declares a repo-root AGENTS.md manual counterpart.")

    check_symlink(
        problems,
        Path.home() / ".codex" / "AGENTS.md",
        ROOT / "codex" / "AGENTS.md",
        "Codex global instruction",
    )
    check_symlink(
        problems,
        Path.home() / ".claude" / "CLAUDE.md",
        ROOT / "claude" / "CLAUDE.md",
        "Claude global instruction",
    )
    drift = global_instruction_sync_problems()
    if drift:
        add_nested_problems(problems, "Global instructions are not synchronized:", drift)


def audit_skills(problems: list[str], manifest: dict, private_manifest: dict) -> None:
    manifest_skill_items = {item["name"]: item for item in manifest.get("skills") or []}
    manifest_skills = set(manifest_skill_items)
    private_skill_names = {
        item["name"] for item in private_manifest.get("private_skills") or []
    }
    claude_skills = {path.parent.name for path in (ROOT / "claude" / "skills").glob("*/SKILL.md")}
    codex_skills = {path.parent.name for path in (ROOT / "codex" / "skills").glob("*/SKILL.md")}
    claude_skills -= private_skill_names
    codex_skills -= private_skill_names

    for skill in sorted(claude_skills - codex_skills):
        item = manifest_skill_items.get(skill)
        if manifest_item_is_explicitly_unpaired(item) and item.get("codex") is None:
            continue
        add_problem(problems, f"Missing Codex skill counterpart: {skill}")
    for skill in sorted(codex_skills - claude_skills):
        item = manifest_skill_items.get(skill)
        if manifest_item_is_explicitly_unpaired(item) and item.get("claude") is None:
            continue
        add_problem(problems, f"Codex skill lacks Claude counterpart or manifest exemption: {skill}")
    for skill in sorted(claude_skills - manifest_skills):
        add_problem(problems, f"Skill missing from manifest: {skill}")
    for skill in sorted(manifest_skills - claude_skills):
        item = manifest_skill_items.get(skill)
        if manifest_item_is_explicitly_unpaired(item) and item.get("claude") is None:
            continue
        add_problem(problems, f"Manifest skill missing from Claude tree: {skill}")

    check_symlink(
        problems,
        Path.home() / ".claude" / "skills",
        ROOT / "claude" / "skills",
        "Claude skills",
    )
    check_symlink(
        problems,
        Path.home() / ".codex" / "skills",
        ROOT / "codex" / "skills",
        "Codex skills",
    )
    check_native_disabled_skills(problems)

    for skill in sorted(claude_skills & codex_skills):
        item = manifest_item_by_name(manifest, "skills", skill)
        if manifest_item_is_explicitly_unpaired(item):
            continue

        claude_skill = ROOT / "claude" / "skills" / skill / "SKILL.md"
        codex_skill = ROOT / "codex" / "skills" / skill / "SKILL.md"
        if normalized_skill_text(claude_skill) != normalized_skill_text(codex_skill):
            add_problem(problems, f"Skill content drift after tool-specific frontmatter normalization: {skill}")

        claude_aux = skill_aux_files(claude_skill.parent)
        codex_aux = skill_aux_files(codex_skill.parent)
        for rel in sorted(set(claude_aux) - set(codex_aux)):
            add_problem(problems, f"Auxiliary skill file only in Claude tree: {skill}/{rel}")
        for rel in sorted(set(codex_aux) - set(claude_aux)):
            add_problem(problems, f"Auxiliary skill file only in Codex tree: {skill}/{rel}")
        for rel in sorted(set(claude_aux) & set(codex_aux)):
            if not filecmp.cmp(claude_aux[rel], codex_aux[rel], shallow=False):
                add_problem(problems, f"Auxiliary skill file drift: {skill}/{rel}")


PARENT_DRIVE_WORKSPACE = Path.home() / "My Drive"


def audit_parent_drive_skill_pairs(problems: list[str], workspace: Path | None = None) -> None:
    """Audit the untracked ~/My Drive/.claude|.codex skill pairs for drift.

    These pairs live outside every git repo, so commit-time guards never see
    them; this absolute-path check is their only drift detection.
    """
    root = PARENT_DRIVE_WORKSPACE if workspace is None else workspace
    claude_root = root / ".claude" / "skills"
    codex_root = root / ".codex" / "skills"
    if not claude_root.is_dir() and not codex_root.is_dir():
        return
    claude_skills = (
        {path.parent.name for path in claude_root.glob("*/SKILL.md")}
        if claude_root.is_dir()
        else set()
    )
    codex_skills = (
        {path.parent.name for path in codex_root.glob("*/SKILL.md")}
        if codex_root.is_dir()
        else set()
    )
    for skill in sorted(claude_skills - codex_skills):
        add_problem(problems, f"Parent-Drive skill lacks Codex counterpart: {skill}")
    for skill in sorted(codex_skills - claude_skills):
        add_problem(problems, f"Parent-Drive skill lacks Claude counterpart: {skill}")
    for skill in sorted(claude_skills & codex_skills):
        claude_skill = claude_root / skill / "SKILL.md"
        codex_skill = codex_root / skill / "SKILL.md"
        if normalized_skill_text(claude_skill) != normalized_skill_text(codex_skill):
            add_problem(
                problems,
                f"Parent-Drive skill content drift after tool-specific frontmatter normalization: {skill}",
            )
        claude_aux = skill_aux_files(claude_skill.parent)
        codex_aux = skill_aux_files(codex_skill.parent)
        for rel in sorted(set(claude_aux) - set(codex_aux)):
            add_problem(problems, f"Parent-Drive auxiliary skill file only in Claude tree: {skill}/{rel}")
        for rel in sorted(set(codex_aux) - set(claude_aux)):
            add_problem(problems, f"Parent-Drive auxiliary skill file only in Codex tree: {skill}/{rel}")
        for rel in sorted(set(claude_aux) & set(codex_aux)):
            if not filecmp.cmp(claude_aux[rel], codex_aux[rel], shallow=False):
                add_problem(problems, f"Parent-Drive auxiliary skill file drift: {skill}/{rel}")


def audit_private_skills(problems: list[str], manifest: dict) -> None:
    private_items = manifest.get("private_skills") or []
    manifest_paths = {
        item.get(side)
        for item in private_items
        for side in ("claude", "codex")
        if item.get(side)
    }
    tree_paths = {
        str(path.relative_to(ROOT))
        for root in (ROOT / "claude" / "private-skills", ROOT / "codex" / "private-skills")
        for path in root.glob("*/SKILL.md")
    }

    for path in sorted(tree_paths - manifest_paths):
        add_problem(problems, f"Private skill path missing from {PRIVATE_MANIFEST}: {path}")
    for path in sorted(manifest_paths - tree_paths):
        add_problem(problems, f"{PRIVATE_MANIFEST} private skill path missing from tree: {path}")

    for item in sorted(private_items, key=lambda record: record["name"]):
        if manifest_item_is_explicitly_unpaired(item):
            continue
        drift = private_skill_item_sync_problems(item)
        for problem in drift:
            add_problem(problems, problem)

        for side in ("claude", "codex"):
            name = item["name"]
            source = item.get(side)
            if not source:
                continue
            shim = ROOT / side / "skills" / name
            expected = (ROOT / source).parent
            if not shim.is_symlink():
                add_problem(problems, f"Missing local {side} private skill shim: {shim}")
                continue
            if shim.resolve() != expected.resolve():
                add_problem(problems, f"Wrong local {side} private skill shim: {shim} -> {shim.resolve()}; expected {expected}")


def audit_hooks(problems: list[str], manifest: dict) -> None:
    manifest_hooks = {item["name"]: item for item in manifest.get("hooks") or []}
    claude_hooks = {
        path.name
        for path in (ROOT / "claude" / "hooks").iterdir()
        if path.is_file() and path.name not in HOOK_DOCUMENTATION_NAMES
    }
    codex_hooks = {
        path.name
        for path in (ROOT / "codex" / "hooks").iterdir()
        if path.is_file() and path.name not in HOOK_DOCUMENTATION_NAMES
    }

    for hook in sorted((claude_hooks | codex_hooks) - set(manifest_hooks)):
        add_problem(problems, f"Hook missing from manifest: {hook}")
    for hook in sorted(set(manifest_hooks) - (claude_hooks | codex_hooks)):
        add_problem(problems, f"Manifest hook missing from both trees: {hook}")

    for name, item in sorted(manifest_hooks.items()):
        status = item.get("status")
        claude = item.get("claude")
        codex = item.get("codex")
        if claude and not (ROOT / claude).exists():
            add_problem(problems, f"Manifest Claude hook path missing: {claude}")
        if codex and not (ROOT / codex).exists():
            add_problem(problems, f"Manifest Codex hook path missing: {codex}")
        if manifest_item_is_paired(item) and not (claude and codex):
            add_problem(problems, f"Paired hook lacks both sides in manifest: {name}")

    claude_settings = json.loads((Path.home() / ".claude" / "settings.json").read_text())
    codex_hooks_json = json.loads((ROOT / "codex" / "hooks.json").read_text())
    claude_commands = hook_commands(claude_settings)
    codex_commands = hook_commands(codex_hooks_json)

    for label, commands in (("Claude", claude_commands), ("Codex", codex_commands)):
        for command in commands:
            executable = command_executable(command)
            if executable is None or not executable.exists():
                add_problem(problems, f"{label} hook command executable is missing: {command}")

    for name, item in sorted(manifest_hooks.items()):
        if not manifest_item_is_registered_pair(item):
            continue
        claude_path = ROOT / item["claude"]
        codex_path = ROOT / item["codex"]
        if not any(command_mentions_path(command, claude_path) for command in claude_commands):
            add_problem(problems, f"Ported Claude hook is not registered in ~/.claude/settings.json: {name}")
        if not any(command_mentions_path(command, codex_path) for command in codex_commands):
            add_problem(problems, f"Ported Codex hook is not registered in codex/hooks.json: {name}")


def audit_registrations(problems: list[str], manifest: dict) -> None:
    check_symlink(
        problems,
        Path.home() / ".codex" / "config.toml",
        ROOT / "codex" / "config.toml",
        "Codex config",
    )
    check_symlink(
        problems,
        Path.home() / ".codex" / "hooks.json",
        ROOT / "codex" / "hooks.json",
        "Codex hooks",
    )
    check_symlink(
        problems,
        Path.home() / ".codex" / "rules",
        ROOT / "codex" / "rules",
        "Codex rules",
    )

    config = tomllib.loads((ROOT / "codex" / "config.toml").read_text())
    if "project_doc_fallback_filenames" in config:
        add_problem(
            problems,
            "codex/config.toml still configures project_doc_fallback_filenames; project Codex instructions now come from AGENTS.md.",
        )
    if not config.get("features", {}).get("hooks"):
        add_problem(problems, "codex/config.toml does not enable features.hooks.")

    registration_paths = {item.get("path") for item in manifest.get("registrations") or []}
    for expected in (
        "codex/AGENTS.md",
        "~/.claude/settings.json",
        "codex/hooks.json",
        "codex/config.toml",
        "bin/install-private-skills",
        "codex/bin/install-skills.sh",
        "codex/rules/default.rules",
    ):
        if expected not in registration_paths:
            add_problem(problems, f"Manifest registrations missing: {expected}")


def _documentation_checker_is_safe(root: Path, checker: Path) -> bool:
    """Return whether checker is a regular, non-symlinked file within root."""
    try:
        checker.resolve().relative_to(root.resolve())
        return checker.is_file() and not checker.is_symlink()
    except (OSError, RuntimeError, ValueError):
        return False


def _run_documentation_audit(
    root: Path,
    checker: Path,
    *,
    checker_argument: str,
    environment: dict[str, str] | None = None,
) -> list[str]:
    """Run checker for root and convert every output line into a problem."""

    try:
        completed = subprocess.run(
            ["python3", checker_argument, "audit", "--root", str(root)],
            cwd=root,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            shell=False,
            check=False,
            env=environment,
        )
    except (OSError, UnicodeError) as error:
        return [f"Documentation audit checker could not run: {error}"]

    problems = [
        line.strip()
        for stream in (completed.stdout, completed.stderr)
        for line in stream.splitlines()
        if line.strip()
    ]
    if completed.returncode and not problems:
        return [
            "Documentation audit checker failed with exit status "
            f"{completed.returncode}"
        ]
    return problems


def documentation_audit_problems(root: Path = ROOT) -> list[str]:
    """Run the canonical working-tree documentation audit."""
    checker = root / "bin" / "docs-audit"
    try:
        checker_exists = checker.exists()
    except OSError:
        checker_exists = False
    if not checker_exists:
        return [f"Documentation audit checker is missing: {checker}"]
    if not _documentation_checker_is_safe(root, checker):
        return [
            "Documentation audit checker is not a regular in-root file: "
            f"{checker}"
        ]
    return _run_documentation_audit(
        root,
        checker,
        checker_argument="bin/docs-audit",
    )


CANDIDATE_DOCS_MATERIALIZATION_ERROR = (
    "Documentation audit could not materialize the proposed commit tree"
)
CANDIDATE_DOCS_FILTERED_PATH_ERROR = (
    "Documentation audit cannot safely model planned filtered or transformed "
    "paths; stage them separately before committing"
)
CANDIDATE_DOCS_MAX_SYMLINK_BYTES = 4096
CANDIDATE_DOCS_COPY_CHUNK_BYTES = 1024 * 1024


def _open_candidate_parent(repo: Path, relative: str) -> tuple[int, str]:
    """Open a candidate path's parent without following any path component."""
    directory_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    try:
        descriptor = os.open(repo, directory_flags)
    except OSError as error:
        raise RuntimeError("candidate repository root could not be opened") from error
    try:
        parts = relative.split("/")
        for part in parts[:-1]:
            child_descriptor = os.open(
                part,
                directory_flags,
                dir_fd=descriptor,
            )
            previous_descriptor = descriptor
            descriptor = child_descriptor
            os.close(previous_descriptor)
        return descriptor, parts[-1]
    except BaseException:
        try:
            os.close(descriptor)
        except OSError:
            pass
        raise


def _sanitized_git_environment() -> dict[str, str]:
    """Return the process environment without inherited Git routing state."""
    environment = {
        key: value
        for key, value in os.environ.items()
        if not key.startswith("GIT_")
    }
    environment["GIT_NO_REPLACE_OBJECTS"] = "1"
    return environment


def _materialize_git_blobs_batch(
    repo: Path,
    entries: dict[str, tuple[str, str]],
    worktree: Path,
    environment: dict[str, str],
) -> bool:
    """Stream raw blobs into a candidate tree through one Git process."""
    process: subprocess.Popen[bytes] | None = None
    succeeded = False
    try:
        process = subprocess.Popen(
            ["git", "-C", str(repo), "cat-file", "--batch"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            shell=False,
            env=environment,
        )
        if process.stdin is None or process.stdout is None:
            return False

        for relative, (mode, object_id) in sorted(entries.items()):
            process.stdin.write(object_id.encode("ascii") + b"\n")
            process.stdin.flush()
            header = process.stdout.readline(257)
            if len(header) > 256 or not header.endswith(b"\n"):
                return False
            fields = header[:-1].split(b" ")
            if len(fields) != 3:
                return False
            raw_object_id, object_type, raw_size = fields
            if (
                raw_object_id != object_id.encode("ascii")
                or object_type != b"blob"
                or not re.fullmatch(rb"0|[1-9][0-9]*", raw_size)
            ):
                return False
            size = int(raw_size)
            destination = worktree.joinpath(*relative.split("/"))
            destination.parent.mkdir(parents=True, exist_ok=True)

            if mode == "120000":
                if size > CANDIDATE_DOCS_MAX_SYMLINK_BYTES:
                    return False
                content = bytearray()
                remaining = size
                while remaining:
                    chunk = process.stdout.read(remaining)
                    if not chunk:
                        return False
                    content.extend(chunk)
                    remaining -= len(chunk)
                target = bytes(content)
                if b"\0" in target:
                    return False
                os.symlink(os.fsdecode(target), destination)
            else:
                remaining = size
                with destination.open("xb") as output_file:
                    while remaining:
                        chunk = process.stdout.read(
                            min(CANDIDATE_DOCS_COPY_CHUNK_BYTES, remaining)
                        )
                        if not chunk:
                            return False
                        output_file.write(chunk)
                        remaining -= len(chunk)
                destination.chmod(0o755 if mode == "100755" else 0o644)

            if process.stdout.read(1) != b"\n":
                return False

        process.stdin.close()
        if process.stdout.read(1) or process.wait() != 0:
            return False
        succeeded = True
        return True
    except (BrokenPipeError, OSError, UnicodeError, ValueError):
        return False
    finally:
        if process is not None:
            if not succeeded:
                try:
                    if process.stdin is not None and not process.stdin.closed:
                        process.stdin.close()
                except OSError:
                    pass
                try:
                    process.terminate()
                except OSError:
                    pass
                try:
                    process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    try:
                        process.kill()
                    except OSError:
                        pass
                    process.wait()
                except OSError:
                    pass
            for pipe in (process.stdin, process.stdout):
                try:
                    if pipe is not None and not pipe.closed:
                        pipe.close()
                except OSError:
                    pass


def candidate_documentation_audit_problems(
    candidate_tree: CommitCandidateTree,
) -> list[str]:
    """Audit the exact canonical commit candidate with the committed checker."""
    if not same_path(candidate_tree.repo_root, ROOT):
        return []

    repo = candidate_tree.repo_root.resolve()
    planned_paths = sorted(candidate_tree.planned_paths)
    if any(
        not path
        or Path(path).is_absolute()
        or "\\" in path
        or any(part in {"", ".", ".."} for part in path.split("/"))
        for path in planned_paths
    ):
        return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]

    base_environment = _sanitized_git_environment()

    def git_process(
        arguments: list[str],
        *,
        environment: dict[str, str] | None = None,
        text: bool = True,
        input_data: str | bytes | None = None,
        input_file: BinaryIO | None = None,
    ) -> subprocess.CompletedProcess:
        input_arguments = (
            {"stdin": input_file} if input_file is not None else {"input": input_data}
        )
        return subprocess.run(
            ["git", "-C", str(repo), *arguments],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=text,
            shell=False,
            env=environment or base_environment,
            **input_arguments,
        )

    try:
        git_dir_result = git_process(["rev-parse", "--absolute-git-dir"])
        objects_result = git_process(["rev-parse", "--git-path", "objects"])
        tree_result = git_process(["write-tree"])
        checker_result = git_process(
            ["show", "HEAD:bin/docs-audit"], text=False
        )
    except OSError:
        return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
    if (
        git_dir_result.returncode
        or objects_result.returncode
        or tree_result.returncode
        or checker_result.returncode
    ):
        return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]

    git_dir = Path(git_dir_result.stdout.strip()).resolve()
    original_objects = Path(objects_result.stdout.strip())
    if not original_objects.is_absolute():
        original_objects = repo / original_objects
    original_objects = original_objects.resolve()
    tree_object = tree_result.stdout.strip()
    if (
        not git_dir.is_absolute()
        or not original_objects.is_absolute()
        or not tree_object
    ):
        return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]

    try:
        with tempfile.TemporaryDirectory(prefix="ai-config-docs-") as temporary:
            temporary_root = Path(temporary).resolve()
            worktree = temporary_root / "tree"
            worktree.mkdir(mode=0o700)
            alternate_index = (temporary_root / "index").resolve()
            temporary_objects = (temporary_root / "objects").resolve()
            temporary_objects.mkdir(mode=0o700)
            trusted_checker = (temporary_root / "docs-audit").resolve()

            trusted_checker.write_bytes(checker_result.stdout)
            trusted_checker.chmod(0o700)

            index_environment = {
                **base_environment,
                "GIT_DIR": str(git_dir),
                "GIT_WORK_TREE": str(repo),
                "GIT_INDEX_FILE": str(alternate_index),
                "GIT_OBJECT_DIRECTORY": str(temporary_objects),
                "GIT_ALTERNATE_OBJECT_DIRECTORIES": str(original_objects),
            }
            read_tree = git_process(
                ["read-tree", tree_object], environment=index_environment
            )
            if read_tree.returncode:
                return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]

            filemode_result = git_process(
                ["config", "--bool", "core.filemode"],
                environment=index_environment,
            )
            filemode_enabled = (
                filemode_result.returncode == 0
                and filemode_result.stdout.strip() == "true"
            )
            autocrlf_result = git_process(
                ["config", "--bool-or-str", "core.autocrlf"],
                environment=index_environment,
            )
            autocrlf_enabled = (
                autocrlf_result.returncode == 0
                and autocrlf_result.stdout.strip() not in {"", "false"}
            )

            for relative in planned_paths:
                if PurePosixPath(relative).name == ".gitattributes":
                    return [CANDIDATE_DOCS_FILTERED_PATH_ERROR]
                try:
                    parent_descriptor, basename = _open_candidate_parent(
                        repo, relative
                    )
                except FileNotFoundError:
                    removal = git_process(
                        ["update-index", "--force-remove", "--", relative],
                        environment=index_environment,
                    )
                    if removal.returncode:
                        return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                    continue
                except (OSError, RuntimeError):
                    return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                try:
                    try:
                        candidate_status = os.stat(
                            basename,
                            dir_fd=parent_descriptor,
                            follow_symlinks=False,
                        )
                    except FileNotFoundError:
                        removal = git_process(
                            ["update-index", "--force-remove", "--", relative],
                            environment=index_environment,
                        )
                        if removal.returncode:
                            return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                        continue

                    for cached_arguments in ([], ["--cached"]):
                        attributes = git_process(
                            [
                                "check-attr",
                                *cached_arguments,
                                "-z",
                                "filter",
                                "text",
                                "eol",
                                "ident",
                                "working-tree-encoding",
                                "--",
                                relative,
                            ],
                            environment=index_environment,
                            text=False,
                        )
                        if attributes.returncode:
                            return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                        attribute_fields = attributes.stdout.split(b"\0")
                        if attribute_fields and attribute_fields[-1] == b"":
                            attribute_fields.pop()
                        if len(attribute_fields) % 3 != 0:
                            return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                        attribute_values = attribute_fields[2::3]
                        if autocrlf_enabled or any(
                            value not in {b"unspecified", b"unset"}
                            for value in attribute_values
                        ):
                            return [CANDIDATE_DOCS_FILTERED_PATH_ERROR]

                    if stat.S_ISLNK(candidate_status.st_mode):
                        mode = "120000"
                        try:
                            content = os.fsencode(
                                os.readlink(basename, dir_fd=parent_descriptor)
                            )
                        except OSError:
                            return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                        if len(content) > CANDIDATE_DOCS_MAX_SYMLINK_BYTES:
                            return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                        blob = git_process(
                            ["hash-object", "-w", "--no-filters", "--stdin"],
                            environment=index_environment,
                            text=False,
                            input_data=content,
                        )
                    elif stat.S_ISREG(candidate_status.st_mode):
                        descriptor = -1
                        try:
                            descriptor = os.open(
                                basename,
                                os.O_RDONLY | os.O_NOFOLLOW,
                                dir_fd=parent_descriptor,
                            )
                            opened_status = os.fstat(descriptor)
                            if not stat.S_ISREG(opened_status.st_mode):
                                return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                            current_mode = opened_status.st_mode
                            with os.fdopen(descriptor, "rb") as input_file:
                                descriptor = -1
                                blob = git_process(
                                    [
                                        "hash-object",
                                        "-w",
                                        "--no-filters",
                                        "--stdin",
                                    ],
                                    environment=index_environment,
                                    text=False,
                                    input_file=input_file,
                                )
                        except OSError:
                            return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                        finally:
                            if descriptor >= 0:
                                try:
                                    os.close(descriptor)
                                except OSError:
                                    pass
                        if filemode_enabled and current_mode & 0o111:
                            mode = "100755"
                        else:
                            mode = "100644"
                            if not filemode_enabled:
                                existing = git_process(
                                    ["ls-files", "--stage", "-z", "--", relative],
                                    environment=index_environment,
                                    text=False,
                                )
                                if existing.returncode:
                                    return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                                record = existing.stdout.split(b"\0", 1)[0]
                                metadata, separator, _path = record.partition(b"\t")
                                fields = metadata.split()
                                if (
                                    separator
                                    and len(fields) == 3
                                    and fields[2] == b"0"
                                ):
                                    existing_mode = fields[0].decode(
                                        "ascii", errors="ignore"
                                    )
                                    if existing_mode in {"100644", "100755"}:
                                        mode = existing_mode
                    else:
                        return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                except OSError:
                    return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                finally:
                    try:
                        os.close(parent_descriptor)
                    except OSError:
                        pass

                if blob.returncode:
                    return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                try:
                    object_id = blob.stdout.decode("ascii").strip()
                except UnicodeDecodeError:
                    return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                if not re.fullmatch(r"[0-9a-f]{40,64}", object_id):
                    return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                update = git_process(
                    [
                        "update-index",
                        "--add",
                        "--cacheinfo",
                        f"{mode},{object_id},{relative}",
                    ],
                    environment=index_environment,
                )
                if update.returncode:
                    return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]

            candidate_environment = {
                **index_environment,
                "GIT_WORK_TREE": str(worktree),
            }
            index_entries_result = git_process(
                ["ls-files", "--stage", "-z"],
                environment=candidate_environment,
                text=False,
            )
            if index_entries_result.returncode:
                return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]

            entries: dict[str, tuple[str, str]] = {}
            normalized_paths: set[str] = set()
            for record in index_entries_result.stdout.split(b"\0"):
                if not record:
                    continue
                metadata, separator, raw_path = record.partition(b"\t")
                fields = metadata.split()
                if not separator or len(fields) != 3:
                    return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                try:
                    mode = fields[0].decode("ascii")
                    object_id = fields[1].decode("ascii")
                    stage = fields[2].decode("ascii")
                    relative = raw_path.decode("utf-8")
                except UnicodeDecodeError:
                    return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                parts = relative.split("/")
                if (
                    stage != "0"
                    or mode not in {"100644", "100755", "120000"}
                    or not re.fullmatch(r"[0-9a-f]{40,64}", object_id)
                    or not relative
                    or PurePosixPath(relative).is_absolute()
                    or "\\" in relative
                    or any(part in {"", ".", ".."} for part in parts)
                    or parts[0].casefold() == ".git"
                    or relative in entries
                ):
                    return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                normalized = unicodedata.normalize("NFC", relative).casefold()
                if normalized in normalized_paths:
                    return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]
                normalized_paths.add(normalized)
                entries[relative] = (mode, object_id)

            tracked_paths = set(entries)
            for relative in tracked_paths:
                parts = relative.split("/")
                if any(
                    "/".join(parts[:index]) in tracked_paths
                    for index in range(1, len(parts))
                ):
                    return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]

            if not _materialize_git_blobs_batch(
                repo,
                entries,
                worktree,
                candidate_environment,
            ):
                return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]

            return _run_documentation_audit(
                worktree,
                trusted_checker,
                checker_argument=str(trusted_checker),
                environment=candidate_environment,
            )
    except (OSError, UnicodeError):
        return [CANDIDATE_DOCS_MATERIALIZATION_ERROR]


def audit_problems(*, include_documentation: bool = True) -> list[str]:
    problems: list[str] = (
        documentation_audit_problems(ROOT) if include_documentation else []
    )
    if not MANIFEST_PATH.exists():
        return [*problems, f"Missing manifest: {MANIFEST}"]

    manifest = load_manifest()
    private_manifest = load_private_manifest()
    audit_tracked_pair_deletions(problems)
    audit_topology(problems)
    audit_known_project_instruction_pairs(problems)
    audit_instructions(problems, manifest)
    audit_skills(problems, manifest, private_manifest)
    audit_parent_drive_skill_pairs(problems)
    audit_duplicate_skill_names(problems)
    audit_private_skills(problems, private_manifest)
    audit_hooks(problems, manifest)
    audit_mcp_servers(problems, manifest)
    audit_registrations(problems, manifest)
    return problems


def audit() -> int:
    problems = audit_problems()

    if problems:
        print("AI config sync audit failed:")
        for problem in problems:
            print(f"- {problem}")
        return 1

    print("AI config sync audit passed.")
    return 0


def check_codex_prompt_roots(prompt_text: str) -> int:
    codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
    active_roots = codex_plugin_skill_roots(
        codex_home,
        load_codex_plugin_list(codex_home),
    )
    stale_roots = stale_codex_prompt_plugin_roots(prompt_text, active_roots)
    if stale_roots:
        print("Stale Codex plugin skill roots in prompt:")
        for path in stale_roots:
            print(f"- {path}")
        print("Active Codex plugin skill roots:")
        for path in active_roots:
            print(f"- {path}")
        return 1
    print("Codex prompt plugin roots are current.")
    return 0


def check_codex_prompt_roots_from_stdin() -> int:
    prompt_text = sys.stdin.read()
    if not prompt_text.strip():
        print("No prompt text on stdin.")
        return 2
    return check_codex_prompt_roots(prompt_text)


def iter_project_claude_files(search_root: Path) -> Iterable[Path]:
    for current, dirs, files in os.walk(search_root):
        dirs[:] = [
            item
            for item in dirs
            if item
            not in {
                ".git",
                ".hg",
                ".svn",
                "node_modules",
                ".venv",
                "venv",
                "__pycache__",
            }
        ]
        if "CLAUDE.md" in files:
            yield Path(current) / "CLAUDE.md"


def skip_project_instruction_migration(path: Path) -> bool:
    return same_path(path, ROOT / GLOBAL_INSTRUCTION_CLAUDE)


def migrate_project_instructions(argv: list[str]) -> int:
    roots = [path_from_token(arg, Path.cwd()) for arg in argv] if argv else [ROOT]
    created: list[Path] = []
    skipped_existing: list[Path] = []
    skipped_nested: list[Path] = []
    skipped_not_git: list[Path] = []

    for search_root in roots:
        if search_root.is_file():
            candidates = [search_root]
        else:
            candidates = list(iter_project_claude_files(search_root))

        for claude_path in candidates:
            repo_root = git_root_for_path(claude_path)
            if repo_root is None:
                skipped_not_git.append(claude_path)
                continue
            try:
                rel = claude_path.relative_to(repo_root).as_posix()
            except ValueError:
                skipped_nested.append(claude_path)
                continue
            if skip_project_instruction_migration(claude_path):
                continue

            codex_path = claude_path.with_name("AGENTS.md")
            if codex_path.exists():
                skipped_existing.append(codex_path)
                continue

            codex_path.write_text(codex_project_instruction_text_from_claude(claude_path))
            created.append(codex_path)

    for path in created:
        print(f"Created {path}")
    for path in skipped_existing:
        print(f"Skipped existing {path}")
    for path in skipped_nested:
        print(f"Skipped nested non-root {path}")
    for path in skipped_not_git:
        print(f"Skipped non-git {path}")

    if not created:
        print("No missing project AGENTS.md files created.")
    return 0


def main() -> int:
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "remind-claude":
        remind_claude()
        return 0
    if mode == "remind-codex":
        remind_codex()
        return 0
    if mode == "guard-commit":
        guard_commit()
        return 0
    if mode == "audit":
        return audit()
    if mode == "check-codex-prompt-roots":
        return check_codex_prompt_roots_from_stdin()
    if mode == "migrate-project-instructions":
        return migrate_project_instructions(sys.argv[2:])
    usage()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
