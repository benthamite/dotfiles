#!/usr/bin/env python3
"""Observe an explicitly selected GitHub Actions snapshot; never push or rerun."""

import argparse
import json
import re
import subprocess
import sys
import time
from urllib.parse import urlsplit


STATUSES = {"queued", "completed", "in_progress", "requested", "waiting", "pending"}
CONCLUSIONS = {"action_required", "cancelled", "failure", "neutral", "skipped", "stale",
               "startup_failure", "success", "timed_out"}
FAILURES = CONCLUSIONS - {"success", "skipped", "neutral"}
RUN_FIELDS = ("databaseId", "attempt", "status", "conclusion", "name", "workflowName",
              "workflowDatabaseId", "event", "headBranch", "headSha", "url", "updatedAt")
COVERAGE = ("Observed snapshot only: this does not prove a push occurred, exclude delayed "
            "workflows, enumerate expected checks, or establish branch-protection coverage.")


class ObservationError(Exception):
    """A sanitized, non-CI evidence failure."""


class ObservationTimeout(ObservationError):
    """The bounded observation did not finish."""


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise ObservationError(message)


def arguments(argv):
    parser = Parser(description=__doc__, epilog=(
        "Exit 0: observed successful runs (see job caveats); 1: observed run/job failure; "
        "2: invalid, incomplete or unverified evidence; 124: observation timeout. "
        "Every gh call is bounded to at most 30 seconds."))
    parser.add_argument("--repo", required=True, metavar="[HOST/]OWNER/REPO")
    parser.add_argument("--commit", required=True, metavar="FULL_SHA")
    parser.add_argument("--branch", required=True)
    parser.add_argument("--event", default="push")
    parser.add_argument("--no-push", action="store_true", help="compatibility no-op; never pushes")
    parser.add_argument("--timeout", type=int, default=900, metavar="SECONDS",
                        help="total observation budget; 0 takes one snapshot with a 30s budget")
    parser.add_argument("--interval", type=int, default=10, metavar="SECONDS")
    parser.add_argument("--limit", type=int, default=20, metavar="N",
                        help="run-list bound (1..1000); a full result is incomplete")
    args = parser.parse_args(argv)
    parts = args.repo.split("/")
    if (len(parts) not in (2, 3)
            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", parts[-2])
            or not re.fullmatch(r"[A-Za-z0-9_.-]+", parts[-1]) or parts[-1] in (".", "..")
            or (len(parts) == 3 and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.-]*", parts[0]))):
        raise ObservationError("--repo must be [HOST/]OWNER/REPO, without a URL or credentials")
    args.host = parts[0].lower() if len(parts) == 3 else "github.com"
    args.repo_path = "/".join(parts[-2:])
    args.request_repo = args.host + "/" + args.repo_path
    if not re.fullmatch(r"[0-9a-fA-F]{40}|[0-9a-fA-F]{64}", args.commit):
        raise ObservationError("--commit must be a full hexadecimal commit SHA")
    args.commit = args.commit.lower()
    if not args.branch or any(ord(char) < 32 or ord(char) == 127 for char in args.branch):
        raise ObservationError("--branch must be a nonempty literal branch name")
    if not re.fullmatch(r"[A-Za-z0-9_]+", args.event):
        raise ObservationError("--event must be a literal Actions event name")
    if args.timeout < 0 or not 1 <= args.interval <= 60 or not 1 <= args.limit <= 1000:
        raise ObservationError("Require timeout >= 0, interval 1..60, and limit 1..1000")
    return args


def strict_json(value):
    def pairs(items):
        result = {}
        for key, item in items:
            if key in result:
                raise ValueError("duplicate key")
            result[key] = item
        return result

    def invalid_number(_value):
        raise ValueError("non-integer JSON number")

    try:
        return json.loads(value, object_pairs_hook=pairs, parse_constant=invalid_number,
                          parse_float=invalid_number)
    except (ValueError, TypeError, RecursionError) as error:
        raise ObservationError("gh returned malformed JSON") from error


def positive_id(value, label):
    if type(value) is not int or value <= 0:
        raise ObservationError(f"Invalid {label}")


def state(record, label):
    status, conclusion = record.get("status"), record.get("conclusion")
    if not isinstance(status, str) or status not in STATUSES:
        raise ObservationError(f"Invalid {label} status")
    if status == "completed":
        if not isinstance(conclusion, str) or conclusion not in CONCLUSIONS:
            raise ObservationError(f"Invalid completed {label} conclusion")
    elif conclusion not in (None, ""):
        raise ObservationError(f"Inconsistent pending {label} conclusion")


def run_record(value, args, *, view_attempt=None):
    if not isinstance(value, dict) or any(field not in value for field in RUN_FIELDS):
        raise ObservationError("Incomplete run record")
    for field in ("databaseId", "attempt", "workflowDatabaseId"):
        positive_id(value[field], "run " + field)
    for field in ("name", "workflowName", "event", "headBranch", "headSha", "url", "updatedAt"):
        if not isinstance(value[field], str):
            raise ObservationError("Invalid run " + field)
    state(value, "run")
    if (value["headBranch"] != args.branch or value["headSha"] != args.commit
            or value["event"] != args.event):
        raise ObservationError("Returned run does not match selected branch/SHA/event")
    try:
        url = urlsplit(value["url"])
        expected_path = f"/{args.repo_path}/actions/runs/{value['databaseId']}"
        attempt_suffix = f"/attempts/{view_attempt}" if view_attempt is not None else ""
        expected_path += attempt_suffix
        if (url.scheme != "https" or url.netloc.lower() != args.host or url.query or url.fragment
                or url.path.lower() != expected_path.lower()
                or (attempt_suffix and not url.path.endswith(attempt_suffix))):
            raise ValueError("mismatch")
    except ValueError as error:
        raise ObservationError("Returned run URL does not match selected repository/run/attempt") from error
    return {field: value[field] for field in RUN_FIELDS}


def job_records(value):
    if not isinstance(value, list):
        raise ObservationError("Missing or invalid jobs evidence")
    result, seen = [], set()
    for job in value:
        if not isinstance(job, dict) or any(field not in job for field in (
                "databaseId", "name", "url", "status", "conclusion")):
            raise ObservationError("Invalid job record")
        positive_id(job.get("databaseId"), "job databaseId")
        if job["databaseId"] in seen:
            raise ObservationError("Duplicate job identity")
        seen.add(job["databaseId"])
        if not isinstance(job.get("name"), str) or not isinstance(job.get("url"), str):
            raise ObservationError("Missing job name or URL")
        state(job, "job")
        result.append({field: job[field] for field in ("databaseId", "name", "url", "status", "conclusion")})
    return result


class Observer:
    def __init__(self, args):
        self.args = args
        self.deadline = time.monotonic() + (args.timeout or 30)
        self.runs = []
        self.logs = []
        self.caveats = []

    def command(self, argv, context):
        remaining = self.deadline - time.monotonic()
        if remaining <= 0:
            raise ObservationTimeout("Observation deadline reached")
        try:
            result = subprocess.run(["gh", *argv], capture_output=True, text=True,
                                    timeout=min(30, remaining))
        except subprocess.TimeoutExpired as error:
            raise ObservationTimeout(context + " exceeded its observation deadline") from error
        except (OSError, UnicodeError) as error:
            raise ObservationError(context + " could not provide readable evidence") from error
        if result.returncode:
            # Never echo arbitrary gh stderr/API bodies (which may contain private data).
            raise ObservationError(f"{context} failed with exit status {result.returncode}")
        return result.stdout

    def listing(self):
        args = self.args
        raw = strict_json(self.command([
            "run", "list", "--repo", args.request_repo, "--commit", args.commit,
            "--branch", args.branch, "--event", args.event, "--limit", str(args.limit),
            "--json", ",".join(RUN_FIELDS)], "Run listing"))
        if not isinstance(raw, list):
            raise ObservationError("Run listing is not an array")
        runs = [run_record(value, args) for value in raw]
        if len({run["databaseId"] for run in runs}) != len(runs):
            raise ObservationError("Duplicate run identity")
        # Filtered REST search is capped at 1000 even if a larger gh limit were used.
        if len(runs) >= args.limit:
            self.runs = runs
            raise ObservationError("Run-list limit reached; matching-run coverage is incomplete")
        return sorted(runs, key=lambda run: run["databaseId"])

    def details(self, run):
        # gh fetches all jobs pages for this exact attempt (not the latest rerun).
        # https://cli.github.com/manual/gh_run_view
        raw = strict_json(self.command([
            "run", "view", str(run["databaseId"]), "--attempt", str(run["attempt"]),
            "--repo", self.args.request_repo, "--json", ",".join((*RUN_FIELDS, "jobs"))],
            f"Run {run['databaseId']} attempt {run['attempt']} inspection"))
        observed = run_record(raw, self.args, view_attempt=run["attempt"])
        # GetRun appends /attempts/N for --attempt N, unlike run-list URLs:
        # https://github.com/cli/cli/blob/trunk/pkg/cmd/run/shared/shared.go#L525-L560
        # Ignore only this validated format difference when comparing; retain
        # the exact-attempt URL returned by gh in the resulting evidence.
        if {**observed, "url": run["url"]} != run:
            raise ObservationError("Run changed during attempt inspection; take another observation")
        return {**observed, "jobs": job_records(raw.get("jobs"))}

    def failed_logs(self, runs):
        for run in runs:
            entry = {"runId": run["databaseId"], "attempt": run["attempt"]}
            try:
                entry["text"] = self.command([
                    "run", "view", str(run["databaseId"]), "--attempt", str(run["attempt"]),
                    "--repo", self.args.request_repo, "--log-failed"],
                    f"Run {run['databaseId']} attempt {run['attempt']} failed-log retrieval")
                entry["status"] = "fetched"
            except ObservationError as error:
                entry.update(status="unavailable", reason=str(error))
            self.logs.append(entry)

    def observe(self):
        while True:
            listed = self.listing()
            self.runs = listed
            if listed and all(run["status"] == "completed" for run in listed):
                self.runs = [self.details(run) for run in listed]
                # A second listing catches visible late runs/reruns, not future ones.
                latest = self.listing()
                if latest == listed:
                    failures = [run for run in self.runs if run["conclusion"] in FAILURES or any(
                        job["conclusion"] in FAILURES for job in run["jobs"])]
                    self.caveats = [
                        {"runId": run["databaseId"], "attempt": run["attempt"],
                         "jobId": job["databaseId"], "conclusion": job["conclusion"]}
                        for run in self.runs for job in run["jobs"]
                        if job["conclusion"] in ("skipped", "neutral")]
                    if failures:
                        self.failed_logs(failures)
                        return 1, "observed_failure", (
                            "Run/job failure evidence observed; job applicability or continue-on-error "
                            "policy still requires workflow review")
                    if any(run["conclusion"] != "success" for run in self.runs):
                        return 2, "not_verified_success", "Skipped/neutral run is not executed-success evidence"
                    if any(not run["jobs"] for run in self.runs):
                        return 2, "incomplete", "Completed run has no observable jobs evidence"
                    if all(job["status"] == "completed" for run in self.runs for job in run["jobs"]):
                        return 0, "observed_success", (
                            "Matching runs report success; skipped/neutral jobs, if any, are separate caveats")
                else:
                    self.runs = latest
            if self.args.timeout == 0 or time.monotonic() >= self.deadline:
                raise ObservationTimeout("No stable, completed observation within the wait budget")
            time.sleep(min(self.args.interval, max(0, self.deadline - time.monotonic())))


def main(argv=None):
    args = None
    observer = None
    try:
        args = arguments(argv)
        observer = Observer(args)
        code, status, reason = observer.observe()
    except ObservationTimeout as error:
        code, status, reason = 124, "pending_or_changed", str(error)
    except ObservationError as error:
        code, status, reason = 2, "incomplete", str(error)
    result = {"schemaVersion": 1, "status": status, "reason": reason,
              "coverage": "observed_snapshot_only", "coverageNote": COVERAGE,
              "runs": observer.runs if observer else [],
              "jobCaveats": observer.caveats if observer else [],
              "failedLogs": observer.logs if observer else []}
    if args:
        result["target"] = {"repository": args.repo, "commit": args.commit,
                            "branch": args.branch, "event": args.event}
    print(json.dumps(result, ensure_ascii=True))
    return code


if __name__ == "__main__":
    sys.exit(main())
