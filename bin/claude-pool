#!/usr/bin/env python3
"""Run Claude Code on a member of an account pool, without needing Emacs.

Pools are declared once, in emacs/agent-accounts.json (Claude accounts
sharing a "pool"), the account list Emacs reads into `agent-claude-accounts'.
This command reads that file itself, so scheduled jobs work whether or not
Emacs is running.

    claude-pool members POOL [--fallback NAME]...         JSON list of {name, home}
    claude-pool run POOL [--fallback NAME]... -- ARGS...  run `claude ARGS...'

`run' tries members in their declared order, then each --fallback account in
the order given. A fallback is any other Claude account in that file; it is
a caller's backup, not a pool member, so Emacs's interactive routing across
the pool is unchanged. Each attempt's stdout and stderr are buffered separately, and an attempt that hits a usage limit is discarded
and the next member tried (likewise a member that is not logged in or whose
login has expired), so the caller sees the output of exactly one attempt.
Work an attempt did before hitting its limit is not undone. Exit codes: the
final attempt's, 75 when no member or fallback is usable (the last stderr line
names the rate-limited and logged-out accounts), 69 when the pool or a
fallback cannot be read.
"""

from __future__ import annotations

import importlib.util
import json
import os
from pathlib import Path
import pwd
import re
import select
import signal
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True  # The checkout is under Drive, where caches do not belong.

BIN = Path(__file__).resolve().parent
CLAUDE = BIN.parent / "shell/shims/claude"
ACCOUNTS = BIN.parent / "emacs/agent-accounts.json"
LIBRARY = BIN.parent / "lib/python/agent_accounts.py"
LIMIT = re.compile(rb"hit your [^\n]{0,40}limit|\"api_error_status\":\s*429|usage limit reached", re.I)
# An expired OAuth session still reports loggedIn locally; only the request fails.
LOGGED_OUT = re.compile(rb"Not logged in|Please run /login|OAuth session expired|could not be refreshed"
                        rb"|Failed to authenticate|Invalid API key|OAuth (?:access )?token (?:is invalid|has expired"
                        rb"|has been revoked)|\"api_error_status\":\s*401", re.I)
EX_UNAVAILABLE, EX_TEMPFAIL = 69, 75
STDIN_WAIT = 3


def unavailable(message: str):
    print(f"claude-pool: {message}", file=sys.stderr)
    sys.exit(EX_UNAVAILABLE)


def accounts() -> list[tuple[str, str, str | None]]:
    """(name, expanded home, pool or None) of every Claude account."""
    try:
        spec = importlib.util.spec_from_file_location("agent_accounts", LIBRARY)
        library = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(library)
        entries = library.load_accounts(ACCOUNTS)["claude"]
    except Exception as error:  # noqa: BLE001 - any failure means the pool cannot be read
        unavailable(f"cannot read the Claude accounts in {ACCOUNTS}: {error}")
    return [(entry["name"], os.path.expanduser(entry["home"]), entry.get("pool")) for entry in entries]


def members(pool: str, fallbacks: list[str] = ()) -> list[dict]:
    """POOL's members in declared order, then each fallback account."""
    parsed = accounts()
    result = [{"name": name, "home": home} for name, home, member_of in parsed if member_of == pool]
    if not result:
        unavailable(f"pool {pool!r} has no members in {ACCOUNTS}")
    for wanted in fallbacks:
        if any(account["name"] == wanted for account in result):
            unavailable(f"fallback {wanted!r} is already in pool {pool!r} or named twice")
        found = [{"name": name, "home": home} for name, home, _ in parsed if name == wanted]
        if len(found) != 1:
            unavailable(f"fallback {wanted!r} matches {len(found)} accounts in {ACCOUNTS}")
        result.extend(found)
    return result


def piped_input() -> bytes | None:
    """Return piped stdin, or None for a terminal or a stdin that stays silent.

An inherited stdin that never closes must not hang a scheduled job, so input
counts only when its first bytes arrive within STDIN_WAIT seconds."""
    if sys.stdin is None or sys.stdin.isatty():
        return None
    ready, _, _ = select.select([sys.stdin], [], [], STDIN_WAIT)
    return sys.stdin.buffer.read() if ready else None


def run(pool: str, fallbacks: list[str], args: list[str]) -> int:
    accounts_to_try = members(pool, fallbacks)
    stdin = piped_input()
    child = None

    def forward(signum, frame):
        if child is not None and child.poll() is None:
            child.send_signal(signum)
    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(signum, forward)
    limited, logged_out = [], []
    for account in accounts_to_try:
        env = {k: v for k, v in os.environ.items() if k not in ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN")}
        env["CLAUDE_CONFIG_DIR"] = account["home"]
        # Claude Code finds its login-keychain credentials by user name, which
        # a minimal job environment may not export.
        user = pwd.getpwuid(os.getuid()).pw_name
        env.setdefault("USER", user)
        env.setdefault("LOGNAME", user)
        # Headless callers choose their own permission mode; the shim's
        # bypass option is refused by --restricted.
        env["CLAUDE_NO_BYPASS_OPTION"] = "1"
        with tempfile.TemporaryFile() as output, tempfile.TemporaryFile() as errors:
            child = subprocess.Popen([str(CLAUDE), *args], stdin=subprocess.PIPE if stdin is not None else subprocess.DEVNULL,
                                     stdout=output, stderr=errors, env=env)
            if stdin is not None:
                child.stdin.write(stdin)
                child.stdin.close()
            code = child.wait()
            output.seek(0)
            errors.seek(0)
            data, diagnostics = output.read(), errors.read()
        # A limit reply is short; a long transcript that merely mentions one is real output.
        tail = data[-4000:] + diagnostics[-4000:]
        if code and LIMIT.search(tail):
            limited.append(account["name"])
            print(f"claude-pool: {account['name']} is at its usage limit", file=sys.stderr)
            continue
        if code and LOGGED_OUT.search(tail):
            logged_out.append(account["name"])
            print(f"claude-pool: {account['name']} is not logged in", file=sys.stderr)
            continue
        print(f"claude-pool: ran on {account['name']}", file=sys.stderr)
        sys.stderr.buffer.write(diagnostics)
        sys.stderr.flush()
        sys.stdout.buffer.write(data)
        sys.stdout.flush()
        return code
    reasons = [f"{label}: {', '.join(names)}" for label, names in
               (("rate-limited", limited), ("logged out", logged_out)) if names]
    scope = pool + "".join(f" or fallback {name}" for name in fallbacks)
    print(f"claude-pool: no member of {scope} is usable ({'; '.join(reasons)})", file=sys.stderr)
    return EX_TEMPFAIL


def options(argv: list[str]) -> tuple[list[str], list[str]] | None:
    """Split leading --fallback NAME pairs from the rest; None when malformed."""
    fallbacks = []
    while argv[:1] == ["--fallback"]:
        if len(argv) < 2 or not argv[1] or argv[1].startswith("-"):
            return None
        fallbacks.append(argv[1])
        argv = argv[2:]
    return fallbacks, argv


def main(argv: list[str]) -> int:
    parsed = options(argv[2:]) if len(argv) >= 2 else None
    if parsed and argv[0] == "members" and not parsed[1]:
        print(json.dumps(members(argv[1], parsed[0])))
        return 0
    if parsed and argv[0] == "run" and parsed[1][:1] == ["--"]:
        return run(argv[1], parsed[0], parsed[1][1:])
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
