   exit 0
 }
 
+deny_op_secret_output() {
+  jq -n --arg tool "$TOOL_NAME" '{
+    "hookSpecificOutput": {
+      "hookEventName": "PreToolUse",
+      "permissionDecision": "deny",
+      "permissionDecisionReason": ("BLOCKED: " + $tool + " would print a 1Password secret into agent output.\n\nInvoking `op-automations` or `op-desktop` is fine; printing what they return is not. Capture the value (`X=$(op-automations read ...)`), redirect it to a mode-0600 file, pipe it to its consumer, use `--out-file` for documents and `inject`, or provision a process with `op-automations run --env-file ... -- <program>` (masked; the program must not dump its environment). Item listings need `| jq` selecting non-secret fields or a redirect.")
+    }
+  }'
+  exit 0
+}
