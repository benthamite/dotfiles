#!/usr/bin/env python3
"""Guarded Ahrefs API helper.

Every paid Ahrefs API call must be preceded by the free subscription-info
quota probe. This wrapper makes that preflight mandatory before forwarding
requests to api.ahrefs.com.

This is an estimated, single-request preflight, not an atomic reservation or a
distributed spending ceiling. Callers must bound costs and coordinate consumers.
"""

from __future__ import annotations

import argparse
import http.client
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass
from typing import Any


DEFAULT_BASE_URL = "https://api.ahrefs.com/v3"
DEFAULT_MIN_REMAINING = 200_000
DEFAULT_OP_REF = "op://Automations/Ahrefs API/credential"
USAGE_PATH = "/subscription-info/limits-and-usage"


class GuardError(RuntimeError):
    pass


class SafeArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        # argparse's default errors echo arbitrary arguments (including secrets).
        self.print_usage(sys.stderr)
        self.exit(2, "Invalid command arguments; use --help for the accepted form.\n")


class NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    def http_error_302(self, req, fp, code, msg, headers):
        # Do not parse, display, or follow Location, even for the same origin.
        fp.close()
        raise GuardError("Ahrefs API redirect refused; no redirected request was sent.")

    http_error_301 = http_error_303 = http_error_307 = http_error_308 = http_error_302


@dataclass(frozen=True)
class Usage:
    used: int
    limit: int
    remaining: int
    key_usage: int | None
    key_limit: int | None
    reset_date: str | None


def normalize_path(path: str) -> str:
    if not re.fullmatch(r"/?[a-z0-9_-]+(?:/[a-z0-9_-]+)*", path):
        raise GuardError("Invalid API path; use a relative endpoint without query or fragment.")
    return path if path.startswith("/") else f"/{path}"


def validate_base_url(base_url: str) -> None:
    if base_url not in (DEFAULT_BASE_URL, DEFAULT_BASE_URL + "/"):
        raise GuardError("Only the official HTTPS Ahrefs v3 base URL is permitted.")


def is_free_usage_endpoint(path: str) -> bool:
    return normalize_path(path) == USAGE_PATH


def parse_params(items: list[str]) -> dict[str, str]:
    params: dict[str, str] = {}
    for item in items:
        if "=" not in item:
            raise GuardError("Invalid --param; expected KEY=VALUE.")
        key, value = item.split("=", 1)
        if not key:
            raise GuardError("Invalid --param; key is empty.")
        params[key] = value
    return params


def op_reader_for(op_ref: str) -> list[str]:
    """Pick the 1Password wrapper that can serve this reference without prompting.

    A child process inherits neither the `op` shell function from .zshenv nor a
    guaranteed PATH where shell/shims wins, so calling bare `op` here is what
    produced a stray Touch ID prompt: the Automations vault is served by a
    read-only service account, but a personal-vault reference needs the
    op-desktop broker, and bare `op` gets neither.
    """
    if op_ref.startswith("op://Automations/"):
        return ["op-automations", "read", op_ref]
    return ["op-desktop", "read", op_ref]


def api_key_from_env_or_op(env: dict[str, str], op_ref: str) -> str:
    key = env.get("AHREFS_API_KEY")
    if key:
        return key
    try:
        result = subprocess.run(
            op_reader_for(op_ref),
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
    except (FileNotFoundError, subprocess.CalledProcessError) as exc:
        raise GuardError(
            "AHREFS_API_KEY is not set and 1Password lookup failed. "
            "Run through an op-enabled environment or set AHREFS_API_KEY."
        ) from exc
    key = result.stdout.strip()
    if not key:
        raise GuardError("1Password returned an empty Ahrefs API key.")
    return key


def build_url(base_url: str, path: str, params: dict[str, str] | None = None) -> str:
    validate_base_url(base_url)
    url = DEFAULT_BASE_URL + normalize_path(path)
    if params:
        try:
            return f"{url}?{urllib.parse.urlencode(params)}"
        except UnicodeError:
            raise GuardError("Invalid query parameter encoding.") from None
    return url


def request_json(
    method: str,
    url: str,
    api_key: str,
    *,
    body: bytes | None = None,
    urlopen=None,
) -> Any:
    # Keep the injectable callable for offline tests, but make the real default
    # a fresh opener whose redirect handler never forwards Authorization.
    try:
        parsed = urllib.parse.urlsplit(url)
    except ValueError:
        raise GuardError("Invalid request URL.") from None
    if (parsed.scheme != "https" or parsed.netloc != "api.ahrefs.com"
            or parsed.fragment or not parsed.path.startswith("/v3/")):
        raise GuardError("Only official HTTPS Ahrefs v3 request destinations are permitted.")
    normalize_path(parsed.path[3:])
    if url != urllib.parse.urlunsplit(parsed):
        raise GuardError("Invalid request URL.")
    if method not in ("GET", "POST"):
        raise GuardError("Only GET and POST requests are supported.")
    headers = {"Authorization": f"Bearer {api_key}", "User-Agent": "ahrefs-api-guard/1.0"}
    if body is not None:
        headers["Content-Type"] = "application/json"
    try:
        request = urllib.request.Request(url, data=body, method=method, headers=headers)
        if urlopen is None:
            urlopen = urllib.request.build_opener(NoRedirectHandler()).open
        with urlopen(request, timeout=60) as response:
            raw = response.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        # Never read or include the body, reason, URL, or Location in diagnostics.
        exc.close()
        raise GuardError(f"Ahrefs API returned HTTP {exc.code}; no retry was attempted.") from None
    except (urllib.error.URLError, OSError, ValueError, http.client.HTTPException):
        raise GuardError("Ahrefs API transport or response decoding failed; no retry was attempted.") from None
    try:
        return json.loads(raw, parse_constant=reject_json_constant)
    except (ValueError, RecursionError):
        raise GuardError("Ahrefs API returned an empty or invalid JSON response.") from None


def reject_json_constant(value: str) -> None:
    raise ValueError("Non-finite constants are not valid JSON.")


def nonnegative_integer(value: Any, label: str) -> int:
    if type(value) is not int or value < 0:
        raise GuardError(f"{label} must be a nonnegative integer.")
    return value


def validate_cost(min_remaining: int, estimated_cost: int | None, *, paid: bool) -> None:
    nonnegative_integer(min_remaining, "Minimum reserve")
    if estimated_cost is None and not paid:
        return
    if type(estimated_cost) is not int or estimated_cost <= 0:
        raise GuardError("Paid requests require an explicit positive conservative --estimated-cost.")


def fetch_usage(api_key: str, base_url: str, *, urlopen=None) -> Usage:
    payload = request_json(
        "GET",
        build_url(base_url, USAGE_PATH),
        api_key,
        urlopen=urlopen,
    )
    if not isinstance(payload, dict) or not isinstance(payload.get("limits_and_usage"), dict):
        raise GuardError("Ahrefs usage probe returned an invalid quota object.")
    data = payload["limits_and_usage"]
    used = nonnegative_integer(data.get("units_usage_workspace"), "Workspace usage")
    limit = nonnegative_integer(data.get("units_limit_workspace"), "Workspace limit")
    if limit == 0:
        raise GuardError("Ahrefs usage probe did not return a positive workspace limit.")
    key_usage = nonnegative_integer(data.get("units_usage_api_key"), "API-key usage")
    if "units_limit_api_key" not in data:
        raise GuardError("Ahrefs usage probe did not return the API-key limit.")
    key_limit = data["units_limit_api_key"]
    if key_limit is not None:
        key_limit = nonnegative_integer(key_limit, "API-key limit")
    return Usage(
        used=used,
        limit=limit,
        remaining=limit - used,
        key_usage=key_usage,
        key_limit=key_limit,
        reset_date=data.get("usage_reset_date"),
    )


def assert_budget_allows_call(
    usage: Usage,
    *,
    min_remaining: int,
    estimated_cost: int,
) -> None:
    validate_cost(min_remaining, estimated_cost, paid=True)
    projected_remaining = usage.remaining - estimated_cost
    if projected_remaining < min_remaining:
        raise GuardError(
            "Ahrefs guard blocked paid API call: "
            f"{usage.remaining:,} units remain before call, "
            f"estimated cost is {estimated_cost:,}, "
            f"projected remaining is {projected_remaining:,}, "
            f"minimum required reserve is {min_remaining:,}."
        )
    if usage.key_limit is not None:
        key_usage = nonnegative_integer(usage.key_usage, "API-key usage")
        key_limit = nonnegative_integer(usage.key_limit, "API-key limit")
        if key_limit - key_usage < estimated_cost:
            raise GuardError("Ahrefs guard blocked paid API call: estimated cost exceeds API-key headroom.")


def usage_payload(usage: Usage) -> dict[str, Any]:
    return {
        "units_usage_workspace": usage.used,
        "units_limit_workspace": usage.limit,
        "units_remaining_workspace": usage.remaining,
        "units_usage_api_key": usage.key_usage,
        "units_limit_api_key": usage.key_limit,
        "usage_reset_date": usage.reset_date,
    }


def build_parser() -> argparse.ArgumentParser:
    parser = SafeArgumentParser(description="Guarded Ahrefs API access (estimated preflight, not a spend ceiling)")
    parser.add_argument("--base-url", default=DEFAULT_BASE_URL, help="Official HTTPS Ahrefs v3 URL only")
    parser.add_argument("--op-ref", default=DEFAULT_OP_REF)

    sub = parser.add_subparsers(dest="cmd", required=True)

    usage = sub.add_parser("usage", help="Print free Ahrefs quota state")
    usage.set_defaults(func=cmd_usage)

    request = sub.add_parser("request", help="Run an Ahrefs API request after quota guard")
    request.add_argument("path", help="API path, e.g. /site-explorer/all-backlinks")
    request.add_argument("--method", choices=("GET", "POST"), default="GET")
    request.add_argument("--param", action="append", default=[], help="Query parameter KEY=VALUE")
    request.add_argument("--json-body", help="JSON request body")
    request.add_argument("--min-remaining", type=int, default=DEFAULT_MIN_REMAINING)
    request.add_argument("--estimated-cost", type=int, help="Required positive conservative bound for paid requests")
    request.set_defaults(func=cmd_request)

    return parser


def cmd_usage(args: argparse.Namespace) -> int:
    validate_base_url(args.base_url)
    key = api_key_from_env_or_op(os.environ, args.op_ref)
    usage = fetch_usage(key, args.base_url)
    print(json.dumps(redact_key(usage_payload(usage), key), indent=2, sort_keys=True))
    return 0


def cmd_request(args: argparse.Namespace) -> int:
    # Validate every local input before credentials, quota probes, or paid IO.
    validate_base_url(args.base_url)
    path = normalize_path(args.path)
    free = is_free_usage_endpoint(path)
    validate_cost(args.min_remaining, args.estimated_cost, paid=not free)
    params = parse_params(args.param)
    if params.get("output", "json") != "json":
        raise GuardError("This wrapper requires output=json.")
    if free and (args.method != "GET" or args.json_body is not None):
        raise GuardError("The free usage endpoint requires GET with no body.")
    body = None
    if args.json_body is not None:
        try:
            body = json.dumps(json.loads(args.json_body), allow_nan=False).encode("utf-8")
        except (ValueError, RecursionError):
            raise GuardError("Invalid --json-body; expected valid JSON.") from None
    url = build_url(args.base_url, path, params)
    key = api_key_from_env_or_op(os.environ, args.op_ref)

    if not free:
        usage = fetch_usage(key, args.base_url)
        assert_budget_allows_call(
            usage,
            min_remaining=args.min_remaining,
            estimated_cost=args.estimated_cost,
        )
        print(
            "Ahrefs guard passed: "
            f"{usage.remaining:,} units remaining; "
            f"reserve {args.min_remaining:,}; "
            f"estimated cost {args.estimated_cost:,}.",
            file=sys.stderr,
        )

    data = request_json(
        args.method,
        url,
        key,
        body=body,
    )
    print(json.dumps(redact_key(data, key), indent=2, sort_keys=True))
    return 0


def redact_key(value: Any, key: str) -> Any:
    """Prevent a JSON response that echoes our credential from printing it."""
    if isinstance(value, str):
        return value.replace(key, "[REDACTED]")
    if isinstance(value, list):
        return [redact_key(item, key) for item in value]
    if isinstance(value, dict):
        return {redact_key(name, key): redact_key(item, key) for name, item in value.items()}
    return value


def main() -> int:
    args = build_parser().parse_args()
    try:
        return args.func(args)
    except GuardError as exc:
        print(str(exc), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
