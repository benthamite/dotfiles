#!/usr/bin/env python3
"""Audit dotfiles documentation ownership, links, and generated outputs."""

from __future__ import annotations

import argparse
import json
import os
import posixpath
import re
import subprocess
import sys
import tempfile
from collections import Counter
from dataclasses import dataclass
from pathlib import Path, PurePosixPath, PureWindowsPath


REPO_ROOT = Path(__file__).resolve().parents[1]
POLICY_PATH = PurePosixPath("docs/readme-policy.json")
POLICY_KEYS = {
    "version",
    "required_readmes",
    "required_nested_readmes",
    "exempt_readmes",
    "source_generated",
    "indexed_directories",
    "skill_inventory",
    "project_local_skill_documentation_owner",
}
SOURCE_GENERATED_KEYS = {"source", "generated"}
INDEXED_DIRECTORY_REQUIRED_KEYS = {"path", "readme", "mode", "headings"}
INDEXED_DIRECTORY_OPTIONAL_KEYS = {"ignored_basenames"}
INDEXED_DIRECTORY_MODES = {"executable", "file"}
DIRECTORY_MAP_HEADING = "* Directory map"
DIRECTORY_MAP_ROW = re.compile(r"^\s*\|\s*=([^=|\s]+)=\s*\|")
INDEX_ROW = re.compile(r"^\s*\|\s*=([^=|\r\n]+)=\s*\|")
ORG_HEADING = re.compile(r"^(\*+) [^\r\n]+$")
ORG_BRACKET_LINK = re.compile(r"\[\[([^\]\n]+)\](?:\[[^\]\n]*\])?\]")
ORG_ANGLE_LINK = re.compile(r"<([A-Za-z][A-Za-z0-9+.-]*):([^>\n]*)>")
ORG_PLAIN_LINK = re.compile(
    r"(?<!\w)([A-Za-z][A-Za-z0-9+.-]*):([^\[\]\s()<>]*[\w/])"
)
ORG_LITERAL_BLOCK = re.compile(
    r"^[ \t]*#\+begin_(src|example|export|comment)\b[^\n]*\n"
    r".*?^[ \t]*#\+end_\1\b[^\n]*(?:\n|$)",
    re.IGNORECASE | re.MULTILINE | re.DOTALL,
)
ORG_INLINE_CODE = re.compile(r"(?<!\w)([=~])(?=\S)([^\n]*?\S)\1(?!\w)")
ORG_FIXED_WIDTH_LINE = re.compile(r"^[ \t]*:[ \t].*(?:\n|$)", re.MULTILINE)
ORG_INLINE_SOURCE = re.compile(
    r"\bsrc_[A-Za-z0-9_+-]+(?:\[[^\]\n]*\])?\{[^}\n]*\}"
)
ORG_COMMENT_LINE = re.compile(r"^[ \t]*#[ \t].*(?:\n|$)", re.MULTILINE)
SKILL_SCOPES = (
    "Global",
    "Project-local: dotfiles",
    "Project-local: emacs",
    "Project-local: macos",
    "Programmatic",
    "Archived",
)
SKILL_TOOLS = ("Claude", "Codex")
SKILL_INVENTORY_HEADER = """#+title: Tracked agent skill inventory

This file is generated by =bin/docs-audit generate=. Do not edit it manually.
It covers tracked public skills in this repository. Dynamic plugins, ignored
runtime system skills, private skills, and skills in other repositories are
outside its scope.
"""
YAML_NON_STRING_SCALARS = {
    "~",
    "null",
    "true",
    "false",
    "yes",
    "no",
    "on",
    "off",
    ".nan",
    ".inf",
    "+.inf",
    "-.inf",
}
YAML_NUMBER = re.compile(
    r"[-+]?(?:0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|"
    r"(?:\d[\d_]*(?:\.\d[\d_]*)?|\.\d[\d_]+)(?:[eE][-+]?\d+)?)"
)
YAML_DATE = re.compile(r"\d{4}-\d{2}-\d{2}(?:[Tt ][^\s]+)?")
CLI_ROOT_ERROR = "Repository root is unavailable or not a Git worktree"
CLI_ROOT_ERROR_EXIT = 2


@dataclass(frozen=True)
class SkillInventoryRow:
    """One consolidated row in the tracked public skill inventory."""

    name: str
    description: str
    scope: str
    tools: tuple[str, ...]
    paths: tuple[str, ...]


@dataclass(frozen=True)
class _SkillDefinition:
    name: str
    description: str
    scope: str
    tool: str
    path: str


@dataclass(frozen=True)
class _SkillInventoryResult:
    rows: tuple[SkillInventoryRow, ...]
    problems: tuple[str, ...]


def git_files(root: Path) -> list[str]:
    """Return repository-relative POSIX paths tracked by Git."""
    result = subprocess.run(
        ["git", "ls-files", "-z"],
        cwd=root,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        shell=False,
    )
    return sorted(path for path in result.stdout.split("\0") if path)


def tracked_top_level_directories(root: Path) -> set[str]:
    """Return top-level directories containing tracked files."""
    return {
        PurePosixPath(path).parts[0]
        for path in git_files(root)
        if len(PurePosixPath(path).parts) > 1
    }


def git_index_entries(root: Path) -> list[tuple[str, str]]:
    """Return tracked Git modes and repository-relative paths."""
    result = subprocess.run(
        ["git", "ls-files", "--stage", "-z"],
        cwd=root,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        shell=False,
    )
    entries = []
    for record in result.stdout.split("\0"):
        if not record:
            continue
        metadata, path = record.split("\t", 1)
        mode = metadata.split(" ", 1)[0]
        entries.append((mode, path))
    return sorted(entries, key=lambda entry: entry[1])


def _path_is_contained(root: Path, path: Path) -> bool:
    try:
        path.resolve(strict=False).relative_to(root.resolve())
    except (OSError, RuntimeError, ValueError):
        return False
    return True


def safe_contained_file(root: Path, relative: str | PurePosixPath) -> Path | None:
    """Return a regular file only when its resolved path stays within root."""
    relative_path = PurePosixPath(relative)
    path = root.joinpath(*relative_path.parts)
    if not _path_is_contained(root, path):
        return None
    try:
        return path if path.is_file() else None
    except OSError:
        return None


def _path_has_symlink_component(
    root: Path, relative: str | PurePosixPath
) -> bool:
    """Return whether any existing path component beneath root is a symlink."""
    candidate = root
    for part in PurePosixPath(relative).parts:
        candidate = candidate / part
        if candidate.is_symlink():
            return True
    return False


def _frontmatter_string(value: str) -> str | None:
    value = value.strip()
    if not value:
        return None

    if value.startswith('"'):
        try:
            decoded = json.loads(value)
        except (json.JSONDecodeError, TypeError):
            return None
        if not isinstance(decoded, str):
            return None
    elif value.startswith("'"):
        if len(value) < 2 or not value.endswith("'"):
            return None
        inner = value[1:-1]
        index = 0
        while index < len(inner):
            if inner[index] != "'":
                index += 1
                continue
            if index + 1 >= len(inner) or inner[index + 1] != "'":
                return None
            index += 2
        decoded = inner.replace("''", "'")
    else:
        if (
            value[0] in "-?:,[]{}#&*!|>'\"%@`"
            or re.search(r"[ \t]#", value)
            or re.search(r":[ \t]", value)
            or value.casefold() in YAML_NON_STRING_SCALARS
        ):
            return None
        if YAML_NUMBER.fullmatch(value) or YAML_DATE.fullmatch(value):
            return None
        decoded = value

    if not decoded.strip() or "\n" in decoded or "\r" in decoded:
        return None
    return decoded


def _invalid_frontmatter_problem(field: str, relative: str) -> str:
    return (
        f"Invalid skill frontmatter {field} "
        f"(expected a nonempty single-line string): {relative}"
    )


def parse_skill_frontmatter(text: str, relative: str) -> tuple[str, str]:
    """Parse exact required keys from the supported frontmatter subset.

    Required keys must be unquoted ``name:`` and ``description:`` entries.
    Values may be plain strings, YAML single-quoted strings, or JSON-compatible
    double-quoted strings; YAML comments and all other scalar forms are invalid.
    """
    lines = text.splitlines()
    if not lines or lines[0] != "---":
        raise ValueError(f"Skill frontmatter opening delimiter is missing: {relative}")
    try:
        closing = lines.index("---", 1)
    except ValueError as error:
        raise ValueError(
            f"Skill frontmatter closing delimiter is missing: {relative}"
        ) from error

    required = {"name", "description"}
    fields: dict[str, str | None] = {}
    seen: set[str] = set()
    invalid: set[str] = set()
    for line in lines[1:closing]:
        raw_key, separator, raw_value = line.partition(":")
        if not separator:
            continue

        stripped_key = raw_key.strip()
        if stripped_key in required:
            field = stripped_key
            exact_key = raw_key == field
        elif (
            len(stripped_key) >= 2
            and stripped_key[0] == stripped_key[-1]
            and stripped_key[0] in "'\""
            and stripped_key[1:-1] in required
        ):
            field = stripped_key[1:-1]
            exact_key = False
        else:
            continue

        if field in seen:
            invalid.add(field)
        seen.add(field)
        if not exact_key:
            invalid.add(field)
            continue
        fields[field] = _frontmatter_string(raw_value)

    name = fields.get("name")
    description = fields.get("description")
    if "name" in invalid or name is None:
        raise ValueError(_invalid_frontmatter_problem("name", relative))
    if "description" in invalid or description is None:
        raise ValueError(_invalid_frontmatter_problem("description", relative))
    return name, description


def _excluded_skill_path(relative: str) -> bool:
    parts = PurePosixPath(relative).parts
    return "private-skills" in parts or any(
        left == "skills" and right == ".system"
        for left, right in zip(parts, parts[1:])
    )


def _skill_scope(relative: str) -> str | None:
    parts = PurePosixPath(relative).parts
    if parts[0] == "archive":
        return "Archived"
    if "programmatic-skills" in parts:
        return "Programmatic"
    if parts[:2] in {("emacs", ".claude"), ("emacs", ".codex")}:
        return "Project-local: emacs"
    if parts[:2] in {("macos", ".claude"), ("macos", ".codex")}:
        return "Project-local: macos"
    if parts[0] in {".claude", ".codex"}:
        return "Project-local: dotfiles"
    if len(parts) >= 2 and parts[0] in {"claude", "codex"} and parts[1] == "skills":
        return "Global"
    return None


def _skill_tool(relative: str) -> str | None:
    parts = PurePosixPath(relative).parts
    claude = (
        parts[0] in {"claude", ".claude"}
        or ".claude" in parts
        or parts[:2] == ("archive", "claude")
    )
    codex = (
        parts[0] in {"codex", ".codex"}
        or ".codex" in parts
        or parts[:2] == ("archive", "codex")
    )
    if claude == codex:
        return None
    return "Claude" if claude else "Codex"


def _skill_row_sort_key(row: SkillInventoryRow) -> tuple[object, ...]:
    return (
        row.name.casefold(),
        row.name,
        SKILL_SCOPES.index(row.scope),
        row.description,
        row.tools,
        row.paths,
    )


def _skill_inventory_result(root: Path) -> _SkillInventoryResult:
    definitions: list[_SkillDefinition] = []
    problems: list[str] = []
    for relative in git_files(root):
        if not relative.endswith("/SKILL.md") or _excluded_skill_path(relative):
            continue

        scope = _skill_scope(relative)
        if scope is None:
            problems.append(
                f"Tracked skill is outside known public roots: {relative}"
            )
            continue
        tool = _skill_tool(relative)
        if tool is None:
            problems.append(
                "Tracked skill path does not identify exactly one tool: "
                f"{relative}"
            )
            continue

        candidate = root.joinpath(*PurePosixPath(relative).parts)
        if candidate.is_symlink():
            problems.append(f"Tracked skill must not be a symlink: {relative}")
            continue
        path = safe_contained_file(root, relative)
        if path is None:
            problems.append(f"Tracked skill could not be read: {relative}")
            continue
        resolved_relative = path.resolve().relative_to(root.resolve()).as_posix()
        if (
            not resolved_relative.endswith("/SKILL.md")
            or _excluded_skill_path(resolved_relative)
        ):
            problems.append(
                f"Tracked public skill resolves to excluded content: {relative}"
            )
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            problems.append(f"Tracked skill could not be read: {relative}")
            continue
        try:
            name, description = parse_skill_frontmatter(text, relative)
        except ValueError as error:
            problems.append(str(error))
            continue
        definitions.append(
            _SkillDefinition(name, description, scope, tool, relative)
        )

    grouped: dict[tuple[str, str], list[_SkillDefinition]] = {}
    for definition in definitions:
        grouped.setdefault((definition.scope, definition.name), []).append(
            definition
        )

    rows: list[SkillInventoryRow] = []
    for (scope, name), group in sorted(grouped.items()):
        descriptions = {definition.description for definition in group}
        if len(descriptions) != 1:
            paths = ", ".join(sorted(definition.path for definition in group))
            problems.append(
                f"Conflicting skill definitions in scope {scope} for name {name}: "
                f"{paths}"
            )
            continue
        tools = tuple(
            tool
            for tool in SKILL_TOOLS
            if any(definition.tool == tool for definition in group)
        )
        paths = tuple(sorted(definition.path for definition in group))
        rows.append(
            SkillInventoryRow(name, descriptions.pop(), scope, tools, paths)
        )

    return _SkillInventoryResult(
        tuple(sorted(rows, key=_skill_row_sort_key)),
        tuple(sorted(set(problems))),
    )


def skill_inventory_input_problems(root: Path) -> list[str]:
    """Report invalid, conflicting, or unknown tracked public skill inputs."""
    return list(_skill_inventory_result(root).problems)


def skill_inventory_rows(root: Path) -> list[SkillInventoryRow]:
    """Return consolidated inventory rows when every tracked input is valid."""
    result = _skill_inventory_result(root)
    if result.problems:
        raise ValueError("\n".join(result.problems))
    return list(result.rows)


def _org_table_cell(value: str) -> str:
    return value.replace("\\", "\\\\").replace("|", "\\|")


def _org_code(value: str) -> str:
    return f"={value}=" if "=" not in value else value


def render_skill_inventory(rows: list[SkillInventoryRow]) -> str:
    """Render inventory rows as deterministic Org tables."""
    lines = SKILL_INVENTORY_HEADER.rstrip("\n").splitlines()
    ordered = sorted(rows, key=_skill_row_sort_key)
    for scope in SKILL_SCOPES:
        scoped_rows = [row for row in ordered if row.scope == scope]
        if not scoped_rows:
            continue
        lines.extend(
            [
                "",
                f"* {scope}",
                "",
                "| Skill | Tools | Description | Paths |",
                "|-------+-------+-------------+-------|",
            ]
        )
        for row in scoped_rows:
            tools = ", ".join(
                tool for tool in SKILL_TOOLS if tool in row.tools
            )
            paths = ", ".join(
                _org_code(path) for path in sorted(row.paths)
            )
            cells = (
                _org_code(row.name),
                tools,
                row.description,
                paths,
            )
            lines.append(
                "| " + " | ".join(_org_table_cell(cell) for cell in cells) + " |"
            )
    return "\n".join(lines) + "\n"


def _skill_inventory_path(
    root: Path, policy: dict
) -> tuple[str | None, Path | None, list[str]]:
    relative = policy.get("skill_inventory")
    if not isinstance(relative, str) or not _valid_skill_inventory_path(
        root, relative
    ):
        return None, None, ["Generated skill inventory path is invalid"]
    path = root.joinpath(*PurePosixPath(relative).parts)
    try:
        if _path_has_symlink_component(root, relative):
            return (
                relative,
                path,
                [
                    "Generated skill inventory path contains a symlink: "
                    f"{relative}"
                ],
            )
    except OSError:
        return relative, path, [f"Generated skill inventory is invalid: {relative}"]
    return relative, path, []


def skill_inventory_problems(root: Path, policy: dict) -> list[str]:
    """Report invalid inputs and missing, unreadable, or stale inventory output."""
    result = _skill_inventory_result(root)
    if result.problems:
        return list(result.problems)

    relative, _, path_problems = _skill_inventory_path(root, policy)
    if path_problems:
        return path_problems
    assert relative is not None
    path = safe_contained_file(root, relative)
    if path is None:
        return [f"Generated skill inventory is stale: {relative}"]
    try:
        actual = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return [f"Generated skill inventory is invalid: {relative}"]
    expected = render_skill_inventory(list(result.rows))
    if actual != expected:
        return [f"Generated skill inventory is stale: {relative}"]
    return []


def write_skill_inventory(root: Path, policy: dict) -> list[str]:
    """Atomically write the configured inventory, returning fail-closed problems."""
    validation_problems = policy_validation_problems(root, policy)
    if validation_problems:
        return validation_problems
    result = _skill_inventory_result(root)
    if result.problems:
        return list(result.problems)

    relative, destination, path_problems = _skill_inventory_path(root, policy)
    if path_problems:
        return path_problems
    assert relative is not None and destination is not None
    temporary: Path | None = None
    try:
        destination.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            newline="\n",
            prefix=f".{destination.name}.",
            dir=destination.parent,
            delete=False,
        ) as handle:
            temporary = Path(handle.name)
            handle.write(render_skill_inventory(list(result.rows)))
            handle.flush()
            os.fsync(handle.fileno())
        temporary.chmod(0o644)
        os.replace(temporary, destination)
        temporary = None
    except OSError:
        return [f"Generated skill inventory could not be written: {relative}"]
    finally:
        if temporary is not None:
            try:
                temporary.unlink()
            except OSError:
                pass
    return []


def _valid_policy_path(root: Path, value: str) -> bool:
    if not _valid_policy_path_syntax(value):
        return False
    path = PurePosixPath(value)
    return _path_is_contained(root, root.joinpath(*path.parts))


def _valid_policy_path_syntax(value: str) -> bool:
    if not value or "\\" in value:
        return False
    windows_path = PureWindowsPath(value)
    if windows_path.drive or windows_path.is_absolute():
        return False
    parts = value.split("/")
    if any(part in {"", ".", ".."} for part in parts):
        return False
    path = PurePosixPath(value)
    if path.is_absolute():
        return False
    return True


def _valid_ignored_basename(value: str) -> bool:
    return (
        bool(value)
        and value not in {".", ".."}
        and "/" not in value
        and "\\" not in value
    )


def _valid_skill_inventory_path(root: Path, value: str) -> bool:
    """Validate an inventory path without following its final component."""
    if not _valid_policy_path_syntax(value):
        return False
    path = root.joinpath(*PurePosixPath(value).parts)
    return _path_is_contained(root, path.parent)


def policy_validation_problems(root: Path, policy: object) -> list[str]:
    """Report every Task-1 policy schema, type, and path problem."""
    if not isinstance(policy, dict):
        return ["README policy must be a JSON object"]

    problems: list[str] = []
    keys = set(policy)
    for key in POLICY_KEYS - keys:
        problems.append(f"README policy is missing required key: {key}")
    for key in keys - POLICY_KEYS:
        problems.append(f"README policy contains unexpected key: {key}")

    if "version" in policy and (
        type(policy["version"]) is not int or policy["version"] != 1
    ):
        problems.append("README policy version must be exactly 1")

    required = policy.get("required_readmes")
    if "required_readmes" in policy:
        if not isinstance(required, list):
            problems.append(
                "README policy key has invalid type: required_readmes (expected array)"
            )
        else:
            for index, directory in enumerate(required):
                field = f"required_readmes[{index}]"
                if not isinstance(directory, str):
                    problems.append(
                        f"README policy value has invalid type: {field} (expected string)"
                    )
                elif not _valid_policy_path(root, directory):
                    problems.append(f"README policy path is invalid: {field}")

    required_nested = policy.get("required_nested_readmes")
    if "required_nested_readmes" in policy:
        if not isinstance(required_nested, list):
            problems.append(
                "README policy key has invalid type: "
                "required_nested_readmes (expected array)"
            )
        else:
            for index, readme in enumerate(required_nested):
                field = f"required_nested_readmes[{index}]"
                if not isinstance(readme, str):
                    problems.append(
                        f"README policy value has invalid type: {field} (expected string)"
                    )
                elif not _valid_policy_path(root, readme):
                    problems.append(f"README policy path is invalid: {field}")

    exempt = policy.get("exempt_readmes")
    if "exempt_readmes" in policy:
        if not isinstance(exempt, dict):
            problems.append(
                "README policy key has invalid type: exempt_readmes (expected object)"
            )
        else:
            for index, (directory, reason) in enumerate(
                sorted(exempt.items(), key=lambda item: str(item[0]))
            ):
                field = f"exempt_readmes[{index}]"
                if not isinstance(directory, str):
                    problems.append(
                        f"README policy value has invalid type: {field} (expected string key)"
                    )
                elif not _valid_policy_path(root, directory):
                    problems.append(f"README policy path is invalid: {field}")
                if not isinstance(reason, str):
                    problems.append(
                        f"README policy value has invalid type: {field} (expected string reason)"
                    )

    pairs = policy.get("source_generated")
    if "source_generated" in policy:
        if not isinstance(pairs, list):
            problems.append(
                "README policy key has invalid type: source_generated (expected array)"
            )
        else:
            for index, pair in enumerate(pairs):
                prefix = f"source_generated[{index}]"
                if not isinstance(pair, dict):
                    problems.append(f"README policy {prefix} must be an object")
                    continue
                for key in SOURCE_GENERATED_KEYS - set(pair):
                    problems.append(f"README policy {prefix} is missing required key: {key}")
                for key in set(pair) - SOURCE_GENERATED_KEYS:
                    problems.append(
                        f"README policy {prefix} contains unexpected key: {key}"
                    )
                for key in SOURCE_GENERATED_KEYS & set(pair):
                    field = f"{prefix}.{key}"
                    value = pair[key]
                    if not isinstance(value, str):
                        problems.append(
                            f"README policy value has invalid type: {field} (expected string)"
                        )
                    elif not _valid_policy_path(root, value):
                        problems.append(f"README policy path is invalid: {field}")

    indexed_directories = policy.get("indexed_directories")
    if "indexed_directories" in policy:
        if not isinstance(indexed_directories, list):
            problems.append(
                "README policy key has invalid type: indexed_directories (expected array)"
            )
        else:
            allowed_keys = (
                INDEXED_DIRECTORY_REQUIRED_KEYS | INDEXED_DIRECTORY_OPTIONAL_KEYS
            )
            for index, entry in enumerate(indexed_directories):
                prefix = f"indexed_directories[{index}]"
                if not isinstance(entry, dict):
                    problems.append(f"README policy {prefix} must be an object")
                    continue
                for key in INDEXED_DIRECTORY_REQUIRED_KEYS - set(entry):
                    problems.append(
                        f"README policy {prefix} is missing required key: {key}"
                    )
                for key in set(entry) - allowed_keys:
                    problems.append(
                        f"README policy {prefix} contains unexpected key: {key}"
                    )
                for key in {"path", "readme"} & set(entry):
                    field = f"{prefix}.{key}"
                    value = entry[key]
                    if not isinstance(value, str):
                        problems.append(
                            f"README policy value has invalid type: {field} (expected string)"
                        )
                    elif not _valid_policy_path(root, value):
                        problems.append(f"README policy path is invalid: {field}")
                if "mode" in entry:
                    field = f"{prefix}.mode"
                    mode = entry["mode"]
                    if not isinstance(mode, str):
                        problems.append(
                            f"README policy value has invalid type: {field} (expected string)"
                        )
                    elif mode not in INDEXED_DIRECTORY_MODES:
                        problems.append(
                            f"README policy {field} must be one of: executable, file"
                        )
                if "headings" in entry:
                    field = f"{prefix}.headings"
                    headings = entry["headings"]
                    if not isinstance(headings, list):
                        problems.append(
                            f"README policy key has invalid type: {field} (expected array)"
                        )
                    elif not headings:
                        problems.append(f"README policy {field} must not be empty")
                    else:
                        for heading_index, heading in enumerate(headings):
                            heading_field = f"{field}[{heading_index}]"
                            if not isinstance(heading, str):
                                problems.append(
                                    "README policy value has invalid type: "
                                    f"{heading_field} (expected string)"
                                )
                            elif ORG_HEADING.fullmatch(heading) is None:
                                problems.append(
                                    f"README policy Org heading is invalid: {heading_field}"
                                )
                if "ignored_basenames" in entry:
                    field = f"{prefix}.ignored_basenames"
                    ignored = entry["ignored_basenames"]
                    if not isinstance(ignored, list):
                        problems.append(
                            f"README policy key has invalid type: {field} (expected array)"
                        )
                    else:
                        for ignored_index, basename in enumerate(ignored):
                            ignored_field = f"{field}[{ignored_index}]"
                            if not isinstance(basename, str):
                                problems.append(
                                    "README policy value has invalid type: "
                                    f"{ignored_field} (expected string)"
                                )
                            elif not _valid_ignored_basename(basename):
                                problems.append(
                                    "README policy ignored basename is invalid: "
                                    f"{ignored_field}"
                                )

    for key in ("skill_inventory", "project_local_skill_documentation_owner"):
        if key not in policy:
            continue
        value = policy[key]
        if not isinstance(value, str):
            problems.append(
                f"README policy value has invalid type: {key} (expected string)"
            )
        elif not (
            _valid_skill_inventory_path(root, value)
            if key == "skill_inventory"
            or (
                key == "project_local_skill_documentation_owner"
                and value == policy.get("skill_inventory")
            )
            else _valid_policy_path(root, value)
        ):
            problems.append(f"README policy path is invalid: {key}")

    return sorted(set(problems))


def load_policy(root: Path) -> dict:
    """Load the repository documentation policy."""
    path = safe_contained_file(root, POLICY_PATH)
    if path is None:
        raise ValueError("README policy is not a safe contained file")
    return json.loads(path.read_text(encoding="utf-8"))


def readme_coverage_problems(root: Path, policy: dict) -> list[str]:
    """Report missing subsystem READMEs and incomplete policy coverage."""
    tracked = set(git_files(root))
    top_level = tracked_top_level_directories(root)
    required = set(policy.get("required_readmes", []))
    exempt = set(policy.get("exempt_readmes", {}))
    decided = required | exempt
    problems: list[str] = []

    for directory in required & exempt:
        problems.append(f"README policy directory is both required and exempt: {directory}")

    for directory in decided - top_level:
        problems.append(
            "README policy decision references missing top-level directory: "
            f"{directory}"
        )

    for directory in required & top_level:
        readme = f"{directory}/README.org"
        if readme not in tracked or safe_contained_file(root, readme) is None:
            problems.append(f"Required subsystem README is missing: {readme}")

    for readme in policy.get("required_nested_readmes", []):
        if readme not in tracked or safe_contained_file(root, readme) is None:
            problems.append(f"Required nested README is missing: {readme}")

    for directory in top_level - decided:
        problems.append(
            f"Top-level directory has no README policy decision: {directory}"
        )

    return sorted(problems)


def _mask_index_literal_regions(text: str) -> str:
    """Mask Org literal regions while preserving line positions."""
    spans = [
        match.span()
        for pattern in (
            ORG_LITERAL_BLOCK,
            ORG_FIXED_WIDTH_LINE,
            ORG_INLINE_SOURCE,
            ORG_COMMENT_LINE,
        )
        for match in pattern.finditer(text)
    ]
    masked = list(text)
    for start, end in spans:
        for index in range(start, end):
            if masked[index] != "\n":
                masked[index] = " "
    return "".join(masked)


def _index_table_contents(
    text: str, headings: list[str]
) -> tuple[list[str], set[str]]:
    """Return indexed basenames and declared headings present in text."""
    declared = set(headings)
    present: set[str] = set()
    basenames: list[str] = []
    active_level: int | None = None

    for line in _mask_index_literal_regions(text).splitlines():
        heading_match = ORG_HEADING.fullmatch(line)
        if heading_match:
            if line in declared:
                present.add(line)
                active_level = len(heading_match.group(1))
            elif active_level is not None and len(heading_match.group(1)) <= active_level:
                active_level = None
            continue
        if active_level is None:
            continue
        row_match = INDEX_ROW.match(line)
        if row_match:
            basenames.append(row_match.group(1))

    return basenames, present


def index_table_basenames(text: str, headings: list[str]) -> list[str]:
    """Return index basenames under the policy-declared Org headings."""
    basenames, _ = _index_table_contents(text, headings)
    return basenames


def indexed_directory_problems(root: Path, policy: dict) -> list[str]:
    """Report drift between tracked direct children and their Org indexes."""
    tracked = set(git_files(root))
    index_entries = git_index_entries(root)
    problems: list[str] = []

    for entry in policy.get("indexed_directories", []):
        directory = PurePosixPath(entry["path"])
        readme_relative = entry["readme"]
        ignored = set(entry.get("ignored_basenames", []))
        headings = entry["headings"]
        expected = []
        for mode, tracked_path in index_entries:
            path = PurePosixPath(tracked_path)
            if path.parent != directory or path.name == "README.org":
                continue
            if path.name in ignored:
                continue
            if entry["mode"] == "executable" and mode != "100755":
                continue
            expected.append(path.name)

        if readme_relative not in tracked:
            problems.append(
                f"Indexed directory README is missing or untracked: {readme_relative}"
            )
            continue
        readme = safe_contained_file(root, readme_relative)
        if readme is None:
            problems.append(
                f"Indexed directory README is missing or unsafe: {readme_relative}"
            )
            continue
        try:
            actual, present_headings = _index_table_contents(
                readme.read_text(encoding="utf-8"), headings
            )
        except (OSError, UnicodeError):
            problems.append(
                f"Indexed directory README could not be read: {readme_relative}"
            )
            continue

        for heading in set(headings) - present_headings:
            problems.append(
                f"Indexed README heading is missing: {readme_relative} -> {heading}"
            )

        expected_counts = Counter(expected)
        actual_counts = Counter(actual)
        for basename, count in actual_counts.items():
            if count > 1:
                problems.append(
                    f"Indexed README entry is duplicated: {readme_relative} -> {basename}"
                )
        for basename in expected_counts.keys() - actual_counts.keys():
            problems.append(
                f"Indexed README entry is missing: {readme_relative} -> {basename}"
            )
        for basename in actual_counts.keys() - expected_counts.keys():
            problems.append(
                f"Indexed README entry is unexpected: {readme_relative} -> {basename}"
            )

    return sorted(set(problems))


def root_map_directories(text: str) -> list[str]:
    """Extract directory names from the root README's directory map."""
    lines = text.splitlines()
    try:
        heading_index = lines.index(DIRECTORY_MAP_HEADING)
    except ValueError:
        return []

    directories: list[str] = []
    for line in lines[heading_index + 1 :]:
        if line.startswith("* "):
            break
        match = DIRECTORY_MAP_ROW.match(line)
        if match:
            directories.append(match.group(1))
    return directories


def root_map_problems(text: str, expected: set[str]) -> list[str]:
    """Report duplicate, missing, and unexpected root directory-map rows."""
    directories = root_map_directories(text)
    counts = Counter(directories)
    present = set(directories)
    problems: list[str] = []

    for directory, count in counts.items():
        if count > 1:
            problems.append(f"Root directory map contains duplicate row: {directory}")
    for directory in expected - present:
        problems.append(f"Root directory map is missing: {directory}")
    for directory in present - expected:
        problems.append(f"Root directory map contains unexpected row: {directory}")

    return sorted(problems)


def _tracked_readme_paths(root: Path) -> list[tuple[str, Path]]:
    readmes = []
    for tracked in git_files(root):
        if tracked == "README.org" or tracked.endswith("/README.org"):
            readmes.append(
                (tracked, root.joinpath(*PurePosixPath(tracked).parts))
            )
    return readmes


def tracked_readme_problems(root: Path) -> list[str]:
    """Report tracked README symlinks whose resolved targets escape root."""
    return sorted(
        f"Tracked README escapes repository: {relative}"
        for relative, path in _tracked_readme_paths(root)
        if not _path_is_contained(root, path)
    )


def tracked_readmes(root: Path) -> list[Path]:
    """Return existing tracked README.org files, including the root README."""
    readmes = []
    for tracked, _ in _tracked_readme_paths(root):
        path = safe_contained_file(root, tracked)
        if path is not None:
            readmes.append(path)
    return sorted(readmes, key=lambda path: path.relative_to(root).as_posix())


def org_file_links(text: str) -> list[str]:
    """Extract unique bracket, angle, and plain Org file-link targets."""
    literal_spans = [
        match.span()
        for pattern in (
            ORG_LITERAL_BLOCK,
            ORG_INLINE_CODE,
            ORG_FIXED_WIDTH_LINE,
            ORG_INLINE_SOURCE,
            ORG_COMMENT_LINE,
        )
        for match in pattern.finditer(text)
    ]

    def is_in_spans(position: int, spans: list[tuple[int, int]]) -> bool:
        return any(start <= position < end for start, end in spans)

    candidates: list[tuple[int, str]] = []
    enclosed_spans: list[tuple[int, int]] = []
    for pattern in (ORG_BRACKET_LINK, ORG_ANGLE_LINK):
        for match in pattern.finditer(text):
            if is_in_spans(match.start(), literal_spans):
                continue
            enclosed_spans.append(match.span())
            if pattern is ORG_BRACKET_LINK:
                raw_link = match.group(1)
                if raw_link.startswith("file:"):
                    candidates.append((match.start(), raw_link.removeprefix("file:")))
            elif match.group(1) == "file":
                candidates.append((match.start(), match.group(2)))

    for match in ORG_PLAIN_LINK.finditer(text):
        if is_in_spans(match.start(), literal_spans + enclosed_spans):
            continue
        if match.group(1) == "file":
            candidates.append((match.start(), match.group(2)))

    links: list[str] = []
    seen: set[str] = set()
    for _, target in sorted(candidates):
        if target not in seen:
            links.append(target)
            seen.add(target)
    return links


def _display_link_target(readme_relative: PurePosixPath, target: str) -> str:
    parent = readme_relative.parent.as_posix()
    if parent == ".":
        parent = ""
    return posixpath.normpath(posixpath.join(parent, target))


def readme_link_problems(root: Path) -> list[str]:
    """Report broken relative file links in tracked README.org files."""
    root_resolved = root.resolve()
    problems = tracked_readme_problems(root)

    for readme in tracked_readmes(root):
        readme_relative = PurePosixPath(readme.relative_to(root).as_posix())
        try:
            text = readme.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            problems.append(
                "Tracked README could not be read: "
                f"{readme_relative.as_posix()}"
            )
            continue
        for link in org_file_links(text):
            target = link.partition("::")[0]
            if (
                not target
                or target.startswith(("/", "~"))
                or PureWindowsPath(target).is_absolute()
            ):
                continue

            display_target = _display_link_target(readme_relative, target)
            resolved_target = (readme.parent / target).resolve()
            try:
                resolved_target.relative_to(root_resolved)
            except ValueError:
                problems.append(
                    "README file link escapes repository: "
                    f"{readme_relative.as_posix()} -> {display_target}"
                )
                continue

            if not resolved_target.exists():
                problems.append(
                    "Broken README file link: "
                    f"{readme_relative.as_posix()} -> {display_target}"
                )

    return sorted(set(problems))


def source_generated_problems(root: Path, policy: dict) -> list[str]:
    """Report missing paths declared as source/generated pairs."""
    problems: list[str] = []
    for pair in policy.get("source_generated", []):
        source = pair["source"]
        generated = pair["generated"]
        if safe_contained_file(root, source) is None:
            problems.append(
                f"Declared source file is missing: {source} (generated: {generated})"
            )
        if safe_contained_file(root, generated) is None:
            problems.append(
                f"Declared generated file is missing: {generated} (source: {source})"
            )
    return sorted(problems)


def _root_readme_text(root: Path, tracked: set[str]) -> tuple[str, list[str]]:
    relative = "README.org"
    if relative not in tracked:
        return "", ["Root README is missing or untracked: README.org"]

    candidate = root / relative
    if not _path_is_contained(root, candidate):
        return "", []
    path = safe_contained_file(root, relative)
    if path is None:
        return "", ["Root README is missing or untracked: README.org"]
    try:
        return path.read_text(encoding="utf-8"), []
    except (OSError, UnicodeError):
        return "", ["Root README could not be read: README.org"]


def audit_problems(root: Path) -> list[str]:
    """Return every documentation audit problem for root."""
    tracked = set(git_files(root))
    expected = tracked_top_level_directories(root)
    root_text, root_problems = _root_readme_text(root, tracked)
    inventory_input_problems = skill_inventory_input_problems(root)
    problems = [
        *root_problems,
        *root_map_problems(root_text, expected),
        *readme_link_problems(root),
        *inventory_input_problems,
    ]

    policy_relative = POLICY_PATH.as_posix()
    if policy_relative not in tracked:
        problems.append(
            "README policy is missing or untracked: docs/readme-policy.json"
        )
        return sorted(problems)
    policy_candidate = root.joinpath(*POLICY_PATH.parts)
    if not _path_is_contained(root, policy_candidate):
        problems.append("README policy escapes repository: docs/readme-policy.json")
        return sorted(problems)
    try:
        policy = load_policy(root)
    except (OSError, UnicodeError, ValueError):
        problems.append("README policy could not be loaded: docs/readme-policy.json")
        return sorted(problems)

    validation_problems = policy_validation_problems(root, policy)
    problems.extend(validation_problems)
    if not validation_problems:
        problems.extend(readme_coverage_problems(root, policy))
        problems.extend(indexed_directory_problems(root, policy))
        problems.extend(source_generated_problems(root, policy))
        if not inventory_input_problems:
            problems.extend(skill_inventory_problems(root, policy))
    return sorted(problems)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    generate_parser = subparsers.add_parser(
        "generate", help="generate the tracked skill inventory"
    )
    generate_parser.add_argument(
        "--root",
        type=Path,
        default=REPO_ROOT,
        help="repository root (default: command repository)",
    )
    audit_parser = subparsers.add_parser("audit", help="audit documentation")
    audit_parser.add_argument(
        "--root",
        type=Path,
        default=REPO_ROOT,
        help="repository root (default: command repository)",
    )
    return parser


def _run_command(args: argparse.Namespace) -> int:
    """Run a parsed command, allowing repository access errors to propagate."""
    if args.command == "generate":
        root = args.root.resolve()
        tracked = set(git_files(root))
        policy_relative = POLICY_PATH.as_posix()
        if policy_relative not in tracked:
            problems = [
                "README policy is missing or untracked: docs/readme-policy.json"
            ]
        else:
            policy_candidate = root.joinpath(*POLICY_PATH.parts)
            if not _path_is_contained(root, policy_candidate):
                problems = [
                    "README policy escapes repository: docs/readme-policy.json"
                ]
            else:
                try:
                    policy = load_policy(root)
                except (OSError, UnicodeError, ValueError):
                    problems = [
                        "README policy could not be loaded: docs/readme-policy.json"
                    ]
                else:
                    problems = write_skill_inventory(root, policy)
        for problem in problems:
            print(problem)
        return 1 if problems else 0

    problems = audit_problems(args.root.resolve())
    for problem in problems:
        print(problem)
    return 1 if problems else 0


def main(argv: list[str] | None = None) -> int:
    """Run the CLI; return 2 when the repository root cannot be inspected."""
    args = build_parser().parse_args(argv)
    try:
        return _run_command(args)
    except (OSError, subprocess.CalledProcessError):
        print(CLI_ROOT_ERROR)
        return CLI_ROOT_ERROR_EXIT


if __name__ == "__main__":
    sys.exit(main())
