LULU_RULES = Path(__file__).with_name("lulu-directory-rules")
# Liveness and failure alerts go through the shared service
# (claude/context/alerting.md).
HEARTBEAT = Path.home() / "repos/launchd/bin/launchd-heartbeat.py"
HEARTBEAT_NAME = "personal-updates"
# Homebrew reports bundle versions only for `app` artifacts. These
# self-updating casks install through a pkg or an installer script, so their
# installed version is read from the location they actually install to.
INSTALLED_VERSION_SOURCES = {
    "gcloud-cli": Path("/opt/homebrew/share/google-cloud-sdk/VERSION"),
    "google-drive": Path("/Applications/Google Drive.app"),
    "karabiner-elements": Path("/Applications/Karabiner-Elements.app"),
    "macfuse": Path("/Library/Filesystems/macfuse.fs"),
    "mullvad-vpn": Path("/Applications/Mullvad VPN.app"),
}
