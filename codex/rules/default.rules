prefix_rule(pattern=["curl", "-L"], decision="allow")
prefix_rule(pattern=["ps", "-Ao"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit", "-m"], decision="allow")
prefix_rule(pattern=["emacs", "-Q", "--batch"], decision="allow")
prefix_rule(pattern=["emacs", "--batch"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
prefix_rule(pattern=["git", "restore", "--source=HEAD", "--worktree"], decision="allow")
prefix_rule(pattern=["emacsclient", "--eval"], decision="allow")
