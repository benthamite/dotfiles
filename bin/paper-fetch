#!/bin/sh
# Use the declared paper-fetch runtime; never install or select ambient Python.
set -eu
PAPER_FETCH_PYTHON="$HOME/.local/share/paper-fetch/venv/bin/python"
if [ ! -x "$PAPER_FETCH_PYTHON" ]; then
    echo 'paper-fetch: dedicated runtime missing; see dotfiles/docs/book-acquisition.md' >&2
    exit 1
fi
exec "$PAPER_FETCH_PYTHON" -B "$HOME/My Drive/dotfiles/lib/python/paper_fetch_cli.py" "$@"
