#!/usr/bin/env bash
# Run focused ERT with the canonical source-first batch setup.
# Usage: elisp-ert PACKAGE TEST-FILE [TEST-NAME]

set -euo pipefail
if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
  echo "Usage: elisp-ert PACKAGE TEST-FILE [TEST-NAME]" >&2
  exit 2
fi
script_dir=$(cd -- "$(dirname -- "$0")" && pwd -P)
exec "$script_dir/batch-test.sh" --ert "$@"
