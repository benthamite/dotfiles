#!/usr/bin/env python3
"""granola — read-only access to Granola notes visible to pablo@forethought.org.

Uses Granola's public API (https://public-api.granola.ai/v1) with Pablo's
personal API key for Peter's Business workspace (scopes: personal and public
notes, so notes Peter shares to the workspace are visible). The key is the
`password` field of `granola-forethought` in the personal 1Password Automation
vault (Forethought exception in claude/context/secrets.md), read in-process
through op-automations and never printed. No write operations.

Usage:
  granola list [--since YYYY-MM-DD] [--match TEXT] [--limit N]
  granola get NOTE_ID [--summary-only]
"""

import argparse
import datetime
import json
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

BASE_URL = "https://public-api.granola.ai/v1"
REQUEST_TIMEOUT = 60
_key = None


def fail(message, code=1):
    sys.stderr.write(f"ERROR: {message}\n")
    sys.exit(code)


def api_key():
    global _key
    if _key is None:
        try:
            out = subprocess.run(
                ["op-automations", "@personal", "item", "get", "granola-forethought",
                 "--vault", "Automation", "--fields", "label=password", "--reveal"],
                check=False, capture_output=True, text=True, timeout=REQUEST_TIMEOUT)
        except (OSError, subprocess.TimeoutExpired):
            fail("Granola credential lookup failed")
        value = out.stdout.strip()
        if out.returncode != 0 or not value or any(c.isspace() for c in value):
            fail("Granola credential lookup failed (item granola-forethought)")
        _key = value
    return _key


def get(path, params=None, allow_413=False):
    url = BASE_URL + path
    if params:
        url += "?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {api_key()}"})
    try:
        with urllib.request.urlopen(req, timeout=REQUEST_TIMEOUT) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as exc:
        if allow_413 and exc.code == 413:
            return None
        fail(f"Granola API returned HTTP {exc.code} for {path}: "
             f"{exc.read()[:300].decode(errors='replace')}")
    except urllib.error.URLError as exc:
        fail(f"Granola API unreachable: {exc.reason}")


def local_time(stamp):
    d = datetime.datetime.fromisoformat(stamp.replace("Z", "+00:00"))
    return d.astimezone().strftime("%Y-%m-%d %H:%M")


def cmd_list(args):
    params = {}
    if args.since:
        params["created_after"] = (datetime.datetime.strptime(args.since, "%Y-%m-%d")
                                   .astimezone(datetime.timezone.utc)
                                   .strftime("%Y-%m-%dT%H:%M:%SZ"))
    notes = []
    while True:
        page = get("/notes", params)
        notes += [n for n in page["notes"] if not n.get("deleted_at")]
        if not page.get("hasMore") or not page.get("cursor"):
            break
        params["cursor"] = page["cursor"]
    if args.match:
        notes = [n for n in notes if args.match.lower() in (n.get("title") or "").lower()]
    notes.sort(key=lambda n: n["created_at"], reverse=True)
    for n in notes[:args.limit]:
        owner = (n.get("owner") or {}).get("name") or "?"
        print(f"{local_time(n['created_at'])}\t{owner}\t{n['id']}\t{n.get('title')}")


def transcript_lines(items):
    for item in items or []:
        speaker = item.get("speaker") or {}
        label = speaker.get("diarization_label") or speaker.get("source")
        text = (item.get("text") or "").strip()
        print(f"{label}: {text}" if label else text)


def cmd_get(args):
    params = None if args.summary_only else {"include": "transcript"}
    n = get(f"/notes/{args.note_id}", params, allow_413=True)
    too_large = n is None
    if too_large:
        n = get(f"/notes/{args.note_id}")
    print(f"# {n.get('title')}\n")
    owner = n.get("owner") or {}
    print(f"- Created: {local_time(n['created_at'])}")
    print(f"- Owner: {owner.get('name')} <{owner.get('email')}>")
    attendees = ", ".join(a.get("name") or a.get("email") or "?" for a in n.get("attendees") or [])
    print(f"- Attendees: {attendees}")
    folders = ", ".join(f.get("name") for f in n.get("folder_membership") or [])
    if folders:
        print(f"- Folders: {folders}")
    print(f"- Granola: {n.get('web_url')}\n")
    if n.get("summary_markdown") or n.get("summary_text"):
        print(f"## Summary\n\n{(n.get('summary_markdown') or n.get('summary_text')).strip()}\n")
    if n.get("private_notes_markdown") or n.get("private_notes_text"):
        notes = n.get("private_notes_markdown") or n.get("private_notes_text")
        print(f"## Notes\n\n{notes.strip()}\n")
    if not args.summary_only:
        print("## Transcript\n")
        if too_large:
            t = get(f"/notes/{args.note_id}/transcript")
            transcript_lines(t.get("transcript") if isinstance(t, dict) else t)
        else:
            transcript_lines(n.get("transcript"))


def main():
    p = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    ls = sub.add_parser("list", help="list notes, newest first")
    ls.add_argument("--since")
    ls.add_argument("--match", help="case-insensitive title filter")
    ls.add_argument("--limit", type=int, default=30)
    g = sub.add_parser("get", help="print a note's summary, notes and transcript as Markdown")
    g.add_argument("note_id")
    g.add_argument("--summary-only", action="store_true")
    args = p.parse_args()
    {"list": cmd_list, "get": cmd_get}[args.cmd](args)


if __name__ == "__main__":
    main()
