#!/usr/bin/env python3
"""Copy a Slack draft to the Emacs kill ring and optionally prefill a reply."""

import argparse
import json
import subprocess
import sys
from pathlib import Path


def run_emacs_eval(expr: str) -> str:
    result = subprocess.run(
        ["emacsclient", "--eval", expr],
        check=False,
        capture_output=True,
        text=True,
    )
    out = (result.stdout or "").strip()
    if result.returncode != 0:
        detail = (result.stderr or out).strip()
        raise RuntimeError(detail or "emacsclient failed")
    # emacsclient exits 0 even when the form signals an error; it reports the
    # failure on stdout instead. Without this check every failure looks like a
    # success.
    if out.startswith("*ERROR*"):
        raise RuntimeError(out)
    return out


def elisp_string(value: str) -> str:
    # JSON strings are valid enough Elisp string literals for paths and URLs.
    return json.dumps(value)


def copy_to_kill_ring(path: Path) -> None:
    expr = (
        "(with-temp-buffer "
        f"(insert-file-contents {elisp_string(str(path))}) "
        "(kill-new (buffer-string)))"
    )
    run_emacs_eval(expr)


def prefill_slack_reply(permalink: str, path: Path) -> str:
    expr = f"""
(progn
  (require 'cl-lib)
  (require 'eieio)
  (require 'subr-x)
  (require 'slack-team nil t)
  (unless (fboundp 'slack-browse-url)
    (require 'slack nil t))
  (unless (fboundp 'slack-browse-url)
    (error "slack-browse-url is not available"))
  (unless (fboundp 'slack-conversations-replies)
    (require 'slack-conversations nil t))
  (unless (fboundp 'slack-conversations-replies)
    (error "slack-conversations-replies is not available"))
  (unless (fboundp 'slack-create-thread-message-buffer)
    (require 'slack-thread-message-buffer nil t))
  (unless (fboundp 'slack-create-thread-message-buffer)
    (error "slack-create-thread-message-buffer is not available"))
  (let* ((info (slack-permalink-to-info {elisp_string(permalink)}))
         (team-domain (plist-get info :team-domain))
         (room-id (plist-get info :room-id))
         (ts (plist-get info :ts))
         (thread-ts (plist-get info :thread-ts))
         (target-ts (or thread-ts ts))
         (team
          (or (slack-team-find-by-domain team-domain)
              (--find
               (or (equal team-domain (oref it name))
                   (and (string= team-domain "epochai")
                        (equal (oref it name) "Epoch AI")))
               (hash-table-values slack-teams-by-token)))))
    (unless (and team-domain room-id ts)
      (error "Could not resolve Slack permalink: %s"
             {elisp_string(permalink)}))
    (unless team
      (error "No registered Slack team for %s" team-domain))
    (unless (slack-team-connectedp team)
      (slack-start team)
      (let ((deadline (+ (float-time) 20)))
        (while (and (not (slack-team-connectedp team))
                    (< (float-time) deadline))
          (accept-process-output nil 0.25))))
    (let ((room (slack-room-find room-id team)))
      (unless room
        (error "Slack room %s is not loaded for team %s"
               room-id (oref team name)))
      (let ((deadline (+ (float-time) 30))
            result
            failure
            done)
        (cl-labels
            ((finish-with-error
             (err)
              (unless done
                (setq failure err
                      done t)))
             (safe-error-value
              (value)
              (cond
               ((stringp value) value)
               ((symbolp value) (symbol-name value))))
             (request-error
              (&rest args)
              (let* ((data (plist-get args :data))
                     (detail
                      (or
                       (and
                        (listp data)
                        (safe-error-value
                         (plist-get data :error)))
                       (safe-error-value
                        (plist-get args :symbol-status))
                       (safe-error-value
                        (plist-get args :error-thrown))
                       (safe-error-value (car args))
                       "request failed")))
                ;; Never format the complete response object: request.el keeps
                ;; request headers, including Slack credentials, inside it.
                (finish-with-error
                 (list
                  'error
                  (format
                   "Slack failed to fetch reply target %s in %s: %s"
                   target-ts room-id detail)))))
             (stage
              (messages _next-cursor has-more)
              (unless done
                ;; The request can finish while the wait loop is crossing its
                ;; deadline.  Check again before touching Slack or Emacs state.
                (if (>= (float-time) deadline)
                    (setq done 'expired)
                  (condition-case err
                      (progn
                        (unless messages
                          (error
                           "Slack returned no message for %s in %s"
                           target-ts room-id))
                        (slack-room-set-messages room messages team)
                        (slack-message-set-replies
                         room target-ts messages)
                        (let ((parent
                               (slack-room-find-message
                                room target-ts)))
                          (unless parent
                            (error
                             "Slack did not load message %s in %s"
                             target-ts room-id))
                          (let* ((thread
                                  (slack-create-thread-message-buffer
                                   room team target-ts has-more))
                                 (buf
                                  (progn
                                    ;; A cached object may predate this fetch.
                                    (when (eieio-object-p thread)
                                      (setf
                                       (slot-value thread 'has-more)
                                       has-more))
                                    (slack-thread--sync-buffer
                                     thread parent room)
                                    (slack-buffer-buffer thread)))
                                 (draft
                                  (with-temp-buffer
                                    (insert-file-contents
                                     {elisp_string(str(path))})
                                    (buffer-string))))
                            (unless (buffer-live-p buf)
                              (error
                               "Slack reply buffer is not live for %s in %s"
                               target-ts room-id))
                            (with-current-buffer buf
                              (unless
                                  (and
                                   (markerp lui-input-marker)
                                   (eq
                                    (marker-buffer lui-input-marker)
                                    buf))
                                (error
                                 "Slack reply input is not available in %s"
                                 (buffer-name buf)))
                              (let ((existing
                                     (buffer-substring-no-properties
                                      lui-input-marker (point-max))))
                                (unless
                                    (or
                                     (string-empty-p existing)
                                     (equal existing draft))
                                  (error
                                   "Slack reply input in %s already contains unsent text"
                                   (buffer-name buf)))
                                (condition-case insert-error
                                    (progn
                                      (unless (equal existing draft)
                                        (goto-char lui-input-marker)
                                        (insert draft))
                                      (let ((staged
                                             (buffer-substring-no-properties
                                              lui-input-marker
                                              (point-max))))
                                        (unless (equal staged draft)
                                          (error
                                           "Slack reply input in %s does not exactly match the draft"
                                           (buffer-name buf))))
                                      (slack-buffer-display thread)
                                      (setq result (buffer-name buf)
                                            done t))
                                  (error
                                   (let ((inhibit-modification-hooks t)
                                         (inhibit-read-only t))
                                     (delete-region
                                      lui-input-marker (point-max))
                                     (goto-char lui-input-marker)
                                     (insert existing))
                                   (signal
                                    (car insert-error)
                                    (cdr insert-error)))))))))
                    (error (finish-with-error err)))))))
          (condition-case err
              (slack-conversations-replies
               room target-ts team
               :after-success #'stage
               :on-error #'request-error)
            (error (finish-with-error err)))
          (while (and (not done)
                      (< (float-time) deadline))
            (accept-process-output nil 0.1))
          (unless done
            (setq done 'expired))
          (cond
           (failure
            (signal (car failure) (cdr failure)))
           ((eq done 'expired)
            (error
             "Timed out waiting for Slack reply target %s in %s"
             target-ts room-id))
           (t result)))))))
""".strip()
    return run_emacs_eval(expr)


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Copy a Slack draft to the Emacs kill ring and prefill its reply."
        )
    )
    parser.add_argument("--file", required=True, help="Path to the draft text file")
    parser.add_argument(
        "--permalink",
        help="Slack permalink to open and prefill in Emacs after copying the draft",
    )
    parser.add_argument(
        "--no-open",
        action="store_true",
        help=(
            "Only copy the draft; do not open or prefill Slack. "
            "Useful for smoke tests."
        ),
    )
    args = parser.parse_args()

    draft_path = Path(args.file).expanduser()
    if not draft_path.exists():
        sys.stderr.write(f"ERROR: draft file does not exist: {draft_path}\n")
        return 2
    if not draft_path.is_file():
        sys.stderr.write(f"ERROR: draft path is not a file: {draft_path}\n")
        return 2
    text = draft_path.read_text()
    if not text.strip():
        sys.stderr.write(f"ERROR: draft file is empty: {draft_path}\n")
        return 2
    if not args.no_open and not args.permalink:
        sys.stderr.write("ERROR: --permalink is required unless --no-open is used\n")
        return 2

    try:
        copy_to_kill_ring(draft_path)
    except RuntimeError as exc:
        sys.stderr.write(f"ERROR: failed to copy draft to Emacs kill ring: {exc}\n")
        return 1
    print("Copied draft to Emacs kill ring")

    if args.no_open:
        return 0

    try:
        buffer_name = prefill_slack_reply(args.permalink, draft_path)
    except RuntimeError as exc:
        sys.stderr.write(
            "ERROR: failed to open Slack reply input and insert draft in "
            f"Emacs: {exc}\n"
        )
        return 1
    print(f"Inserted draft into the Slack reply input of {buffer_name}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
