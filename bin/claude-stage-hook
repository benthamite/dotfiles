#!/bin/bash
# claude-stage-hook — Claude Code `Stop` hook.
#
# Auto-stages any `!`-prefixed command from the assistant's final message onto
# the user's Emacs kill ring + macOS clipboard (via `stage-for-user`), so the
# user never has to copy a command out of the terminal. The `!`-line is the
# empirically-validated signature of "run this in your session".
#
# Registered as a Stop-hook command in ~/.claude/settings.json. Fails silent:
# any problem just skips staging. Reads the hook JSON on stdin, which includes
# { "transcript_path": "...", ... }.

# Hooks may run with a minimal PATH; make sure our tools resolve.
export PATH="$HOME/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# One-line trail per invocation, so "did the hook run at all?" is answerable.
log="${XDG_STATE_HOME:-$HOME/.local/state}/claude-stage-hook.log"
mkdir -p "$(dirname "$log")" 2>/dev/null || true
trace() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$log" 2>/dev/null || true; }

input=$(cat 2>/dev/null) || { trace "no stdin"; exit 0; }

# Prefer the message text Claude Code hands the Stop hook directly. The hooks
# reference documents that the transcript file is written asynchronously and
# "may not yet include the current turn's final messages" when Stop fires, so
# reading the transcript here silently missed the very message that contained
# the command. Fall back to the transcript only for older clients that do not
# send last_assistant_message.
text=$(printf '%s' "$input" | jq -r '.last_assistant_message // empty' 2>/dev/null)
source=last_assistant_message
if [ -z "$text" ]; then
  tp=$(printf '%s' "$input" | jq -r '.transcript_path // empty' 2>/dev/null)
  [ -n "$tp" ] && [ -f "$tp" ] || { trace "no last_assistant_message and no transcript_path in hook input"; exit 0; }
  # Slurp so a multi-line message stays one unit (a naive `tail -n1` would
  # grab only the message's last physical line).
  text=$(tail -n 200 "$tp" 2>/dev/null \
    | jq -rs 'map(select(.type=="assistant" and ((.message.content|type)=="array"))
                  | (.message.content | map(select(.type=="text").text) | join("\n")))
              | map(select(length > 0)) | (last // "")' 2>/dev/null)
  source=transcript
fi
[ -n "$text" ] || { trace "invoked: empty assistant text ($source)"; exit 0; }

# `!`-prefixed command lines, with the leading `! ` stripped.
cmds=$(printf '%s\n' "$text" \
  | grep -E '^[[:space:]]*![[:space:]]+[~/._[:alnum:]]' 2>/dev/null \
  | sed -E 's/^[[:space:]]*![[:space:]]?//')
[ -n "$cmds" ] || { trace "invoked: no !-command in last assistant message ($source)"; exit 0; }

# Bound stage-for-user so a wedged Emacs server can never leave a hung process
# (GNU timeout is `timeout` or `gtimeout` on macOS; run bare if neither exists).
TO=$(command -v timeout || command -v gtimeout || true)
# The hook must stay silent for Claude Code, so record the outcome in the log.
if out=$(printf '%s\n' "$cmds" | ${TO:+"$TO" 5} stage-for-user 2>&1) && ! printf '%s' "$out" | grep -q "warning"; then
  trace "staged $(printf '%s\n' "$cmds" | wc -l | tr -d ' ') command line(s) ($source)"
else
  trace "FAILED: ${out:-stage-for-user failed}"
fi
exit 0
