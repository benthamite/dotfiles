#!/usr/bin/env python3
"""Disable stale Claude/Codex skills with native tool settings."""

from __future__ import annotations

import argparse
import json
import os
import re
import sqlite3
import stat
import sys
import tempfile
import tomllib
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
MANIFEST = ROOT / "ai-config-sync.json"
DISABLED = ROOT / "skills-disabled.json"
DEFAULT_DAYS = 60
CODEX_BLOCK_BEGIN = "# BEGIN skill-prune disabled skills"
CODEX_BLOCK_END = "# END skill-prune disabled skills"
OLD_MANAGED_MARKER = ".managed-by-dotfiles-skill-prune"
LOCAL_ROOTS_ENV = "SKILL_PRUNE_LOCAL_ROOTS"
DEFAULT_LOCAL_ROOT = Path.home() / "My Drive"
LOCAL_SCAN_SKIP_DIRS = {
    ".cache",
    ".claude",
    ".codex",
    ".git",
    ".hg",
    ".mypy_cache",
    ".pytest_cache",
    ".tox",
    ".venv",
    ".svn",
    "dist",
    "node_modules",
    "target",
    "venv",
}


@dataclass
class Skill:
    name: str
    claude: str | None
    codex: str | None
    status: str
    source: str = "global"


def iso_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()


def parse_iso(value: str) -> datetime | None:
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def skill_path(path: str) -> Path:
    value = Path(path)
    if value.is_absolute():
        return value
    return ROOT / value


def load_manifest() -> list[Skill]:
    data = json.loads(MANIFEST.read_text())
    return [
        Skill(
            name=item["name"],
            claude=item.get("claude"),
            codex=item.get("codex"),
            status=item.get("status", ""),
            source="global",
        )
        for item in data.get("skills", [])
    ]


def local_skill_search_roots() -> list[Path]:
    configured = os.environ.get(LOCAL_ROOTS_ENV)
    if configured:
        return [Path(item).expanduser() for item in configured.split(os.pathsep) if item]
    return [DEFAULT_LOCAL_ROOT]


def discover_project_local_skills() -> list[Skill]:
    skills: list[Skill] = []
    seen_projects: set[Path] = set()
    for root in local_skill_search_roots():
        if not root.exists():
            continue
        for dirpath, dirnames, _filenames in os.walk(root):
            project = Path(dirpath)
            claude_root = project / ".claude" / "skills"
            codex_root = project / ".codex" / "skills"
            if project in seen_projects or not claude_root.is_dir() or not codex_root.is_dir():
                dirnames[:] = [
                    name
                    for name in dirnames
                    if name not in LOCAL_SCAN_SKIP_DIRS and not name.endswith(".nosync")
                ]
                continue
            seen_projects.add(project)
            for claude_skill in sorted(claude_root.glob("*/SKILL.md")):
                name = claude_skill.parent.name
                codex_skill = codex_root / name / "SKILL.md"
                if not codex_skill.exists():
                    continue
                skills.append(
                    Skill(
                        name=name,
                        claude=claude_skill.as_posix(),
                        codex=codex_skill.as_posix(),
                        status="paired-project-local",
                        source="project-local",
                    )
                )
            dirnames[:] = [
                name
                for name in dirnames
                if name not in LOCAL_SCAN_SKIP_DIRS and not name.endswith(".nosync")
            ]
    return skills


def load_skills() -> list[Skill]:
    return load_manifest() + discover_project_local_skills()


def load_disabled() -> dict:
    if not DISABLED.exists():
        return {"version": 1, "disabled": {}, "enabled": {}}
    return json.loads(DISABLED.read_text())


def save_disabled(data: dict) -> None:
    DISABLED.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")


def iter_jsonl(paths: list[Path], needles: tuple[str, ...] = ()):
    for path in paths:
        try:
            with path.open("r", encoding="utf-8", errors="replace") as handle:
                for line in handle:
                    line = line.strip()
                    if not line:
                        continue
                    if needles and not any(needle in line for needle in needles):
                        continue
                    if "<skills_instructions>" in line or "### Available skills" in line:
                        continue
                    try:
                        yield path, json.loads(line)
                    except json.JSONDecodeError:
                        continue
        except OSError:
            continue


def text_parts(value) -> list[str]:
    parts: list[str] = []
    if isinstance(value, str):
        return [value]
    if isinstance(value, list):
        for item in value:
            parts.extend(text_parts(item))
    elif isinstance(value, dict):
        for key in ("text", "content", "arguments", "cmd", "message"):
            if key in value:
                parts.extend(text_parts(value[key]))
    return parts


PATH_PATTERNS = {
    "claude": re.compile(r"(?:^|[\s'\"(])(?:/[^'\"\s)]*)?claude/skills/([A-Za-z0-9_.-]+)/SKILL\.md"),
    "codex": re.compile(r"(?:^|[\s'\"(])(?:/[^'\"\s)]*)?codex/skills/([A-Za-z0-9_.-]+)/SKILL\.md"),
}
ROOTED_SKILL_RE = re.compile(r"\br[0-9]+/([A-Za-z0-9_.-]+)/SKILL\.md\b")
CLAUDE_SKILL_TOOL_RE = re.compile(r"\bSkill\(skill:\s*[\"']([A-Za-z0-9_.-]+)[\"']\)")
BRACKET_SKILL_RE = re.compile(r"\[\$?([A-Za-z0-9_.-]+)\]\([^)]*/skills/\1/SKILL\.md\)")
EXPLICIT_SKILL_RE = re.compile(r"(?<![\w-])\$([A-Za-z0-9_.-]+)(?![\w-])")
ASSISTANT_SKILL_ANNOUNCE_RE = re.compile(
    r"\b(?:using|use|used|trigger(?:ing|ed)?)\s+(?:the\s+)?([A-Za-z0-9_.-]+)\s+skill\b",
    re.IGNORECASE,
)


def matching_skill_names(text: str, tool: str, skill_names: set[str]) -> set[str]:
    if (
        "SKILL.md" not in text
        and "Skill(skill:" not in text
    ):
        return set()
    matches: set[str] = set()
    for regex in (PATH_PATTERNS[tool], ROOTED_SKILL_RE, CLAUDE_SKILL_TOOL_RE, BRACKET_SKILL_RE, EXPLICIT_SKILL_RE):
        for match in regex.finditer(text):
            name = match.group(1)
            if name in skill_names:
                matches.add(name)
    return matches


def explicit_skill_names(text: str, skill_names: set[str]) -> set[str]:
    matches: set[str] = set()
    for regex in (BRACKET_SKILL_RE, EXPLICIT_SKILL_RE):
        for match in regex.finditer(text):
            name = match.group(1)
            if name in skill_names:
                matches.add(name)
    return matches


def announced_skill_names(text: str, skill_names: set[str]) -> set[str]:
    matches: set[str] = set()
    for match in ASSISTANT_SKILL_ANNOUNCE_RE.finditer(text):
        name = match.group(1)
        if name in skill_names:
            matches.add(name)
    return matches


def note_match(last_used: dict[str, dict[str, float]], tool: str, name: str, timestamp: float) -> None:
    current = last_used[tool].get(name)
    if current is None or timestamp > current:
        last_used[tool][name] = timestamp


def scan_claude(skill_names: set[str], cutoff_ts: float, last_used: dict[str, dict[str, float]]) -> None:
    root = Path.home() / ".claude" / "projects"
    if not root.exists():
        return
    files = [path for path in root.rglob("*.jsonl") if path.stat().st_mtime >= cutoff_ts]
    for path, record in iter_jsonl(files, ("SKILL.md", '"Skill"', "Skill(skill:")):
        ts_text = record.get("timestamp")
        timestamp = path.stat().st_mtime
        if isinstance(ts_text, str):
            parsed = parse_iso(ts_text)
            if parsed:
                timestamp = parsed.timestamp()
        message = record.get("message") or {}
        content = message.get("content")
        if record.get("type") == "assistant":
            for item in content if isinstance(content, list) else []:
                if not isinstance(item, dict):
                    continue
                if item.get("type") == "tool_use" and item.get("name") == "Skill":
                    skill = (item.get("input") or {}).get("skill")
                    if skill in skill_names:
                        note_match(last_used, "claude", skill, timestamp)
        for text in text_parts(content):
            if "<skills_instructions>" in text or "### Available skills" in text:
                continue
            for name in matching_skill_names(text, "claude", skill_names):
                note_match(last_used, "claude", name, timestamp)


def scan_codex_rollouts(skill_names: set[str], cutoff_ts: float, last_used: dict[str, dict[str, float]]) -> None:
    roots = [Path.home() / ".codex" / "sessions", Path.home() / ".codex" / "archived_sessions"]
    files: list[Path] = []
    for root in roots:
        if root.exists():
            files.extend(path for path in root.rglob("*.jsonl") if path.stat().st_mtime >= cutoff_ts)
    for path, record in iter_jsonl(files, ("SKILL.md", "Skill(skill:")):
        timestamp = path.stat().st_mtime
        parsed = parse_iso(str(record.get("timestamp", "")))
        if parsed:
            timestamp = parsed.timestamp()
        payload = record.get("payload") or {}
        role = payload.get("role")
        if role in {"developer", "system"}:
            continue
        payload_type = payload.get("type")
        if payload_type in {"function_call", "function_call_output"}:
            continue
        for text in text_parts(payload):
            if "<skills_instructions>" in text or "### Available skills" in text:
                continue
            if role == "user":
                matches = explicit_skill_names(text, skill_names)
            elif role == "assistant":
                matches = announced_skill_names(text, skill_names)
            else:
                matches = set()
            for name in matches:
                note_match(last_used, "codex", name, timestamp)


def scan_codex_sqlite(skill_names: set[str], cutoff_ts: float, last_used: dict[str, dict[str, float]]) -> None:
    db = Path.home() / ".codex" / "logs_2.sqlite"
    if not db.exists():
        return
    try:
        conn = sqlite3.connect(db)
        rows = conn.execute(
            """select ts, feedback_log_body from logs
               where ts >= ?
                 and feedback_log_body is not null
                 and (feedback_log_body like '%SKILL.md%'
                      or feedback_log_body like '%Skill(skill:%')""",
            (int(cutoff_ts),),
        )
        for timestamp, body in rows:
            if "<skills_instructions>" in body or "### Available skills" in body:
                continue
            for name in announced_skill_names(body, skill_names) | explicit_skill_names(body, skill_names):
                note_match(last_used, "codex", name, float(timestamp))
    except sqlite3.Error:
        return
    finally:
        try:
            conn.close()
        except UnboundLocalError:
            pass


def scan_usage(skills: list[Skill], days: int) -> dict[str, dict[str, float]]:
    cutoff_ts = datetime.now(timezone.utc).timestamp() - days * 86400
    names = {skill.name for skill in skills}
    last_used = {"claude": {}, "codex": {}}
    scan_claude(names, cutoff_ts, last_used)
    scan_codex_rollouts(names, cutoff_ts, last_used)
    scan_codex_sqlite(names, cutoff_ts, last_used)
    return last_used


def fmt_ts(timestamp: float | None) -> str:
    if timestamp is None:
        return "not found"
    return datetime.fromtimestamp(timestamp, timezone.utc).strftime("%Y-%m-%d")


def keep_enabled_names(disabled_data: dict) -> set[str]:
    return set((disabled_data.get("enabled") or {}).keys())


def stale_skills(
    skills: list[Skill],
    days: int,
    last_used: dict[str, dict[str, float]],
    keep_enabled: set[str] | None = None,
) -> list[Skill]:
    cutoff_ts = datetime.now(timezone.utc).timestamp() - days * 86400
    keep_enabled = keep_enabled or set()
    stale: list[Skill] = []
    for skill in skills:
        if not skill.claude or not skill.codex:
            continue
        if skill.name in keep_enabled:
            continue
        claude_recent = last_used["claude"].get(skill.name, 0) >= cutoff_ts
        codex_recent = last_used["codex"].get(skill.name, 0) >= cutoff_ts
        if not claude_recent and not codex_recent:
            stale.append(skill)
    return stale


def resolve_home(tool: str) -> Path:
    if tool == "claude":
        return Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))
    return Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))


def link_tool_skills(tool: str) -> None:
    source = ROOT / tool / "skills"
    target = resolve_home(tool) / "skills"
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.is_symlink():
        if target.resolve() == source.resolve():
            return
        target.unlink()
    elif target.exists():
        marker = target / OLD_MANAGED_MARKER
        if not marker.is_file():
            raise SystemExit(f"Refusing to replace existing skills directory: {target}")
        for item in target.iterdir():
            if item.is_symlink() or item.is_file():
                item.unlink()
            else:
                raise SystemExit(f"Refusing to replace managed skills directory with nested directory: {item}")
        target.rmdir()
    target.symlink_to(source)


def strip_codex_block(text: str, managed_paths: set[str]) -> str:
    """Remove generated disabled-skill state without trusting its markers.

    The markers make the generated region easy to inspect, but they are not
    the ownership boundary.  Remove only exact disabled tables for skills that
    this command manages, then remove the marker lines.  This also repairs a
    block whose begin or end marker was lost without consuming adjacent user
    configuration.
    """
    tomllib.loads(text)
    pattern = re.compile(
        rf"(?:^|\n+){re.escape(CODEX_BLOCK_BEGIN)}\n.*?\n"
        rf"{re.escape(CODEX_BLOCK_END)}(?:\n+|$)",
        re.DOTALL,
    )
    text = pattern.sub(lambda match: "" if match.start() == 0 else "\n\n", text)
    for path in sorted(managed_paths, key=len, reverse=True):
        table = re.compile(
            rf"(?:^|\n)\[\[skills\.config\]\]\n"
            rf"path = \"{re.escape(path)}\"\n"
            rf"enabled = false\n?"
        )
        text = table.sub("\n", text)
    marker = re.compile(
        rf"^({re.escape(CODEX_BLOCK_BEGIN)}|{re.escape(CODEX_BLOCK_END)})\n?",
        re.MULTILINE,
    )
    text = marker.sub("", text).rstrip() + "\n"
    tomllib.loads(text)
    return text


def write_text_atomic(path: Path, text: str) -> None:
    mode = stat.S_IMODE(path.stat().st_mode)
    handle, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary_path = Path(temporary)
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            stream.write(text)
        temporary_path.chmod(mode)
        os.replace(temporary_path, path)
    finally:
        temporary_path.unlink(missing_ok=True)


def paired_skills_by_name(skills: list[Skill]) -> dict[str, list[Skill]]:
    grouped: dict[str, list[Skill]] = {}
    for skill in skills:
        if skill.claude and skill.codex:
            grouped.setdefault(skill.name, []).append(skill)
    return grouped


def update_codex_config(disabled_names: set[str], skills: list[Skill]) -> None:
    skill_map = paired_skills_by_name(skills)
    config = ROOT / "codex" / "config.toml"
    managed_paths = {
        skill_path(skill.codex).as_posix()
        for matches in skill_map.values()
        for skill in matches
        if skill.codex
    }
    text = strip_codex_block(config.read_text(), managed_paths)
    if disabled_names:
        lines = ["", CODEX_BLOCK_BEGIN]
        for name in sorted(disabled_names):
            paths = {
                skill_path(skill.codex).as_posix()
                for skill in skill_map.get(name, [])
                if skill.codex
            }
            for path in sorted(paths):
                lines.extend(
                    [
                        "",
                        "[[skills.config]]",
                        f'path = "{path}"',
                        "enabled = false",
                    ]
                )
        lines.append(CODEX_BLOCK_END)
        text = text.rstrip() + "\n" + "\n".join(lines) + "\n"
    tomllib.loads(text)
    write_text_atomic(config, text)


def claude_settings_target(skill: Skill) -> Path:
    """Return the settings file Claude Code actually consults for this skill.

    Claude Code has no user-level settings.local.json: the user scope is
    <config>/settings.json and the local scope is <project>/.claude/settings.local.json.
    An override written anywhere else is silently ignored, which is how four
    project-local skills stayed loaded for months after skills-disabled.json
    recorded them as off.
    """
    if skill.source == "project-local" and skill.claude:
        return Path(skill.claude).parents[2] / "settings.local.json"
    return resolve_home("claude") / "settings.json"


def _read_json_object(path: Path) -> dict:
    if not path.exists():
        return {}
    data = json.loads(path.read_text() or "{}")
    if not isinstance(data, dict):
        raise ValueError(f"{path} does not contain a JSON object")
    return data


def _write_json_object(path: Path, data: dict) -> None:
    text = json.dumps(data, indent=2) + "\n"
    if path.exists():
        # <config>/settings.json is normally a symlink into the shared ~/.claude
        # tree; write through to the real file so os.replace() updates the target
        # instead of swapping the link for a detached copy.
        write_text_atomic(path.resolve(), text)
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.touch(mode=0o600)
    write_text_atomic(path, text)


def _apply_overrides(path: Path, managed_here: set[str], disabled_here: set[str]) -> None:
    data = _read_json_object(path)
    overrides = data.get("skillOverrides")
    if not isinstance(overrides, dict):
        overrides = {}
    for name in sorted(managed_here - disabled_here):
        if overrides.get(name) == "off":
            overrides.pop(name)
    for name in sorted(disabled_here):
        overrides[name] = "off"
    if overrides:
        data["skillOverrides"] = overrides
    else:
        data.pop("skillOverrides", None)
    if not data and not path.exists():
        return
    _write_json_object(path, data)


def update_claude_settings(disabled_names: set[str], skills: list[Skill]) -> None:
    managed = paired_skills_by_name(skills)
    targets: dict[Path, tuple[set[str], set[str]]] = {}
    for name, entries in managed.items():
        for skill in entries:
            managed_here, disabled_here = targets.setdefault(
                claude_settings_target(skill), (set(), set())
            )
            managed_here.add(name)
            if name in disabled_names:
                disabled_here.add(name)
    for path, (managed_here, disabled_here) in sorted(targets.items()):
        _apply_overrides(path, managed_here, disabled_here)

    # Retire managed entries from the user-level settings.local.json that earlier
    # versions wrote: Claude Code never reads that file, so an "off" there is dead.
    legacy = resolve_home("claude") / "settings.local.json"
    if legacy.exists():
        data = _read_json_object(legacy)
        overrides = data.get("skillOverrides")
        if isinstance(overrides, dict) and set(overrides) & set(managed):
            for name in managed:
                overrides.pop(name, None)
            if overrides:
                data["skillOverrides"] = overrides
            else:
                data.pop("skillOverrides", None)
            _write_json_object(legacy, data)


def install(disabled_data: dict) -> None:
    disabled_names = set((disabled_data.get("disabled") or {}).keys())
    skills = load_skills()
    link_tool_skills("claude")
    link_tool_skills("codex")
    update_codex_config(disabled_names, skills)
    update_claude_settings(disabled_names, skills)


def audit(args: argparse.Namespace) -> int:
    skills = load_skills()
    disabled = load_disabled()
    last_used = scan_usage(skills, args.days)
    stale = stale_skills(skills, args.days, last_used, keep_enabled_names(disabled))
    disabled_names = set((disabled.get("disabled") or {}).keys())
    if not stale:
        print(f"No paired skills are stale under the {args.days}-day threshold.")
    else:
        print(f"Paired skills stale under the {args.days}-day threshold:")
        for skill in stale:
            marker = "disabled" if skill.name in disabled_names else "candidate"
            print(
                f"{skill.name}\t{marker}\tclaude={fmt_ts(last_used['claude'].get(skill.name))}"
                f"\tcodex={fmt_ts(last_used['codex'].get(skill.name))}"
            )
    return 0


def apply(args: argparse.Namespace) -> int:
    skills = load_skills()
    disabled = load_disabled()
    disabled.setdefault("version", 1)
    disabled.setdefault("disabled", {})
    disabled.setdefault("enabled", {})
    last_used = scan_usage(skills, args.days)
    stale = stale_skills(skills, args.days, last_used, keep_enabled_names(disabled))
    now = iso_now()
    for skill in stale:
        disabled["disabled"].setdefault(
            skill.name,
            {
                "disabled_at": now,
                "threshold_days": args.days,
                "reason": "No Claude or Codex usage found inside the threshold window.",
                "claude_last_used": fmt_ts(last_used["claude"].get(skill.name)),
                "codex_last_used": fmt_ts(last_used["codex"].get(skill.name)),
                "claude_path": skill.claude,
                "codex_path": skill.codex,
                "source": skill.source,
            },
        )
    save_disabled(disabled)
    install(disabled)
    print(f"Disabled {len(stale)} stale paired skill(s).")
    return 0


def enable(args: argparse.Namespace) -> int:
    disabled = load_disabled()
    changed = False
    for name in args.name:
        if disabled.get("disabled", {}).pop(name, None) is not None:
            changed = True
        if args.keep:
            disabled.setdefault("enabled", {})[name] = {
                "enabled_at": iso_now(),
                "reason": args.reason,
            }
            changed = True
    if changed:
        save_disabled(disabled)
    install(disabled)
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    audit_parser = subparsers.add_parser("audit", help="Report stale paired skills.")
    audit_parser.add_argument("--days", type=int, default=DEFAULT_DAYS)
    apply_parser = subparsers.add_parser("apply", help="Disable stale paired skills with native settings.")
    apply_parser.add_argument("--days", type=int, default=DEFAULT_DAYS)
    subparsers.add_parser("install", help="Apply live skill links and native settings from skills-disabled.json.")
    enable_parser = subparsers.add_parser("enable", help="Re-enable named skills and apply native settings.")
    enable_parser.add_argument("name", nargs="+")
    enable_parser.add_argument("--keep", action="store_true", help="Keep named skills enabled even if usage history is absent.")
    enable_parser.add_argument("--reason", default="Manually kept enabled.", help="Reason stored with --keep.")
    args = parser.parse_args()
    if args.command == "audit":
        return audit(args)
    if args.command == "apply":
        return apply(args)
    if args.command == "install":
        install(load_disabled())
        return 0
    if args.command == "enable":
        return enable(args)
    raise AssertionError(args.command)


if __name__ == "__main__":
    sys.exit(main())
