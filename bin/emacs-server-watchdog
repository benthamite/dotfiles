#!/usr/bin/env python3
"""Alert when the live Emacs server stops answering, and say why.

Run every minute by launchd. Each run probes the server socket with a short
`emacsclient --eval (emacs-pid)`. A probe fails when it times out or errors,
or when a different Emacs answers (a test instance that took over the socket).
After FAILURES_TO_ALERT consecutive failures it sends one macOS notification,
then one more when the server answers again.

The notification names the cause from the state file that
`simple-extras-server-state-mode' writes every few seconds: a debugger
backtrace or minibuffer prompt parking server requests, or, when the file has
stopped updating, Emacs blocked in Lisp or a subprocess. When the file is
fresh, the cause comes from how the probe failed: a timeout means Emacs runs
its timers but is too slow to answer (long garbage collections or busy Lisp);
a missing socket file, one replaced since the server last answered, or a
refused connection points at the socket itself. Each outage and recovery is
appended to LOG_FILE, with the probe's failure, so past incidents can be
classified.

Every run also appends one JSON line to SAMPLES_FILE: how long the server
took to answer and why the probe failed, the state file's age, the garbage
collections Emacs ran since the previous run, the load averages, swap use,
the user's processes with the largest memory footprint and all processes
with the largest resident size. The footprint, unlike the resident size,
counts compressed and swapped-out pages, so a process that has been swapped
out still ranks by the memory it holds; macOS reports it only for the
user's own processes. A freeze can then be matched against what the
machine was doing at the time. Lines older than SAMPLES_RETENTION are
dropped.

When the probe fails, or Emacs ran a storm of garbage collections since
the previous run, the watchdog also samples Emacs's threads with
`/usr/bin/sample' into STACKS_DIR, at most once per CAPTURE_INTERVAL, and
names the report in that run's sample line (`stack_file'). Without it, a
freeze leaves no record of the code that was running. Incident history:
emacs/freeze-incidents.org.
"""

from __future__ import annotations

import ctypes
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

STATE_FILE = Path.home() / ".cache/emacs-server-state.json"
WATCHDOG_FILE = Path.home() / ".cache/emacs-server-watchdog.json"
LOG_FILE = Path.home() / "Library/Logs/emacs-server-watchdog.log"
SAMPLES_FILE = Path.home() / "Library/Logs/emacs-server-watchdog.samples.jsonl"
SAMPLES_RETENTION = 7 * 86400
# Trim only once the oldest line is this far past retention, so the file
# is rewritten about once a day rather than every minute.
SAMPLES_TRIM_SLACK = 86400
TOP_PROCESSES = 5
EMACSCLIENT = "/opt/homebrew/bin/emacsclient"
PROBE_TIMEOUT = 5
# Longest emacsclient error kept in samples and the log.
DETAIL_LENGTH = 160
FAILURES_TO_ALERT = 2
# The state file is written every five seconds; older than this means
# Emacs is not running its timers.
STALE_AFTER = 30
# Stacks of a stalled Emacs, one file per capture, kept for STACKS_RETENTION.
STACKS_DIR = Path.home() / "Library/Logs/emacs-server-watchdog.stacks"
STACKS_RETENTION = 7 * 86400
SAMPLE = "/usr/bin/sample"
SAMPLE_SECONDS = 3
# A `sample' still running after this long is stopped. While attached it
# makes every dlopen in Emacs, such as loading native-compiled Lisp, wait
# for it; on 2026-10-19 five samplers hung for up to 2 h under load and
# froze Emacs on each load.
SAMPLE_DEADLINE = 120
# Runs `sample' (the arguments after the deadline) and stops it at the
# deadline.
SAMPLE_SUPERVISOR = ('deadline=$1; shift; "$@" & s=$!; '
                     '(sleep "$deadline"; kill "$s" 2>/dev/null) & k=$!; '
                     'wait "$s"; kill "$k" 2>/dev/null')
# A garbage-collection storm: this many collections since the previous run.
# The busiest minute in a week of samples before 2026-10-10 had under 30.
GC_STORM = 30
# Minimum time between captures, so a long outage keeps a stack every few
# minutes without filling the disk.
CAPTURE_INTERVAL = 300


def main() -> int:
    now = time.time()
    server = check_server(now)
    record_sample(server, now)
    return 0


def check_server(now: float) -> dict:
    """Probe the server, alert on outages, and return the probe's result."""
    state = read_json(STATE_FILE)
    watchdog = read_json(WATCHDOG_FILE) or {}
    pid = state.get("pid") if state else None
    if not (isinstance(pid, int) and emacs_running(pid)):
        write_json(WATCHDOG_FILE, {"failures": 0, "alerted": False})
        return {"emacs_pid": None, "answered": None, "probe_seconds": None}
    socket = socket_path()
    started = time.monotonic()
    outcome = probe(socket)
    probe_seconds = round(time.monotonic() - started, 2)
    answered = outcome["answer"] == pid
    if outcome["answer"] is not None and not answered:
        outcome = {**outcome, "failure": "other_emacs",
                   "detail": f"pid {outcome['answer']} answered"}
    identity = socket_identity(socket)
    socket_status = compare_socket(identity, watchdog.get("socket"))
    result = {"emacs_pid": pid, "answered": answered,
              "probe_seconds": probe_seconds,
              "failure": outcome["failure"], "failure_detail": outcome["detail"],
              "socket": socket_status,
              "state_age_seconds": round(now - float(state.get("time", 0)), 1),
              **gc_activity(state, watchdog.get("gc"))}
    failures = 0 if answered else watchdog.get("failures", 0) + 1
    last_capture = watchdog.get("last_capture", 0)
    reason = capture_reason(result)
    if reason and now - last_capture >= CAPTURE_INTERVAL:
        result["stack_file"] = capture_stack(pid, reason, now)
        last_capture = now
    alerted = watchdog.get("alerted", False)
    if answered and alerted:
        log("recovered")
        notify("The outage is over.", "Emacs server answering again")
        alerted = False
    if failures >= FAILURES_TO_ALERT and not alerted:
        cause = diagnose(state, outcome, socket_status, now)
        log(f"outage: {cause} [probe: {outcome['failure']}: {outcome['detail']}]")
        notify(cause, "Emacs server not answering")
        alerted = True
    write_json(WATCHDOG_FILE, {
        "failures": failures, "alerted": alerted,
        "socket": identity if answered else watchdog.get("socket"),
        "gc": gc_counters(state), "last_capture": last_capture})
    return result


def capture_reason(result: dict) -> str | None:
    """Return why RESULT warrants sampling Emacs's stack, or None.

    A failed probe means Emacs is stalled now. A storm of garbage
    collections may already be over by the time the watchdog runs, but
    one that lasts several minutes is caught in progress.
    """
    if not result["answered"]:
        return result["failure"] or "failure"
    if (result["gc_count_delta"] or 0) >= GC_STORM:
        return "gc-storm"
    return None


def capture_stack(pid: int, reason: str, now: float) -> str | None:
    """Start sampling PID's threads with `sample' and return the report's path.

    Native-compiled Lisp functions appear in the report under their
    symbol names, so it shows which Lisp code was running, not only the C
    frames. `sample' records for SAMPLE_SECONDS at once but then spends
    17-40 s symbolicating (longer at launchd's background priority), so it
    runs detached in its own session, which launchd does not kill when
    this run exits; the report appears once it finishes. A supervising
    shell stops it after SAMPLE_DEADLINE. Return None when it cannot be
    started.
    """
    STACKS_DIR.mkdir(parents=True, exist_ok=True)
    # Stacks name local paths and buffers; keep them owner-only.
    STACKS_DIR.chmod(0o700)
    trim_stacks(now)
    stamp = time.strftime("%Y%m%d-%H%M%S", time.localtime(now))
    path = STACKS_DIR / f"{stamp}-{reason}.txt"
    try:
        subprocess.Popen(["/bin/sh", "-c", SAMPLE_SUPERVISOR, "sh",
                          str(SAMPLE_DEADLINE), SAMPLE, str(pid),
                          str(SAMPLE_SECONDS), "-file", str(path)],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as err:
        log(f"stack capture failed: {shorten(str(err))}")
        return None
    return str(path)


def trim_stacks(now: float) -> None:
    """Delete stack reports older than STACKS_RETENTION."""
    for path in STACKS_DIR.glob("*.txt"):
        if path.stat().st_mtime < now - STACKS_RETENTION:
            path.unlink()


def socket_identity(socket: str) -> list[int] | None:
    """Return SOCKET's inode and modification time, or None if it is missing."""
    try:
        info = os.stat(socket)
    except FileNotFoundError:
        return None
    return [info.st_ino, int(info.st_mtime)]


def compare_socket(identity: list[int] | None, answered: list[int] | None) -> str:
    """Compare the socket's IDENTITY with the one it had when it last ANSWERED.

    Return "missing", "replaced", "unchanged", or "unknown" when the server
    has not answered since the watchdog's state was reset.
    """
    if identity is None:
        return "missing"
    if answered is None:
        return "unknown"
    return "unchanged" if identity == answered else "replaced"


def gc_counters(state: dict) -> dict | None:
    """Return the cumulative garbage-collection counters in STATE, or None."""
    if not isinstance(state.get("gcs_done"), int):
        return None
    return {"pid": state["pid"], "gcs_done": state["gcs_done"],
            "gc_elapsed": float(state["gc_elapsed"])}


def gc_activity(state: dict, previous: dict | None) -> dict:
    """Return the garbage collections in STATE since the PREVIOUS counters.

    The deltas are None when there is nothing to compare with: no counters
    in either reading, or a different or restarted Emacs.
    """
    current = gc_counters(state)
    comparable = (current and previous and previous.get("pid") == current["pid"]
                  and previous["gcs_done"] <= current["gcs_done"])
    return {
        "gc_count_delta": (current["gcs_done"] - previous["gcs_done"]
                           if comparable else None),
        "gc_seconds_delta": (round(current["gc_elapsed"] - previous["gc_elapsed"], 2)
                             if comparable else None),
        "gc_cons_threshold": state.get("gc_cons_threshold"),
    }


def record_sample(server: dict, now: float) -> None:
    """Append SERVER's probe result and the machine's load to SAMPLES_FILE."""
    processes = memory_by_process()
    emacs = next((p for p in processes if p[0] == server["emacs_pid"]), None)
    by_footprint = sorted((p for p in processes if p[2] is not None),
                          key=lambda p: p[2], reverse=True)
    by_rss = sorted(processes, key=lambda p: p[1], reverse=True)
    sample = {
        "time": round(now),
        **server,
        "emacs_memory_mb": emacs[2] if emacs else None,
        "emacs_rss_mb": emacs[1] if emacs else None,
        "load": [round(x, 2) for x in os.getloadavg()],
        "swap_used_mb": swap_used_mb(),
        "top_memory_mb": [[name, footprint, rss] for _, rss, footprint, name
                          in by_footprint[:TOP_PROCESSES]],
        "top_rss_mb": [[name, rss] for _, rss, _, name in by_rss[:TOP_PROCESSES]],
    }
    SAMPLES_FILE.parent.mkdir(parents=True, exist_ok=True)
    with SAMPLES_FILE.open("a") as f:
        f.write(json.dumps(sample) + "\n")
    trim_samples(now)


def memory_by_process() -> list[tuple[int, int, int | None, str]]:
    """Return (pid, resident MB, footprint MB, executable name) per process.

    The footprint is None for processes of other users, root daemons
    included: macOS reports it only to their owner or root. (top, which
    is setuid, reads it for all, but takes over 30 s at launchd's
    background priority.) Only the executable name is read: command lines
    can carry credentials.
    """
    output = subprocess.run(["ps", "-A", "-o", "pid=,rss=,comm="],
                            capture_output=True, text=True, check=True).stdout
    processes = []
    for line in output.splitlines():
        pid, rss, comm = line.split(None, 2)
        processes.append((int(pid), int(rss) // 1024, footprint_mb(int(pid)),
                          Path(comm).name))
    return processes


class RusageInfoV0(ctypes.Structure):
    """The `rusage_info_v0' structure of <sys/resource.h>."""
    _fields_ = [("uuid", ctypes.c_uint8 * 16)] + [
        (name, ctypes.c_uint64) for name in (
            "user_time", "system_time", "pkg_idle_wkups", "interrupt_wkups",
            "pageins", "wired_size", "resident_size", "phys_footprint",
            "proc_start_abstime", "proc_exit_abstime")]


LIBPROC = ctypes.CDLL("/usr/lib/libproc.dylib", use_errno=True)


def footprint_mb(pid: int) -> int | None:
    """Return PID's physical footprint in MB, or None if it cannot be read.

    This is the "Memory" column of Activity Monitor: the process's private
    memory, including compressed and swapped-out pages.
    """
    info = RusageInfoV0()
    if LIBPROC.proc_pid_rusage(pid, 0, ctypes.byref(info)) != 0:
        return None
    return info.phys_footprint // 2**20


def swap_used_mb() -> int:
    """Return the swap space in use, in MB."""
    output = subprocess.run(["sysctl", "-n", "vm.swapusage"],
                            capture_output=True, text=True, check=True).stdout
    match = re.search(r"used = ([0-9.]+)M", output)
    if not match:
        raise ValueError(f"unexpected vm.swapusage output: {output!r}")
    return round(float(match.group(1)))


def trim_samples(now: float) -> None:
    """Drop samples older than SAMPLES_RETENTION once enough have expired."""
    with SAMPLES_FILE.open() as f:
        first = f.readline()
    if json.loads(first)["time"] > now - SAMPLES_RETENTION - SAMPLES_TRIM_SLACK:
        return
    cutoff = now - SAMPLES_RETENTION
    kept = [line for line in SAMPLES_FILE.read_text().splitlines(keepends=True)
            if json.loads(line)["time"] >= cutoff]
    temp = SAMPLES_FILE.with_suffix(".tmp")
    temp.write_text("".join(kept))
    temp.replace(SAMPLES_FILE)


def diagnose(state: dict, outcome: dict, socket_status: str, now: float) -> str:
    """Return a one-line cause for a failed probe.

    STATE is the Emacs state file, OUTCOME the probe's result and
    SOCKET_STATUS how the socket compares with when the server last answered.
    """
    age = now - float(state.get("time", 0))
    if outcome["failure"] == "other_emacs":
        return (f"Another Emacs (pid {outcome['answer']}) answers the server "
                f"socket, not the live one (pid {state['pid']}).")
    if age > STALE_AFTER:
        return (f"Emacs has been blocked for {int(age)} s, in Lisp or a "
                "subprocess; C-g may interrupt it.")
    if state.get("debugger"):
        first = state["debugger"].splitlines()[:2]
        return ("Server parked in the debugger: " + " / ".join(first)
                + ". Leave it with C-] or q in *Backtrace*.")
    if state.get("prompt"):
        return (f"Server parked at a minibuffer prompt: {state['prompt']} "
                "Answer or quit it.")
    if state.get("recursion_depth", 0) > 0:
        return (f"Server parked in a recursive edit (depth "
                f"{state['recursion_depth']}); leave it with C-].")
    if socket_status == "missing" or outcome["failure"] == "no_socket":
        return "The server socket file is missing, so nothing can connect to Emacs."
    if socket_status == "replaced":
        return ("The server socket was replaced since Emacs last answered; "
                "another process may own it now.")
    if outcome["failure"] == "refused":
        return ("The server socket refuses connections: nothing listens on it, "
                "or Emacs has left its connection queue full.")
    if outcome["failure"] == "timeout":
        return (f"Emacs runs timers (state {int(age)} s old) but did not answer "
                f"within {PROBE_TIMEOUT} s: likely long garbage collections or "
                "busy Lisp.")
    return f"emacsclient failed: {outcome['detail']}"


def socket_path() -> str:
    """Return the live server socket, which launchd's TMPDIR may not name."""
    tmp = subprocess.run(["getconf", "DARWIN_USER_TEMP_DIR"],
                         capture_output=True, text=True, check=True).stdout.strip()
    return f"{tmp}emacs{os.getuid()}/server"


def probe(socket: str) -> dict:
    """Ask the Emacs at SOCKET for its process ID.

    Return a dict with "answer", the process ID or None, and, when there is
    no answer, "failure" (see `classify_failure') and "detail", a shortened
    error message; both are None after an answer.
    """
    try:
        result = subprocess.run(
            [EMACSCLIENT, f"--socket-name={socket}", f"--timeout={PROBE_TIMEOUT}",
             "--eval", "(emacs-pid)"],
            capture_output=True, text=True, timeout=PROBE_TIMEOUT + 10)
    except subprocess.TimeoutExpired:
        return {"answer": None, "failure": "timeout",
                "detail": f"emacsclient hung past {PROBE_TIMEOUT + 10} s"}
    if result.returncode == 0:
        try:
            return {"answer": int(result.stdout.strip()), "failure": None,
                    "detail": None}
        except ValueError:
            return {"answer": None, "failure": "error",
                    "detail": "unexpected answer: " + shorten(result.stdout)}
    return {"answer": None, "failure": classify_failure(result.stderr),
            "detail": f"exit {result.returncode}: " + shorten(result.stderr)}


def classify_failure(stderr: str) -> str:
    """Return why emacsclient failed, from its STDERR.

    "timeout" when the server accepted the connection but did not reply,
    "refused" when the connection was refused, "no_socket" when there is no
    socket file, and "error" otherwise.
    """
    if "timed out after" in stderr:
        return "timeout"
    if "Connection refused" in stderr:
        return "refused"
    if "can't find socket" in stderr or "No such file or directory" in stderr:
        return "no_socket"
    return "error"


def shorten(text: str) -> str:
    """Return TEXT's lines joined, without emacsclient's path, cut to DETAIL_LENGTH."""
    lines = [line.strip().removeprefix(EMACSCLIENT + ": ")
             for line in text.splitlines() if line.strip()]
    return " / ".join(lines)[:DETAIL_LENGTH]


def emacs_running(pid: int) -> bool:
    """Return whether PID is a running Emacs process."""
    result = subprocess.run(["ps", "-p", str(pid), "-o", "comm="],
                            capture_output=True, text=True)
    return result.returncode == 0 and "Emacs" in result.stdout


def notify(message: str, title: str) -> None:
    subprocess.run(["osascript", "-e", "on run argv", "-e",
                    "display notification (item 1 of argv) with title (item 2 of argv)",
                    "-e", "end run", "--", message, title],
                   capture_output=True)


def log(line: str) -> None:
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with LOG_FILE.open("a") as f:
        f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {line}\n")


def read_json(path: Path) -> dict | None:
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_suffix(".tmp")
    temp.write_text(json.dumps(data))
    temp.replace(path)


if __name__ == "__main__":
    sys.exit(main())
