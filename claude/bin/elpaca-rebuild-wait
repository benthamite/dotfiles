#!/usr/bin/env python3
"""Wait for a rebuild bound to one runtime and clean, committed source.

The first-line status protocol is retained for post-commit callers. Its JSON
sidecar is evidence, not a cache of unqualified success. A per-package lock and
durable in-flight record prevent cooperating invocations from competing.
"""

import base64
from contextlib import contextmanager
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import time


class RebuildError(Exception):
    pass


def command(args, timeout=10):
    try:
        result = subprocess.run(args, capture_output=True, text=True,
                                timeout=timeout, check=False)
    except (OSError, subprocess.SubprocessError, UnicodeError):
        raise RebuildError("command transport failed") from None
    if result.returncode:
        raise RebuildError("command failed; raw output suppressed")
    return result.stdout.strip()


def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, name = tempfile.mkstemp(prefix=".reload-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def write_json(path, value):
    atomic_write(path, json.dumps(value, sort_keys=True) + "\n")


def read_json(path):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return None
    except (OSError, ValueError, UnicodeError):
        raise RebuildError("invalid rebuild receipt; reconcile its owner") from None


def read_status(path):
    try:
        return path.read_text().splitlines()[0].split(":", 1)[0]
    except FileNotFoundError:
        return "missing"
    except (OSError, IndexError, UnicodeError):
        raise RebuildError("unreadable rebuild status") from None


def status_identity(path):
    with path.open("rb") as stream:
        stat = os.fstat(stream.fileno())
        digest = hashlib.sha256(stream.read()).hexdigest()
    return [stat.st_dev, stat.st_ino, stat.st_mtime_ns, stat.st_size, digest]


@contextmanager
def owner_lock(root, package, *, observe=False):
    directory = root / "owners"
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (directory / f"{package}.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            if observe:
                yield None
                return
            raise RebuildError("another rebuild owner is active; wait for that owner") from None
        yield directory


def read_operation(operation_file):
    operation = read_json(operation_file)
    if operation is not None:
        if (not isinstance(operation, dict) or operation.get("version") != 1
                or operation.get("state") not in ("requesting", "pending", "finished", "failed", "rejected")
                or not isinstance(operation.get("context"), dict)
                or not isinstance(operation.get("status_file"), str)
                or not Path(operation["status_file"]).is_absolute()
                or (operation["state"] != "requesting" and
                    (not isinstance(operation.get("token"), str) or
                     not re.fullmatch(r"[A-Za-z0-9+_.-]{1,256}", operation["token"])))):
            raise RebuildError("invalid owner record; reconcile its owner")
    return operation


def resume_token(operation, initial, status_file):
    if (operation.get("context") != initial or operation.get("status_file") != str(status_file)
            or not operation.get("token")
            or operation.get("status_identity") != status_identity(status_file)):
        raise RebuildError("an unresolved rebuild exists; reconcile its owner before requesting another")
    return operation["token"]


def wait_for_operation(package, source_repo, extras, initial, operation,
                       operation_file, status_file, receipt_file, interval, deadline):
    token = operation["token"]
    while time.monotonic() <= deadline:
        state = token_status(package, token, initial["runtime"])
        if state in ("finished", "failed"):
            # Once terminal completion fails validation this token must never
            # become evidence, even if the source later returns to its HEAD.
            operation["state"] = "rejected"
            write_json(operation_file, operation)
            try:
                if context(package, source_repo, extras) != initial:
                    raise RebuildError("source or runtime changed during rebuild; completion not certified")
                if operation["status_identity"] != status_identity(status_file):
                    raise RebuildError("status replaced by another producer; completion not certified")
            except RebuildError:
                if operation["status_identity"] == status_identity(status_file):
                    atomic_write(status_file, "failed:completion context could not be verified\n")
                raise
            operation["state"] = state
            write_json(operation_file, operation)
            if state == "failed":
                atomic_write(status_file, "failed:build or reload failed\n")
                raise RebuildError("build or reload failed; raw diagnostics suppressed")
            write_json(receipt_file, {"version": 1, "context": initial, "token": token, "state": "finished"})
            atomic_write(status_file, "finished:loaded\n")
            print("finished:loaded")
            return
        poll_sleep(interval, deadline)
    raise RebuildError("timed out; rebuild may still be running, retained owner record")


def observe_abandoned_operation(root, package, source_repo, extras, initial,
                                status_file, receipt_file, interval, deadline):
    """Resume certification under the free owner lock, never request a rebuild."""
    with owner_lock(root, package, observe=True) as directory:
        if directory is None or read_status(status_file) != "pending":
            return False
        operation_file = directory / f"{package}.json"
        operation = read_operation(operation_file)
        if operation is None:
            return False  # The post-commit producer may not have started yet.
        if operation["state"] == "rejected":
            raise RebuildError("existing completion was rejected; reconcile its owner")
        resume_token(operation, initial, status_file)
        if context(package, source_repo, extras) != initial:
            raise RebuildError("source or runtime changed before resuming rebuild")
        wait_for_operation(package, source_repo, extras, initial, operation,
                           operation_file, status_file, receipt_file, interval, deadline)
        return True


def runtime_form(package):
    # Values come from this process and the live registry, not .current-profile.
    return f"""(let* ((entry (elpaca-get '{package}))
      (source (and entry (or (elpaca<-source-dir entry)
                            (elpaca-source-dir entry)))))
      (unless (and source (not (file-remote-p source))) (error "Missing source"))
      `((package . ,(symbol-name '{package})) (pid . ,(emacs-pid))
        (start . ,(prin1-to-string before-init-time))
        (profile . ,(directory-file-name (file-truename user-emacs-directory)))
        (source . ,(directory-file-name (file-truename source)))))"""


def emacs_json(form):
    wrapped = f"""(progn (require 'json)
      ;; elpaca-rebuild-context-v1
      (base64-encode-string (encode-coding-string
        (json-encode {form}) 'utf-8) t))"""
    raw = command(["emacsclient", "-e", wrapped], timeout=30)
    try:
        encoded = json.loads(raw)
        if not isinstance(encoded, str):
            raise ValueError()
        return json.loads(base64.b64decode(encoded, validate=True).decode("utf-8"))
    except (ValueError, TypeError, UnicodeError):
        raise RebuildError("invalid Emacs protocol response; raw output suppressed") from None


def validate_runtime(value, package):
    if (not isinstance(value, dict) or set(value) != {"package", "pid", "start", "profile", "source"}
            or value["package"] != package or type(value["pid"]) is not int
            or value["pid"] <= 0):
        raise RebuildError("invalid runtime identity")
    for key in ("start", "profile", "source"):
        if not isinstance(value[key], str) or not value[key] or any(ord(c) < 32 for c in value[key]):
            raise RebuildError("invalid runtime identity")
    for key in ("profile", "source"):
        if not Path(value[key]).is_absolute():
            raise RebuildError("invalid runtime path")
        value[key] = str(Path(value[key]).resolve(strict=True))
    return value


def source_identity(repo, pathspec=None):
    repo = Path(command(["git", "-C", str(repo), "rev-parse", "--show-toplevel"])).resolve(strict=True)
    head = command(["git", "-C", str(repo), "rev-parse", "HEAD"])
    if not re.fullmatch(r"[0-9a-f]{40,64}", head):
        raise RebuildError("invalid source revision")
    args = ["git", "-C", str(repo), "status", "--porcelain", "--untracked-files=normal"]
    if pathspec:
        args.extend(["--", pathspec])
    if command(args):
        raise RebuildError("source or active mirror has uncommitted changes")
    stat = repo.stat()
    return {"repo": str(repo), "head": head, "device": stat.st_dev, "inode": stat.st_ino}


def context(package, source_repo, extras):
    runtime = validate_runtime(emacs_json(runtime_form(package)), package)
    pathspec = f"emacs/extras/{package}.el" if extras else "*.el"
    source = source_identity(source_repo, pathspec)
    active = source_identity(runtime["source"], None if extras else pathspec)
    if extras:
        if active["head"] != source["head"]:
            raise RebuildError("active dotfiles mirror HEAD does not match source HEAD")
    elif active["repo"] != source["repo"]:
        raise RebuildError("active registry source does not match resolved source")
    return {"runtime": runtime, "source": source, "active": active}


def token_status(package, token, expected_runtime):
    if not isinstance(token, str) or not re.fullmatch(r"[A-Za-z0-9+_.-]{1,256}", token):
        raise RebuildError("invalid completion token")
    value = emacs_json(f"""(let ((status (elpaca-extras-build-reload-status {json.dumps(token)})))
      `((runtime . ,{runtime_form(package)})
        (package . ,(and (plist-get status :package)
                        (symbol-name (plist-get status :package))))
        (state . ,(symbol-name (or (plist-get status :state) 'missing)))))""")
    if not isinstance(value, dict) or validate_runtime(value.get("runtime"), package) != expected_runtime:
        raise RebuildError("Emacs runtime changed while waiting")
    if value.get("package") != package or value.get("state") not in ("queued", "finished", "failed"):
        raise RebuildError("completion token is missing or belongs to another package")
    return value["state"]


def request(package, expected):
    # Compare in the same Emacs evaluation that queues the build. No transport
    # output or provider message is interpolated into executable forms.
    checks = " ".join(
        f"(equal (alist-get '{key} runtime) {json.dumps(value)})"
        for key, value in expected.items()
    )
    value = emacs_json(f"""(let ((runtime {runtime_form(package)}))
      (unless (and {checks}) (error "Runtime changed"))
      `((token . ,(elpaca-extras-rebuild-and-reload '{package}))))""")
    token = value.get("token") if isinstance(value, dict) else None
    if not isinstance(token, str) or not re.fullmatch(r"[A-Za-z0-9+_.-]{1,256}", token):
        raise RebuildError("no valid completion token; rebuild outcome is uncertain")
    return token


def seconds(name, default, positive=False):
    try:
        value = float(os.environ.get(name, default))
        if not math.isfinite(value) or value < 0 or (positive and value == 0):
            raise ValueError()
        return value
    except ValueError:
        raise RebuildError("invalid timeout or poll interval") from None


def poll_sleep(interval, deadline):
    time.sleep(min(interval, max(0, deadline - time.monotonic())))


def main():
    if len(sys.argv) != 2 or not re.fullmatch(r"[A-Za-z0-9+_.-]+", sys.argv[1]):
        raise RebuildError("Usage: elpaca-rebuild-wait PACKAGE (valid identifier required)")
    tool_root = Path(__file__).resolve().parents[2]
    dotfiles = Path(os.environ.get("DOTFILES_ROOT", tool_root)).resolve(strict=True)
    resolution = json.loads(command([str(tool_root / "bin/elpaca-package-resolve"), sys.argv[1]]))
    package, source_repo = resolution["id"], Path(resolution["repo"]).resolve(strict=True)
    if not isinstance(package, str) or not re.fullmatch(r"[A-Za-z0-9+_.-]+", package):
        raise RebuildError("invalid resolved package")
    extras = source_repo == dotfiles and (dotfiles / "emacs/extras" / f"{package}.el").is_file()
    owner = os.environ.get("ELPACA_RELOAD_OWNER", "0")
    if owner not in ("0", "1"):
        raise RebuildError("ELPACA_RELOAD_OWNER must be 0 or 1")
    owner = owner == "1" or not extras
    timeout = seconds("ELPACA_RELOAD_TIMEOUT_SECONDS", "120", positive=True)
    interval = seconds("ELPACA_RELOAD_POLL_INTERVAL_SECONDS", "1")
    root = Path(os.environ.get("ELPACA_RELOAD_STATE_DIR", Path.home() / ".cache/dotfiles/elpaca-reload"))
    commit = command(["git", "-C", str(source_repo), "rev-parse", "HEAD"])
    status_file = Path(os.environ.get("ELPACA_RELOAD_STATUS_FILE", root / commit / f"{package}.status")).absolute()
    try:
        initial = context(package, source_repo, extras)
        if (status_file.parent.parent == root.absolute()
                and re.fullmatch(r"[0-9a-f]{40,64}", status_file.parent.name)
                and status_file.parent.name != initial["source"]["head"]):
            raise RebuildError("post-commit status revision no longer matches source HEAD")
    except RebuildError:
        if owner:
            with owner_lock(root, package) as directory:
                previous = read_json(directory / f"{package}.json")
                if ((previous is None or (isinstance(previous, dict) and
                     previous.get("state") in ("finished", "failed", "rejected")))
                        and read_status(status_file) == "pending"):
                    atomic_write(status_file, "failed:owner preflight failed; no rebuild requested\n")
        raise
    receipt_file = status_file.with_name(status_file.name + ".receipt.json")
    deadline = time.monotonic() + timeout

    if not owner and read_status(status_file) != "missing":
        while time.monotonic() <= deadline:
            state = read_status(status_file)
            if state == "finished":
                receipt = read_json(receipt_file)
                if (not isinstance(receipt, dict) or receipt.get("version") != 1
                        or receipt.get("context") != initial or receipt.get("state") != "finished"):
                    raise RebuildError("unverified completion; request a fresh owner with ELPACA_RELOAD_OWNER=1")
                if token_status(package, receipt.get("token"), initial["runtime"]) != "finished":
                    raise RebuildError("completion token is not finished")
                if context(package, source_repo, extras) != initial or read_json(receipt_file) != receipt or read_status(status_file) != "finished":
                    raise RebuildError("completion context changed during verification")
                print("finished:loaded")
                return
            if state == "failed":
                raise RebuildError("existing rebuild failed; request a fresh owner")
            if state not in ("pending", "missing"):
                raise RebuildError("invalid rebuild status")
            if state == "pending" and observe_abandoned_operation(
                    root, package, source_repo, extras, initial, status_file,
                    receipt_file, interval, deadline):
                return
            poll_sleep(interval, deadline)
        raise RebuildError("timed out waiting for the existing owner; no rebuild requested")

    with owner_lock(root, package) as lock_dir:
        if context(package, source_repo, extras) != initial:
            raise RebuildError("source or runtime changed before rebuild")
        if not owner and read_status(status_file) != "missing":
            raise RebuildError("another owner published status; retry to observe that owner")
        operation_file = lock_dir / f"{package}.json"
        operation = read_operation(operation_file)
        if operation and operation.get("state") in ("requesting", "pending"):
            resume_token(operation, initial, status_file)
        else:
            operation = {"version": 1, "context": initial, "status_file": str(status_file), "state": "requesting"}
            write_json(operation_file, operation)
            atomic_write(status_file, "pending:requesting rebuild\n")
            operation["status_identity"] = status_identity(status_file)
            write_json(operation_file, operation)
            token = request(package, initial["runtime"])
            operation.update(token=token, state="pending")
            write_json(operation_file, operation)
        wait_for_operation(package, source_repo, extras, initial, operation,
                           operation_file, status_file, receipt_file, interval, deadline)


if __name__ == "__main__":
    try:
        main()
    except (RebuildError, OSError, ValueError, KeyError, TypeError) as error:
        # Only our controlled messages may cross the terminal/status boundary.
        message = str(error) if isinstance(error, RebuildError) else "invalid configuration or local I/O failure"
        print("failed:" + message, file=sys.stderr)
        sys.exit(1)
