#!/usr/bin/env bash
# Audited clipboard consumer for arbitrary API credentials.
#
# Reads the macOS clipboard (populated by a vendor console's Copy button),
# validates its shape, and pipes a 1Password item template to
# `op-desktop item create -` on stdin. The value never reaches argv, agent
# output, or a file. Prints only length/newline diagnostics and the item's
# non-secret reference paths. Companion to `ai-provider-key-from-clipboard`,
# which covers model-provider keys specifically.
#
# Usage: store-secret-from-clipboard --vault Automations \
#          --title "Slack - Slack Monitor" --prefix xoxb- \
#          [--field credential] [--extra app_id=A0123] [--extra channel_id=C0123] \
#          [--min-bytes 20] [--max-bytes 250] [--update]
#
# --update edits the named field on an existing item instead of creating one.
set -euo pipefail

vault="" title="" prefix="" field="credential" min_bytes=20 max_bytes=250 update=0
extras=()
while [ $# -gt 0 ]; do
  case "$1" in
    --vault) vault="$2"; shift 2 ;;
    --title) title="$2"; shift 2 ;;
    --prefix) prefix="$2"; shift 2 ;;
    --field) field="$2"; shift 2 ;;
    --extra) extras+=("$2"); shift 2 ;;
    --min-bytes) min_bytes="$2"; shift 2 ;;
    --max-bytes) max_bytes="$2"; shift 2 ;;
    --update) update=1; shift ;;
    *) echo "store-secret-from-clipboard: unknown argument $1" >&2; exit 2 ;;
  esac
done
if [ -z "$vault" ] || [ -z "$title" ]; then
  echo "store-secret-from-clipboard: --vault and --title are required" >&2
  exit 2
fi
case "$title" in
  *"("*|*")"*) echo "store-secret-from-clipboard: parentheses in titles break op:// references" >&2; exit 2 ;;
esac

SECRET="$(pbpaste)"
trap 'unset SECRET' EXIT

bytes=$(printf %s "$SECRET" | wc -c | tr -d ' ')
newlines=$(printf %s "$SECRET" | tr -cd '\n' | wc -c | tr -d ' ')
printf 'clipboard candidate: len=%s nl=%s\n' "$bytes" "$newlines"
if [ -n "$prefix" ]; then
  case "$SECRET" in
    "$prefix"*) : ;;
    *) echo "clipboard content does not start with the expected prefix $prefix" >&2; exit 1 ;;
  esac
fi
if [ "$bytes" -lt "$min_bytes" ] || [ "$bytes" -gt "$max_bytes" ] || [ "$newlines" -ne 0 ]; then
  echo "clipboard content does not match expected secret shape" >&2
  exit 1
fi

if [ "$update" -eq 1 ]; then
  # `op item edit` takes assignments on argv; keep the value off argv by
  # feeding a template through stdin is not supported for edit, so use the
  # documented in-process variable form (the value stays in this process).
  op-desktop item edit "$title" --vault="$vault" "$field[concealed]=$SECRET" >/dev/null
else
  template="$(
    SECRET="$SECRET" TITLE="$title" FIELD="$field" python3 - "${extras[@]}" <<'PY'
import json, os, sys
fields = [{"id": os.environ["FIELD"], "type": "CONCEALED", "label": os.environ["FIELD"], "value": os.environ["SECRET"]}]
for extra in sys.argv[1:]:
    label, _, value = extra.partition("=")
    fields.append({"id": label, "type": "STRING", "label": label, "value": value})
print(json.dumps({"title": os.environ["TITLE"], "category": "API_CREDENTIAL", "fields": fields}))
PY
  )"
  printf '%s' "$template" | op-desktop item create --vault "$vault" - >/dev/null
  unset template
fi

op-desktop read "op://$vault/$title/$field" >/dev/null
if [ "$vault" = "Automations" ]; then
  op-automations read "op://$vault/$title/$field" >/dev/null
fi
printf 'stored op://%s/%s/%s\n' "$vault" "$title" "$field"
for extra in "${extras[@]}"; do
  printf 'stored op://%s/%s/%s\n' "$vault" "$title" "${extra%%=*}"
done
