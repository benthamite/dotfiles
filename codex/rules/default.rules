prefix_rule(pattern=["curl", "-L"], decision="allow")
prefix_rule(pattern=["ps", "-Ao"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit", "-m"], decision="allow")
prefix_rule(pattern=["emacs", "-Q", "--batch"], decision="allow")
prefix_rule(pattern=["emacs", "--batch"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
prefix_rule(pattern=["git", "restore", "--source=HEAD", "--worktree"], decision="allow")
prefix_rule(pattern=["emacsclient", "--eval"], decision="allow")
prefix_rule(pattern=["paper-fetch"], decision="allow")
# Idea Swipe app deploy (Pablo, 6 Nov 2026); pairs the Claude allow rule in claude/settings.json.
# The server deploy rule has no counterpart: a prefix rule would also allow server/deploy's
# card-loading, deletion and visibility subcommands, which still need Pablo's approval.
prefix_rule(pattern=["op-automations", "@personal", "run", "--env-file", "/Users/pablostafforini/repos/forethought/idea-swipe/deploy.env.op", "--", "python3", "/Users/pablostafforini/repos/forethought/idea-swipe/web/deploy"], decision="allow")
