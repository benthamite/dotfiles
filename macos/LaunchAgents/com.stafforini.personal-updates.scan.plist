<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stafforini.personal-updates.scan</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/pablostafforini/repos/launchd/bin/launchd-network-retry</string>
    <string>--label</string>
    <string>com.stafforini.personal-updates.scan</string>
    <string>--host</string>
    <string>github.com</string>
    <string>--</string>
    <string>/Users/pablostafforini/My Drive/dotfiles/bin/personal-updates</string>
    <string>scan</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/pablostafforini</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/pablostafforini/.local/state/personal-updates/launchd.scan.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/pablostafforini/.local/state/personal-updates/launchd.scan.err.log</string>
</dict>
</plist>
