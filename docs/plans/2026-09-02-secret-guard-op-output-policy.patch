+    prepared=$(op_policy_prepare "$variant")
+    # Printing a captured broker result is printing the secret.
+    printf '%s' "$prepared" | grep -qE "(^|[;&|(][[:space:]]*)(builtin[[:space:]]+)?([^;&|[:space:]]*/)?(echo|printf)[[:space:]][^;&|]*(SUBST_|\`)[[:space:]]*${OP_BROKER_RE}([[:space:]]|$)" && return 0
+    while IFS= read -r seg; do
+      [ -n "$seg" ] || continue
+      op_segment_prints_secret "$seg" && return 0
+    done < <(op_policy_segments "$prepared")
+  done
+  return 1
+}
